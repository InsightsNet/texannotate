\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{lpsb-luamath}[2026/01/07 v2.0 LPSB LuaLaTeX Math Extension with Coordinates]

% Load Lua module and initialize
\directlua{lpsb_math = require("lpsb-math")}
\directlua{lpsb_math.init()}
\directlua{lpsb_math.open_file(tex.jobname)}

% Use a late hook to ensure all pages are shipped out before closing
% \AtEndDocument runs before the last page is shipped out
% We need to use a later hook
\AddToHook{enddocument/end}{%
    \directlua{lpsb_math.close_file()}%
}

\endinput
