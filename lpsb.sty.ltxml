# -*- mode: LaTeXML; -*-
# LaTeXML binding for lpsb.sty

package LaTeXML::Package::lpsb;
use strict;
use warnings;
use LaTeXML::Package;

# Load ONLY a marker-only TeX shim for LaTeXML conversion.
# This avoids zref/expl3/file-I/O, but still emits \lpsbMark{<id>} at math/table entry points.
# NOTE: LaTeXML avoids raw *.sty unless explicitly permitted; force raw loading.
RequirePackage('lpsb-latexml', type => 'sty', noltxml => 1, raw => 1);

# Emit a lightweight marker element that carries the explicit LPSB id.
DefConstructor('\lpsbMark{}', "<ltx:span class='lpsb-mark' data-lpsb-id='#1'/>");
# In math mode, prefer a robust textual marker that will become MathML text.
# (We strip it out when extracting MathML.)
DefMath('\lpsbMark{}', '\mbox{LPSBMARK:#1}');

1;
