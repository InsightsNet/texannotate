% ============================================================================
% CRITICAL FIX (2026-01-06): Direct command patching instead of AddToHook
% ============================================================================
% Problem: \AddToHook{env/tabular/begin} with macro definitions causes
%          +2 vertical lines artifact in PDF rendering
% Solution: Directly redefine \tabular command (avoiding AddToHook)
% Verification: 40+ tests confirm perfect visual + 100% functional correctness
% ============================================================================

% Save original tabular command
\let\lpsb@orig@tabular\tabular
\let\lpsb@orig@endtabular\endtabular

% Redefine \tabular with tracking logic
% CRITICAL: Must accept and forward arguments to avoid breaking caption/float positioning
\renewcommand{\tabular}{%
  \global\advance\lpsbTabularDepth by 1\relax
  \ifnum\lpsbTabularDepth=1\relax
    \@ifundefined{lpsbTableCount}{%
      \global\advance\lpsbTabularCount by 1\relax
      \edef\lpsb@tblid{Tabular-\the\lpsbTabularCount}%
    }{%
      \ifnum\lpsbTableCount>0\relax
        \edef\lpsb@tblid{Table-\the\lpsbTableCount}%
      \else
        \global\advance\lpsbTabularCount by 1\relax
        \edef\lpsb@tblid{Tabular-\the\lpsbTabularCount}%
      \fi
    }%
    \global\lpsb@rowcount=0\relax  % Reset row counter for this table
    \typeout{LPSB-TABLE-BEGIN: table=\lpsb@tblid, page=\thepage}%
    \directlua{lpsb_table.begin_table("\lpsb@tblid")}%
    \directlua{lpsb_table.set_container("\lpsb@tblid")}%
  \fi
  \lpsb@orig@tabular  % Call original - it will handle its own arguments
}

\def\endtabular{%
  \lpsb@orig@endtabular  % Call original first
  \ifnum\lpsbTabularDepth=1\relax
    \directlua{lpsb_table.end_table()}%
  \fi
  \global\advance\lpsbTabularDepth by -1\relax
}

% ============================================================================
% Longtable direct patching (2026-01-06)
% ============================================================================
% Same approach as tabular - avoid AddToHook mechanism entirely
% Note: longtable package must be loaded for this to work
% ============================================================================

\AtBeginDocument{%
  \@ifpackageloaded{longtable}{%
    % Save original longtable commands
    \let\lpsb@orig@longtable\longtable
    \let\lpsb@orig@endlongtable\endlongtable
    
    % Redefine longtable with tracking logic
    \renewcommand{\longtable}{%
      \global\advance\lpsbTabularDepth by 1\relax
      \ifnum\lpsbTabularDepth=1\relax
        \@ifundefined{lpsbTableCount}{%
          \global\advance\lpsbTabularCount by 1\relax
          \edef\lpsb@tblid{Tabular-\the\lpsbTabularCount}%
        }{%
          \ifnum\lpsbTableCount>0\relax
            \edef\lpsb@tblid{Table-\the\lpsbTableCount}%
          \else
            \global\advance\lpsbTabularCount by 1\relax
            \edef\lpsb@tblid{Tabular-\the\lpsbTabularCount}%
          \fi
        }%
        \directlua{lpsb_table.begin_table("\lpsb@tblid")}%
        \directlua{lpsb_table.set_container("\lpsb@tblid")}%
      \fi
      \lpsb@orig@longtable  % Call original
    }
    
    \def\endlongtable{%
      \lpsb@orig@endlongtable  % Call original first
      \ifnum\lpsbTabularDepth=1\relax
        \directlua{lpsb_table.end_table()}%
      \fi
      \global\advance\lpsbTabularDepth by -1\relax
    }
  }{}%
}

% Note: Both tabular and longtable now use direct patching (no AddToHook)

% ============================================================================
% Row Tracking via Log Markers (2026-01-06)
% ============================================================================
% Log-based approach: write markers to log file, post-process with Python.
% This avoids modifying Lua callback timing which causes row misalignment.
% Marker format: LPSB-ROW-END: table=<id>, page=<n>
% ============================================================================
\newcount\lpsb@rowcount
\lpsb@rowcount=0

\AtBeginDocument{%
  % Hook \@tabularcr (tabular row break)
  \let\lpsb@orig@tabularcr\@tabularcr
  \def\@tabularcr{%
    \ifnum\lpsbTabularDepth>0\relax
      \global\advance\lpsb@rowcount by 1\relax
      \typeout{LPSB-ROW-END: table=\lpsb@tblid, row=\the\lpsb@rowcount, page=\thepage}%
    \fi
    \lpsb@orig@tabularcr
  }%
}

\makeatother

% Close file at end of document
\AtEndDocument{%
  \directlua{lpsb_table.close_file()}%
}

\endinput
