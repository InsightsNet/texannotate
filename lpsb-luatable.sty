\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{lpsb-luatable}[2026/01/06 v0.2 LPSB LuaLaTeX Table Extension]

\RequirePackage[savepos]{zref}
\RequirePackage{zref-abspage}
\RequirePackage{iftex}
\ifLuaTeX\else
  \PackageError{lpsb-luatable}{This package requires LuaLaTeX}{Use lualatex for the table pass.}
\fi

\makeatletter
% Create a custom property list that includes position + abspage.
% The 'savepos' option creates properties posx/posy but not a list containing abspage.
% We need a combined list for our labels.
\zref@newlist{lpsb}
\zref@addprop{lpsb}{posx}
\zref@addprop{lpsb}{posy}
\zref@addprop{lpsb}{abspage}

% Custom save command that uses our combined property list.
% Named lpsb@zrsave to avoid conflict with lpsb.sty's lpsb@savepos.
\newcommand*{\lpsb@zrsave}[1]{%
  \@bsphack
  \pdfsavepos
  \zref@labelbylist{#1}{lpsb}%
  \@esphack
}

% Helper: set page value. For now, just use current page counter.
% TODO: Fix to extract from zref for cross-page longtable tracking.
\newcommand{\lpsb@setpage}[1]{%
  \edef\lpsb@pageval{\the\c@page}%
}

% Load Lua module and initialize
\directlua{lpsb_table = require("lpsb-table")}
\directlua{lpsb_table.init()}
\directlua{lpsb_table.open_file(tex.jobname)}

% Counters and state
\newcount\lpsbTabularDepth
\lpsbTabularDepth=0
\newcount\lpsbTabularCount
\lpsbTabularCount=0
\newcount\lpsb@tblrow
\lpsb@tblrow=0
\def\lpsb@tblid{Tabular-0}

% Save/restore tabular row macros
\let\lpsb@orig@tabularcr\relax
\let\lpsb@orig@arraycr\relax
\let\lpsb@orig@LT@tabularcr\relax

% === Standard tabular/tabularx begin hook ===
\def\lpsb@tabularBegin{%
  \global\advance\lpsbTabularDepth by 1\relax
  \ifnum\lpsbTabularDepth=1\relax
    \@ifundefined{lpsbTableCount}{%
      \global\advance\lpsbTabularCount by 1\relax
      \edef\lpsb@tblid{Tabular-\the\lpsbTabularCount}%
    }{%
      \ifnum\lpsbTableCount>0\relax
        \edef\lpsb@tblid{Table-\the\lpsbTableCount}%
      \else
        \global\advance\lpsbTabularCount by 1\relax
        \edef\lpsb@tblid{Tabular-\the\lpsbTabularCount}%
      \fi
    }%
    \directlua{lpsb_table.begin_table("\lpsb@tblid")}%
    \directlua{lpsb_table.set_container("\lpsb@tblid")}%
    % Row 1 baseline anchor
    \global\lpsb@tblrow=1\relax
    \lpsb@savepos{lpsbtable-\lpsb@tblid-r\the\lpsb@tblrow}%
    \kern1pt\lpsb@savepos{lpsbtable-\lpsb@tblid-dirx}\kern-1pt%
    \lpsb@setpage{lpsbtable-\lpsb@tblid-r\the\lpsb@tblrow}%
    \directlua{lpsb_table.set_anchor(\lpsb@pageval, \zposx{lpsbtable-\lpsb@tblid-r\the\lpsb@tblrow}, \zposy{lpsbtable-\lpsb@tblid-r\the\lpsb@tblrow})}%
    \directlua{lpsb_table.set_dirx(\zposx{lpsbtable-\lpsb@tblid-dirx}, \zposy{lpsbtable-\lpsb@tblid-dirx})}%
    % Patch row-ending macros
    \let\lpsb@orig@tabularcr\@tabularcr
    \def\@tabularcr{%
      \lpsb@orig@tabularcr
      \noalign{%
        \global\advance\lpsb@tblrow by 1\relax
        \lpsb@savepos{lpsbtable-\lpsb@tblid-r\the\lpsb@tblrow}%
        \lpsb@setpage{lpsbtable-\lpsb@tblid-r\the\lpsb@tblrow}%
        \directlua{lpsb_table.row_break(\lpsb@pageval, \zposx{lpsbtable-\lpsb@tblid-r\the\lpsb@tblrow}, \zposy{lpsbtable-\lpsb@tblid-r\the\lpsb@tblrow})}%
      }%
    }%
    \@ifundefined{@arraycr}{}{%
      \let\lpsb@orig@arraycr\@arraycr
      \def\@arraycr{%
        \lpsb@orig@arraycr
        \noalign{%
          \global\advance\lpsb@tblrow by 1\relax
          \lpsb@savepos{lpsbtable-\lpsb@tblid-r\the\lpsb@tblrow}%
          \lpsb@setpage{lpsbtable-\lpsb@tblid-r\the\lpsb@tblrow}%
          \directlua{lpsb_table.row_break(\lpsb@pageval, \zposx{lpsbtable-\lpsb@tblid-r\the\lpsb@tblrow}, \zposy{lpsbtable-\lpsb@tblid-r\the\lpsb@tblrow})}%
        }%
      }%
    }%
  \fi
}

\def\lpsb@tabularEnd{%
  \ifnum\lpsbTabularDepth=1\relax
    \ifx\lpsb@orig@tabularcr\relax\else
      \let\@tabularcr\lpsb@orig@tabularcr
    \fi
    \ifx\lpsb@orig@arraycr\relax\else
      \let\@arraycr\lpsb@orig@arraycr
    \fi
    \directlua{lpsb_table.end_table()}%
  \fi
  \global\advance\lpsbTabularDepth by -1\relax
}

% === Longtable-specific hooks ===
\def\lpsb@longtableBegin{%
  \global\advance\lpsbTabularDepth by 1\relax
  \ifnum\lpsbTabularDepth=1\relax
    \@ifundefined{lpsbTableCount}{%
      \global\advance\lpsbTabularCount by 1\relax
      \edef\lpsb@tblid{Tabular-\the\lpsbTabularCount}%
    }{%
      \ifnum\lpsbTableCount>0\relax
        \edef\lpsb@tblid{Table-\the\lpsbTableCount}%
      \else
        \global\advance\lpsbTabularCount by 1\relax
        \edef\lpsb@tblid{Tabular-\the\lpsbTabularCount}%
      \fi
    }%
    \directlua{lpsb_table.begin_table("\lpsb@tblid")}%
    \directlua{lpsb_table.set_container("\lpsb@tblid")}%
    % Row 1 anchor
    \global\lpsb@tblrow=1\relax
    \lpsb@savepos{lpsbtable-\lpsb@tblid-r\the\lpsb@tblrow}%
    \kern1pt\lpsb@savepos{lpsbtable-\lpsb@tblid-dirx}\kern-1pt%
    \lpsb@setpage{lpsbtable-\lpsb@tblid-r\the\lpsb@tblrow}%
    \directlua{lpsb_table.set_anchor(\lpsb@pageval, \zposx{lpsbtable-\lpsb@tblid-r\the\lpsb@tblrow}, \zposy{lpsbtable-\lpsb@tblid-r\the\lpsb@tblrow})}%
    \directlua{lpsb_table.set_dirx(\zposx{lpsbtable-\lpsb@tblid-dirx}, \zposy{lpsbtable-\lpsb@tblid-dirx})}%
    % Patch longtable's row break macro
    \@ifundefined{LT@tabularcr}{}{%
      \let\lpsb@orig@LT@tabularcr\LT@tabularcr
      \def\LT@tabularcr{%
        \lpsb@orig@LT@tabularcr
        \noalign{%
          \global\advance\lpsb@tblrow by 1\relax
          \lpsb@savepos{lpsbtable-\lpsb@tblid-r\the\lpsb@tblrow}%
          \lpsb@setpage{lpsbtable-\lpsb@tblid-r\the\lpsb@tblrow}%
          \directlua{lpsb_table.row_break(\lpsb@pageval, \zposx{lpsbtable-\lpsb@tblid-r\the\lpsb@tblrow}, \zposy{lpsbtable-\lpsb@tblid-r\the\lpsb@tblrow})}%
        }%
      }%
    }%
  \fi
}

\def\lpsb@longtableEnd{%
  \ifnum\lpsbTabularDepth=1\relax
    \ifx\lpsb@orig@LT@tabularcr\relax\else
      \let\LT@tabularcr\lpsb@orig@LT@tabularcr
    \fi
    \directlua{lpsb_table.end_table()}%
  \fi
  \global\advance\lpsbTabularDepth by -1\relax
}

% Register hooks
\AddToHook{env/tabular/begin}{\lpsb@tabularBegin}
\AddToHook{env/tabular/end}{\lpsb@tabularEnd}
\AddToHook{env/tabularx/begin}{\lpsb@tabularBegin}
\AddToHook{env/tabularx/end}{\lpsb@tabularEnd}
\AddToHook{env/longtable/begin}{\lpsb@longtableBegin}
\AddToHook{env/longtable/end}{\lpsb@longtableEnd}

% Ensure our hooks run after lpsb.sty
\IfFormatAtLeastTF{2020/10/01}{%
  \DeclareHookRule{env/longtable/begin}{lpsb-luatable}{after}{lpsb}%
}{}
\makeatother

% Close file at end of document
\AtEndDocument{%
  \directlua{lpsb_table.close_file()}%
}

\endinput
