%% lpsb-footnotes.sty - Footnote Tagging Support for LPSB
%% Handles \footnote, \footnotemark, \footnotetext, and \@makefntext
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{lpsb-footnotes}[2026/01/25 LPSB Footnote Tagging]

\RequirePackage{etoolbox}

\makeatletter

% --- Helper macros for \thanks tagging ---
% Strategy: Allocate MCID at render time using a global counter.
% The \protected\def prevents expansion when \thanks stores its argument.

% Helper to emit Note BDC with fresh MCID (protected to prevent expansion)
\protected\def\lpsb@thanks@emit@note{%
  \lpsb@pdfliteralcmd{ EMC }%
  % Increment global counter and use its value
  \global\advance\c@lpsb@mcid\@ne
  \lpsb@pdfliteralcmd{ /Note << /MCID \number\c@lpsb@mcid\space >> BDC }%
}
% Helper to emit P BDC after Note content
\protected\def\lpsb@thanks@emit@p{%
  \lpsb@pdfliteralcmd{ EMC }%
  \global\advance\c@lpsb@mcid\@ne
  \lpsb@pdfliteralcmd{ /P << /MCID \the\c@lpsb@mcid\space >> BDC }%
}

% --- Footnote → Note ---
% Hook \footnote to tag as Note (PDF/UA)
\AtBeginDocument{%
  \typeout{LPSB-DEBUG: lpsb-footnotes AtBeginDocument EXECUTING}%
  \@ifundefined{footnote}{}{%
    \let\lpsb@orig@footnote\footnote
    % \footnote produces both a mark (superscript) and text (at page bottom)
    % We tag the mark as Lbl (label), the text will be tagged via @makefntext as Note
    \renewcommand{\footnote}[2][]{%
      \def\lpsb@fn@opt{#1}%
      \ifx\lpsb@fn@opt\@empty
        % The mark is tagged as Lbl, the text is tagged separately via @makefntext
        \lpsb@orig@footnote{#2}%
      \else
        \lpsb@orig@footnote[#1]{#2}%
      \fi
    }%
  }%
  % Hook \thanks for title area footnotes (author acknowledgments)
  % NOTE: \thanks uses \@footnotetext internally, which we already hook.
  % The previous approach with \lpsb@thanks@emit@note/p caused spurious
  % empty Note tags in TitleArea. Disabling this hook - footnotes from
  % \thanks will be tagged via the \@footnotetext hook instead.
  %
  % \@ifundefined{thanks}{}{%
  %   \let\lpsb@orig@thanks\thanks
  %   \renewcommand{\thanks}[1]{%
  %     \lpsb@orig@thanks{%
  %       \lpsb@thanks@emit@note
  %       #1%
  %       \lpsb@thanks@emit@p
  %     }%
  %   }%
  % }%
  % Many papers use split footnotes: \footnotemark + \footnotetext.
  % Footnotemark is the superscript reference - tag as Lbl (label)
  \@ifundefined{footnotemark}{}{%
    \let\lpsb@orig@footnotemark\footnotemark
    \renewcommand{\footnotemark}{%
      \@ifnextchar[\lpsb@fnmark@opt\lpsb@fnmark@noopt
    }%
    \def\lpsb@fnmark@opt[#1]{\lpsbTagAtom{Lbl}{\lpsb@orig@footnotemark[#1]}}%
    \def\lpsb@fnmark@noopt{\lpsbTagAtom{Lbl}{\lpsb@orig@footnotemark}}%
  }%
  \@ifundefined{footnotetext}{}{%
    \let\lpsb@orig@footnotetext\footnotetext
    \renewcommand{\footnotetext}{%
      \@ifnextchar[\lpsb@fntext@opt\lpsb@fntext@noopt
    }%
    \def\lpsb@fntext@opt[#1]#2{%
      \begingroup
        % Tagging happens inside \@makefntext in the insert context.
        \let\lpsb@orig@@makefntext\@makefntext
        \long\def\@makefntext##1{%
          \lpsbTagBeginForce{Note}%
          \lpsb@orig@@makefntext{##1}%
          \lpsbTagEndForce
        }%
        \lpsb@orig@footnotetext[#1]{#2}%
      \endgroup
    }%
    \def\lpsb@fntext@noopt#1{%
      \begingroup
        % Tagging happens inside \@makefntext in the insert context.
        \let\lpsb@orig@@makefntext\@makefntext
        \long\def\@makefntext##1{%
          \lpsbTagBeginForce{Note}%
          \lpsb@orig@@makefntext{##1}%
          \lpsbTagEndForce
        }%
        \lpsb@orig@footnotetext{#1}%
      \endgroup
    }%
  }%
  % Standard \footnote uses internal \@footnotemark/\@footnotetext; hook those too so the
  % footnote text itself gets tagged (not just the mark in the paragraph).
  %
  % CRITICAL: \@footnotetext uses \insert\footins{...} which is async (like floats).
  % The content is rendered at page bottom, not when the command is called.
  % To properly tag, we hook \@makefntext which formats the actual footnote content.
  %
  % Footnote structure in PDF/UA:
  % - Footnote mark (in paragraph): tagged as Lbl via \@footnotemark hook
  % - Footnote text (at page bottom): tagged as Note via \@makefntext hook
  %
  \newif\if@lpsb@in@footnote \@lpsb@in@footnotefalse
  %
  % Hook \@footnotemark to tag the superscript mark as Lbl
  \@ifundefined{@footnotemark}{}{%
    \let\lpsb@orig@@footnotemark\@footnotemark
    \def\@footnotemark{%
      \lpsbTagAtom{Lbl}{\lpsb@orig@@footnotemark}%
    }%
  }%
  %
  % No separate \@footnotetext patch needed - handled via \footnotetext wrapper.
  % Also hook minipage footnotes
  \@ifundefined{@mpfootnotetext}{}{%
    \let\lpsb@orig@@mpfootnotetext\@mpfootnotetext
    \long\def\@mpfootnotetext#1{%
      % minipage footnotes use similar mechanism
      \lpsb@orig@@mpfootnotetext{#1}%
    }%
  }%
}

\makeatother
\endinput
