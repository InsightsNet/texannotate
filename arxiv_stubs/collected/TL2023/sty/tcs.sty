% Defining paired delimiters
% \norm, \abs, \iprod, \paren, \braces, \bracks, \floor, \ceil, \over
% \fnorm, \expec
% \littleo, \bigO, \bigOmega, \bigTheta
% capitalizing the first letter gets the \left \right version of the delimiter
\DeclarePairedDelimiter\norm{\lVert}{\rVert}
\newcommand{\Norm}[1]{\norm*{#1}}
\DeclarePairedDelimiter\abs{\lvert}{\rvert}
\newcommand{\Abs}[1]{\abs*{#1}}
\DeclarePairedDelimiter\iprod{\langle}{\rangle}
\newcommand{\Iprod}[1]{\iprod*{#1}}
\DeclarePairedDelimiter\angles{\langle}{\rangle}
\newcommand{\Angles}[1]{\angles*{#1}}
\DeclarePairedDelimiter\paren{\lparen}{\rparen}
\DeclarePairedDelimiter\parens{\lparen}{\rparen}
\newcommand{\Paren}[1]{\paren*{#1}}
\newcommand{\Parens}[1]{\paren*{#1}}
\DeclarePairedDelimiter\braces{\lbrace}{\rbrace}
\newcommand{\Braces}[1]{\braces*{#1}}
\DeclarePairedDelimiter\bracks{\lbrack}{\rbrack}
\newcommand{\Bracks}[1]{\bracks*{#1}}
\DeclarePairedDelimiter\floor{\lfloor}{\rfloor}
\newcommand{\Floor}[1]{\floor*{#1}}
\DeclarePairedDelimiter\ceil{\lceil}{\rceil}
\newcommand{\Ceil}[1]{\ceil*{#1}}
\DeclarePairedDelimiter\iver{\llbracket}{\rrbracket}
\newcommand{\Iver}[1]{\iver*{#1}}
\DeclarePairedDelimiterXPP{\fnorm}[1]{}{\lVert}{\rVert}{_F}{#1}
\newcommand{\Fnorm}[1]{\fnorm*{#1}}
\DeclarePairedDelimiterXPP{\infnorm}[1]{}{\lVert}{\rVert}{_\infty}{#1}
\newcommand{\Infnorm}[1]{\Infnorm*{#1}}
\DeclarePairedDelimiterXPP{\expec}[2]{\E_{#1}\,}{\lbrack}{\rbrack}{}{#2}
\newcommand{\expecf}[2]{\expec*{#1}{#2}}
\DeclarePairedDelimiterXPP{\pexpec}[2]{\widetilde{\E}_{#1}\,}{\lbrack}{\rbrack}{}{#2}
\newcommand{\pexpecf}[2]{\pexpec*{#1}{#2}}
\DeclarePairedDelimiterXPP{\littleO}[1]{o}{\lparen}{\rparen}{}{#1}
\newcommand{\LittleO}[1]{\littleO*{#1}}
\DeclarePairedDelimiterXPP{\bigO}[1]{\mathcal{O}}{\lparen}{\rparen}{}{#1}
\newcommand{\BigO}[1]{\bigO*{#1}}
\DeclarePairedDelimiterXPP{\bigOmega}[1]{\Omega}{\lparen}{\rparen}{}{#1}
\newcommand{\BigOmega}[1]{\bigOmega*{#1}}
\DeclarePairedDelimiterXPP{\bigOt}[1]{\widetilde{\mathcal{O}}}{\lparen}{\rparen}{}{#1}
\newcommand{\BigOt}[1]{\bigOt*{#1}}
\DeclarePairedDelimiterXPP{\bigOmegat}[1]{\widetilde{\Omega}}{\lparen}{\rparen}{}{#1}
\newcommand{\BigOmegat}[1]{\bigOmegat*{#1}}
\DeclarePairedDelimiterXPP{\bigTheta}[1]{\Theta}{\lparen}{\rparen}{}{#1}
\newcommand{\BigTheta}[1]{\bigTheta*{#1}}
\DeclarePairedDelimiterXPP{\bigThetat}[1]{\widetilde{\Theta}}{\lparen}{\rparen}{}{#1}
\newcommand{\BigThetat}[1]{\bigThetat*{#1}}

