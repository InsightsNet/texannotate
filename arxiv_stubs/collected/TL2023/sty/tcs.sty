% Global notation for the Hamiltonian under study
\newcommand{\terms}{m}
\newcommand{\qubits}{n}
\newcommand{\dims}{N} % dimension of the space, 2^\qubits
\newcommand{\locality}{\mathfrak{K}} % the locality of the Hamiltonian
\newcommand{\amen}{c} % amenability parameter
\newcommand{\locals}{\mathcal{P}} % Pauli local terms
\newcommand{\ii}{\mathrm{i}} % imaginary unit
\newcommand{\logpart}{{\mathcal{L}}} % log partition function
\newcommand{\graph}{{\mathfrak{G}}} % term intersection graph
\newcommand{\edges}{{\mathfrak{E}}} % edges of the graph
\newcommand{\degree}{{\mathfrak{g}}} % degree of the graph
\newcommand{\realdeg}{{\mathfrak{d}}} % degree for dual interaction graph
\newcommand{\sparse}{\mathfrak{r}} % effective sparsity
\newcommand{\net}{\mathcal{N}} % net lower bound
\newcommand{\dataset}{\mathcal{S}} % used in shadows
\newcommand{\circuit}{\mathcal{C}} % used in shadows
