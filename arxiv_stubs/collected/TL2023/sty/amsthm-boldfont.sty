%%
%% Package to force amsthm to make the note in theorem bold face.
%%
%% Written by Massimo Lauria <lauria@csc.kth.se> 
%% Incorporated into the "LaTeX files package" of
%% Jakob Nordström <jakobn@csc.kth.se> 

\NeedsTeXFormat{LaTeX2e}[1995/06/01]
\ProvidesPackage{amsthm-boldfont}[2014/06/09 v1]

\@ifpackageloaded{amsthm}{%
  \def\th@plain{%
    \thm@notefont{}% same as heading font
    \itshape % body font
  }
  \def\th@definition{%
    \thm@notefont{}% same as heading font
    \normalfont % body font
  }
  \def\th@remark{%
    \thm@notefont{}% same as heading font
    \normalfont % body font
  }
}{}


