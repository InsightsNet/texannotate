%%
%%
%% THEOREM STYLES
%%
%%
% Not defined if option no-theorems is passed
\makeatletter
\@ifpackagewith{mplmacros}{no-theorems}{
	% true code
}{
	% false code
	% Proposition
	\newtheorem{proposition}{Proposition}
	\newtheorem*{proposition*}{Proposition}
	\makeatletter
	\@ifclassloaded{beamer}
		{
			% true code
		}
		{
			% false code
			% proposition types loaded by beamer
			% Theorem
			\newtheorem{theorem}{Theorem}
			\newtheorem*{theorem*}{Theorem}
			% Lemma
			\newtheorem{lemma}{Lemma}
			\newtheorem*{lemma*}{Lemma}
			% Conjecture
			\newtheorem{conjecture}{Conjecture}
			\newtheorem*{conjecture*}{Conjecture}
			% Corollary
			\newtheorem{corollary}{Corollary}
			\newtheorem*{corollary*}{Corollary}
		}
	\makeatother
	%
	% Remark style
	%
	\theoremstyle{remark}
	\makeatletter
	\@ifclassloaded{beamer}
		{
			% true code
		}
		{
			% false code
			% proposition types loaded by beamer
			% Example
			\newtheorem{example}{Example}
			\newtheorem*{example*}{Example}
		}
	\makeatother
	% Remark
	\newtheorem{remark}{Remark}
	\newtheorem*{remark*}{Remark}
	%
	% Definition style
	%
	\theoremstyle{definition}
	\makeatletter
	\@ifclassloaded{beamer}
		{
			% true code
		}
		{
			% false code
			% proposition types loaded by beamer
			% Definition
			\newtheorem{definition}{Definition}
			\newtheorem*{definition*}{Definition}
		}
	\makeatother
	% Axiom
	\newtheorem{axiom}{Axiom}
	\newtheorem*{axiom*}{Axiom}
	% Question style
	\newtheoremstyle{question}
		{\topsep}		% above space
		{\topsep}		% bellow space
		{\normalfont}	% body font
		{0pt}			% indent
		{\bfseries}		% headfont
		{}				% headpunct
		{\itemsep}		% headspace
		{\tcr{#1 #2.}}	% custom-head-spec
	% Question definition
	\theoremstyle{question}
	\newtheorem{question}{Question}
}
\makeatother
%%
%%
%% MATH OPERATORS
%%
%%
% d - for integrals
\DeclareMathOperator{\dd}{d \!}
\newcommand*{\ddd}[1]{\mathrm{d}^{#1} \!}
% e - for exponents
\DeclareMathOperator{\e}{e}
% big O notation
\DeclareMathOperator{\bigO}{\mathcal{O}}
% States
\DeclareMathOperator{\states}{\mathfrak{S}}
% Pe
\DeclareMathOperator{\Pe}{\mathcal{P}}
% Ha
\DeclareMathOperator{\Ha}{\mathcal{H}}
% Ka
\DeclareMathOperator{\Ka}{\mathcal{K}}
% dH
\DeclareMathOperator{\dH}{\dim({\mathcal{H}})}
% dK
\DeclareMathOperator{\dK}{\dim({\mathcal{K}})}
% bound
\DeclareMathOperator{\bound}{\mathcal{B}}
% lin
\DeclareMathOperator{\lin}{\mathcal{L}}
% dens
\DeclareMathOperator{\dens}{\mathcal{D}}
% chan
\DeclareMathOperator{\chan}{\mathcal{C}}
% effect
\DeclareMathOperator{\effect}{\mathcal{E}}
% J - for Jamiołkowski isomorphism
\DeclareMathOperator{\J}{\mathcal{J}}
% int - interior
\DeclareMathOperator{\intr}{int}
% conv - convex hull
\DeclareMathOperator{\conv}{conv}
% cone - convex hull
\DeclareMathOperator{\cone}{cone}
% aff - affine hull
\DeclareMathOperator{\aff}{aff}
% span - linear hull
\DeclareMathOperator{\linspan}{span}
% ri - relative interior
\DeclareMathOperator{\ri}{ri}
% ext - extreme poitns
\DeclareMathOperator{\ext}{ext}
% DegCom - degree of compatibility
\DeclareMathOperator{\DegCom}{DegCom}
% RobNB - robustness of no-broadcasting
\DeclareMathOperator{\RobNB}{RobNB}
% RobCon - robustness of contextuality
\DeclareMathOperator{\RobCon}{RobCon}
% MP - measure-and-prepare
\DeclareMathOperator{\MP}{MP}
% Tr - trace
\DeclareMathOperator{\Tr}{Tr}
% id - identity
\DeclareMathOperator{\id}{id}
% I - identity operator
\usepackage{dsfont}
\DeclareMathOperator{\I}{\mathds{1}}
% tmin - minimal tensor product
\DeclareMathOperator{\tmin}{\dot{\otimes}}
% tmax - maximal tensor product
\DeclareMathOperator{\tmax}{\hat{\otimes}}
% treal - real tensor product
\DeclareMathOperator{\treal}{\tilde{\otimes}}
% \ceil and \floor - lower and upper whole part
\newcommand*{\ceil}[1]{\left\lceil #1 \right\rceil}
\newcommand*{\floor}[1]{\left\lfloor #1 \right\rfloor}
% \<, \> for the dual stuff
\newcommand*{\<}{\langle}
\renewcommand*{\>}{\rangle}
% Moyal bracket
\newcommand*{\lmb}{\{\!\{}
\newcommand*{\rmb}{\}\!\}}
\newcommand*{\mb}[1]{\left\lbrace \! \left\lbrace #1 \right\rbrace \! \right \rbrace}
% norm and bra-ket notation
\newcommand*{\abs}[1]{\left\lvert #1 \right\rvert}
\newcommand*{\norm}[1]{\left\lVert #1 \right\rVert}
\newcommand*{\bra}[1]{\langle #1 |}
\makeatletter
\newcommand*{\ket}[1]{| #1 \rangle \@ifnextchar\bra{\!}{}}
\makeatother
\newcommand*{\braket}[1]{\langle #1 \rangle}
\newcommand*{\ketbra}[1]{| #1 \rangle \! \langle #1 |}
% CHSH quantity
\DeclareMathOperator{\chsh}{\text{CHSH}}
% SWAP gate
\DeclareMathOperator{\swap}{SWAP}
% Prob - probability distributons
\DeclareMathOperator{\Prob}{Prob}
% SProb - signed probability distributions
\DeclareMathOperator{\SProb}{SProb}
% Meas - measures
\DeclareMathOperator{\Meas}{Meas}
% SMeas - signed measures
\DeclareMathOperator{\SMeas}{SMeas}
% FinMeas - finite measures
\DeclareMathOperator{\FinMeas}{FinMeas}
% SFinMeas - signed finite measures
\DeclareMathOperator{\SFinMeas}{SFinMeas}
% Lie - Lie derivative
\DeclareMathOperator{\Lie}{\mathcal{L}}
% Observables
\DeclareMathOperator{\oA}{\mathsf{A}}
\DeclareMathOperator{\oB}{\mathsf{B}}
\DeclareMathOperator{\oC}{\mathsf{C}}
\DeclareMathOperator{\oD}{\mathsf{D}}
\DeclareMathOperator{\oE}{\mathsf{E}}
\DeclareMathOperator{\oF}{\mathsf{F}}
\DeclareMathOperator{\oG}{\mathsf{G}}
\DeclareMathOperator{\oH}{\mathsf{H}}
\DeclareMathOperator{\oM}{\mathsf{M}}
\DeclareMathOperator{\oN}{\mathsf{N}}
\DeclareMathOperator{\oT}{\mathsf{T}}
\DeclareMathOperator{\oP}{\mathsf{P}}
\DeclareMathOperator{\oQ}{\mathsf{Q}}
% Intruments
\DeclareMathOperator{\iI}{\mathcal{I}}
\DeclareMathOperator{\iJ}{\mathcal{J}}
% Numbers
\DeclareMathOperator{\NN}{\mathbb{N}}
\DeclareMathOperator{\ZZ}{\mathbb{Z}}
\DeclareMathOperator{\RR}{\mathbb{R}}
\DeclareMathOperator{\Rp}{\mathbb{R}_+}
\DeclareMathOperator{\CC}{\mathbb{C}}
%%
%%
%% BEAMER SETTINGS
%%
%%
\makeatletter
\@ifclassloaded{beamer}
	{
		% true code
		% Collaboration variable
		\def\collaboration#1{\gdef\@collaboration{#1}}
		\collaboration{}
		%
		% TITLE PAGE
		%
		\setbeamertemplate{title page}
		{
			\vspace{-7pt}
			\begingroup
			\begin{beamercolorbox}[wd=\paperwidth, sep=0em, center]{title}
				\vskip1em
				\usebeamerfont{title}\LARGE\inserttitle\par
				\ifx\insertsubtitle\@empty
				\else
					\vskip0.5em
					{\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\insertsubtitle\par}
				\fi
				\vskip1em
			\end{beamercolorbox}
			\vskip1em\par
			\begin{beamercolorbox}[sep=0.5em,center]{author}
				\usebeamerfont{author}\insertauthor\par
			\end{beamercolorbox}
			\begin{beamercolorbox}[sep=0.5em,center]{institute}
				\usebeamerfont{institute}\insertinstitute\par
			\end{beamercolorbox}
			\ifx\@collaboration\@empty
			\else
				\begin{beamercolorbox}[sep=1em,center]{collaboration}
					\usebeamerfont{author}In collaboration with: \@collaboration\par
				\end{beamercolorbox}
			\fi
			\vfill
			{\usebeamercolor[fg]{titlegraphic}
				\begin{minipage}[c]{0.25\linewidth}
					\centering
					\includegraphics[width=\linewidth]{uni_logo.eps}
				\end{minipage}
				\hfill
				\begin{minipage}[c]{0.25\linewidth}
					\centering
					\includegraphics[width=\linewidth]{group_logo.png}
				\end{minipage}
			\par}
			\endgroup
		}
		%
		% THEME SETTINGS
		%
		% font settings
		\usefonttheme[onlymath]{serif}
		% colortheme - in case something would be undefined
		\usecolortheme{seahorse}
		% other color settings
		\setbeamercolor*{titlelike}{parent=structure, fg=black, bg=mpLightBlue}
		\setbeamercolor*{local structure}{fg=mpLightBlue}
		% list color
		\setbeamertemplate{itemize item}{\color{mpLightBlue}$\bullet$}
		\setbeamertemplate{itemize subitem}{\color{mpLightBlue}$\blacktriangleright$}
		\setbeamercolor*{enumerate item}{fg=black}
		\setbeamercolor*{enumerate subitem}{fg=black}
		\setbeamercolor*{enumerate subsubitem}{fg=black}
		\setbeamercolor*{description item}{fg=black}
		\setbeamercolor*{description subitem}{fg=black}
		% example block
		\setbeamercolor*{block title example}{bg=mpLightGreen}
		\setbeamercolor*{block body example}{bg=mpLightGreen}
		% alert block
		\setbeamercolor*{block title alerted}{bg=mpLightRed}
		\setbeamercolor*{block body alerted}{bg=mpLightRed}
		% block and theorem colors
		\setbeamertemplate{blocks}[rounded]
		\setbeamercolor{block title}{fg=black}
		\setbeamerfont{block title}{series=\bfseries, size=\normalsize, parent=structure}
		\renewcommand\qedsymbol{$\square$}
		% caption template
		\setbeamertemplate{caption}{\insertcaption}
		% other Beamer settings
		\setbeamertemplate{navigation symbols}{}
		%
		% CUSTOM COMMANDS
		%
		% \newpar command definition for making vertical space around Prop., Ex., between paragraphs etc. Leave a blank line or manually break line if inside text (adding that to the command would break it when there is no line to end)
		\newcommand{\newpar}{\vspace{1em}}
	}
	{
		% false code
	}
\makeatother
%%
%%
%% TIKZPOSTER SETTINGS
%%
%%
\makeatletter
\@ifclassloaded{tikzposter}
	{
		% true code
		\RequirePackage{fancybox}
		\RequirePackage{epstopdf}
		\RequirePackage{xcolor}
		%
		% THEME AND STYLE
		%
		\usetitlestyle{Filled}
		\usebackgroundstyle{Empty}
		% defining the noSlide block style
		\defineblockstyle{noSlide}{
			titlewidthscale=1,
			bodywidthscale=1,
			titleleft,
			titleoffsetx=0cm,
			titleoffsety=0cm,
			bodyoffsetx=0cm,
			bodyoffsety=0cm,
			bodyverticalshift=0cm,
			roundedcorners=0,
			linewidth=0cm,
			titleinnersep=1cm,
			bodyinnersep=1cm
		}{
			\ifBlockHasTitle
				\draw[draw=none, fill=blocktitlebgcolor] 
					(blocktitle.south west) rectangle (blocktitle.north east);
			\fi
			\draw[draw=none, fill=blockbodybgcolor]
				(blockbody.north west) [rounded corners=30] -- (blockbody.south west) --
				(blockbody.south east) [rounded corners=0]-- (blockbody.north east) -- cycle;
		}
		\useblockstyle{noSlide}
		\useinnerblockstyle{Table}
		%
		% COLORS
		%
		\colorlet{blocktitlefgcolor}{black}
		\colorlet{titlebgcolor}{mpLightBlue}
		\colorlet{blocktitlebgcolor}{mpLightBlue}
		\colorlet{innerblockbodybgcolor}{mpGray}
		\colorlet{innerblocktitlebgcolor}{mpLightBlue}
		\colorlet{framecolor}{mpLightBlue}
		% clean the bottom right corner
		\tikzposterlatexaffectionproofoff
		% change font to sans
		\renewcommand{\familydefault}{\sfdefault}
		% QED symbol
		\renewcommand\qedsymbol{$\square$}
		%
		% TITLE
		%
		% redefine \title command to get rid of tikzposter behaviour
		\makeatletter
		\def\title#1{\gdef\@title{
		#1
		}}
		\makeatother
		% settitle
		\settitle{
			\centering
			\begin{minipage}[c]{0.145\linewidth}
				\centering
				\includegraphics[width=\linewidth]{uni_logo.eps}
			\end{minipage}
			\hfill
			\begin{minipage}[c]{0.7\linewidth}
				\centering
				\color{titlefgcolor}
				{\Huge \parbox{\linewidth}{\centering \@title} \par}
				\vspace*{1em}
				{\LARGE \@author \par}
				\vspace*{1em}
				{\Large \@institute \par}
			\end{minipage}
			\hfill
			\begin{minipage}[c]{0.145\linewidth}
				\centering
%				\includegraphics[width=\linewidth]{\@titlegraphic}
				\@titlegraphic
			\end{minipage}
		}
		%
		% CUSTOM COMMANDS
		%
		% \newpar command definition for making vertical space around Prop., Ex., etc. Leave a blank line or manually break line if inside text (adding that to the command would break it when there is no line to end)
		\newcommand{\newpar}{\vspace{0.666666em}}
		% \horline command definition for making horizontal lines
		\newcommand{\horline}{
			\newpar
			\noindent\makebox[\linewidth]{
				\textcolor{lightgray}{\rule{0.8\linewidth}{3pt}}
			}
			\newpar
		}
	}
	{
		% false code
	}
\makeatother
