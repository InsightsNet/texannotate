\ProvidesPackage{luxecontribute}[LUXE technical note contributions]
\NeedsTeXFormat{LaTeX2e}

%-------------------------------------------------------------------------------
% More advanced if syntax
\RequirePackage{ifthen}
% Use kvoptions package to set options
\RequirePackage{kvoptions}
\SetupKeyvalOptions{
  family=LCTR,
  prefix=LCTR@
}
\DeclareBoolOption[false]{xtab}
\DeclareBoolOption[false]{longtable}
\DeclareBoolOption[true]{authblk}
\ProcessKeyvalOptions*

% Use package xparse to process optional arguments.
\RequirePackage{xparse}


%\let\ifLCTR@xtab\iffalse
%\DeclareOption{xtab}{\let\ifLCTR@xtab\iftrue}
%\let\ifLCTR@authblk\iftrue
%\DeclareOption{noauthblk}{\let\ifLCTR@authblk\iffalse}
%
%\ProcessOptions\relax

% Include array package so \raggedright works
\RequirePackage{array}
% Include booktabs package to get a nicer table
\RequirePackage{booktabs}

% Include longtable or xtab package if necessary
\ifthenelse{\boolean{LCTR@longtable}}{\RequirePackage{longtable}}{}
\ifthenelse{\boolean{LCTR@xtab}}{\RequirePackage{xtab}}{}

% If multiple authors/affiliations are needed, use the authblk package
\ifthenelse{\boolean{LCTR@authblk}}{%
  \RequirePackage{authblk}
  \renewcommand\Authands{, } % avoid ``. and'' for last author
  \renewcommand\Affilfont{\itshape\small} % affiliation formatting
}{}

% Analysis contributors: Name, Contributions
\def\LCTR@Contributors{}
\newcommand{\LuxeContributor}[2]{%
  \g@addto@macro\LCTR@Contributors{%
    #1 & #2 \tabularnewline
  }
}

\def\LCTR@Affils{}
%\newcommand{\LuxeAffil}[2]{%
%  \g@addto@macro\LCTR@Affils{%
%    \itshape\small^{#1} #2 & \tabularnewline 
%  }
%}

% \newcommand{\LuxeAuthorContributor}[3]{%
%   \g@addto@macro\LCTR@Contributors{%
%     #1 & #3 \tabularnewline
%   }
%   \author[#2]{#1}
% }

% Use xparse to process optional argument is ORCID
\NewDocumentCommand \LuxeAuthorContributor { o m m m } {%
    \g@addto@macro\LCTR@Contributors{%
      #2$^{#3}$ & #4 \tabularnewline
    }%
    \author[#3]{#2}%
}

\NewDocumentCommand \LuxeAffil { o m m} {%
 \g@addto@macro\LCTR@Affils{%
 \multicolumn{2}{c}{ $^{#2}$\textit{#3}} \tabularnewline
  }%
}

\newcommand*{\LuxeContributionsTitle}{List of contributions}

\newcommand{\PrintLuxeContribute}[1]{%
  \newlength{\LCTR@namewidth}
  \newlength{\LCTR@linewidth}
  \setlength{\LCTR@namewidth}{#1\linewidth}
  \setlength{\LCTR@linewidth}{\linewidth}
  \addtolength{\LCTR@linewidth}{-#1\linewidth}
  \addtolength{\LCTR@linewidth}{-4\tabcolsep}
  \section*{\LuxeContributionsTitle}
  {\raggedright
    \ifthenelse{\boolean{LCTR@longtable}}{%
      \begin{longtable}{>{\raggedright}p{\LCTR@namewidth}p{\LCTR@linewidth}}
        \toprule
        \LCTR@Contributors
        \bottomrule \tabularnewline
        \LCTR@Affils
      \end{longtable}
    }{%
      \ifthenelse{\boolean{LCTR@xtab}}{%
        \begin{xtabular}{>{\raggedright}p{\LCTR@namewidth}p{\LCTR@linewidth}}
          \toprule
          \LCTR@Contributors
          \bottomrule \tabularnewline
          \LCTR@Affils
        \end{xtabular}
      }{%
        \begin{tabular}{>{\raggedright}p{\LCTR@namewidth}p{\LCTR@linewidth}}
          \toprule
          \LCTR@Contributors
          \bottomrule \tabularnewline
          \LCTR@Affils
        \end{tabular}
      }
    }
  }
}




\endinput

