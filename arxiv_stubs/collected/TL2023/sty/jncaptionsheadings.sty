% CHANGE FORMATTING OF TEXT IN CAPTIONS
% Switching back to using standard LaTeX caption package --JN 14-05-03

\usepackage
[%
labelformat=default, % typeset caption label as specified by doc class
labelsep=colon, % separator between label and caption text 
textformat=simple, % typeset text as-is; e.g., don't add period
font={small,sf}, % typeset all caption in small sans serif
labelfont=bf % in addition, typeset label in boldface
]%
{caption}

%
% Using sans serif for chapter and section headings
%
% Change to \newcommand{\mystyle}{\rmfamily} if romans are wanted
%

\newcommand{\mystyle}{\sffamily}
%       \newcommand{\mystyle}{\rmfamily}

\usepackage{sectsty}
\allsectionsfont{\mystyle}

%
% Take care of abstract separately
%

\if@titlepage
  \renewenvironment{abstract}{%
      \titlepage
      \null\vfil
      \@beginparpenalty\@lowpenalty
      \begin{center}%
        \bfseries \mystyle \abstractname
        \@endparpenalty\@M
      \end{center}}%
     {\par\vfil\null\endtitlepage}
\else
  \renewenvironment{abstract}{%
      \if@twocolumn
        \section*{\abstractname}%
      \else
        \small
        \begin{center}%
          {\bfseries \mystyle \abstractname\vspace{-.5em}\vspace{\z@}}%
        \end{center}%
        \quotation
      \fi}
      {\if@twocolumn\else\endquotation\fi}
\fi



