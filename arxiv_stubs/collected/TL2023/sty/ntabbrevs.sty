\NeedsTeXFormat{LaTeX2e}
\RequirePackage{xspace}
\ProvidesPackage{ntabbrevs}
              [1998/08/28 v1.1 Abbreviations]

\DeclareOption{german}{\@germantrue\@bothtrue}
\DeclareOption{english}{\@englishtrue\@bothtrue}
\DeclareOption{none}{\@englishfalse\@germanfalse\@bothfalse}
\newif\if@german
\newif\if@english
\newif\if@both
\ExecuteOptions{none}
\ProcessOptions

\newcommand{\abbrevsep}{\,}
\newcommand{\abbrev}[1]{#1.\xspace}
\newcommand{\abbrevs}[2]{#1.\abbrevsep#2.\xspace}

\if@german
	\newcommand{\db}{\abbrevs{d}{h}}
	\newcommand{\Db}{\abbrevs{D}{h}}
	\newcommand{\zB}{\abbrevs{z}{B}}
	\newcommand{\ZB}{\abbrevs{Z}{B}}
	\newcommand{\ua}{\abbrevs{u}{a}}
	\newcommand{\Ua}{\abbrevs{U}{a}}
	\newcommand{\uU}{\abbrevs{u}{U}}
	\newcommand{\UU}{\abbrevs{U}{U}}
	\newcommand{\iallg}{\abbrevs{i}{allg}}
	\newcommand{\Iallg}{\abbrevs{I}{allg}}
	\newcommand{\vgl}{\abbrev{vgl}}
	\newcommand{\Vgl}{\abbrev{Vgl}}
	\newcommand{\bzw}{\abbrev{bzw}}
	\newcommand{\Bzw}{\abbrev{Bzw}}
	\newcommand{\sog}{\abbrev{sog}}
	\newcommand{\Sog}{\abbrev{Sog}}
	\newcommand{\bez}{\abbrev{bez}}
	\newcommand{\Bez}{\abbrev{Bez}}
	\newcommand{\bzgl}{\abbrev{bzgl}}
	\newcommand{\Bzgl}{\abbrev{Bzgl}}
	\newcommand{\usw}{\abbrev{usw}}
\fi
\if@english
	\newcommand{\ie}{\abbrevs{i}{e}}
	\newcommand{\Ie}{\abbrevs{I}{e}}
	\newcommand{\eg}{\abbrevs{e}{g}}
	\newcommand{\Eg}{\abbrevs{E}{g}}
	\newcommand{\cf}{\abbrev{cf}}
	\newcommand{\Cf}{\abbrev{Cf}}
\fi
\if@both
	\newcommand{\etc}{\abbrev{etc}}
\fi
