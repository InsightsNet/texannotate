%define theorems
\newcounter{everything}[section]
\renewcommand{\theeverything}{\thesection.\arabic{everything}}

\declaretheorem[sibling=everything, style=plain]{theorem, lemma, proposition, corollary, question}
\declaretheorem[sibling=everything, style=definition]{definition, assumption, example, remark, notation, construction}
\declaretheorem[numbered=no, style=definition]{claim}

