%
% define a new length register for indentation of caption text
% from both sides of text borderlines.
%
\newdimen\captionparindent
%
% initialize it with 1.5 paragraph indentation length
%
\captionparindent=1.5\parindent
%
% modified caption text
% done by Peter Helnwein, 30th of September, 1993
%
\long\def\@makecaption#1#2{
   \vskip 10pt 
   \advance\hsize by -2.\captionparindent
   \setbox\@tempboxa\hbox{#1: #2}
   \ifdim \wd\@tempboxa >\hsize 
%      \newbox\@tempboxb
%      \newbox\@tempboxc
%      \setbox\@tempboxb\hbox{#1:\ }
%      \setbox\@tempboxc\vtop{\advance\hsize by -\wd\@tempboxb #2}
%      \setbox\@tempboxa\hbox{\box\@tempboxb\box\@tempboxc}
      \setbox\@tempboxa\vbox{\hangafter=1
			     \hangindent\captionparindent
			     #1: #2}%
   \fi
   \hbox to\hsize{\hskip\captionparindent
		  \hfil\box\@tempboxa\hfil
		  \hskip-\captionparindent}}%
%
% end of caption text definition
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
% define an additional environment for subequations
%
\@definecounter{subequation}
\@addtoreset{subequation}{equation}

\def\thesubequation{\theequation.\arabic{subequation}}

\def\subequation{$$                           % unbalaced !
		  \ifnum\c@subequation = 0
		     \stepcounter{equation}
		  \fi
		  \refstepcounter{subequation} }

\def\endsubequation{\eqno \hbox{\@subeqnnum}  % still unbalanced !
		      $$\global\@ignoretrue}  % now $$ is balanced

% \def\@subeqnnum{{\reset@font\rm (\thesubequation)}}
\def\@subeqnnum{{\rm (\thesubequation)}}
%
% end of definitions for subequations
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%
% mark labels where they are defined
%
% \marklabel	: start this feature
% \nomarklabel	: stop this feature
%
\let\llabel\label
\def\marklabel{\def\label##1{\llabel{##1}\rlap{\small \ \fbox{$##1$}}}}
\def\nomarklabel{\def\label##1{\llabel{##1}}}
\nomarklabel
