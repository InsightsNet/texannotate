% Figures
\newcommand{\insertFigure}[5]{
\begin{figure}[t]
  \centering
  \includegraphics[width=#3\linewidth]{figures/#1}
  \vspace{#4}
  \caption{\small #2}
  \label{fig:#1}
  \vspace{#5}
\end{figure}
}

\newcommand{\insertFigureWide}[5]{
\begin{figure*}[t]
  \centering
  \includegraphics[width=#3\linewidth]{figures/#1}
  \vspace{#4}
  \caption{#2}
  \label{fig:#1}
  \vspace{#5}
\end{figure*}
}
