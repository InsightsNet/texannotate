\newcommand{\WBH}{Wilhelm Büchner Hochschule}

\newcommand{\Fachbereich}[1]{%
  % Entspricht einer der folgenden Optionen für den Fachbereich:
  % * ING = Ingenieurwissenschaften
  % * INF = Informatik
  % * WRT = Wirtschaftsingenieurwesen und Technologiemanagement
  % * EUV = Energie-, Umwelt- und Verfahrenstechnik
  % * DES = Design
  \ifthenelse{\equal{#1}{ING}}{\newcommand{\fachbereich}{Ingenieurwissenschaften}}{%
  \ifthenelse{\equal{#1}{INF}}{\newcommand{\fachbereich}{Computer Science}}{%
  \ifthenelse{\equal{#1}{WRT}}{\newcommand{\fachbereich}{Wirtschaftsingenieurwesen \\ und Technologiemanagement}}{%
  \ifthenelse{\equal{#1}{EUV}}{\newcommand{\fachbereich}{Energie-, Umwelt- \\ und Verfahrenstechnik}}{%
  \ifthenelse{\equal{#1}{DES}}{\newcommand{\fachbereich}{Design}}{%
  \errmessage{Unbekannter Fachbereich}
     }
    }
   }
  }
 }
}

% Ermittlung des Schlüssel/Wert-Paars für den/die Betreuer/in
\newcommand{\Betreuung}[2][nogender]{%
  \ifthenelse{\equal{#1}{m}}{\newcommand{\betreuungschluessel}{Supervisor}}{%
    \ifthenelse{\equal{#1}{f}}{\newcommand{\betreuungschluessel}{Supervisor}}{%
      \newcommand{\betreuungschluessel}{Supervisor}
    }
  }
  \newcommand{\betreuungwert}{#2}
}

% Ermittlung des Schlüssel/Wert-Paares für den/die Autor/in bzw. die/den
% Studierende/n
\newcommand{\Autor}[2][nogender]{%
  \ifthenelse{\equal{#1}{m}}{%
    \newcommand{\autorschluessel}{Author}
    \newcommand{\studentschluessel}{Studierender}
  }{%
    \ifthenelse{\equal{#1}{f}}{%
      \newcommand{\autorschluessel}{Author}
      \newcommand{\studentschluessel}{Student}
    }{%
      \newcommand{\autorschluessel}{Author}
      \newcommand{\studentschluessel}{Student}
    }
  }
  \newcommand{\autorwert}{#2}
}

\newcommand{\Matrikelnummer}[1]{\newcommand{\matrikelnummer}{#1}}
\newcommand{\Abgabetermin}[1]{\newcommand{\abgabetermin}{#1}}

