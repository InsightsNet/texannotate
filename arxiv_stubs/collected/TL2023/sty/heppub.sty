% The latest version of the original jheppub.sty can be obtained from:
% https://jhep.sissa.it/jhep/help/JHEP/TeXclass/DOCS/jheppub.sty
%
% Provides several additional commands:
%   \lastcompiled: Expands to a string giving date and time of last compilation
%                  This can be used e.g. as \date{\lastcompiled} (which is the
%                  default for the notes package option).
%
%   \version: Expands to a string giving the version.
%
%   \header[<url>]{<string>}:       Redefines the header to <string>.
%   \subheader[<url>]{<string>}:    Sets the subheader to <string>.
%   \subsubheader[<url>]{<string>}: Sets the subsubheader to <string>.
%   \journalref[<url>]{<string>}:   Specifies a journal reference.
%
%   If the optional argument for the above commands is provided, a link to <url>
%   is generated with <string> as the link text.
%
% Several commands are defined for refering to equations, sections, etc.:
%
%   \eq{<name>}, \sec{<name>}, \app{<name>}, \fig{<name>}, \tab{<name>}
%
% generate linked references like 'eq. (1)', 'section 1', 'appendix A',
% 'figure 1', 'table 1'. The associated labels have to be defined with a
% corresponding prefix as \label{eq:<name>}, \label{sec:<name>},
% \label{app:<name>}, \label{fig:<name>}, \label{tab:<name>}.
%
% (There is also a \subsec{<name>} version if one wants to explicitly
% distinguish subsections from sections.)
%
% All the commands have plural versions, that take two arguments, e.g.
% \eqs{<name1>}{<name2>}, \secs{<name1>}{<name2>}, which generate references
% like 'eqs. (1) and (2)', 'sections 1 and 2', etc.
%
% Finally, all commands have capitalized versions (\Eq, \Eqs, \Sec, \Secs, ...)
% that should be used at the beginning of sentences.
%
% For bibliographic references, the commands
%
%    \refcite{<ref>}, \refscite{<refs>}
%
% expand to 'ref.~\cite{<ref>}' and 'refs.~\cite{<refs>}', and similarly for the
% capitalized versions.
%
% Note: Only eq. and ref. are abbreviated, while section, subsection, appendix,
% figure, and table are written out, which follows JHEP style.
%
% Several package options are defined:
%   notes:             Select a predefined style suitable for private notes
%   version=<version>: Sets the version reported by \version
%   compress:          Compress the spacing of the title page
%   toc|notoc:         Display table of contents or not (default is toc)
%   refcommands|norefcommands: Define (or not) the above commands for refering
%                              to equations, sections, etc. (on by default)
%   jhep:              Restores the original header string from jheppub.sty
%
% Additional changes compared to jheppub.sty:
% - Change the header to print the date by default.
% - Slightly reduce the spacing in the table of contents.
% - Allow empty emails and to redefine keywords (removing associated package
%   warnings).
%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{heppub}[2019/08/03]

