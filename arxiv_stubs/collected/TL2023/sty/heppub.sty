\DeclareBoolOption[false]{notes}
\DeclareStringOption{version}

\DeclareBoolOption[false]{notoc}
\DeclareComplementaryOption{toc}{notoc}
\DeclareBoolOption[false]{compress}
\DeclareBoolOption[true]{refcommands}
\DeclareComplementaryOption{norefcommands}{refcommands}
\DeclareBoolOption[false]{jhep}

\DeclareDefaultOption{
   \PackageWarningNoLine{\@currname}{Ignoring unknown option: `\CurrentOption'}
}

\ProcessLocalKeyvalOptions*\relax

\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{epsfig}
\RequirePackage{graphicx}
\ifnatbibsort\RequirePackage[numbers,sort&compress]{natbib}\else\RequirePackage[numbers,compress]{natbib}\fi
