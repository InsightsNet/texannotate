%% usage : \systvarfigure{<NAME_FRAGMENT>}{<NP_CAPTION_TEXT>}{<SAMPLE_CAPTION_TEXT>}
% arg 1 is the fragment of the input file names up to the region,
% i.e. for files like "signal-y-20GeV_ME_PDF25200_SR_mJ.pdf", 
% the argument fragment is "signal-y-20GeV_ME_PDF25200".
% when figures are in directories, set the graphicspath to make the files accessible
\newcommand{\systvarfigure}[3]
{
  \begin{figure}
    \centering
    \regionsubfig{#1_SR_mJ.pdf}{SR}{fig:#1_SR}
    \regionsubfig{#1_forward_CR_mJ.pdf}{Forward-photon tagged CR}{fig:#1_forward_CR}
    \centering
    \regionsubfig{#1_central_inverted_CR_mJ.pdf}{Central-photon anti-tagged CR}{fig:#1_central_inverted_CR}
    \regionsubfig{#1_forward_inverted_CR_mJ.pdf}{Forward-photon anti-tagged CR}{fig:#1_forward_inverted_CR}
    \caption{
      Effect of #2 on #3 across the four analysis regions
      (see \cref{tab:region-selections} for their defintion).
    }
  \label{fig:#1}
  \end{figure}
}

% helper for shapefactor caption explanation
\newcommand{\shapefactorcaption}{
    The shapefactors are multiplicative unconstrained modifiers that are applied to unitary nominal yields.
    Their initial values are the observed yields in the \twoprongtag-failing control regions less the resonant backgrounds.
    In a consistent fit, and assuming the non-resonant background efficency of \twoprongtag is treated correctly in the likelihood,
    the post-fit parameter values should vary according to the binwise Poisson error of the \twoprongtag-passing and \twoprongtag-failing
    observed yields, which are dominated by the much larger \twoprongtag-failing observed yields.
    This motivates choosing $\sqrt{\theta_\mathrm{initial}}$ as the uncertainty to scale the pulls by.
}
