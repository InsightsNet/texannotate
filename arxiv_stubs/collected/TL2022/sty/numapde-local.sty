\newcommand{\cy}{\mathpzc{y}}
\newcommand{\Qref}{Q_\text{ref}}
\newcommand{\vvec}{\operatorname{vec}}
\newcommand{\powerset}[2][]{\cP\enclose[#1]{(}{#2}{)}}
\newcommand{\lk}{\operatorname{lk}}
\newcommand{\St}{\operatorname{St}}
\newcommand{\closedSt}[1]{\overline{\operatorname{St}(#1)}}
\newcommand{\zeromanifold}{\cM_0(\Delta)}
\newcommand{\plusmanifold}{\cM_+(\Delta)}
\newcommand{\planarmanifold}{\cM_+(\Delta;\Qref)}
\newcommand{\fj}{\widehat{j}}
