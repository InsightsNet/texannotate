% new commands for the different variants 
\newcommand{\EucEuc}{Euclidean-Euclidean\xspace}
\newcommand{\ElasEuc}{Elasticity-Euclidean\xspace}
\newcommand{\CompEuc}{Complete-Euclidean\xspace}
\newcommand{\CompComp}{Complete-Complete\xspace}

% new commands for the different sets of parameters associated with the penalization
\newcommand{\alphaPenalization}{\alpha^{\textup{penalty}}}
\newcommand{\alphaMetric}{\alpha^{\textup{metric}}}

% Advanced commands related to quantities in a triangle 
% \edgelength{Q}{\ell}
% \edgelength[auto]{Q}{\ell}[i_0,i_1,i_2]
\NewDocumentCommand{\edgelength}{O{} m m o}{E_{#2}^{#3}\IfNoValueF{#4}{\enclose[#1]{(}{#4}{)}}}
% \edgelengthTriangle{k}{\ell}
\NewDocumentCommand{\edgelengthTriangle}{O{} m m o}{E_{#2}^{#3}}
% \height{Q}{\ell}
% \height[auto]{Q}{\ell}[i_0,i_1,i_2]
\NewDocumentCommand{\height}{O{} m m o}{h_{#2}^{#3}\IfNoValueF{#4}{\enclose[#1]{(}{#4}{)}}}
% \height{Q}{\ell}
\NewDocumentCommand{\heightTriangle}{O{} m m}{h_{#2}^{#3}}
% \area{Q}
% \area[auto]{Q}[i_0,i_1,i_2]
\NewDocumentCommand{\area}{O{} m o}{A_{#2}\IfNoValueF{#3}{\enclose[#1]{(}{#3}{)}}}
% \areaTriangle{k}
\NewDocumentCommand{\areaTriangle}{O{} m }{A_{#2}}
% \circumradius{k}
\NewDocumentCommand{\circumradius}{O{} m }{R_{#2}}
% \interiorangle{k}{\ell}
\NewDocumentCommand{\interiorangle}{O{} m m}{\theta_{#2}^{#3}}
% \distance{Q}
% \distance[auto]{Q}[i_0][[j_0,j_1]]
\NewDocumentCommand{\distance}{O{} m o O{\cdot}}{d_{#2}\IfNoValueF{#3}{\enclose[#1]{(}{#3;#4}{)}}}
% \regularizedDistance{Q}
% \regularizedDistance[auto]{Q}[i_0][[j_0,j_1]]
\NewDocumentCommand{\regularizedDistance}{O{} m o O{\cdot}}{D_{#2}^\mu\IfNoValueF{#3}{\enclose[#1]{(}{#3;#4}{)}}}
% Euclidean retraction
% \retractEuc{Q}
\NewDocumentCommand{\retractEuc}{ O{} m d() }{\retractionSymbol^{\textup{euc}}_{#2}\IfNoValueF{#3}{\enclose[#1]{(}{#3}{)}}}
% define a command for the metric associated with the linear elasticity bilinear form
\NewDocumentCommand{\riemannianLinElas}{ O{} m m O{} }{\enclose[#1]{(}{#2\,,\,#3}{)^{\textup{elas}}}_{#4}}
% define a command for the riemannian norm associated with the euclidean metric
%\eucldieanrieammaniannorm{d^n_i}[Q^n]
\NewDocumentCommand{\euclideanriemanniannorm}{ O{} m O{} }{\norm[#1]{#2}_2^{}}
