% sync with yquantlanguage-groups
\long\protected\def\yquant@env@begin@generic#1[#2]{%
   \begingroup%
      \let\yquant@parent=\yquant@prefix%
      \global\advance\yquant@env by 1 %
      \edef\yquant@prefix{yquant@env\the\yquant@env @}%
      \ifnum\yquant@env=1 %
