	\@ifclassloaded{m2an}{\setboolean{numapde@wrapcite}{true}}{}
	\@ifclassloaded{numapde-preprint}{\setboolean{numapde@wrapcite}{true}}{}
	\@ifclassloaded{svjour3}{\@ifpackageloaded{natbib}{\setboolean{numapde@wrapcite}{true}}{}}{}
	\@ifclassloaded{WileyNJD-v2}{\setboolean{numapde@wrapcite}{true}}{}
	\@ifclassloaded{w-art}{\setboolean{numapde@wrapcite}{true}}{}
	\newcommand{\numapde@deleted}[1]{%
		% Also, wrap the content of \cref into an \mbox to achieve compatibility with ulem
		% https://tex.stackexchange.com/questions/270901/cleveref-and-ulem-soul-compatibility
		% http://mirrors.ctan.org/macros/latex/contrib/ulem/ulem.pdf
		{\let\oldcref\cref\renewcommand{\cref}[1]{\mbox{\oldcref{##1}}}%
			\ifthenelse{\boolean{numapde@wrapcite}}{%
				\let\oldcite\cite\renewcommand{\cite}[2][]{\mbox{\oldcite[##1]{##2}}}%
			}{}
			% Finally, locally increase the width of ulem's \sout-generated lines and use the 
			% current author's colors for all hyperref colors
			\renewcommand{\ULthickness}{1.2pt}%
			\ltx@ifpackageloaded{hyperref}{\hypersetup{allcolors=authorcolor}}{}%
			% Fix the strikeout command for 'deleted' and 'replaced' commands to work correctly in displayed equations
			% https://tex.stackexchange.com/questions/297111/wrong-to-delete-replace-equation-by-using-changes-package
			\ifmmode\text{\sout{\ensuremath{#1}}}\else\sout{#1}\fi%
		}%
	}
	\setdeletedmarkup{\numapde@deleted{#1}}
	% Fix the added command to use current author's color for all hyperref colors
	\newcommand{\numapde@added}[1]{%
		\ltx@ifpackageloaded{hyperref}{\hypersetup{allcolors=authorcolor}}{}%
		#1%
	}
	\setaddedmarkup{\numapde@added{#1}}
