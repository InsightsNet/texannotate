	}{%
		\ifltxcounter{equation}{\counterwithin{equation}{section}}{}
		\ifltxcounter{figure}{\counterwithin{figure}{section}}{}
		\ifltxcounter{table}{\counterwithin{table}{section}}{}
	}
}{}
