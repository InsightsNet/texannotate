	\lstdefinelanguage{Julia}%
	{morekeywords={abstract,begin,break,case,catch,const,continue,do,else,elseif,%
			end,export,false,for,function,immutable,import,if,in,%
			macro,module,otherwise,quote,return,switch,true,try,type,%
		using,while},%
