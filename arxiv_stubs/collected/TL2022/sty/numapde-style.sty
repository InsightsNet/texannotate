% Configure the listings package
\@ifpackageloaded{listings}{%
	% General settings
	\lstset{backgroundcolor=\color{TolPaleGray},
		rulecolor=\color{TolDarkGray},
		frame=single,
		commentstyle=\color{TolDarkBlue},
		keywordstyle=\color{TolMutedWine},
		keywordstyle={[2]\color{TolMutedGreen}},
		emphstyle=\color{TolMutedBlue},
		emphstyle={[2]\color{TolMutedGreen}},
		emphstyle={[3]\color{TolMutedSand}},
		keywordstyle={[3]\color{TolMutedSand}},
		stringstyle=\color{TolMutedWine},
		identifierstyle=\color{black},
		basicstyle=\ttfamily,
		showstringspaces=false,
		breaklines=true,
		tabsize=2
	}

	% Add a symbol before a line break in listings (but not in inline mode)
	% \lst@AddToHook{DisplayStyle}{\lstset{prebreak=\raisebox{0ex}[0ex][0ex]{\ensuremath{\color{black}\hookrightarrow}}}}

	% UFL specific settings
	\lstdefinelanguage{UFL}{
		morekeywords={Constant,DirichletBC,UnitSquare,VariationalProblem,Function,File,SubDomain,FunctionSpace,VectorFunctionSpace,BilinearForm,LinearForm,Functional,Expression,Coefficient,Coefficients,TestFunction,TestFunctions,TrialFunction,TrialFunctions,BasisFunction,FiniteElement,VectorElement,TensorElement,TensorConstant,FacetNormal,BoundaryMesh,MeshFunction,NewtonSolver,MixedElement},
