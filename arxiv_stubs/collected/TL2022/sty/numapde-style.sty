	% Customize the strikeout command for 'deleted' and 'replaced'
	% Determine whether the current .cls file has issues with \cite or with \cite[] 
	% and requires it to be wrapped into an \mbox inside \deleted.
	% \@ifpackageloaded{natbib}{\setboolean{nextbranch}{true}}{}
