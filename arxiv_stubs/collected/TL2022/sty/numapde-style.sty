% This LaTeX package sets numerous configuration options for the commonly used
% packages loaded through numapde-packages.sty.
\ProvidesPackage{numapde-style}

% Resolve the dependencies of this package
\RequirePackage{numapde-packages}
\RequirePackage{numapde-colors}

% Define Boolean switches
\provideboolean{nextbranch}
\provideboolean{numapde@wrapcite}
\setboolean{numapde@wrapcite}{false}

