% siamart190516.cls 
% siamonline190516.cls 
% use ntheorem.sty and derive
% \newsiamthm and \newsiamremark to select the \theoremstyle etc. before
% \newtheorem is called
% They load cleveref.sty
% Owing to ntheorem.sty, unnumbered versions are automatically added as well
\setboolean{nextbranch}{false}
\@ifclassloaded{siamart190516}{\setboolean{nextbranch}{true}}{} 
\@ifclassloaded{siamonline190516}{\setboolean{nextbranch}{true}}{} 
\ifthenelse{\boolean{nextbranch}}{%
	\newsiamthm{assumption}{Assumption}
	\newsiamthm{example}{Example}
}{}

% Out of the list of desired theorem-like environments, assumption is not a standard
% in cleveref.sty. Moreover, in German, cleveref.sty translates 'proposition' as 'Satz'
% and 'theorem' as 'Theorem'. We change that by explicitly setting \crefname:s for language German.
\@ifpackageloaded{cleveref}{%
	\cref@addlanguagedefs{ngerman}{%
		\if@cref@capitalise%
			\ifdef{\assumption}{\crefname{assumption}{\protect\GetTranslation{Assumption}}{\protect\GetTranslation{Assumptions}}}{}
			\ifdef{\corollary}{\crefname{corollary}{\protect\GetTranslation{Corollary}}{\protect\GetTranslation{Corollarys}}}{}
			\ifdef{\example}{\crefname{example}{\protect\GetTranslation{Example}}{\protect\GetTranslation{Examples}}}{}
			\ifdef{\proposition}{\crefname{proposition}{\protect\GetTranslation{Proposition}}{\protect\GetTranslation{Propositions}}}{}
			\ifdef{\remark}{\crefname{remark}{\protect\GetTranslation{Remark}}{\protect\GetTranslation{Remarks}}}{}
			\ifdef{\theorem}{\crefname{theorem}{\protect\GetTranslation{Theorem}}{\protect\GetTranslation{Theorems}}}{}
		\else
			\ifdef{\assumption}{\crefname{assumption}{\protect\GetTranslation{assumption}}{\protect\GetTranslation{assumptions}}}{}
			\ifdef{\corollary}{\crefname{corollary}{\protect\GetTranslation{corollary}}{\protect\GetTranslation{corollarys}}}{}
			\ifdef{\example}{\crefname{example}{\protect\GetTranslation{example}}{\protect\GetTranslation{examples}}}{}
			\ifdef{\proposition}{\crefname{proposition}{\protect\GetTranslation{proposition}}{\protect\GetTranslation{propositions}}}{}
			\ifdef{\remark}{\crefname{remark}{\protect\GetTranslation{remark}}{\protect\GetTranslation{remarks}}}{}
			\ifdef{\theorem}{\crefname{theorem}{\protect\GetTranslation{theorem}}{\protect\GetTranslation{theorems}}}{}
		\fi
		\ifdef{\assumption}{\Crefname{assumption}{\protect\GetTranslation{Assumption}}{\protect\GetTranslation{Assumptions}}}{}
		\ifdef{\corollary}{\Crefname{corollary}{\protect\GetTranslation{Corollary}}{\protect\GetTranslation{Corollarys}}}{}
		\ifdef{\example}{\Crefname{example}{\protect\GetTranslation{Example}}{\protect\GetTranslation{Examples}}}{}
		\ifdef{\proposition}{\Crefname{proposition}{\protect\GetTranslation{Proposition}}{\protect\GetTranslation{Propositions}}}{}
		\ifdef{\remark}{\Crefname{remark}{\protect\GetTranslation{Remark}}{\protect\GetTranslation{Remarks}}}{}
		\ifdef{\theorem}{\Crefname{theorem}{\protect\GetTranslation{Theorem}}{\protect\GetTranslation{Theorems}}}{}
	}
}{}
