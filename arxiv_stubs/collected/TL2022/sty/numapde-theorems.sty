% This LaTeX package provides a common ground of theorem-like environments.
\ProvidesPackage{numapde-theorems}

% Resolve the dependencies of this package
\RequirePackage{numapde-packages}
\RequirePackage{numapde-translations}

% Define a Boolean switch
\provideboolean{nextbranch}

% The following theorem-like environments are being provided for many .cls 
% files:
%
%   assumption
%   corollary
%   definition
%   example
%   lemma
%   proposition
%   remark
%   theorem
%
% We pay attention to provide compatibility with the cleveref.sty package.
% Some .cls files build on amsthm.sty or ntheorem.sty, while others rely on
% basic LaTeX \newtheorem (which does not provide starred = unnumbered versions)
% or even implement their own mechanism to define new theorem-like environments.
% We distinguish here by the .cls file loaded since, even though the .cls files
% building on amsthm.sty or ntheorem.sty could be handled in a unified way, they 
% may still implement their own, individual \theoremstyle:s which we also use
% for additional environments.
% Moreover, we wish to provide cleveref support for all templates, but few .cls
% files load cleveref. Since cleveref needs to be loaded before amsthm.sty or
% ntheorem.sty, we redeclare all theorem-like environments here.

% Define a command which will clear a single and multiple theorem-like environments
% https://tex.stackexchange.com/questions/459258
\def\clear@theorems#1{\@for\next:=#1\do{\expandafter\clear@theorem\expandafter{\next}}}
\def\clear@theorem#1{\expandafter\let\csname #1\endcsname\relax\expandafter\let\csname end#1\endcsname\relax}

% A number of classes, including 
%   numapde-preprint.cls 
% may or may not load amsthm.sty, but they do not define any theorem-like environments
% Also,
%   svjour.cls
%   etna-numapde.cls
% in the way we use it does not define any theorem-like environments due to the
% documentclass option 'nospthms'.
\setboolean{nextbranch}{false}
\@ifclassloaded{achemso}{\setboolean{nextbranch}{true}}{} 
\@ifclassloaded{elsarticle}{\setboolean{nextbranch}{true}}{} 
\@ifclassloaded{etna}{\setboolean{nextbranch}{true}}{} 
\@ifclassloaded{etna-numapde}{\setboolean{nextbranch}{true}}{} 
\@ifclassloaded{frontiersFPHY}{\setboolean{nextbranch}{true}}{} 
\@ifpackageloaded{icml2020}{\setboolean{nextbranch}{true}}{} 
\@ifpackageloaded{icml2021}{\setboolean{nextbranch}{true}}{} 
\@ifclassloaded{interact}{\setboolean{nextbranch}{true}}{} 
\@ifclassloaded{mcom-l}{\setboolean{nextbranch}{true}}{} 
\@ifclassloaded{numapde-exercise}{\setboolean{nextbranch}{true}}{} 
\@ifclassloaded{numapde-lecture-notes}{\setboolean{nextbranch}{true}}{} 
\@ifclassloaded{numapde-preprint}{\setboolean{nextbranch}{true}}{} 
\@ifclassloaded{numapde-thesis}{\setboolean{nextbranch}{true}}{} 
\@ifclassloaded{svjour3}{\setboolean{nextbranch}{true}}{} 
\ifthenelse{\boolean{nextbranch}}{%
	\@ifclassloaded{numapde-thesis}{%
		\newtheorem{theorem}{\protect\GetTranslation{Theorem}}[chapter]
		}{%
		\newtheorem{theorem}{\protect\GetTranslation{Theorem}}[section]
	} 
	\newtheorem{assumption}[theorem]{\protect\GetTranslation{Assumption}}
	\newtheorem{corollary}[theorem]{\protect\GetTranslation{Corollary}}
	\newtheorem{definition}[theorem]{Definition}
	\newtheorem{example}[theorem]{\protect\GetTranslation{Example}}
	\newtheorem{lemma}[theorem]{Lemma}
	\newtheorem{proposition}[theorem]{Proposition}
	\newtheorem{remark}[theorem]{\protect\GetTranslation{Remark}}
	\newtheorem*{theorem*}{\protect\GetTranslation{Theorem}}
	\newtheorem*{assumption*}{\protect\GetTranslation{Assumption}}
	\newtheorem*{corollary*}{\protect\GetTranslation{Corollary}}
	\newtheorem*{definition*}{Definition}
	\newtheorem*{example*}{\protect\GetTranslation{Example}}
	\newtheorem*{lemma*}{Lemma}
	\newtheorem*{proposition*}{Proposition}
	\newtheorem*{remark*}{\protect\GetTranslation{Remark}}
}{}

