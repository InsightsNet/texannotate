% This LaTeX package provides numerous terms and their translations in German and/or English.
\ProvidesPackage{numapde-translations}

% Resolve the dependencies of this package
\RequirePackage{translations}

% Load the dictionary for translations into German
\LoadDictionaryFor{German}{numapde}

% Define commands for language specific content
\newcommand{\langde}[1]{\ifnum\pdfstrcmp{\languagename}{ngerman}=0 {#1}\fi}
\newcommand{\langen}[1]{\ifnum\pdfstrcmp{\languagename}{english}=0 {#1}\fi}

% As an alternative to the above two internal commands you can also use
% \lang[en]{Text} for English text 
% \lang[de]{Text} for German text
% \lang{A} defaults to English.
\NewDocumentCommand{\lang}{ O{en} m}{\expandafter\csname lang#1\endcsname{#2}}
