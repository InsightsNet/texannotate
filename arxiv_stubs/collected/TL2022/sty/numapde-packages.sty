% Packages related to encodings (only for non-XeTeX)
\ifthenelse{\boolean{xetex}}{%
}{%
	\RequirePackage[utf8]{inputenc}
	\RequirePackage[T1]{fontenc}
}

% Localization and internationalization related packages
\ifthenelse{\boolean{usebabel}}{\RequirePackage{babel}}{}

% Math typesetting related packages
\@ifpackageloaded{newtxmath}{}{%
	\RequirePackage{amssymb}
}
\ifthenelse{\boolean{useamsthm}}{\RequirePackage{amsthm}}{}
\ifthenelse{\boolean{usentheorem}}{\RequirePackage[amsthm,thmmarks,hyperref]{ntheorem}}{}
\RequirePackage{mathtools}
\RequirePackage{stmaryrd}

% Source code typesetting related packages
\RequirePackage{listings}

% Number and unit typesetting related packages
\RequirePackage{siunitx}

% Packages related to tables and lists
\RequirePackage{booktabs}
\ifthenelse{\boolean{useenumitem}}{\RequirePackage{enumitem}}{}
\ifthenelse{\boolean{useenumitem}}{\@ifpackageloaded{ntheorem}{}{\RequirePackage{moreenum}}}{}
\RequirePackage{longtable}

% Packages related to coloring
\PassOptionsToPackage{svgnames}{xcolor}
\RequirePackage{xcolor}

% Packages which facilitate the definition of new commands
\RequirePackage{xparse}
\RequirePackage{xspace}

% Packages related to typesetting of algorithms
\ifthenelse{\boolean{usealgpseudocode}}{\RequirePackage{algpseudocode}}{}

% Packages related to internationalization
\RequirePackage{csquotes}

% Packages related to referencing
\ifthenelse{\boolean{useBibLaTeX}}{%
	\RequirePackage[style=authoryear-comp,backend=biber]{biblatex}
}{}

\ifthenelse{\boolean{usehyperref}}{\RequirePackage{hyperref}}{}
\ifthenelse{\boolean{usecleveref}}{\RequirePackage[nameinlink,capitalize,noabbrev]{cleveref}}{}

% Packages related to changes tracking
\RequirePackage[ulem=normalem,truncate=fit]{changes}

% Packages related to icons (only for XeTeX)
\ifthenelse{\boolean{xetex}}{%
	\RequirePackage{academicons}
}{}

% Packages related to numbering
\RequirePackage{chngcntr}

% Packages for icons and such
\RequirePackage{ccicons} % Creative Commons License icons
