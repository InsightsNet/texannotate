% This LaTeX package defines and loads all commonly used packages. Class
% options can be used if required to turn off undesired packages. Note that,
% wherever possible, the configuration of each package is deferred to
% numapde-style.sty.

\ProvidesPackage{numapde-packages}

% Packages which allow control flow
\RequirePackage{ifthen}
\RequirePackage{xifthen}
\RequirePackage{ifxetex}

% Define some Boolean variables which are going to be used for conditional loading
\provideboolean{useamsthm}        \setboolean{useamsthm}{true}
\provideboolean{usentheorem}      \setboolean{usentheorem}{false}
\provideboolean{useBibLaTeX}      \setboolean{useBibLaTeX}{true}
\provideboolean{usehyperref}      \setboolean{usehyperref}{true}
\provideboolean{usecleveref}      \setboolean{usecleveref}{true}
\provideboolean{useenumitem}      \setboolean{useenumitem}{true}
\provideboolean{usealgpseudocode} \setboolean{usealgpseudocode}{false}
\provideboolean{usebabel}         \setboolean{usebabel}{true}

% Alter some default behavior, depending on the class loaded
\@ifclassloaded{achemso}{%
	\setboolean{usebabel}{false}
	\setboolean{useBibLaTeX}{false}
}{}
