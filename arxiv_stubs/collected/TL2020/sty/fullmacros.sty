\newtheorem{rubric}{***} % add [section] for numbering within sections
\newcommand{\mynewtheorem}[2]{
  \newaliascnt{#1}{rubric}
  \newtheorem{#1}[#1]{#2}
  \aliascntresetthe{#1}
  % maybe we will squish some autoref defaults, but who cares?
  \expandafter\def\csname #1autorefname\endcsname{#2}
}
\newcommand{\mynewtheoremnonumbers}[2]{
  \newaliascnt{#1}{rubric}
  \newtheorem*{#1}{#2}
  \aliascntresetthe{#1}
  % maybe we will squish some autoref defaults, but who cares?
  \expandafter\def\csname #1autorefname\endcsname{#2}
}

