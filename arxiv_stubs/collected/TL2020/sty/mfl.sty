\newenvironment{properties}[2]{%
\@ifundefined{c@prop#2}{\newcounter{prop#2}}{\relax}
\def\@propprefix{#1}
\begin{list}{{{\upshape$($#1\arabic{prop#2}$)$}\hfill}}
{\leftmargin5.5em\labelwidth4.2em\itemsep0pt\itemindent0pt\labelsep0.2em\@nmbrlisttrue\def\@listctr{prop#2}}%
}{\end{list}}

\newenvironment{propproof}{%
\begin{list}{\hfill}{\leftmargin4em\labelwidth3.8em\itemsep0pt\itemindent0pt\labelsep0.2em\@nmbrlisttrue}%
}{\end{list}}

\def\plabel#1{\@bsphack
  \protected@write\@auxout{}%
         {\string\newlabel{#1}{{$($\@propprefix\@currentlabel$)$}{\thepage}}}%
  \@esphack}


\def\pitem#1{\item[\ref{#1}\hfill]}

\newcounter{qcounter}                                           %  new list environments

\newenvironment{pclist}
{\begin{list}{\hbox to 40pt{(\roman{qcounter})}}{\usecounter{qcounter}
\setlength\itemsep{5pt}
\setlength\parskip{0pt}
\setlength\parsep{0pt}
\setlength\topsep{2ex}
\setlength\labelwidth{40pt}
\addtolength\labelsep{5pt}
\setlength\leftmargin{55pt}
}}
{\end{list}}

\newenvironment{prooflist}
{\begin{list}{\hbox to 10pt{(\alph{qcounter})}}{\usecounter{qcounter}
\setlength\itemsep{3pt}
\setlength\parskip{0pt}
\setlength\parsep{0pt}
\setlength\topsep{1ex}
\setlength\labelwidth{25pt}
\addtolength\labelsep{10pt}
\setlength\leftmargin{30pt}
}}
{\end{list}}

