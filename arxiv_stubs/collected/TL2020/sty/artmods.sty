\def\@maketitle{%
  \newpage
  \null
%  \vskip 2em%
   \vspace{-2em}
  \begin{center}%
%    {\LARGE \@title \par}%
    {\Large \@title \par}%
    \vskip 1.5em%
%    {\large
    {\normalsize
      \lineskip .5em%
      \begin{tabular}[t]{c}%
        \@author
      \end{tabular}\par}%
    \vskip 1em%
%    {\large \@date}%
    {\small \@date}%
  \end{center}%
  \par
  \vskip 1.5em}

% Definition of 'headings' page style 
%  Note the use of ##1 for parameter of \def\sectionmark inside the
%  \def\ps@headings.
%

\if@twoside         % If two-sided printing.
  \def\ps@headings{%
      \let\@oddfoot\@empty\let\@evenfoot\@empty %       No feet.
%      \def\@evenhead{\thepage\hfil\slshape\leftmark}%
      \def\@evenhead{\begin{tabular*}{\textwidth}%
                {@{\extracolsep{\fill}}lcr@{}}
                \itshape \thepage &\itshape \leftmark &\hbox{}\\ \hline
                \end{tabular*}}%
%      \def\@oddhead{{\slshape\rightmark}\hfil\thepage}%
      \def\@oddhead{\begin{tabular*}{\textwidth}%
                {@{\extracolsep{\fill}}lcr@{}}          
                \hbox{}&\itshape \rightmark &\itshape \thepage\\ \hline
                \end{tabular*}}%
      \let\@mkboth\markboth
%    \def\sectionmark##1{%
%      \markboth {\uppercase{%
%        \ifnum \c@secnumdepth >\z@
%          \thesection.\hskip 1em\relax
%        \fi
%        ##1}}{}}%
    \def\sectionmark##1{\markright{\thesection.\hskip 1em\relax ##1}}%
%    \def\subsectionmark##1{%
%      \markright {%
%        \ifnum \c@secnumdepth >\@ne
%          \thesubsection\hskip 1em\relax
%          \fi
%          ##1}}}
    \def\subsectionmark##1{}}              
\else               % If one-sided printing.
  \def\ps@headings{%
    \let\@oddfoot\@empty       %     No feet.                    
%    \def\@oddhead{{\slshape\rightmark}\hfil\thepage}%
%    \def\@oddhead{\hfil{\itshape\rightmark}\hfil\thepage}% Heading.
      \def\@oddhead{\begin{tabular*}{\textwidth}%
                {@{\extracolsep{\fill}}lcr@{}}          
                \hbox{}&\itshape \rightmark &\itshape \thepage\\ \hline
                \end{tabular*}}%
    \let\@mkboth\markboth
%    \def\sectionmark##1{%
%      \markright {\uppercase{%
%        \ifnum \c@secnumdepth >\m@ne
%          \thesection\hskip 1em\relax
%        \fi
%        ##1}}}}
    \def\sectionmark##1{\markright {{\ifnum \c@secnumdepth >\m@ne
     \thesection.\hskip 1em\relax \fi ##1}}}}
\fi

