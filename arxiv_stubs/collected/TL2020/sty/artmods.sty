\@addtoreset{equation}{section}  % Makes \section reset 'equation' counter.  
\def\theequation{\thesection.\arabic{equation}}

\newenvironment{proof}{\penalty 25\noindent{\bfseries Proof.}%
%           \nobreak\hskip 1em\ignorespaces\noindent}%
            \nobreak\ignorespaces\noindent}%
               {\hspace{1em}\blackslug\vspace{\bigskipamount}}

\newenvironment{proofof}[1]{\vspace{\bigskipamount}%
            \penalty 25\noindent{\bfseries Proof of #1.}%
%           \nobreak\hskip 1em\ignorespaces\noindent}%
            \nobreak\ignorespaces\noindent}%
               {\hspace{1em}\blackslug\vspace{\bigskipamount}}

\newtheorem{definition}{Definition}[section]
\newtheorem{example}{Example}[section]
\newtheorem{result}{Result}[section]
\newtheorem{theorem}{Theorem}[section]
\newtheorem{corollary}{Corollary}[section]
\newtheorem{lemma}{Lemma}[section]
\newtheorem{property}{Property}[section]
\newtheorem{proposition}{Proposition}[section]
\newtheorem{algorithm}{Algorithm}[section]
\newtheorem{assumption}{Assumption}[section]

% Key words and AMS, consistent with SIAM style

\newcommand\keywordsname{Key words}
\newenvironment{keywords}{%
      \if@twocolumn
        \section*{\keywordsname}%
      \else
        \small
        \quotation
          {\bfseries \keywordsname.}%
      \fi}
      {\if@twocolumn\else\endquotation\fi}

\def\AMSname{AMS subject classifications}
\newenvironment{AMS}{%
      \if@twocolumn
        \section*{\AMSname}%
      \else
        \small
        \quotation
          {\bfseries \AMSname.}%
      \fi}
      {\if@twocolumn\else\endquotation\fi}

