\setbeamercolor{palette tertiary}{fg=black,bg=structure!50!white}
\setbeamercolor{palette secondary}{fg=structure!50!white,bg=structure!70!black}
\setbeamercolor{palette primary}{fg=black,bg=structure!20!white}
\setbeamercolor{palette secondary bis}{bg=structure!50!white,fg=structure!70!black}


\setbeamercolor*{author in head/foot}{parent=palette secondary bis}
\setbeamercolor*{title in head/foot}{parent=palette secondary}
\setbeamercolor*{date in head/foot}{parent=palette primary}

\setbeamercolor*{section in head/foot}{parent=palette tertiary}
\setbeamercolor*{subsection in head/foot}{parent=palette primary}
% colors for the external link field
\setbeamercolor*{external link}{parent=palette secondary}

\defbeamertemplate*{footline}{modificatema theme}
{
  \leavevmode%
  \hbox{%
  \begin{beamercolorbox}[wd=.39\paperwidth,ht=2.25ex,dp=1ex,center]{author in head/foot}%
    \usebeamerfont{author in head/foot}\insertshortauthor\expandafter\beamer@ifempty\expandafter{\beamer@shortinstitute}{}{~~(\insertshortinstitute)}
  \end{beamercolorbox}%
  \begin{beamercolorbox}[wd=.53\paperwidth,ht=2.25ex,dp=1ex,center]{title in head/foot}%
    \usebeamerfont{title in head/foot}\insertshorttitle
  \end{beamercolorbox}%
  \begin{beamercolorbox}[wd=.08\paperwidth,ht=2.25ex,dp=1ex,center]{date in head/foot}%
    \usebeamerfont{date in head/foot}
    \insertframenumber{} / \inserttotalframenumber 
  \end{beamercolorbox}%
  % this is a new field with an external link
%  \begin{beamercolorbox}[wd=.25\paperwidth,ht=2.25ex,dp=1ex,right]{external link}%
   % \usebeamerfont{author in head/foot}\href{a}{a}\hspace*{2ex}
  %\end{beamercolorbox}
  }%
  \vskip0pt%
}



