\typeout{Document Option `bptitle':  6 Oct 92}

% ADD WAY TO INCLUDE KEYWORDS AND SUBJECT CLASSIFICATIONS AT BOTTOM OF
% TITLE PAGE.  THIS INVOLVES SOME CHANGES IN THE DEFINITIONS FOR THE
% MAKETITLE MACROS FROM ARTICLE.TEX.
%
\def\amssubj#1{\begingroup
\def\protect{\noexpand\protect\noexpand}\xdef\@amssubj{\@amssubj
  \protect\footnotetext[\the\c@footnote]{{\it AMS {\rm 2000} subject
classifications.\/} #1}}\endgroup}
\def\@amssubj{}

\def\abtitle#1{\begingroup
\def\protect{\noexpand\protect\noexpand}\xdef\@abtitle{\@abtitle
  \protect\footnotetext[\the\c@footnote]{{\it Abbreviated title.\/}
    #1}}\endgroup}
\def\@abtitle{}

\def\keywords#1{\begingroup
\def\protect{\noexpand\protect\noexpand}\xdef\@keywords{\@keywords
  \protect\footnotetext[\the\c@footnote]{{\it Key words and
      phrases.\/} #1}}\endgroup}
\def\@keywords{}

\def\maketitle{\par
 \begingroup
 \def\thefootnote{\fnsymbol{footnote}}
 \def\@makefnmark{\hbox 
 to 0pt{$^{\@thefnmark}$\hss}} 
 \if@twocolumn 
 \twocolumn[\@maketitle] 
 \else \newpage
 \global\@topnum\z@ \@maketitle \fi
 \thispagestyle{plain}\@thanks\@amssubj\@abtitle\@keywords
 \endgroup
 \setcounter{footnote}{0}
 \let\maketitle\relax
 \let\@maketitle\relax
 \gdef\@thanks{}\gdef\@amssubj{}\gdef\@abtitle{}\gdef\@keywords{}\gdef\@author{}\gdef\@title{}
 \let\thanks\relax\let\amssubj\relax\let\keywords\relax}
\def\@maketitle{\newpage
 \null
 \vskip 2em \begin{center}
 {\LARGE \@title \par} \vskip 1.5em {\large \lineskip .5em
\begin{tabular}[t]{c}\@author 
 \end{tabular}\par} 
 \vskip 1em {\large \@date} \end{center}
 \par
 \vskip 1.5em} 
\def\abstract{\if@twocolumn
\section*{Abstract}
\else \small 
\begin{center}
{\bf Abstract\vspace{-.5em}\vspace{0pt}} 
\end{center}
\quotation 
\fi}
\def\endabstract{\if@twocolumn\else\endquotation\fi}
