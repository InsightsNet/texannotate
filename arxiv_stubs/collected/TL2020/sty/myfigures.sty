\llegt{M} \altind{$(M)-(3mm,0mm)$}{#3}
\rlegt{M} \artind{$(M)+(3.5mm,0mm)$}{#4}
}}

%%%
%%% supercore with indices
%%%
\newcommand{\mytikzsupercoreind}[5][-0.75mm]{%
