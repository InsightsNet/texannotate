%%%
%%% iTR matrix (unit cell = 2)
%%%
\newcommand{\mytikzbHk}[8][0mm]{%
\tikz[on grid,baseline=#1]{%
\clip (-0.1mm,-7.1mm) rectangle (56mm,6.8mm);
\fnode{c1}{}           \anode[6.5mm]{i1}{c1}{} \bnode[6.5mm]{j1}{c1}{}
\rnode[10mm]{c2}{c1}{} \anode[6.5mm]{i2}{c2}{} \bnode[6.5mm]{j2}{c2}{}
\rnode[10mm]{c3}{c2}{} \anode[6.5mm]{i3}{c3}{} \bnode[6.5mm]{j3}{c3}{}
\rnode[10mm]{c4}{c3}{} \anode[6.5mm]{i4}{c4}{} \bnode[6.5mm]{j4}{c4}{}
\rnode[10mm]{c5}{c4}{} \anode[6.5mm]{i5}{c5}{} \bnode[6.5mm]{j5}{c5}{}
\rnode[10mm]{c6}{c5}{} \anode[6.5mm]{i6}{c6}{} \bnode[6.5mm]{j6}{c6}{}
\draw (i1) -- (j1); \draw (i2) -- (j2); \draw (i3) -- (j3);
\draw (i4) -- (j4); \draw (i5) -- (j5); \draw (i6) -- (j6);
\oper{op}{($0.5*(c3)+0.5*(c4)$)}{#2}
%
\brtind{$(c1)-(0mm,4.25mm)$}{$j_{#3}$} \brtind{$(c1)+(0mm,7.25mm)$}{$i_{#3}$}
\brtind{$(c2)-(0mm,4.25mm)$}{$j_{#4}$} \brtind{$(c2)+(0mm,7.25mm)$}{$i_{#4}$}
\brtind{$(c3)-(0mm,4.25mm)$}{$j_{#5}$} \brtind{$(c3)+(0mm,7.25mm)$}{$i_{#5}$}
\brtind{$(c4)-(0mm,4.25mm)$}{$j_{#6}$} \brtind{$(c4)+(0mm,7.25mm)$}{$i_{#6}$}
\brtind{$(c5)-(0mm,4.25mm)$}{$j_{#7}$} \brtind{$(c5)+(0mm,7.25mm)$}{$i_{#7}$}
\brtind{$(c6)-(0mm,4.25mm)$}{$j_{#8}$} \brtind{$(c6)+(0mm,7.25mm)$}{$i_{#8}$}
}}

%%%
%%% iTR2: Rayleigh quotient (inf)
%%%
\newcommand{\mytikzrqinf}[3][0mm]{%
\tikz[on grid,auto,baseline=#1]{%
\fcor{X1t}{#2} \bcor[14mm]{X1b}{X1t}{#2}
\rcor{X2t}{X1t}{#3} \rcor{X2b}{X1b}{#3} \draw (X2t) -- (X2b);
\rcor{X3t}{X2t}{#2} \rcor{X3b}{X2b}{#2} \draw (X3t) -- (X3b);
\rcor{X4t}{X3t}{#3} \rcor{X4b}{X3b}{#3} \draw (X4t) -- (X4b);
\rcor{X5t}{X4t}{#2} \rcor{X5b}{X4b}{#2} \draw (X5t) -- (X5b);
\rcor{X6t}{X5t}{#3} \rcor{X6b}{X5b}{#3} \draw (X6t) -- (X6b);
\linf{linft}{X1t} \rinf{rinft}{X6t} \ringup{linft}{rinft}
\linf{linfb}{X1b} \rinf{rinfb}{X6b} \ringdown{linfb}{rinfb}
\oper[minimum width=13mm]%
{op}{($0.25*(X3t)+0.25*(X3b)+0.25*(X4t)+0.25*(X4b)$)}{$M$}
}}

%%%
%%% iTR2: Rayleigh quotient
%%%
\newcommand{\mytikzrq}[5][0mm]{%
\tikz[on grid,auto,baseline=#1]{%
\fcor{Xt}{#2}     \bcor[14mm]{Xb}{Xt}{#2}
\rcor{Yt}{Xt}{#3} \rcor{Yb}{Xb}{#3} \draw (Yt) -- (Yb);
\node (CX) at ($0.5*(Xt)+0.5*(Xb)$) {}; \ulmat{VL}{CX}{#4}
\node (CY) at ($0.5*(Yt)+0.5*(Yb)$) {}; \urmat{VR}{CY}{#5}
\oper[minimum width=13mm]{op}{($0.5*(CX)+0.5*(CY)$)}{{$M$}}
\draw (Xt) -- ($(Xt)-(3.5mm,0mm)$) to[out=180,in=90]  (VL);
\draw (Xb) -- ($(Xb)-(3.5mm,0mm)$) to[out=180,in=270] (VL);
\draw (Yt) -- ($(Yt)+(3.5mm,0mm)$) to[out=0,in=90]  (VR);
\draw (Yb) -- ($(Yb)+(3.5mm,0mm)$) to[out=0,in=270] (VR);
}}

