%%%
%%% iTR matrix
%%%
\newcommand{\mytikziTRmatrix}[5][0mm]{%
\tikz[on grid,baseline=#1]{%
\clip (-10mm,-6.7mm) rectangle (27mm,6.5mm);
\foper{M1}{#2}            \bleg[5mm]{M1} \aleg[5mm]{M1} \linf{linf}{M1}
\roper[8.5mm]{M2}{M1}{#2} \bleg[5mm]{M2} \aleg[5mm]{M2}
\roper[8.5mm]{M3}{M2}{#2} \bleg[5mm]{M3} \aleg[5mm]{M3} \rinf{rinf}{M3}
\draw (M1) -- (M2) -- (M3);
\brtind{$(M1)-(0mm,4mm)$}{$j_{#3}$} \brtind{$(M1)+(0mm,7mm)$}{$i_{#3}$}
\brtind{$(M2)-(0mm,4mm)$}{$j_{#4}$} \brtind{$(M2)+(0mm,7mm)$}{$i_{#4}$}
\brtind{$(M3)-(0mm,4mm)$}{$j_{#5}$} \brtind{$(M3)+(0mm,7mm)$}{$i_{#5}$}
}}

