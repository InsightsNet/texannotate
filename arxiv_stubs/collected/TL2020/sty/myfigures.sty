\bnode{U1}{Q1}{}         \rnode[7.5mm]{T1}{U1}{}
\rnode[15mm]{Q2}{Q1}{}   \rnode[11.25mm]{Q3}{Q2}{}
\rnode[15mm]{U2}{U1}{}   \rnode[11.25mm]{U3}{U2}{}
\rnode[22.5mm]{Q4}{Q2}{} \urmat[7.5mm]{S4}{Q4}{#3}
\rnode[22.5mm]{U4}{U2}{} \urmat[7.5mm]{T4}{U4}{#3}
%
\veceyet[0mm]{Q2}{U2} \veceye[0mm]{$(S1)-(10mm,0mm)$}{$(T1)-(10mm,0mm)$}
\veceyet[4.5mm]{S4}{T4}
\ringup{$(S1)-(10mm,0mm)$}{S4}
\ringdown{$(T1)-(10mm,0mm)$}{T4}
%
\draw ($(U3)-(  0mm,4mm)$) -- ($(Q3)+(   0mm,4mm)$);
\draw ($(U4)-(7.5mm,4mm)$) -- ($(Q4)+(-7.5mm,4mm)$);
\draw[rounded corners] (Q2) -- ($(Q2)+(7.5mm,0mm)$) -- ($(Q2)+(7.5mm, 4mm)$);
\draw[rounded corners] (U2) -- ($(U2)+(7.5mm,0mm)$) -- ($(U2)+(7.5mm,-4mm)$);
}}

%%%
%%% iTR2
%%%
\newcommand{\mytikziTRR}[7][-0.75mm]{%
\tikz[on grid,baseline=#1]{%
\clip (-13.6mm,-6.2mm) rectangle (37.6mm,5.1mm);
\fcore{X1}{#2}            \linf{linf}{X1} \brphind{X1}{#4}
\rcore[7.5mm]{Y1}{X1}{#3}                 \brphind{Y1}{#5}
\rcore[9mm]{X2}{Y1}{#2}                   \brphind{X2}{#6}
\rcore[7.5mm]{Y2}{X2}{#3} \rinf{rinf}{Y2} \brphind{Y2}{#7}
\ringup{linf}{rinf}
}}

%%%
%%% iTR2: transfer matrices
%%%
\newcommand{\mytikzTT}[3][-5mm]{%
\tikz[baseline=#1]{%
\fcor{Xt}{#2}     \rcor{Yt}{Xt}{#3} \lleg{Xt}\rleg{Yt}
\bcor{Xb}{Xt}{#2} \rcor{Yb}{Xb}{#3} \lleg{Xb}\rleg{Yb} \draw (Yt) -- (Yb);
}}

%%%
%%% iTR2c
%%%
\newcommand{\mytikziTRRc}[9][-0.75mm]{%
\tikz[on grid,baseline=#1]{%
\clip (-13.6mm,-6.2mm) rectangle (67.6mm,5.1mm);
\fcore{Q1}{#2}            \rmat[7.5mm]{S1}{Q1}{#3} \brphind{Q1}{#6}
\rcore[7.5mm]{U1}{S1}{#4} \rmat[7.5mm]{O1}{U1}{#5} \brphind{U1}{#7}
\rcore[9mm]{Q2}{O1}{#2}   \rmat[7.5mm]{S2}{Q2}{#3} \brphind{Q2}{#8}
\rcore[7.5mm]{U2}{S2}{#4} \rmat[7.5mm]{O2}{U2}{#5} \brphind{U2}{#9}
\linf{linf}{Q1} \rinf{rinf}{O2} \ringup{linf}{rinf}
}}

%%%
%%% iTR2c: left transfer matrix (right eigenvectors)
%%%
\newcommand{\mytikzTQULright}[5][0mm]{%
\tikz[on grid,auto,baseline=#1]{%
\clip (-12.1mm,-10.6mm) rectangle (30.5mm,2.6mm);
\fcor{Qt}{#2}             \bcor{Qb}{Qt}{#2}
\lmat[7.5mm]{Ot}{Qt}{#5}  \lmat[7.5mm]{Ob}{Qb}{#5} \lleg{Ot} \lleg{Ob}
\rmat[7.5mm]{St}{Qt}{#4}  \rmat[7.5mm]{Sb}{Qb}{#4}
\rcor[7.5mm]{Ut}{St}{#3}  \rcor[7.5mm]{Ub}{Sb}{#3} \draw (Ut) -- (Ub);
\urmat[9.5mm]{Rt}{Ut}{#5} \urmat[9.5mm]{Rb}{Ub}{#5}
\rleg{Ut} \rleg{Ub} \lleg{Rt} \lleg{Rb} \veceye[3.5mm]{Rt}{Rb}
}}

%%%
%%% iTR2c: right transfer matrix (right eigenvectors)
%%%
\newcommand{\mytikzTQURright}[5][0mm]{%
\tikz[on grid,auto,baseline=#1]{%
\clip (-15.5mm,-10.6mm) rectangle (27.1mm,2.6mm);
\fcor{Qt}{#2}             \bcor{Qb}{Qt}{#2}        \lleg{Qt} \lleg{Qb}
\rmat[7.5mm]{St}{Qt}{#4}  \rmat[7.5mm]{Sb}{Qb}{#4}
\rcor[7.5mm]{Ut}{St}{#3}  \rcor[7.5mm]{Ub}{Sb}{#3} \draw (Ut) -- (Ub);
\rmat[7.5mm]{Ot}{Ut}{#5}  \rmat[7.5mm]{Ob}{Ub}{#5} \rleg{Ot} \rleg{Ob}
\ulmat[9.5mm]{Rt}{Qt}{#5} \ulmat[9.5mm]{Rb}{Qb}{#5}
\rleg{Rt} \rleg{Rb} \veceyet[3.5mm]{Rt}{Rb}
}}

%%%
