% !TEX root = paper.tex

\newcommand{\myvcenter}[1]{\vcenter{\hbox{#1}}}

%%%
%%% core
%%%
\newcommand{\mytikzcore}[2][-0.75mm]{%
\tikz[on grid,baseline=#1]{%
\fcore{X}{#2} \lleg{X} \rleg{X}
}}

%%%
%%% supercore
%%%
\newcommand{\mytikzsupercore}[2][-0.75mm]{%
\tikz[on grid,baseline=#1]{%
\fcor{X}{#2} \lleg{X} \blegt{X} \rleg{X}
}}

%%%
%%% center core
%%%
\newcommand{\mytikzcentercore}[4][-0.75mm]{%
\tikz[on grid,baseline=#1]{%
\fcore{Q}{#3}
\lmat[7.5mm]{L}{Q}{#2} \lleg{L}
\rmat[7.5mm]{R}{Q}{#4} \rleg{R}
}}

%%%
%%% center supercore
%%%
\newcommand{\mytikzcentersupercore}[5][-0.75mm]{%
\tikz[on grid,baseline=#1]{%
\fmat{O1}{#5}           \lleg{O1}
\rcor[7.5mm]{Q}{O1}{#2} \bleg{Q}
\rmat[7.5mm]{S}{Q}{#3}
\rcor[7.5mm]{U}{S}{#4}  \bleg{U}
\rmat[7.5mm]{O2}{U}{#5} \rleg{O2}
}}

%%%
%%% center supercore (thick leg)
%%%
\newcommand{\mytikzcentersupercorecombined}[4][-0.75mm]{%
\tikz[on grid,baseline=#1]{%
\fcor{Q}{#3} \blegt{Q}
\lmat[7.5mm]{L}{Q}{#2} \lleg{L}
\rmat[7.5mm]{R}{Q}{#4} \rleg{R}
}}

% ============================================================================ %
% === 2. NOTATION ============================================================ %
% ============================================================================ %

%%%
%%% notation: scalar
%%%
\newcommand{\mytikznotsca}[2][-0.85mm]{%
\tikz[on grid,baseline=#1]{%
\fmat{a}{#2}
}}

%%%
%%% notation: vector
%%%
\newcommand{\mytikznotvec}[3][-0.85mm]{%
\tikz[on grid,baseline=#1]{%
\clip (-5.6mm,-2.6mm) rectangle (2.6mm,2.6mm);
\fmat{v}{#2} \lleg[5.5mm]{v} \brtind{$(v)+(-6mm,2.9mm)$}{#3}
}}

%%%
%%% notation: matrix
%%%
\newcommand{\mytikznotmat}[4][-0.85mm]{%
\tikz[on grid,baseline=#1]{%
\clip (-5.6mm,-2.6mm) rectangle (5.6mm,2.6mm);
\fmat{M}{#2}
\lleg[5.5mm]{M} \brtind{$(M)+(-6.0mm,2.9mm)$}{#3}
\rleg[5.5mm]{M} \bltind{$(M)+( 6.0mm,2.9mm)$}{#4}
}}

%%%
%%% notation: tensor
%%%
\newcommand{\mytikznotten}[5][-0.85mm]{%
\tikz[on grid,baseline=#1]{%
\clip (-5.6mm,-5.6mm) rectangle (5.6mm,2.6mm);
\fcor{T}{#2}
\lleg[5.5mm]{T} \artind{$(T)+(-6.0mm,0mm)$}{#3}
\bleg[5.5mm]{T}  \rtind{$(T)+(   0mm,-4.5mm)$}{#4}
\rleg[5.5mm]{T} \altind{$(T)+( 6.0mm,0mm)$}{#5}
}}

%%%
%%% notation: matvec
%%%
\newcommand{\mytikznotmatvec}[5][-0.85mm]{%
\tikz[on grid,baseline=#1]{%
\clip (-5.6mm,-2.6mm) rectangle (11.6mm,2.6mm);
\fmat{M}{#2}         \lleg[5.5mm]{M} \brtind{$(M)+(-6.0mm,2.9mm)$}{#4}
\rmat[9mm]{v}{M}{#3}                 \btind{$0.5*(M)+0.5*(v)+(0mm,2.9mm)$}{#5}
}}

%%%
%%% notation: matmat
%%%
\newcommand{\mytikznotmatmat}[6][-0.85mm]{%
\tikz[on grid,baseline=#1]{%
\clip (-5.6mm,-2.6mm) rectangle (14.6mm,2.6mm);
\fmat{A}{#2}         \lleg[5.5mm]{A} \brtind{$(A)+(-6.0mm,2.9mm)$}{#4}
\rmat[9mm]{B}{A}{#3}                 \btind{$0.5*(A)+0.5*(B)+(0mm,2.9mm)$}{#5}
                     \rleg[5.5mm]{B} \altind{$(B)+( 6.0mm,0mm)$}{#6}
}}

%%%
%%% notation: tenten super core
%%%
\newcommand{\mytikznottentensuper}[5][-0.85mm]{%
\tikz[on grid,baseline=#1]{%
\clip (-5.6mm,-5.65mm) rectangle (6.2mm,2.6mm);
\fcor{X}{#2}
\lleg[5.5mm]{X}  \artind{$(X)-(6.0mm,0mm)$}{#3}
\blegt[5.5mm]{X} \rtind{$(X)+(0mm,-4.5mm)$}{#4}
\rleg[5.5mm]{X}  \altind{$(X)+(7.0mm,0mm)$}{#5}
}}

%%%
%%% notation: tenten
%%%
\newcommand{\mytikznottenten}[8][-0.85mm]{%
\tikz[on grid,baseline=#1]{%
\clip (-5.6mm,-5.6mm) rectangle (16.2mm,2.6mm);
\fcor{X}{#2} \rcor[10mm]{Y}{X}{#3}
\lleg[5.5mm]{X} \artind{$(X)-(6.0mm,0mm)$}{#4}
\bleg[5.5mm]{X} \rtind{$(X)+(0mm,-4.5mm)$}{#5}
                \atind{$0.5*(X)+0.5*(Y)$}{#6}
\bleg[5.5mm]{Y} \rtind{$(Y)+(0mm,-4.5mm)$}{#7}
\rleg[5.5mm]{Y} \altind{$(Y)+(7.0mm,0mm)$}{#8}
}}

%%%
%%% notation: trace
%%%
\newcommand{\mytikznottrace}[2][-0.85mm]{%
\tikz[on grid,baseline=#1]{%
\fmat{M}{#2} \ringup{M}{M}
}}

%%%
%%% notation: vector^T
%%%
\newcommand{\mytikznotvectrans}[2][-0.85mm]{%
\tikz[on grid,baseline=#1]{%
\fmat{v}{#2} \rleg[5mm]{v}
}}

%%%
%%% notation: vecM
%%%
\newcommand{\mytikznotvecM}[2][-0.85mm]{%
\tikz[on grid,baseline=#1]{%
\fmat{M}{#2}
\draw[rounded corners] (M) -- ($(M)+(0mm,5mm)$) -- ($(M)+(-3mm,5mm)$);
\draw[rounded corners] (M) -- ($(M)-(0mm,5mm)$) -- ($(M)-( 3mm,5mm)$);
}}

%%%
%%% notation: vecM^T
%%%
\newcommand{\mytikznotvecMtrans}[2][-0.85mm]{%
\tikz[on grid,baseline=#1]{%
\fmat{M}{#2}
\draw[rounded corners] (M) -- ($(M)+(0mm,5mm)$) -- ($(M)+( 3mm,5mm)$);
\draw[rounded corners] (M) -- ($(M)-(0mm,5mm)$) -- ($(M)-(-3mm,5mm)$);
}}

%%%
%%% notation: vecT
%%%
\newcommand{\mytikznotvecT}[2][-0.85mm]{%
\tikz[on grid,baseline=#1]{%
\fcor{T}{#2} \bleg[4.75mm]{T}
\draw[rounded corners] (T) -- ($(T)-(5mm,0mm)$) -- ($(T)-(5mm, 4.75mm)$);
\draw[rounded corners] (T) -- ($(T)+(5mm,0mm)$) -- ($(T)+(5mm,-4.75mm)$);
}}

%%%
%%% notation: vecI*vecS2^T
%%%
\newcommand{\mytikznotvecIvecST}[2][-5mm]{%
\tikz[on grid,baseline=#1]{%
\clip (-11.35mm,-10.6mm) rectangle (4.6mm,2.6mm);
\fmat{St}{#2}      \rleg{St} \lnode[12.5mm]{It}{St}{}
\ubmat{Sb}{St}{#2} \rleg{Sb} \lnode[12.5mm]{Ib}{Sb}{}
\veceyet[4.5mm]{St}{Sb} \veceye{It}{Ib}
}}

%%%
%%% notation: vecS2*vecI^T
%%%
\newcommand{\mytikznotvecSvecIT}[2][-5mm]{%
\tikz[on grid,baseline=#1]{%
\clip (-4.6mm,-10.6mm) rectangle (11.35mm,2.6mm);
\fmat{St}{#2}      \lleg{St} \rnode[12.5mm]{It}{St}{}
\ubmat{Sb}{St}{#2} \lleg{Sb} \rnode[12.5mm]{Ib}{Sb}{}
\veceye[4.5mm]{St}{Sb} \veceyet{It}{Ib}
(Ib);
}}

% ============================================================================ %
% === 3. TRANSLATIONAL INVARIANT INFINITE TENSOR RING ======================== %
% ============================================================================ %

%%%
%%% TR
%%%
\newcommand{\mytikzTRing}[7][-0.75mm]{%
\tikz[on grid,baseline=#1]{%
\clip (-5.6mm,-6.2mm) rectangle (29.6mm,5.1mm);
\fcore{X1}{#2}      \brphind{X1}{#5}
\rcore{X2}{X1}{#3}  \brphind{X2}{#6}
\rinf{inf}{X2}
\rcore{X3}{inf}{#4} \brphind{X3}{#7}
\ringup{X1}{X3}
}}

%%%
%%% iTR1
%%%
\newcommand{\mytikziTR}[5][-0.75mm]{%
\tikz[on grid,baseline=#1]{%
\clip (-13.6mm,-6.2mm) rectangle (29.6mm,5.1mm);
\fcore{X1}{#2}     \linf{linf}{X1} \brphind{X1}{#3}
\rcore{X2}{X1}{#2}                 \brphind{X2}{#4}
\rcore{X3}{X2}{#2} \rinf{rinf}{X3} \brphind{X3}{#5}
\ringup{linf}{rinf}
}}

%%%
%%% iTR1: transfer matrix
%%%
\newcommand{\mytikzT}[2][-5mm]{%
\tikz[baseline=#1]{%
\fcor{Xt}{#2}     \lleg{Xt} \rleg{Xt}
\bcor{Xb}{Xt}{#2} \lleg{Xb} \rleg{Xb}
}}

%%%
%%% iTR1: transfer matrix (left eigenvectors)
%%%
\newcommand{\mytikzTleft}[3][0mm]{%
\tikz[on grid,auto,baseline=#1]{%
\fcor{Xt}{#2} \bcor[10mm]{Xb}{Xt}{#2} \rleg{Xt} \rleg{Xb}
\node (C) at ($0.5*(Xt)+0.5*(Xb)$) {}; \ulmat[6mm]{VL}{C}{#3}
\draw (Xt) -- ($(Xt)-(3.5mm,0mm)$) to[out=180,in=90]  (VL);
\draw (Xb) -- ($(Xb)-(3.5mm,0mm)$) to[out=180,in=270] (VL);
}}

%%%
%%% iTR1: transfer matrix (right eigenvectors)
%%%
\newcommand{\mytikzTright}[3][0mm]{%
\tikz[on grid,auto,baseline=#1]{%
\fcor{Xt}{#2} \bcor[10mm]{Xb}{Xt}{#2} \lleg{Xt} \lleg{Xb}
\node (C) at ($0.5*(Xt)+0.5*(Xb)$) {}; \urmat[6mm]{VR}{C}{#3}
\draw (Xt) -- ($(Xt)+(3.5mm,0mm)$) to[out=0,in=90]  (VR);
\draw (Xb) -- ($(Xb)+(3.5mm,0mm)$) to[out=0,in=270] (VR);
}}

%%%
%%% left eigenvector
%%%
\newcommand{\mytikzlefteigv}[2][0mm]{%
\tikz[on grid,auto,baseline=#1]{%
\fmat{V}{#2}
\draw (V) to[out= 90,in=180] ($(V)+(2.5mm, 5mm)$) -- ($(V)+(4mm, 5mm)$);
\draw (V) to[out=-90,in=180] ($(V)+(2.5mm,-5mm)$) -- ($(V)+(4mm,-5mm)$);
}}

%%%
%%% right eigenvector
%%%
\newcommand{\mytikzrighteigv}[2][0mm]{%
\tikz[on grid,auto,baseline=#1]{%
\fmat{V}{#2}
\draw (V) to[out= 90,in=0] ($(V)+(-2.5mm, 5mm)$) -- ($(V)+(-4mm, 5mm)$);
\draw (V) to[out=-90,in=0] ($(V)+(-2.5mm,-5mm)$) -- ($(V)+(-4mm,-5mm)$);
}}

%%%
%%% vec(VL)^T * vec(VR)
%%%
\newcommand{\mytikzvLTvR}[3][0mm]{%
\tikz[on grid,auto,baseline=#1]{%
\fmat{VL}{#2} \urmat{VR}{VL}{#3}
\draw (VL) to[out= 90,in=180] ($(VL)+(2.5mm, 5mm)$) -- ($(VL)+(5.5mm, 5mm)$)
           to[out=  0,in= 90] (VR);
\draw (VL) to[out=-90,in=180] ($(VL)+(2.5mm,-5mm)$) -- ($(VL)+(5.5mm,-5mm)$)
           to[out=  0,in=-90] (VR);
}}

%%%
%%% iTR1: norm
%%%
\newcommand{\mytikziTRnorm}[2][-5mm]{%
\tikz[baseline=#1]{%
\fcor{X1}{$X$}     \bcor{Y1}{X1}{$X$}
\rcor{X2}{X1}{$X$} \bcor{Y2}{X2}{$X$} \draw (Y1) -- (Y2);
\rcor{X3}{X2}{$X$} \bcor{Y3}{X3}{$X$} \draw (Y2) -- (Y3);
\linf{linfX}{X1} \rinf{rinfX}{X3} \ringup{linfX}{rinfX}
\linf{linfY}{Y1} \rinf{rinfY}{Y3} \ringdown{linfY}{rinfY}
}}

%%%
%%% iTR1c
%%%
\newcommand{\mytikziTRc}[6][-0.75mm]{%
\tikz[on grid,baseline=#1]{%
\clip (-13.6mm,-6.2mm) rectangle (51.1mm,5.1mm);
\fcore{Q1}{#2}            \rmat[7.5mm]{S1}{Q1}{#3} \brphind{Q1}{#4}
\rcore[7.5mm]{Q2}{S1}{#2} \rmat[7.5mm]{S2}{Q2}{#3} \brphind{Q2}{#5}
\rcore[7.5mm]{Q3}{S2}{#2} \rmat[7.5mm]{S3}{Q3}{#3} \brphind{Q3}{#6}
\linf{linf}{Q1} \rinf{rinf}{S3} \ringup{linf}{rinf}
}}

%%%
%%% iTR1c: left transfer matrix
%%%
\newcommand{\mytikzTL}[3][-5mm]{%
\tikz[baseline=#1]{%
\fcor{Qt}{#2}
\bcor{Qb}{Qt}{#2}\rleg{Qt}\rleg{Qb}
\lmat[7.5mm]{St}{Qt}{#3}
\lmat[7.5mm]{Sb}{Qb}{#3}\lleg{St}\lleg{Sb}
}}

%%%
%%% iTR1c: right transfer matrix
%%%
\newcommand{\mytikzTR}[3][-5mm]{%
\tikz[baseline=#1]{%
\fcor{Qt}{#2}
\bcor{Qb}{Qt}{#2}\lleg{Qt}\lleg{Qb}
\rmat[7.5mm]{St}{Qt}{#3}
\rmat[7.5mm]{Sb}{Qb}{#3}\rleg{St}\rleg{Sb}
}}

%%%
%%% vecI
%%%
\newcommand{\mytikzvecI}[1][0mm]{%
\tikz[on grid,auto,baseline=#1]{%
\clip (1.2mm,-8.1mm) rectangle (4.45mm,0.1mm);
\fnode{It}{} \bnode{Ib}{It}{} \veceye[2mm]{It}{Ib}
}}

%%%
%%% vecI^T
%%%
\newcommand{\mytikzvecIT}[1][0mm]{%
\tikz[on grid,auto,baseline=#1]{%
\clip (-4.45mm,-8.1mm) rectangle (-1.2mm,0.1mm);
\fnode{It}{} \bnode{Ib}{It}{} \veceyet[2mm]{It}{Ib}
}}

%%%
%%% vecSS
%%%
\newcommand{\mytikzvecSS}[2][0mm]{%
\tikz[on grid,auto,baseline=#1]{%
\clip (-4.6mm,-10.6mm) rectangle (6mm,2.6mm);
\fmat{St}{#2} \ubmat{Sb}{St}{#2} \lleg{St} \lleg{Sb} \veceye[3.5mm]{St}{Sb}
}}

%%%
%%% vecSS^T
%%%
\newcommand{\mytikzvecSST}[2][0mm]{%
\tikz[on grid,auto,baseline=#1]{%
\clip (-6mm,-10.6mm) rectangle (4.6mm,2.6mm);
\fmat{St}{#2} \ubmat{Sb}{St}{#2} \rleg{St} \rleg{Sb} \veceyet[3.5mm]{St}{Sb}
}}

%%%
%%% iTR1c: left transfer matrix (left eigenvectors)
%%%
\newcommand{\mytikzTQLleft}[3][0mm]{%
\tikz[on grid,auto,baseline=#1]{%
\clip (-16mm,-10.6mm) rectangle (4.6mm,2.6mm);
\fcor{Xt}{#2}            \bcor{Xb}{Xt}{#2}        \rleg{Xt} \rleg{Xb}
\lmat[7.5mm]{St}{Xt}{#3} \lmat[7.5mm]{Sb}{Xb}{#3} \lleg{St} \lleg{Sb}
\veceyet[1mm]{$(St)-(5mm,0mm)$}{$(Sb)-(5mm,0mm)$}
}}

%%%
%%% iTR1c: right transfer matrix (left eigenvectors)
%%%
\newcommand{\mytikzTQRleft}[3][0mm]{%
\tikz[on grid,auto,baseline=#1]{%
\clip (-4.6mm,-10.6mm) rectangle (16mm,2.6mm);
\fcor{Xt}{#2}            \bcor{Xb}{Xt}{#2}        \lleg{Xt} \lleg{Xb}
\rmat[7.5mm]{St}{Xt}{#3} \rmat[7.5mm]{Sb}{Xb}{#3} \rleg{St} \rleg{Sb}
\veceye[1mm]{$(St)+(5mm,0mm)$}{$(Sb)+(5mm,0mm)$}
}}

%%%
%%% iTR1c: left transfer matrix (right eigenvectors)
%%%
\newcommand{\mytikzTQLright}[3][0mm]{%
\tikz[on grid,auto,baseline=#1]{%
\clip (-12.1mm,-10.6mm) rectangle (15.5mm,2.6mm);
\fcor{Xt}{#2}             \bcor{Xb}{Xt}{#2}        \rleg{Xt} \rleg{Xb}
\lmat[7.5mm]{St}{Xt}{#3}  \lmat[7.5mm]{Sb}{Xb}{#3} \lleg{St} \lleg{Sb}
\urmat[9.5mm]{Rt}{Xt}{#3} \urmat[9.5mm]{Rb}{Xb}{#3}
\lleg{Rt} \lleg{Rb} \veceye[3.5mm]{Rt}{Rb}
}}

%%%
%%% iTR1c: right transfer matrix (right eigenvectors)
%%%
\newcommand{\mytikzTQRright}[3][0mm]{%
\tikz[on grid,auto,baseline=#1]{%
\clip (-15.5mm,-10.6mm) rectangle (12.1mm,2.6mm);
\fcor{Xt}{#2}             \bcor{Xb}{Xt}{#2}        \lleg{Xt} \lleg{Xb}
\rmat[7.5mm]{St}{Xt}{#3}  \rmat[7.5mm]{Sb}{Xb}{#3} \rleg{St} \rleg{Sb}
\ulmat[9.5mm]{Rt}{Xt}{#3} \ulmat[9.5mm]{Rb}{Xb}{#3}
\rleg{Rt} \rleg{Rb} \veceyet[3.5mm]{Rt}{Rb}
}}

%%%
%%% iTR1c: frame matrix
%%%
\newcommand{\mytikziTRframe}[9][-0.75mm]{%
\tikz[on grid,baseline=#1]{%
\clip (-13.6mm,-6.4mm) rectangle (66.1mm,7.6mm);
\fcore{Q1}{#2}            \rmat[7.5mm]{S1}{Q1}{#3} \linf{linf}{Q1}
\rcore[7.5mm]{Q2}{S1}{#2}
\rnode[15mm]{Q3}{Q2}{}    \bleg{Q3}
\urcore[30mm]{Q4}{Q2}{#2} \rmat[7.5mm]{S4}{Q4}{#3} \rinf{rinf}{S4}
\ringup[7.5mm]{linf}{rinf}
\draw ($(Q3)-(0mm,2mm)$) -- ($(Q3)+(0mm,5mm)$);
\draw[rounded corners] (Q2) -- ($(Q2)+(7.5mm,0mm)$) -- ($(Q2)+(7.5mm, 4.5mm)$);
\draw[rounded corners] (Q4) -- ($(Q4)-(7.5mm,0mm)$) -- ($(Q4)-(7.5mm,-4.5mm)$);
\brphind{Q1}{$#4_{#6}$}
\brphind{Q2}{$#4_{#7}$} \brtind{$(Q2)+( 7.5mm,6.75mm)$}{$#5_{#7}$}
\brphind{Q3}{$#4_{#8}$} \brtind{$(Q3)+(   0mm,6.75mm)$}{$#5_{#8}$}
\brphind{Q4}{$#4_{#9}$} \brtind{$(Q4)+(-7.5mm,6.75mm)$}{$#5_{#9}$}
}}

%%%
%%% iTR1c: frame matrix (orthogonality 1)
%%%
\newcommand{\mytikziTRframeorthA}[3][-5mm]{%
\tikz[on grid,baseline=#1]{%
\clip (-13.6mm,-13.1mm) rectangle (58.6mm,5.1mm);
\fcor{Q1}{#2}              \rmat[7.5mm]{S1}{Q1}{#3} \linf{ltinf}{Q1}
\bcor{U1}{Q1}{#2}          \rmat[7.5mm]{T1}{U1}{#3} \linf{lbinf}{U1}
\rcor[7.5mm]{Q2}{S1}{#2}   \rnode[11.25mm]{Q3}{Q2}{}
\rcor[7.5mm]{U2}{T1}{#2}   \rnode[11.25mm]{U3}{U2}{}
\urcor[22.5mm]{Q4}{Q2}{#2} \rmat[7.5mm]{S4}{Q4}{#3} \rinf{rtinf}{S4}
\urcor[22.5mm]{U4}{U2}{#2} \rmat[7.5mm]{T4}{U4}{#3} \rinf{rbinf}{T4}
%
\draw (Q2) -- (U2); \draw (Q4) -- (U4);
\ringup{ltinf}{rtinf} \ringdown{lbinf}{rbinf}
%
\draw ($(U3)-(0mm,4mm)$) -- ($(Q3)+(0mm,4mm)$);
\draw[rounded corners] (Q2) -- ($(Q2)+(7.5mm,0mm)$) -- ($(Q2)+(7.5mm, 4mm)$);
\draw[rounded corners] (U2) -- ($(U2)+(7.5mm,0mm)$) -- ($(U2)+(7.5mm,-4mm)$);
\draw[rounded corners] (Q4) -- ($(Q4)-(7.5mm,0mm)$) -- ($(Q4)-(7.5mm,-4mm)$);
\draw[rounded corners] (U4) -- ($(U4)-(7.5mm,0mm)$) -- ($(U4)-(7.5mm, 4mm)$);
}}

%%%
%%% iTR1c: frame matrix (orthogonality 2)
%%%
\newcommand{\mytikziTRframeorthB}[3][-5mm]{%
\tikz[on grid,baseline=#1]{%
\clip (-13.6mm,-13.1mm) rectangle (50.6mm,5.1mm);
\fnode{Q1}{}             \urmat[7.5mm]{S1}{Q1}{#3}
\bnode{U1}{Q1}{}         \urmat[7.5mm]{T1}{U1}{#3}
\rcor[7.5mm]{Q2}{S1}{#2} \rnode[11.25mm]{Q3}{Q2}{}
\rcor[7.5mm]{U2}{T1}{#2} \rnode[11.25mm]{U3}{U2}{}
\rnode[22.5mm]{Q4}{Q2}{} \urmat[7.5mm]{S4}{Q4}{#3}
\rnode[22.5mm]{U4}{U2}{} \urmat[7.5mm]{T4}{U4}{#3}
%
\draw (Q2) -- (U2);
\veceyet[4.5mm]{S1}{T1} \veceye[0mm]{$(S1)-(10mm,0mm)$}{$(T1)-(10mm,0mm)$}
\veceyet[4.5mm]{S4}{T4} \veceye[0mm]{$(S4)-(10mm,0mm)$}{$(T4)-(10mm,0mm)$}
\ringup{$(S1)-(10mm,0mm)$}{S4}
\ringdown{$(T1)-(10mm,0mm)$}{T4}
%
\draw ($(U3)-(0mm,4mm)$) -- ($(Q3)+(0mm,4mm)$);
\draw[rounded corners] (Q2) -- ($(Q2)+(7.5mm,0mm)$) -- ($(Q2)+(7.5mm, 4mm)$);
\draw[rounded corners] (U2) -- ($(U2)+(7.5mm,0mm)$) -- ($(U2)+(7.5mm,-4mm)$);
\draw[rounded corners] ($(S4)-(10mm,0mm)$) -- ($(Q4)-(7.5mm,0mm)$)
                                           -- ($(Q4)-(7.5mm,-4mm)$);
\draw[rounded corners] ($(T4)-(10mm,0mm)$) -- ($(U4)-(7.5mm,0mm)$)
                                           -- ($(U4)-(7.5mm,4mm)$);
}}

%%%
%%% iTR1c: frame matrix (orthogonality 3)
%%%
\newcommand{\mytikziTRframeorthC}[3][-5mm]{%
