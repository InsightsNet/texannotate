\blegt{X} \brphind{X}{#4}
\rleg{X}  \artind{$(X)+(3.5mm,0mm)$}{#5}
}}

%%%
%%% TMT product with indices
%%%
\newcommand{\mytikzTMTind}[8][-0.75mm]{%
\tikz[on grid,baseline=#1]{%
\clip (-6.1mm,-6.2mm) rectangle (22.2mm,2.7mm);
