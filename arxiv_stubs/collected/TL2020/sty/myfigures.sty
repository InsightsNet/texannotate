\clip (-7mm,-6.7mm) rectangle (29mm,6.5mm);
\fnode{C1}{}           \oper[minimum width=8mm]{M1}{(C1)}{#2}
\rnode[11mm]{C2}{M1}{} \oper[minimum width=8mm]{M2}{(C2)}{#2}
\rnode[11mm]{C3}{M2}{} \oper[minimum width=8mm]{M3}{(C3)}{#2}
\bleg[5mm]{M1} \aleg[5mm]{M1} \draw[densely dotted] (M1) -- ($(M1)-(7mm,0mm)$);
\bleg[5mm]{M2} \aleg[5mm]{M2} \draw[densely dotted] (M1) -- (M2) -- (M3);
\bleg[5mm]{M3} \aleg[5mm]{M3} \draw[densely dotted] (M3) -- ($(M3)+(7mm,0mm)$);
\brtind{$(M1)-(0mm,4mm)$}{$j_{#3}$} \brtind{$(M1)+(0mm,7mm)$}{$i_{#3}$}
\brtind{$(M2)-(0mm,4mm)$}{$j_{#4}$} \brtind{$(M2)+(0mm,7mm)$}{$i_{#4}$}
\brtind{$(M3)-(0mm,4mm)$}{$j_{#5}$} \brtind{$(M3)+(0mm,7mm)$}{$i_{#5}$}
}}

%%%
%%% exp(-Mt)
%%%
\newcommand{\mytikzexpMt}[8][-0.85mm]{%
\tikz[baseline=#1]{%
\clip (-11mm,-6.7mm) rectangle (61mm,6.5mm);
\fnode{C1}{}           \bleg[5mm]{C1} \aleg[5mm]{C1} \ulinf[9mm]{linf}{C1}
\rnode[10mm]{C2}{C1}{} \bleg[5mm]{C2} \aleg[5mm]{C2}
\rnode[10mm]{C3}{C2}{} \bleg[5mm]{C3} \aleg[5mm]{C3}
\rnode[10mm]{C4}{C3}{} \bleg[5mm]{C4} \aleg[5mm]{C4}
\rnode[10mm]{C5}{C4}{} \bleg[5mm]{C5} \aleg[5mm]{C5}
\rnode[10mm]{C6}{C5}{} \bleg[5mm]{C6} \aleg[5mm]{C6} \urinf[9mm]{rinf}{C6}
\oper[minimum width=15mm]{M1}{($0.5*(C1)+0.5*(C2)$)}{#2}
\oper[minimum width=15mm]{M2}{($0.5*(C3)+0.5*(C4)$)}{#2}
\oper[minimum width=15mm]{M3}{($0.5*(C5)+0.5*(C6)$)}{#2}
\draw[densely dotted] (linf) -- (M1) -- (M2) -- (M3) -- (rinf);
\brtind{$(C1)-(0mm,4mm)$}{$j_{#3}$} \brtind{$(C1)+(0mm,7mm)$}{$i_{#3}$}
\brtind{$(C2)-(0mm,4mm)$}{$j_{#4}$} \brtind{$(C2)+(0mm,7mm)$}{$i_{#4}$}
\brtind{$(C3)-(0mm,4mm)$}{$j_{#5}$} \brtind{$(C3)+(0mm,7mm)$}{$i_{#5}$}
\brtind{$(C4)-(0mm,4mm)$}{$j_{#6}$} \brtind{$(C4)+(0mm,7mm)$}{$i_{#6}$}
\brtind{$(C5)-(0mm,4mm)$}{$j_{#7}$} \brtind{$(C5)+(0mm,7mm)$}{$i_{#7}$}
\brtind{$(C6)-(0mm,4mm)$}{$j_{#8}$} \brtind{$(C6)+(0mm,7mm)$}{$i_{#8}$}
}}

