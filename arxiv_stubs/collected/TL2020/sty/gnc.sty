% Macros for common guidance, navigation, and control mathematical symbols. 
% Particularly designed with estimaton and Kalman filtering derivations in mind.
% 
% Originally created by Daniel Whitten, 2017
% Sandia National Laboratories, org 5442 Navigation Guidance & Control 1
% Latest at https://gitlab.sandia.gov/wdwhitt/gnc-latex-style

\NeedsTeXFormat{LaTeX2e}[1994/06/01]
\ProvidesPackage{gnc}[2013/01/13 Custom Package]

\RequirePackage{xparse}
\RequirePackage{tensor}
\RequirePackage{amsmath}
\usepackage{ifthen}

\NewDocumentCommand{\trans}{} {
	{}^{\mathrm{T}}
}

\NewDocumentCommand{\inv}{} {
	{}^{-1}
}

\NewDocumentCommand{\mathRmBf}{m} {
	\boldsymbol{\mathrm{#1}}
}

\newcommand\numberthis{\addtocounter{equation}{1}\tag{\theequation}}


\NewDocumentCommand{\zero}{oo} {
	\mathbf{0}_{#1\times#2}
}
\NewDocumentCommand{\expect}{m} {
	E\{#1\}
}

\NewDocumentCommand{\normDistr}{mm} {
	\sim N(#1,#2)
}

\NewDocumentCommand{\diag}{m} {
	\mathrm{diag}(#1)
}

\def \eye {\mathrm{I}}
\def \zeroMat {\stdMat{0}}

\def \quatMult {\otimes}


%eqref
\NewDocumentCommand{\eqRefL}{m} {
	eq.~\eqref{eq:#1}
}

\NewDocumentCommand{\figRef}{m} {
	fig.~\ref{fig:#1}
}

% quat
\NewDocumentCommand{\quat}{O{}O{}O{\bar{q}}}{
    \tensor*[^{#2}_{#1}]{#3}{}
}

\NewDocumentCommand{\stdMat}{mO{}O{}O{}} {
	\tensor*[^{#2}]{\mathrm{#1}}{^{#4}_{#3}}
}


% stdvec
% print a formmated vector with options for reference frame, subscript, and superscript
\NewDocumentCommand{\stdVec}{mO{}O{}O{}} {
	\tensor*[^{#2}]{\mathRmBf{#1}}{^{#4}_{#3}}
}

\NewDocumentCommand{\stdVecDot}{mO{}O{}O{}} {
	\tensor*[^{#2}]{\dot{\mathRmBf{#1}}}{^{#4}_{#3}}
}


% unitvec
% print a formmated unit vector with options for reference frame, subscript, and superscript
\NewDocumentCommand{\unitVec}{mO{}O{}O{}} {
	\stdVecHat{#1}[#2][#3][#4]
}

\NewDocumentCommand{\stdVecHat}{mO{}O{}O{}} {
	\tensor*[^{#2}]{ \hat{\mathRmBf{#1}} }{^{#4}_{#3}}
}

\NewDocumentCommand{\stdVecHatDot}{mO{}O{}O{}} {
	\tensor*[^{#2}]{ \dot{\hat{\mathRmBf{#1}}} }{^{#4}_{#3}}
}

\NewDocumentCommand{\stdVecTilde}{mO{}O{}O{}} {
	\tensor*[^{#2}]{ \tilde{\mathRmBf{#1}} }{^{#4}_{#3}}
}

\NewDocumentCommand{\stdVecTildeDot}{mO{}O{}O{}} {
	\tensor*[^{#2}]{ \dot{\tilde{\mathRmBf{#1}} } }{^{#4}_{#3}}
}

\NewDocumentCommand{\stdTensor}{mO{}O{}O{}} {
	\tensor*[^{#2}]{\mathRmBf{#1}}{^{#4}_{#3}}
}

% dcm
%
\NewDocumentCommand{\dcm}{O{}O{}} {
	\tensor*[^{#2}_{#1}]{\mathRmBf{C}}{}
}

\NewDocumentCommand{\dcmEulerOne}{m} {
	\begin{bmatrix}
		1 & 0 & 0 \\
		0 & \cos(#1) & \sin{#1} \\
		0 & -\sin(#1) & \cos(#1)
	\end{bmatrix}
}

\NewDocumentCommand{\dcmEulerTwo}{m} {
	\begin{bmatrix}
		\cos(#1) & 0 & -\sin(#1) \\
		0 & 1 & 0 \\
		\sin(#1) & 0 & \cos(#1)
	\end{bmatrix}
}

\NewDocumentCommand{\dcmEulerThree}{m} {
	\begin{bmatrix}
		\cos(#1) & \sin(#1) & 0 \\
		-\sin(#1) & \cos(#1) & 0\\
		0 & 0 & 1
	\end{bmatrix}
}

\NewDocumentCommand{\dcmHat}{O{}O{}} {
	\tensor*[^{#2}_{#1}]{\mathRmBf{\hat{C}}}{}
}

\NewDocumentCommand{\dcmDot}{O{}O{}} {
	\tensor*[^{#2}_{#1}]{\mathRmBf{\dot{C}}}{}
}

\NewDocumentCommand{\dcmHatDot}{O{}O{}} {
	\tensor*[^{#2}_{#1}]{\mathRmBf{\dot{\hat{C}}}}{}
}

\NewDocumentCommand{\rtm}{O{}O{}} {
	\tensor*[^{#2}_{#1}]{\mathrm{R}}{}
}

\NewDocumentCommand{\rtmHat}{O{}O{}} {
	\tensor*[^{#2}_{#1}]{\mathrm{\hat{R}}}{}
}

% skewsym
%
\NewDocumentCommand{\skewSym}{m} {
	\lfloor #1 \ \times \rfloor
}

% rowvec
% print a row vector filled by inputs
\ExplSyntaxOn

\NewDocumentCommand{\rowVec}{m}
 {
  \seq_set_split:Nnn \l_tmpa_seq { , } { #1 }
  \begin{bmatrix}
  \seq_use:Nn \l_tmpa_seq { & }
  \end{bmatrix}
 }
 \ExplSyntaxOff

 % rowvectrans
 % print a row vector filled by inputs
 \ExplSyntaxOn

 \NewDocumentCommand{\colVecTrans}{m}
  {
   \seq_set_split:Nnn \my_seq { , } { #1^T }
   \begin{bmatrix}
   \seq_use:Nn \my_seq { ^\mathrm{T}& }
   \end{bmatrix}^T
  }
  \ExplSyntaxOff

 % colvec
 % print a row vector filled by inputs
 \ExplSyntaxOn

 \NewDocumentCommand{\colVec}{m}
  {
   \seq_set_split:Nnn \l_tmpa_seq { , } { #1 }
   \begin{bmatrix}
   \seq_use:Nn \l_tmpa_seq { \\ }
   \end{bmatrix}
  }
  \ExplSyntaxOff

\def \dRm {\mathrm{d}}
\def \timeDer {\dfrac{\dRm}{\dRm t}}
