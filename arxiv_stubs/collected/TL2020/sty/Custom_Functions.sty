\newcommand{\InputFig}[4]{%
	\begin{figure}
		\centering
		\graphicspath{{./Images/}}
		\includegraphics[width=#2mm]{#1}
		\caption{#3}
		#4
	\end{figure}
}


\newcommand{\InputFigCombine}[4]{%
	\begin{figure*}
		\centering
		\graphicspath{{./Images/}}
		\includegraphics[width=#2mm]{#1}
		\caption{#3}
		#4
	\end{figure*}
}
















