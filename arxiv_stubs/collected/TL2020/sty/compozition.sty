%\Cgrid[->]{0.5}{11}{11}{4,5}

\newrobustcmd{\Cgrid}[5][->]{
\foreach \x in {0,#2,...,#3}
\draw[#1] ($(#5)+(XYshift)$)  [xshift=-\x cm, yshift=\x cm]  +($(-0.5,-#3-0.5)$) -- +($(#3+0.5,0.5)$);
\foreach \x in {0,#2,...,#4}
\draw[#1]  ($(#5)+(XYshift)$) [xshift=\x cm, yshift=\x cm] +($(0.5,-#3-0.5)$) -- +($(-#3-0.5,0.5)$);
}

