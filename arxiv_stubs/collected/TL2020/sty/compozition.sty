\draw[-*,-<-=.5] (right) to [out=#5, in=0.5*#3+90+0.5*#5] ($(bmiddle)!1.5pt!(middle)$);
\path ($(bmiddle)!-1.5pt!(middle)$) to node[#1=0.09] (fontlocation){} ($(bmiddle)!1.5pt!(middle)$);  }


