\draw[shift={($(#2)+(XYshift)$)}, thin, scale=#1] + (0,-1) -- +(0,-4); %body
\draw[shift={($(#2)+(XYshift)$)}, thin, scale=#1] + (-1.5,-3.5) -- + (0,-1.25) -- + (1.5, -3.5); %arms
\draw[shift={($(#2)+(XYshift)$)}, thin, scale=#1] + (-1.85,-7) --  + (-1.5, -7) -- + (0, -4) -- + (1.5, -7) -- +(1.85,-7) ; %legs
}


