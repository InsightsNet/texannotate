	\newcommand{\textfillwidthof}[3][l]{%								\textfillwidthof[pos]{textToReplace}{textToPrint}
		\hspace*{0pt}%
		\settowidth\@myLength{#2}%
		\ifx#1c%
			\setlength\@myLength{.5\@myLength}%
			\hspace*{\@myLength}%
			\clap{#3}%
			\hspace*{\@myLength}%
		\else\ifx#1l%
			\rlap{#3}%
			\hspace*{\@myLength}%
		\else\ifx#1r%
			\hspace*{\@myLength}%
			\llap{#3}%
		\fi\fi\fi%
	}%

	\newcommand{\mathfillwidthof}[3][l]{%								\fillwidthof[pos]{textToReplace}{textToPrint}
		\mathchoice{
			\textfillwidthof[#1]{$\m@th{\displaystyle #2}$}{$\m@th{\displaystyle #3}$}
		}{
			\textfillwidthof[#1]{$\m@th{#2}$}{$\m@th{#3}$}
		}{
			\textfillwidthof[#1]{$\m@th{\scriptstyle #2}$}{$\m@th{\scriptstyle #3}$}
		}{
			\textfillwidthof[#1]{$\m@th{\scriptscriptstyle #2}$}{$\m@th{\scriptscriptstyle #3}$}
		}
	}
	
	\newcommand{\fillwidthof}[3][l]{%
		\ifmmode
			\mathfillwidthof[#1]{{}#2{}}{{}#3{}}%
		\else
			\textfillwidthof[#1]{#2}{#3}%
		\fi
	}

	\newcommandx\limsubstack[1]{{%  \lim_{\limsubstack{w&\to&x\\w&\neq&x}}...
		\renewcommand\arraystretch{0.5}%
		\begin{array}{>{\scriptstyle}r >{\scriptstyle{}}c<{{}} >{\scriptstyle}l}#1\end{array}%
	}}

	%% Horizontal braces and brackets
	% redefine optional argument for under/overbracket
	\let\oldoverbracket\overbracket
	\let\oldunderbracket\underbracket
	\let\oldoverbrace\overbrace
	\let\oldunderbrace\underbrace
	\newcommand\@overbracket[2][0.5pt]{%
		\oldoverbracket[#1]{#2}%
	}
	\newcommand\@underbracket[2][0.5pt]{%
		\oldunderbracket[#1]{#2}%
	}
	% define star versions as smashed
	\def\underbracket{\@ifstar\@smashunderbracket\@underbracket}
	\def\overbracket{\@ifstar\@smashoverbracket\@overbracket}
	\def\underbrace{\@ifstar\@smashunderbrace\oldunderbrace}
	\def\overbrace{\@ifstar\@smashoverbrace\oldoverbrace}
	% define smashed versions
	\newcommand{\@smashoverbracket}[2][0.5pt]{%
		\def\@optarg{#1}%
		\def\@arg{#2}%
		\def\@command{%
			\vphantom{\@arg}%
			\smash{\@overbracket[\@optarg]{\@arg}_{\@subarg}^{\@suparg}}%
		}%
		\@getscripts%
	}
	\newcommand{\@smashunderbracket}[2][0.5pt]{%
		\def\@optarg{#1}%
		\def\@arg{#2}%
		\def\@command{%
			\vphantom{\@arg}%
			\smash{\@underbracket[\@optarg]{\@arg}_{\@subarg}^{\@suparg}}%
		}%
		\@getscripts%
	}
	\newcommand{\@smashoverbrace}[1]{%
		\def\@arg{#1}%
		\def\@command{%
			\vphantom{\@arg}%
			\smash{\overbrace{\@arg}_{\@subarg}^{\@suparg}}%
		}%
		\@getscripts%
	}
	\newcommand{\@smashunderbrace}[1]{%
		\def\@arg{#1}%
		\def\@command{%
			\vphantom{\@arg}%
			\smash{\underbrace{\@arg}_{\@subarg}^{\@suparg}}%
		}%
		\@getscripts%
	}


