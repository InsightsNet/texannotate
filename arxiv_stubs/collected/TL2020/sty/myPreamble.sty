\StrSubstitute{\myPreamble@excludethm}{ }{,}[\myPreamble@excludethmList]
\IfStrEq{\myPreamble@excludethm}{all}{}{%
	\theoremstyle{plain}
	% foreach \x/\y/\z creates problem with expansion when defining \enum\y i
	\IfStrEq{\myPreamble@thmreset}{never}{%
		\CreateNewTheorem{dummythm}{DummyTheorem}
	}{
		\CreateNewTheorem{dummythm}{DummyTheorem}[\myPreamble@thmreset]
	}
	\ifmyPreamble@capitalize
		\def\myPreamble@crefname#1#2{#2}
	\else
		\ifmyPreamble@abbr
			\def\myPreamble@crefname#1#2{#1}
		\else
			\def\myPreamble@crefname#1#2{\MakeLowercase#2}
		\fi
	\fi
	\IfSubStr{,\myPreamble@excludethmList,}{,thm,}{}{%
		\CreateNewTheorem[\myPreamble@crefname{Thm.}{Theorem}]{thm}[dummythm]{Theorem}
	}
	\IfSubStr{,\myPreamble@excludethmList,}{,defin,}{}{%
		\CreateNewTheorem[\myPreamble@crefname{Def.}{Definition}]{defin}[dummythm]{Definition}
	}
	\IfSubStr{,\myPreamble@excludethmList,}{,prop,}{}{%
		\CreateNewTheorem[\myPreamble@crefname{Prop.}{Proposition}]{prop}[dummythm]{Proposition}
	}
	\IfSubStr{,\myPreamble@excludethmList,}{,cor,}{}{%
