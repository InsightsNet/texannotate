	% An \includegraphics-like command for tikz/pgfplots pictures.
	% USAGE:
	%	Save the tikz/pgfplots code inclusive of \begin{tikzpicture}... in TeX/Tikz
	%	with extension .tex, e.g. "TeX/Tikz/myTikzCode.tex".
	%	Now simply use
	%
	% >		\includetikz[options]{myTikzCode}
	%
	%	[options] are the same as for \includegraphics (width, scale, height, ...)
	%	Notice: only the file name WITHOUT extension
	%	The tikz picture will be externalized in Pics/Tikz as myTikzCode.pdf
	%	and as long as the source is not changed, it will not be compiled again.
	%
	\@ifpackageloaded{pgfplots}{%
		\pgfplotsset{compat=1.10}
	}{}
	\@ifpackageloaded{tikz}{%
		\usetikzlibrary{external}
		\tikzsetexternalprefix{Pics/Tikz/}
		\tikzexternalize
		\newcommandx{\includetikz}[3][1={},3={}]{{{%
			\pgfkeys{/pgf/images/include external/.code={\includegraphics[#1]{##1}}}%
			\ifstrempty{#3}{%
				\tikzsetnextfilename{#2}%
			}{%
				\tikzsetnextfilename{#3}%
			}%
			\input{./TeX/Tikz/#2.tex}%
		}}}
%	when you want to (e.g.) upload on arxiv, uncomment the following
%	\renewcommand\includetikz[2][]{\includegraphics[#1]{Pics/Tikz/#2}}%
		\tikzset{
			invisible/.style={opacity=0},
			visible on/.style={alt={#1{}{invisible}}},
			alt/.code args={<#1>#2#3}{%
			\alt<#1>{\pgfkeysalso{#2}}{\pgfkeysalso{#3}} % \pgfkeysalso doesn't change the path
			},
		}
	}{}



