			\renewcommand\intertext[1]{\global\myPreamble@overwrite@false\OLDintertext{##1}}%
			\renewcommand\shortintertext[1]{\global\myPreamble@overwrite@false\OLDshortintertext{##1}}%
			\renewcommand\numberthis{\global\myPreamble@overwrite@true\OLDnumberthis}%
			%
			\myPreamble@overwrite@false%
			\par\noindent%
			\begin{minipage}[b]{\linewidth}%
				\vspace*{0pt}%
				\setlength\belowdisplayshortskip{0pt}%
				\setlength\belowdisplayskip{0pt}%
				\begin{align*}
					\BODY
				\end{align*}
				\vspace*{0pt}%
			\end{minipage}%
			\llap{\qedsymbol}\hspace*{0pt}%
			\par
			\hrule height 0pt\relax
			%
			\ifmyPreamble@overwrite@
				\iftagsleft@\relax\else
					\PackageWarning{myPreamble}{%
						document is in right-equation mode; `numberthis' in last line might produce unwanted results.
						Consider removing equation tag in last line.
					}%
				\fi
			\fi
		}%
		\AfterEndEnvironment{qedalign*}{\let\qedsymbol\relax}
		%
		\NewEnviron{qedalign}{%
			% https://tex.stackexchange.com/a/234320/21001
			\let\OLDhalign\halign
			\def\halign{%
