\def\myPreamble@date{2019/05/07}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%% OPTIONS %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% abbr       : defines cref-labels as abbreviations
% bibsection : whether to add phantomsection before \bibliography
% capitalize : defines cref-labels as Cref-labels in theorems
% eqreset	 : when to reset equation counter
% excludethm : which default theorems not to load
% metadata	 : whether to automatically generate pdftitle and pdfauthor in hypersetup
% noload	 : which packages not to load
% noqed		 : suppress qed at the end of remarks
% thmreset	 : when to reset theorem counter
% version	 : required package version (for compatibility)

\RequirePackage{kvoptions}
\RequirePackage{kvsetkeys}

\DeclareStringOption[]{version}[]
\DeclareStringOption[]{eqreset}[section]%
\DeclareStringOption{excludethm}
\DeclareStringOption[never]{thmreset}[section]%
\DeclareStringOption{noload}
\DeclareBoolOption[false]{abbr}
\DeclareBoolOption[true]{capitalize}
\DeclareBoolOption[true]{metadata}
\DeclareBoolOption[false]{noqed}
\DeclareBoolOption[true]{bibsection}


\DeclareDefaultOption{\PackageWarningNoLine{myPreamble}{Unknown option `\CurrentOption'}}

\SetupKeyvalOptions{
	family=myPreamble,
	prefix=myPreamble@,
	setkeys=\kvsetkeys,
}
\ProcessKeyvalOptions*\relax

