%%%% GET SUB/SUPERscripts %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
	\def\@command{}
	\def\@getscripts{%
		\let\@subarg\relax
		\let\@suparg\relax
		\@getscripts@testsub%
	}
	
	% Check subscript
	% (the @b variants don't check the other case)
	\def\@getscripts@testsub{\@ifnextchar_\@getscripts@sub\@getscripts@testsup}

	% Check superscript
	% (the @b variants don't check the other case)
	\def\@getscripts@testsup{\@ifnextchar^\@getscripts@sup\@getscripts@testsub@b}

	% Store subscript and check superscript (if not already defined)
	\def\@getscripts@sub_#1{%
		\def\@subarg{#1}%
		\ifx\@suparg\relax
			\expandafter\@getscripts@testsup@b
		\else
			\expandafter\@command
		\fi
	}

	% Store superscript and check subscript (if not already defined)
	\def\@getscripts@sup^#1{%
		\def\@suparg{#1}%
		\ifx\@subarg\relax
			\expandafter\@getscripts@testsub@b
		\else
			\expandafter\@command
		\fi
	}

	% Check for subscript and then concludes
	\def\@getscripts@testsub@b{%
		\ifx\@suparg\relax
			\def\@suparg{\@empty}
		\fi
		\@ifnextchar_\@getscripts@sub\@command%
	}

	% Check for superscript and then concludes
	\def\@getscripts@testsup@b{%
		\ifx\@subarg\relax
			\def\@subarg{\@empty}
		\fi
		\@ifnextchar^\@getscripts@sup\@command%
	}
