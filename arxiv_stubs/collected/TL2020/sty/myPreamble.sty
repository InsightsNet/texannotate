	%%%%
	% Shifts overlays inside scope (useful for tikz pictures!)
	% https://tex.stackexchange.com/a/318257/21001
	\newcommand\shiftoverlay[1]{%
		\advance\beamer@slideinframe by #1%
	}%
	% To externalize appending overlay number to filename
	% (compatible with \shiftoverlay: no re-externalization)
	% http://tex.stackexchange.com/a/119440/21001
		\newcommand*{\overlaynumber}{\number\beamer@slideinframe}
		\@ifpackageloaded{tikz}{%
			\tikzset{%
				beamer externalizing/.style={%
					execute at end picture={%
						\tikzifexternalizing{%
							\ifbeamer@anotherslide
								\pgfexternalstorecommand{\string\global\string\beamer@anotherslidetrue}%
							\fi
						}{}%
					}%
				},
				external/optimize=false
			}
			\let\orig@tikzsetnextfilename=\tikzsetnextfilename
			\renewcommand\tikzsetnextfilename[1]{\orig@tikzsetnextfilename{#1-\overlaynumber}}
			\tikzset{every picture/.style={beamer externalizing}}
		}{}
	}{}
