			\let\OLDshortintertext\shortintertext%
			\let\OLDnotag\notag%
			\let\OLDnonumber\nonumber%
			\renewcommand\intertext[1]{\OLDintertext{##1}\global\myPreamble@overwrite@true}%
			\renewcommand\shortintertext[1]{\OLDshortintertext{##1}\global\myPreamble@overwrite@true}%
			\renewcommand\notag{\OLDnotag\global\myPreamble@overwrite@false}%
			\renewcommand\nonumber{\OLDnonumber\global\myPreamble@overwrite@false}%
			%
			\myPreamble@overwrite@true%
			\par\noindent%
			\begin{minipage}[b]{\linewidth}%
				\vspace*{0pt}%
				\setlength\belowdisplayshortskip{0pt}%
				\setlength\belowdisplayskip{0pt}%
				\begin{align}
					\BODY
				\end{align}
			\end{minipage}%
			\llap{\qedsymbol}\hspace*{0pt}%
			\par
			\hrule height 0pt\relax
			%
			\ifmyPreamble@overwrite@
				\iftagsleft@\relax\else
					\PackageWarning{myPreamble}{%
						document is in right-equation mode; `qedalign' might produce unwanted results.
						Consider removing equation tag in last line.
					}%
				\fi
			\fi
		}%
		\AfterEndEnvironment{qedalign}{\let\qedsymbol\relax}
	}{
		\newenvironment{qedequation}{\equation}{%
			\endequation%
			\PackageWarning{myPreamble}{add \protect\usepackage{environ} for using qedequation}%
		}
		\newenvironment{qedequation*}{\csname equation*\endcsname}{%
