%% Fancy frames
%  https://tex.stackexchange.com/a/346365/21001
%  --------------------------------------------
	\@ifpackageloaded{stackengine}{%
		\newcommand\fancyframecornerpicture{Pics/vines_corner.png}
		\newlength\@framewidth
		\newlength\@contentwidth
		\def\fancyframeprop{.25}
		\@ifpackageloaded{environ}{%
			\NewEnviron{fancyframe}[1][.4]{% fancyframe[offset]{content}
				\par\noindent
				\pgfmathsetmacro\lwratio{1 / (1 + 2 * #1 * \fancyframeprop)}%
				\setlength\@contentwidth{\lwratio\linewidth}%
				\IfFileExists{\fancyframecornerpicture}{%
					\setbox0=\hbox{\parbox{\@contentwidth}{\BODY}}%
					\setlength\@framewidth{\fancyframeprop\@contentwidth\relax}%
					\savestack\corner{\includegraphics[width=\@framewidth]{\fancyframecornerpicture}}%
					\hspace{#1\@framewidth}%
					\stackinset{l}{-#1\@framewidth}{t}{}{\corner}{%
						\stackinset{r}{-#1\@framewidth}{t}{-#1\@framewidth}{\rotatebox{-90}{\corner}}{%
							\stackinset{l}{-#1\@framewidth}{b}{}{\rotatebox{90}{\corner}}{%
								\stackinset{r}{-#1\@framewidth}{b}{-#1\@framewidth}{\rotatebox{180}{\corner}}{%
									\copy0%
								}%
							}%
						}%
					}%
					\hspace{#1\@framewidth}%
				}{%
					{\centering
						\fbox{\parbox{\@contentwidth}{\BODY}}
					\par}%
					\PackageWarning{myPreamble}{%
						File '\fancyframecornerpicture' not found, no frame produced.
						To change picture location, redefine \protect\fancyframecornerpicture%
					}%
				}%
			}%
		}{%
			\newcommand\fancyframe[2][.4]{% fancyframe[offset]{content}
				\par\noindent
				\pgfmathsetmacro\lwratio{1 / (1 + 2 * #1 * \fancyframeprop)}%
				\setlength\@contentwidth{\lwratio\linewidth}%
				\IfFileExists{\fancyframecornerpicture}{%
					\setbox0=\hbox{\parbox{\@contentwidth}{#2}}%
					\setlength\@framewidth{\fancyframeprop\@contentwidth\relax}%
					\savestack\corner{\includegraphics[width=\@framewidth]{\fancyframecornerpicture}}%
					\hspace{#1\@framewidth}%
					\stackinset{l}{-#1\@framewidth}{t}{}{\corner}{%
						\stackinset{r}{-#1\@framewidth}{t}{-#1\@framewidth}{\rotatebox{-90}{\corner}}{%
							\stackinset{l}{-#1\@framewidth}{b}{}{\rotatebox{90}{\corner}}{%
								\stackinset{r}{-#1\@framewidth}{b}{-#1\@framewidth}{\rotatebox{180}{\corner}}{%
									\copy0%
								}%
							}%
						}%
					}%
					\hspace{#1\@framewidth}%
				}{%
					{\centering
						\fbox{\parbox{\@contentwidth}{#2}}
					\par}%
					\PackageWarning{myPreamble}{%
						File '\fancyframecornerpicture' not found, no frame produced.
						To change picture location, redefine \protect\fancyframecornerpicture%
					}%
				}%
			}%
		}%
	}{}
