\@ifpackageloaded{clevethm}{}{%
	\def\CreateNewTheorem{}%
	\renewcommandx\CreateNewTheorem[5][{1={}},{3={}},{5={}}]{%
		\ifstrempty{#3}{%
			\ifstrempty{#5}{%
				\newtheorem{#2}{#4}%
			}{%
				\newtheorem{#2}{#4}[#5]%
			}%
		}{%
			\ifstrempty{#5}{%
				\newtheorem{#2}[#3]{#4}%
			}{%
				\newtheorem{#2}[#3]{#4}[#5]%
			}%
		}
	}
	
	\@ifpackageloaded{enumitem}{%
		\newlist{enumeratass}{enumerate}{1}
		\newlist{enumerateq}{enumerate}{1}
		\newlist{enumerator}{enumerate}{1}
		\newlist{enumeratprop}{enumerate}{1}
		\setlist[enumerateq,1]{%
			label=\textit{(\alph*)},
			ref=\textit{(\alph*)},
			itemsep=3pt,
			labelwidth=\widthof{\textit{(mm)}},
			leftmargin=\widthof{\textit{(mm)}\hspace{\labelsep}},
	%		\clevethm@enumeq
		}
		\setlist[enumerator]{%
			label=\textit{(\greek*)},
			ref=\textit{(\greek*)},
			itemsep=3pt,
			labelwidth=\widthof{\textit{(10)}},
			leftmargin=\widthof{\textit{(10)}\hspace{\labelsep}},
	%		\clevethm@enumor
		}
		\setlist[enumeratass]{%
			label={{\sc a\oldstylenums{\arabic*}}},
			ref={{\sc a\oldstylenums{\arabic*}}},
			itemsep=3pt,
			labelwidth=\widthof{{\sc a\oldstylenums{8}}},
			leftmargin=\widthof{{\sc a\oldstylenums{8}}\hspace{\labelsep}},
	%		\clevethm@enumass
		}
		\setlist[enumeratprop]{%
			label={{\sc p\oldstylenums{\arabic*}}},
			ref={{\sc p\oldstylenums{\arabic*}}},
			itemsep=3pt,
			labelwidth=\widthof{{\sc p\oldstylenums{8}}},
			leftmargin=\widthof{{\sc p\oldstylenums{8}}\hspace{\labelsep}},
	%		\clevethm@enumass
		}
	}{
		\newenvironment{enumerateq}{% equivalent statements
			\begin{enumerate}%
				\renewcommand\theenumi{\textit{(\alph*)}}%
		}{\end{enumerate}}
		%
		\newenvironment{enumeratass}{% assumptions
			\begin{enumerate}%
				\renewcommand\theenumi{{\sc a\oldstylenums{\arabic{enumi}}}}%
		}{\end{enumerate}}
		%
		\newenvironment{enumeratprop}{% properties
			\begin{enumerate}%
				\renewcommand\theenumi{{\sc p\oldstylenums{\arabic{enumi}}}}%
		}{\end{enumerate}}
		%
		\newenvironment{enumerator}{% either-or statements
			\begin{enumerate}%
				\renewcommand\theenumi{\textit{(\greek*)}}%
		}{\end{enumerate}}
	}
}

