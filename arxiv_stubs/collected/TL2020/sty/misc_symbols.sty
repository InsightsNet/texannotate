\usepackage{bm} 



%% Bold alphabets %%
\newcommand{\ab}{\bm{a}}
\newcommand{\bb}{\bm{b}}
\newcommand{\cb}{\bm{c}}
\newcommand{\eb}{\bm{e}}
\newcommand{\fb}{\bm{f}}
\newcommand{\pb}{\bm{p}}
\newcommand{\rb}{\bm{r}}
\newcommand{\xb}{\bm{x}}
\newcommand{\yb}{\bm{y}}
\newcommand{\zb}{\bm{z}}


%% Bold symbols %%
\newcommand{\thetab}{\boldsymbol{\theta}}

%% Bar on top %%
\newcommand{\abar}{\bar{a}}
\newcommand{\xbar}{\bar{x}}
\newcommand{\ybar}{\bar{y}}
