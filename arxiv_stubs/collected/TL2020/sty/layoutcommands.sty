\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{layoutcommands}[2011/01/15 My other commands] 

\RequirePackage{framed}
\RequirePackage[shortcuts]{extdash}


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%  spacing issues
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\let\originalleft\left
\let\originalright\right
\renewcommand{\left}{\mathopen{}\mathclose\bgroup\originalleft}
\renewcommand{\right}{\aftergroup\egroup\originalright}


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%  environments for framed boxes
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newenvironment{boxenv}
 {\begin{minipage}{\textwidth}
    \small
    \begin{framed}
      \smallskip
 }
 {  \end{framed}
  \end{minipage}
 }

% takes a title as argument
\newenvironment{boxenvtitle}[1]
 {\begin{minipage}{\textwidth}
    \small
    \begin{framed}
      \centering
      \smallskip
      \textbf{\large #1}
      \smallskip
 }
 {  \end{framed}
  \end{minipage}
 }


