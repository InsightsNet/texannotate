% wgroup_switch.sty
%
% Authors: Watcharapan Suwansantisuk (Ae)
%
% Purposes: Provides commands to switch among different pieces of text
% 
% Installation: Put this style file (wgroup_switch.sty) in a local
%    Latex tree directory, such as
%
%       /Users/Ae/Library/texmf/tex/latex/wgroup/
%
%    Create directories, if needed.
%
% Description:
%    To load a package, put "\usepackage{wgroup_switch}" before the 
%    \begin{document}
%
%     Available commands are
%       \setswitchA{...a number...}  
%                   Set the value of switch A to be the given number
%       \showifAeq{...a number...}{...a text...}
%                   Show the given text if the value of switch A
%                   equals the given number
%       \switchAtwo{...text 1...}{...text 2...}
%                   Show text 1 if the value of switch A is 1; 
%                   Show text 2 if the value of switch A is 2
%       \switchAthree{...text 1...}{...text 2...}{...text 3...}
%                   Show text 1 if the value of switch A is 1; 
%                   Show text 2 if the value of switch A is 2
%                   Show text 3 if the value of switch A is 3
%       There are analogous command for switch B and switch C:
%           \setswitchB         \setswitchC
%           \showifBeq          \showifCeq
%           \switchBtwo         \switchCtwo
%           \switchBthree       \switchCthree
%
% History:
%    Jan 25, 2012 -- Ae created this file according to the specifications from Prof. Win
%    Jan 29, 2012 -- Ae renames switch to "switcha" and add "switchb"
%    Feb  1, 2012 -- Ae renames the commands to "switchA" and "switchB"
%    Jun 22, 2012 -- Ae created a style file (.sty)
%    Jun 10, 2014 -- Ae added LateX commands for switchC

\ProvidesPackage{wgroup_switch}[2014/06/10 Wgroup Switch package]

%==============================%
% interval counter and command %
%==============================%
\newcommand{\wgroupSwitchCounterDefaultValue}{1}  % default value of the switch


%==============================%
% commands for switch a        %
%==============================%

\newcounter{wgroupSwitchACounter}    % a counter is used to indicate the switch level
\setcounter{wgroupSwitchACounter}{\wgroupSwitchCounterDefaultValue}  % set the level to its default value

%------------------------------%
% commands for users to use    %
%------------------------------%

%-----------
% Set a switch to a given level
%
% Example: \setswitchA{1}
\newcommand{\setswitchA}[1]{\setcounter{wgroupSwitchACounter}{#1}}

%-----------
% Show the message if the value of the switch equals the given value, otherwise display an empty text
%
% Example: \showifAeq{1}{You see this message iff the value of the switch is 1}
%-----------
\newcommand{\showifAeq}[2]{%
\ifnum\value{wgroupSwitchACounter}=#1% display 1st argument if counter is 1 
#2%
\fi%
}

%-----------
% Display the 1st argument if the switch level is 1, and
% display the 2nd argument if the switch level is 2.
%
% Example: 
% \switchAtwo{Display this message if the switch is one}
%            {Display this message if the switch is two}
%-----------
\newcommand{\switchAtwo}[2]{%
\ifnum\value{wgroupSwitchACounter}=1% display 1st argument if counter is 1 
#1%
\else% else, display the 2nd argument
\ifnum\value{wgroupSwitchACounter}=2% display 2nd argument if counter is 2 
#2%
\fi%
\fi%
}

%-----------
% Display the 1st argument if the switch level is 1, and
% display the 2nd argument if the switch level is 2, and
% display the 3rd argument if the switch level is 3, and
%
% Example: 
% \switchAthree{Display this message if the switch is one}
%              {Display this message if the switch is two}
%              {Display this message if the switch is three}
%-----------
\newcommand{\switchAthree}[3]{%
\ifnum\value{wgroupSwitchACounter}=1% display 1st argument if counter is 1 
#1%
\else%
\ifnum\value{wgroupSwitchACounter}=2% display 2nd argument if counter is 2 
#2%
\else%
\ifnum\value{wgroupSwitchACounter}=3% display 2nd argument if counter is 3 
#3%
\fi
\fi%
\fi%
}


