% table heading trick
\newcommand{\headline}{\hline\rule{0pt}{2.5ex}}

% emphasise with italic
\renewcommand\emph[1]{\textit{#1}}

% listings default
\lstset{%
    numbers=left,
    %frame=lines,
    breaklines=true,
    captionpos=b,
    columns=fixed,
    flexiblecolumns=false,
    keepspaces=true,
    basicstyle={\small\ttfamily},
    keywordstyle={\small\ttfamily\bfseries},
    xleftmargin=1cm,
    xrightmargin=1cm,
    float,
    escapeinside={(*@}{@*)},
    aboveskip=2ex,
    belowskip=1ex,
    showstringspaces=false,
    float=tbhp,
    tabsize=4,
}
\renewcommand{\lstlistingname}{Листинг}

