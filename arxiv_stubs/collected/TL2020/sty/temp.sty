% typesetting the article's header
\def\maketitle{%
    \pagebreak
    \thispagestyle{plain}
    \@BeginDocument
    \vskip\vskipBeforeTitle\noindent
    \parbox{\textwidth}{%
      \vskip 10mm
      \typeChapterIfFirst
      \typeUdk{\@udk}
    }
    \begin{center}%
      \vskip-1.5ex%
      {\typeTitle{\@titleformat}}\\
      \vskip 1.5ex
      {\typeAuthor{\@author}} \\
      \vskip 1.5ex
      {\typeOrganization{\@organization}} \\
      \vskip 1.5ex
%      {\typeEmail{\@email}} \\
%      \vskip 1.5ex
    \end{center}%
    \vskip-1.5ex\vskip\vskipAfterTitle
    \addcontentsline{ruart}{ruarticle}{%
      {\small{\bfseries \@authorrev} \@title}%
    }%
    \addcontentsline{enart}{enarticle}{%
      \selectlanguage{english}
      {\small{\bfseries \@enauthor} \@entitle}%
      \selectlanguage{russian}
    }%
}

