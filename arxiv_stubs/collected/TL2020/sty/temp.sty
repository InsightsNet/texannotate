\def\@clear@title{%
    \gdef\@author@short{}%
    \gdef\@title@short{}%
    \gdef\@author{}%
    \gdef\@title{}%
    \gdef\@enauthor{}%
    \gdef\@entitle{}%
    \gdef\@titleformat{}%
    \gdef\@authorrev{}%
    \gdef\@organization{}%
    \gdef\@email{}%
    \gdef\@enauthor{}%
    \gdef\@entitle{}%
}

\renewcommand{\title}[4][]{\@clear@title
    \gdef\@titleformat{#2}%
    \gdef\@title{#3}%
    \gdef\@entitle{#4}%
    \ifthenelse{\equal{#1}{}}%
        {\gdef\@title@short{{#3}}}%
        {\gdef\@title@short{{#1}}}%
}

\renewcommand{\author}[5][]{%
    \gdef\@author{#2}%
    \gdef\@authorrev{#3}%
    \gdef\@enauthor{#4}%
    \gdef\@enauthort{#5}
    \ifthenelse{\equal{#1}{}}%
        {\gdef\@author@short{{#2}}}%
        {\gdef\@author@short{{#1}}}%
}

\newcommand{\organization}[2]{\gdef\@organization{{#1}}
                              \gdef\@enorganization{{#2}}}
\newcommand{\email}[1]{\gdef\@email{#1}}
\newcommand{\udk}[1]{\gdef\@udk{#1}}
\newcommand{\udc}[1]{\gdef\@udc{#1}}

