%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Captions
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\RequirePackage{caption}

%\captionsetup[table]{width={\textwidth-5cm}}

\captionsetup[table]{%
    position=above,
    labelfont={small},
    textfont={small,bf},
    %singlelinecheck=false,
    %format=admTableCaptionFormat,
    justification=centering,
    labelsep=newline,
    name={\hfill\so{Таблица }},
}

\captionsetup[figure]{%
    position=below,
    labelfont={small},
    textfont={small},
    %format=admFigureCaptionFormat,
    %justification=centering,
    format=hang,
    labelsep=period,
}

\captionsetup[lstlisting]{%
    labelsep=period,
    labelfont={small},
    textfont={small},
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% List of authors
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\renewenvironment{thenomenclature}{%
  \let\olditem\item
  \renewcommand{\item}[2][0]{##1 ##2 \par\vskip 0mm}
  \begin{list}{}{\leftmargin=0pt}\olditem[]\par
}{%
  \end{list}
  \let\item\olditem
}

