% Начало новой главы
\def\newchapterpage{%
  \newpage
}

\def\chaptercode#1{\gdef\@chapter@code{#1}}
\chaptercode{??}

\newcommand*{\chapter}{\secdef{\chap}{\chaps}}
\newcommand\chap[4][]{%
    \pagebreak
    \gdef\@chapterName{#2}%
    \gdef\@chapterEnName{#4}%
    \ifthenelse{\equal{#1}{}}%
               {\gdef\@chapterShortName{#2}}%
               {\gdef\@chapterShortName{#1}}%
    \gdef\@chapterTocName{#3}%
    \addtocontents{ruart}{%
      {\protect\begin{center} \small\bfseries\MakeUppercase{\@chapterTocName} \protect\end{center}}%
      \vskip -3mm \protect\nopagebreak%
    }%
    \addtocontents{enart}{%
      {\protect\begin{center} \small\bfseries\MakeUppercase{\@chapterEnName} \protect\end{center}}%
      \vskip -3mm \protect\nopagebreak%
    }%
}
\newcommand\chaps[4][]{%
    \pagebreak
    \gdef\@chapterName{#2}
    \gdef\@chapterEnName{#4}
    \ifthenelse{\equal{#1}{}}%
               {\gdef\@chapterShortName{#2}}%
               {\gdef\@chapterShortName{#1}}
    \gdef\@chapterTocName{#3}%
    \@clear@title
    \gdef\@title@short{\@chapterShortName}
    \gdef\@author@short{\@chapterShortName}
    \addtocontents{ruart}{\vskip 2mm}
    \addcontentsline{ruart}{ruarticle}{%
      {\small \MakeUppercase{\@chapterTocName}}%
    }
    \addtocontents{enart}{\vskip 2mm}
    \addcontentsline{enart}{enarticle}{%
      {\small \MakeUppercase{\@chapterEnName}}%
    }
    \thispagestyle{plain}
    \vskip\vskipBeforeTitle\noindent
    \parbox{\textwidth}{%
      \vskip 1cm \typeChapterIfFirst{}
    }
}

