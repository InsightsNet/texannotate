\usepackage{ifthen}

\usepackage{xcolor}

\newsavebox{\laterrefbox}
\newlength{\tempwidth}
%\newcommand{\squeezewidth}{0.92\linewidth}
\newlength{\squeezewidth}
\settowidth{\squeezewidth}{\rule{0.92\linewidth}{0cm}}

\newcommand{\laterref}[1]{
  \sbox{\laterrefbox}{#1}%
  \ifthenelse{\lengthtest{\wd\laterrefbox > \squeezewidth}}
  {\setlength{\tempwidth}{\squeezewidth}
    \fbox{\fbox{
        \begin{minipage}{\squeezewidth}
          \textsl{\small #1}
        \end{minipage}
        }}
    }
  {{\fcolorbox{blue}{magenta}{#1}}}
%   \fbox{\fbox{
%   \begin{minipage}{7cm}
%     \textsl{\small #1}
%   \end{minipage}%
%   }}%
  \ref{#1}%
}

\newcommand{\questionable}[1]{%
  \setlength{\tempwidth}{\squeezewidth}%
  {%
    % \typeout{Mynote box needs more lines}
    % \the\linewidth
    % \the{\squeezewidth}
    % \typeout{\squeezewidth}
    \fcolorbox{blue}{purple}{
      \color{white}\bfseries
      \begin{minipage}{0.9\squeezewidth}
        \underline{Questionable, please review}\\
        \textsl{\small #1}
      \end{minipage}
    }
  }
}

% Name, Comment, Colour
\newcommand{\mynote}[3]{
  {\color{#3} #1
  \sbox{\laterrefbox}{#2}%
  \ifthenelse{\lengthtest{\wd\laterrefbox > \squeezewidth}}
  {\setlength{\tempwidth}{\squeezewidth}
    {%
      %\typeout{Mynote box needs more lines}
      %\the\linewidth
      %\the{\squeezewidth}
      %\typeout{\squeezewidth}
    \fcolorbox{blue}{#3}{
      \color{white}\bfseries
        \begin{minipage}{0.9\squeezewidth}
          \textsl{\small #2}
        \end{minipage}
      }
    }
  }
  {{\color{#3}\fcolorbox{blue}{#3}{\color{white}\bfseries\textsl{\small #2}}}}
%   \fbox{\fbox{
%   \begin{minipage}{7cm}
%     \textsl{\small #1}
%   \end{minipage}%
%   }}%
  {\color{#3} \ref{undefined-ref-remove-when-fixed}}}%
}

\newcounter{quicknotecount}

\newcommand{\quicknote}[1]{%
  \mynote{}{#1}{magenta}%
  \addtocounter{quicknotecount}{1}%
}

\newcommand{\quicknotesopen}{%
  \mynote{Warning}{There are \thequicknotecount{} open quicknotes.}{red}
}