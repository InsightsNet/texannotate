\def\n#1{\|#1\|}
\newcommand\scal[2][ ]{\ifthenelse{\equal{#1}{ }}{\langle#2\rangle}{}
        \ifthenelse{\equal{#1}{b}}{\bigl\langle#2\bigr\rangle}{}
        \ifthenelse{\equal{#1}{B}}{\Bigl\langle#2\Bigr\rangle}{}
        \ifthenelse{\equal{#1}{bb}}{\biggl\langle#2\biggr\rangle}{}
        \ifthenelse{\equal{#1}{BB}}{\Biggl\langle#2\Biggr\rangle}{}}
