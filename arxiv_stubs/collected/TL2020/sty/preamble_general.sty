% THEOREM STYLES 
% Reference: https://www.overleaf.com/learn/latex/Theorems_and_proofs
% I have decided to nujmber everything by section.  See 
% https://tex.stackexchange.com/questions/45355/theorem-numbering-as-chapter-section-subsection-theorem-number
\usepackage{amsthm}
\numberwithin{equation}{subsection}
\newtheorem{theorem}{Theorem}[subsection]
\newtheorem{proposition}{Proposition}[subsection]
\newtheorem{corollary}{Corollary}[subsection]
\newtheorem{conjecture}{Conjecture}[subsection]
\newtheorem{numberedalgorithm}{Algorithm}[subsection]

%%%% AUTO ADD A TRIANGLE TO REMARKS,  QUESTIONS,  ETC.
% Reference: https://tex.stackexchange.com/questions/48878/qed-symbol-in-a-custom-theorem-environment
% Reference: https://ctan.math.washington.edu/tex-archive/macros/latex/contrib/thmtools/doc/thmtools-manual.pdf
% Reference: https://tex.stackexchange.com/questions/16453/denoting-the-end-of-example-remark (for triangle instead of qed)
% Remark:  Could use kwargs like  "sibling=remark " to share numbering across
% multiple of these. 
\usepackage{amsthm}
\usepackage{thmtools}

\declaretheoremstyle[
  spaceabove=\topsep, spacebelow=\topsep,
  headfont=\bfseries,
  notefont=\bfseries, notebraces={(}{)},
  bodyfont=\normalfont,
  postheadspace=1em,
  qed=$\triangle$,
  within=subsection,
]{mythmstyle}
\declaretheorem[style=mythmstyle]{remark}
\declaretheorem[style=mythmstyle]{question}
\declaretheorem[style=mythmstyle]{definition}
\declaretheorem[style=mythmstyle]{property}
\declaretheorem[style=mythmstyle]{notation}
\declaretheorem[style=mythmstyle]{exercise}
\declaretheorem[style=mythmstyle]{problem}
\declaretheorem[style=mythmstyle]{claim}
\declaretheorem[style=mythmstyle]{lemma}
\declaretheorem[style=mythmstyle]{example}
