% wgroup_message.sty
%
% Authors: Watcharapan Suwansantisuk (Ae)
%
% Purposes: Provides commands to write notes
% 
% Installation: Put this style file (wgroup_message.sty) in a local
%    Latex tree directory, such as
%
%       /Users/Ae/Library/texmf/tex/latex/wgroup/
%
%    Create directories, if needed.
%
% Description:
%    To load a package, put "\usepackage{wgroup_message" before the 
%    \begin{document}
%
%     Available commands are
%       \mynote{...a text...}       --- Write a note
%       \mysubnote{...a text...}    --- Write a subnote
%       \mysubsubnote{...a text...} --- Write a subsubnote
%       \todo{...a text...}         --- Write a todo task
%       \question{...a text...}     --- Write a question
%
%     To turn off the note, subnote, or subsubnote, supply either 
%     0, 1, 2, or 3 to the option "level" in the package call:
%         \usepackage[level=0]{wgroup_message} 
%               --- turn off the note, subnote, and subsubnote 
%                   (i.e., retain 0 level of notes)
%         \usepackage[level=1]{wgroup_message} 
%                     --- turn off the subnote, and subsubnote
%                   (i.e., retain 1 level of notes)
%         \usepackage[level=2]{wgroup_message} 
%                     --- turn off subsubnote
%                   (i.e., retain 2 level of notes)
%         \usepackage[level=3]{wgroup_message} 
%                     --- turn on every level of notes
%     "level=0" will turn off \todo and \question text.
%     The other settings of level will turn on \todo and \question text.
%
%     Use todo=0 and todo=1 to turn off and on \todo message.
%     Use question=0 and question=1 to turn off or on \question message.
% 
% Limitations:
%    The empty note, \msgStyleEmpty, may produce a warning 
%    ("LaTex Warning: Marginpar on page 'n' moved"). 
%    This warning can usually be ignored.  
% 
% History:
%    Jul 12, 2010  Ae created the preliminary version of this package
%    Aug 12, 2010  Ae modified the default subnote and subsubnote styles
%                  according to the feedback from Prof. Win and William
%    Aug 13, 2010  Ae put the definitions into the style file
%    Sep  7, 2010  Ae added "\RequirePackage{amssymb}," to reflect the need
%                  of those packages
%                  Ae added commands \todo and \question, and adjust the package
%                  parameters to turn on or off the new commands
%    Sep 21, 2010  Ae added \questline command
%    Dec 23, 2010  Ae added option "normalem" to package "ulem", to prevent
%                  the commpand "\emph" to turn into the underline


\ProvidesPackage{wgroup_message}[2010/09/21 Wgroup Message package]

% Set option for loaded packages

\PassOptionsToPackage{normalem}{ulem} % option "normalem" for ulem package 
                                      % = do not turn \emph into underline

% Load the required package

\RequirePackage{color}   % provides color
\RequirePackage{xkeyval} % provides a "key=value" mapping 
                         % in the package option
\RequirePackage{amssymb} % symbols that appear in the notes  
\RequirePackage{ulem}    % fancy underline

%======================================================================%
% Define available underlines                                          %
%======================================================================%
% Note: \rule[raise-height]{width}{thickness} creates a line

% thick blue underline (use commands defined in package ulem)
\newcommand{\ulineThickBlue}
{\bgroup\markoverwith{\textcolor{blue}{\rule[-0.5ex]{2pt}{1pt}}}\ULon}

% thick red underline (use commands defined in package ulem)
\newcommand{\ulineThickRed}
{\bgroup\markoverwith{\textcolor{red}{\rule[-0.5ex]{2pt}{1pt}}}\ULon}

% a blue underline, a black text
\newcommand{\ulineStyleBlueThickLine}[1]{\ulineThickBlue{\textcolor{black}{#1}}}

% a red underline, a black text
\newcommand{\ulineStyleRedThickLine}[1]{\ulineThickRed{\textcolor{black}{#1}}}

% a red unerline, a black text
\newcommand{\ulineStyleRedLine}[1]{\textcolor{blue}{\uline{\textcolor{black}{#1}}}}

% blue underline, blue text
\newcommand{\ulineStyleBlue}[1]{\textcolor{blue}{\uline{#1}}}  

% red underline, red text
\newcommand{\ulineStyleRed}[1]{\textcolor{red}{\uline{#1}}}

% no underline
\newcommand{\ulineStyleEmpty}[1]{#1}

%======================================================================%
% Define available styles of message                                   %
%======================================================================%

% Solid triangle in 1 opposite direction
\newcommand{\msgStylePointy}[1]{%
\noindent \textcolor{red}{\framebox{$\blacktriangleright$ %
{\small\textsf{#1}} $\blacktriangleleft$}}}

% Solid triangle in 2 direction
\newcommand{\msgStylePointyTwoWays}[1]{%
\noindent \textcolor{red}{\framebox{%
$\blacktriangleleft \blacktriangleright$ %
{\small\textsf{#1}} $\blacktriangleleft \blacktriangleright $}}}

% Hollow triangles, blue
\newcommand{\msgStyleHollowPointy}[1]{%
\noindent \textcolor{blue}{\framebox{$\triangleright$ %
{\small\textsf{#1}} $\triangleleft$}}}

% Hollow triangles, Italic font
\newcommand{\msgStyleHollowPointyItalic}[1]{%
\noindent \textcolor{red}{\framebox{$\triangleright$ %
{\small\textit{#1}} $\triangleleft$}}}

% Plain -- a box containing a text
\newcommand{\msgStylePlain}[1]{%
\noindent \textcolor{red}{\framebox{\small\textsf{#1}}}}

% PlainBlue -- a box containing a text, in blue
\newcommand{\msgStylePlainBlue}[1]{%
\noindent \textcolor{blue}{\framebox{\small\textsf{#1}}}}

% Plain --- italic, no box
\newcommand{\msgStyleNoBoxItalic}[1]{%
\noindent \textcolor{blue}{{$\triangleright$ {%
\small\textit{#1}} $\triangleleft$}}}

% A classic style, begins and ends with square blocks
\newcommand{\msgStyleBlock}[1]{%
\noindent\textcolor{red}{$\blacksquare$ #1 $\blacksquare$}}

% Begins with question mark, end with bracket
\newcommand{\msgStyleQuestSqBracket}[1]{%
\noindent\textcolor{blue}{\framebox{?} #1 ]}}

% Empty -- empty box
\newcommand{\msgStyleEmpty}[1]{} %\marginpar{}                     

%======================================================================%
% note, subnote, and subsubnote                                        %
%======================================================================%

%--------------------------------------------%
% Create default styles of underlines        %
%--------------------------------------------%

\newcommand{\todolineStyleDefault}{\ulineStyleRed}
\newcommand{\questlineStyleDefault}{\ulineStyleBlue}

%--------------------------------------------%
% Create default styles of notes             %
%--------------------------------------------%

\newcommand{\mynoteStyleDefault}[1]{\msgStylePointy{#1}}
\newcommand{\mysubnoteStyleDefault}[1]{\msgStyleHollowPointy{#1}}
\newcommand{\mysubsubnoteStyleDefault}[1]{\msgStyleNoBoxItalic{#1}}
\newcommand{\todoStyleDefault}[1]{\msgStyleBlock{#1}}
\newcommand{\questionStyleDefault}[1]{\msgStyleQuestSqBracket{#1}}

%--------------------------------------------%
% Use the default styles                     %
%--------------------------------------------%
% notes
\newcommand{\mynote}[1]{\mynoteStyleDefault{#1}}
\newcommand{\mysubnote}[1]{\mysubnoteStyleDefault{#1}}
\newcommand{\mysubsubnote}[1]{\mysubsubnoteStyleDefault{#1}}
\newcommand{\todo}[1]{\todoStyleDefault{#1}}
\newcommand{\question}[1]{\questionStyleDefault{#1}}
% underlines
\newcommand{\todoline}[1]{\todolineStyleDefault{#1}}
\newcommand{\questline}[1]{\questlineStyleDefault{#1}}


%--------------------------------------------%
% Create utility/helper commands             %
%--------------------------------------------%
% Purpose: maps a note,subnote, or subsubnote to its definition
% Usage: \mapNoteToDefinition{#1}{#2}
%        where #1 is either note, subnote, or subsubnote (the command to map)
%              #2 is one of the available styles, such as
%                 msgStylePointy, msgStylePointyTwoWays
% Example: \mapNoteToDefinition{mynote}{msgStylePointy}
% Remarks:
%   The latex command for the above example is
%       \rewnewcomannd{\mynote}[1]{\noteTyleEmpty[#1]}
\newcommand{\mapNoteToDefinition}[2]{
\expandafter\renewcommand\csname#1\endcsname[1]{\csname#2\endcsname{##1}}%
}

%--------------------------------------------%
% Set a level of notes                       %
%--------------------------------------------%
% Purpose: select a way to display note, subnote, and subsubnote
% Usage:   \setnotelevel{#1}
%          where #1 is a number describing how the note, subnote, and
%          subsubnote should be displayed
%            0 (or smaller) -- All note commands are invisible
%            1 -- \note is visible; subnote and subsubnote are invisible
%            2 -- note and subnote are visible; subsubnote is invisible
%            3 (or greater) -- All notes commands are visible
\newcommand{\setnotelevel}[1]{%
\ifnum#1<1%
    \expandafter\mapNoteToDefinition{mynote}{msgStyleEmpty}%
    \expandafter\mapNoteToDefinition{mysubnote}{msgStyleEmpty}%
    \expandafter\mapNoteToDefinition{mysubsubnote}{msgStyleEmpty}%
    \expandafter\mapNoteToDefinition{todo}{msgStyleEmpty}%
    \expandafter\mapNoteToDefinition{question}{msgStyleEmpty}%
    \expandafter\mapNoteToDefinition{todoline}{ulineStyleEmpty}%
    \expandafter\mapNoteToDefinition{questline}{ulineStyleEmpty}%
\fi%
\ifnum#1=1%
    \expandafter\mapNoteToDefinition{mynote}{mynoteStyleDefault}%
    \expandafter\mapNoteToDefinition{mysubnote}{msgStyleEmpty}%
    \expandafter\mapNoteToDefinition{mysubsubnote}{msgStyleEmpty}%
    \expandafter\mapNoteToDefinition{todo}{todoStyleDefault}%
    \expandafter\mapNoteToDefinition{question}{questionStyleDefault}%
    \expandafter\mapNoteToDefinition{todoline}{todolineStyleDefault}%
    \expandafter\mapNoteToDefinition{questline}{questlineStyleDefault}%    
\fi%
\ifnum#1=2%
    \expandafter\mapNoteToDefinition{mynote}{mynoteStyleDefault}%
    \expandafter\mapNoteToDefinition{mysubnote}{mysubnoteStyleDefault}%
    \expandafter\mapNoteToDefinition{mysubsubnote}{msgStyleEmpty}%
    \expandafter\mapNoteToDefinition{todo}{todoStyleDefault}%
    \expandafter\mapNoteToDefinition{question}{questionStyleDefault}%  
    \expandafter\mapNoteToDefinition{todoline}{todolineStyleDefault}%
    \expandafter\mapNoteToDefinition{questline}{questlineStyleDefault}% 
\fi%
\ifnum#1>2%
    \expandafter\mapNoteToDefinition{mynote}{mynoteStyleDefault}%
    \expandafter\mapNoteToDefinition{mysubnote}{mysubnoteStyleDefault}%
    \expandafter\mapNoteToDefinition{mysubsubnote}{mysubsubnoteStyleDefault}%
    \expandafter\mapNoteToDefinition{todo}{todoStyleDefault}%
    \expandafter\mapNoteToDefinition{question}{questionStyleDefault}%    
    \expandafter\mapNoteToDefinition{todoline}{todolineStyleDefault}%
    \expandafter\mapNoteToDefinition{questline}{questlineStyleDefault}%    
\fi%
}

% set the level of "todo"
\newcommand{\settodolevel}[1]{%
\ifnum#1<1%
    \expandafter\mapNoteToDefinition{todo}{msgStyleEmpty}%
    \expandafter\mapNoteToDefinition{todoline}{ulineStyleEmpty}%
\fi%
\ifnum#1>0%
    \expandafter\mapNoteToDefinition{todo}{todoStyleDefault}%
    \expandafter\mapNoteToDefinition{todoline}{todolineStyleDefault}%
\fi%
}

% set the level of "question"
\newcommand{\setquestionlevel}[1]{%
\ifnum#1<1%
    \expandafter\mapNoteToDefinition{question}{msgStyleEmpty}%
    \expandafter\mapNoteToDefinition{questline}{ulineStyleEmpty}%    
\fi%
\ifnum#1>0%
    \expandafter\mapNoteToDefinition{question}{questionStyleDefault}%
    \expandafter\mapNoteToDefinition{questline}{questlineStyleDefault}%
\fi%
}


%--------------------------------------------%
% Process the package options                %
%--------------------------------------------%
% option "level" has a default value of 0
\DeclareOptionX{level}[0]{\setnotelevel{#1}}

% option "todo" (has no default value)
\DeclareOptionX{todo}{\settodolevel{#1}}

% option "question" (has no default value)
\DeclareOptionX{question}{\setquestionlevel{#1}}

\ProcessOptionsX

