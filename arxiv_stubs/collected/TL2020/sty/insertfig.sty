%\usepackage[dvipdfmx]{graphicx}
\usepackage[pdftex]{graphicx}
\usepackage{epstopdf}

\usepackage{subfigure}
\usepackage{lcaption}
\usepackage{ifthen}

% default figure size in the unit of paper width.
\newcommand{\insertfigsize}{0}

% [size][filename]
\newcommand{\@insertfig}[2][0]{%
  \ifthenelse{\equal{#1}{0}}{
    \ifthenelse{\equal{\insertfigsize}{0}}{
      \if@twocolumn
        \includegraphics[width=.49\textwidth]{#2}
      \else
        \includegraphics[width=.7\textwidth]{#2}
      \fi}{
      \includegraphics[width=\insertfigsize\textwidth]{#2}}}{
    \includegraphics[width=#1\textwidth]{#2}}}


% [size]{name}{caption}
\newcommand{\insertfig}[3][0]{%
  \begin{figure}[t]
    \centering
    \leavevmode
    \@insertfig[#1]{figure/#2.eps}
    \lcaption{#3}
    \label{fig:#2}
  \end{figure}}

\newcommand{\insertPDFfig}[3][0]{%
  \begin{figure}[t]
    \centering
    \leavevmode
    \@insertfig[#1]{figure/#2.pdf}
    \lcaption{#3}
    \label{fig:#2}
  \end{figure}}

% [size]{name1}{caption1}{name2}{caption2}
\newcommand{\insertfigs}[5][0]{%
  \begin{figure}[tb]
    \begin{minipage}{.49\textwidth}
      \begin{center}
        \leavevmode
        \@insertfig[#1]{figure/#2.eps}
        \lcaption{#3}
        \label{fig:#2}
      \end{center}
    \end{minipage}
    \hfill
    \begin{minipage}{.49\textwidth}
      \begin{center}
        \leavevmode
        \@insertfig[#1]{figure/#4.eps}
        \lcaption{#5}
        \label{fig:#4}
      \end{center}
    \end{minipage}
  \end{figure}}

% [size]{name1}{caption1}{name2}{caption2}
\newcommand{\insertPDFfigs}[5][0]{%
  \begin{figure}[tb]
    \begin{minipage}{.49\textwidth}
      \begin{center}
        \leavevmode
        \@insertfig[#1]{figure/#2.pdf}
        \lcaption{#3}
        \label{fig:#2}
      \end{center}
    \end{minipage}
    \hfill
    \begin{minipage}{.49\textwidth}
      \begin{center}
        \leavevmode
        \@insertfig[#1]{figure/#4.pdf}
        \lcaption{#5}
        \label{fig:#4}
      \end{center}
    \end{minipage}
  \end{figure}}


% [size]{name1}{subcaption1}{name2}{subcaption2}{label}{caption}
\newcommand{\insertfigsubs}[7][0]{%
  \begin{figure}[tb]
    \centering
    \leavevmode
    \ifthenelse{\equal{#3}{}}{
      % without subfigure captions
      \subfigure{\@insertfig[#1]{figure/#2.eps}}
      \subfigure{\@insertfig[#1]{figure/#4.eps}}}{
      % with subfigure captions
      \subfigure[#3]{\@insertfig[#1]{figure/#2.eps}}
      \subfigure[#5]{\@insertfig[#1]{figure/#4.eps}}}
    \lcaption{#7}
    \label{fig:#6}
  \end{figure}}

% [size]{name}{caption}{english_caption}
\newcommand{\insertfige}[4][0]{%
  \begin{figure}[tb]
    \centering
    \leavevmode
    \@insertfig[#1]{figure/#2.eps}
    \lcaption{#3}
    \ecaption{#4}
    \label{fig:#2}
  \end{figure}}

% [size]{name1}{subcaption1}{name2}{subcaption2}{name3}{subcaption3}{label}{caption}
\newcommand{\insertfigsubthree}[9][0]{%
  \begin{figure}[tb]
    \begin{center}
      \leavevmode
      \ifthenelse{\equal{#3}{}}{
        % without subfigure captions
        \subfigure{\@insertfig[#1]{figure/#2.eps}}
        \subfigure{\@insertfig[#1]{figure/#4.eps}}
	\subfigure{\@insertfig[#1]{figure/#6.eps}}}{
        % with subfigure captions
        \subfigure[#3]{\@insertfig[#1]{figure/#2.eps}}
        \subfigure[#5]{\@insertfig[#1]{figure/#4.eps}}
	\subfigure[#7]{\@insertfig[#1]{figure/#6.eps}}}
      \lcaption{#9}
      \label{fig:#8}
    \end{center}
  \end{figure}}
