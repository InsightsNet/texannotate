% ================================================================
% Characters/Symbols
% ================================================================
\DeclareSymbolFont{frenchscript}{OMS}{ztmcm}{m}{n}
\DeclareMathAlphabet{\mathbbm}{U}{bbm}{m}{n}            % blackboard bold
\DeclareMathSymbol{\Pow}{\mathord}{frenchscript}{80}    % powerset
\newcommand{\IN}{\mathbbm{N}}                           % natural numbers
\newcommand{\s}[1]{{\scriptscriptstyle #1}}             % scriptscript style L
% ––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––
% Process Algebra-Related
% ––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––
\DeclareMathSymbol{\A}{\mathord}{frenchscript}{65}      % set of agent identifiers
\DeclareMathSymbol{\B}{\mathord}{frenchscript}{66}      % set of broadcast communications names
\DeclareMathSymbol{\Ch}{\mathord}{frenchscript}{67}     % set of handshake communications names
\DeclareMathSymbol{\Sig}{\mathord}{frenchscript}{83}    % set of signals
\newcommand{\cT}{\mathbbm{P}}                           % closed terms, or processes
% ––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––
% Labelled Transition System-Related
% ––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––
\DeclareMathSymbol{\Lab}{\mathord}{frenchscript}{76}    % labels in labelled transition system
\newcommand{\IT}{\mathbbm{T}}                           % labelled transition system
% ––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––
% Bisimulation-Related
% ––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––
\DeclareMathSymbol{\R}{\mathord}{frenchscript}{82}      % bisimulation relation R
% ================================================================
% References
% ================================================================
\newcommand{\Sec}[1]{Section~\ref{sec:#1}}
\newcommand{\app}[1]{Appendix~\ref{app:#1}}
\newcommand{\tab}[1]{Table~\ref{tab:#1}}
\newcommand{\fig}[1]{Figure~\ref{#1}}
\newcommand{\mylabel}[1]{\hypertarget{lab:#1}{\ \mbox{{\scriptsize\sc (#1)}}}}
\newcommand{\myref}[1]{\hyperlink{lab:#1}{\scriptsize\sc (#1)}}
% ––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––
% Theorem-Related
% ––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––
\newcommand{\df}[1]{Definition~\ref{df:#1}}
\newcommand{\thm}[1]{Theorem~\ref{thm:#1}}
\newcommand{\pr}[1]{Proposition~\ref{pr:#1}}
\newcommand{\lem}[1]{Lemma~\ref{lem:#1}}
\newcommand{\cor}[1]{Corollary~\ref{cor:#1}}
\newcommand{\obs}[1]{Observation~\ref{obs:#1}}  
\newcommand{\ex}[1]{Example~\ref{ex:#1}}
% ================================================================
% Other Macros
% ================================================================
\newcommand{\plat}[1]{\raisebox{0pt}[0pt][0pt]{#1}}                             % no vertical space
\newcommand{\defis}{\stackrel{\textit{def}}{=}}                                 % definition
\newcommand{\djcup}{\mathbin{\mathaccent\cdot\cup}}                             % disjoint union
\newcommand{\bigdjcup}{\mathop{\mathaccent\cdot{\bigcup}}}                      % disjoint union
\newcommand{\Id}[1]{[\hspace{-1.4pt}[#1]\hspace{-1.4pt}]}                       % denotation
% ––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––
% Labelled Transition System-Related
% ––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––
\newcommand{\goto}[1]{\stackrel{#1}{\longrightarrow}}                           % transition arrow
\newcommand{\ngoto}[1]{\mathrlap{\;\;\;\;\not}\goto{#1}{}\!\!}                  % negated transition arrow
\newcommand{\Tr}{\textit{Tr}}                                                   % set of transitions
\newcommand{\source}{\textit{source}}                                           % source of transition
\newcommand{\target}{\textit{target}}                                           % target of transition
\newcommand{\en}{\textit{en}}                                                   % enabled transitions
% ––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––
% Signal-Related
% ––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––
\newcommand{\signals}{\mathrel{\hat{}\!}}                                       % syntactic opertor ``signals''
% ––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––
% Synchron-Related
% ––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––
\newcommand{\actsyn}[1]{\mathord{\stackrel{#1}{\rightarrow}}}                   % active synchron
\newcommand{\sigsyn}[1]{^{\rightarrow #1}}                                          % signal synchron
\newcommand{\Left}{\mathrm{\scriptscriptstyle L}}                               % left component indicator
\newcommand{\Right}{\mathrm{\scriptscriptstyle R}}                              % right component indicator
\newcommand{\D}{\mathrm{\scriptscriptstyle D}}                                  % D component indicator
\newcommand{\E}{\mathrm{\scriptscriptstyle E}}                                  % E component indicator
\newcommand{\Arg}{\textit{Arg}}                                                 % set of arguments
\newcommand{\static}{\textit{static}}                                           % static arguments
\newcommand{\sconc}{\smile}                                                     % symmetric concurrency relation (synchrons x synchrons)
\newcommand{\nsconc}{\mathrel{\mbox{$\,\not\!\smile$}}}                         % negation of symmetric concurrency relation (synchrons x synchrons)
\newcommand{\sleadsto}{\leadsto}                                                % successor relation (synchrons x synchrons)
\newcommand{\saconc}{\aconc}                                                    % asymmetric concurrency relation (synchrons x transitions)
\newcommand{\nsaconc}{\naconc}                                                  % negation of asymmetric concurrency relation (synchrons x transitions)
% ––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––
% Concurrency-Related
% ––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––
\newcommand{\aconc}{\mathrel{\mbox{$\smile\hspace{-1.25ex}\raisebox{3pt}{$\scriptscriptstyle\bullet$}$}}}
\newcommand{\conc}{\smile}                                                      % symmetric concurrency relation (transitions x transitions)
\newcommand{\naconc}{\mathrel{\mbox{$\,\not\hspace{-1pt}\smile\hspace{-1.25ex}\raisebox{3pt}{$\scriptscriptstyle\bullet$}$}}}     % negation of asymmetric concurrency relation (transitions x transitions)
\newcommand{\paconc}{\aconc}                                                    % asymmetric concurrency relation (transitions x paths)
\newcommand{\pnaconc}{\naconc}                                                  % negation of asymmetric concurrency relation (transitions x paths)
\newcommand{\pleadsto}{\leadsto}                                                % successor relation (transitions x paths x transitions)
\newcommand{\ssaconc}{\aconc'}                                                  % synchron-stemed asymmetric concurrency relation (transitions x transitions)
\newcommand{\ssleadsto}{\leadsto'}                                              % synchron-stemed successor relation (transitions x transitions x transitions)
% ––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––
% Bisimularity-Related
% ––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––––
\newcommand{\obis}[2]{\mathrel{_{#1}\,                                          % open bisimilarity
  \raisebox{.3ex}{$\underline{\makebox[.7em]{$\leftrightarrow$}}$}
  \,_{#2}}}
\newcommand{\bis}[1]{\obis{}{#1}}                                               % bisimilarity
\newcommand{\biss}{\bis{}}                                                      % strong bisimilarity
\newcommand{\bisep}{\bis{\textit{ep}}}                                          % enabling-preserving bisimilarity
\newcommand{\bisepp}{\bis{\textit{ep}}}                                         % enabling-preserving bisimilarity on expressions
\newcommand{\nobis}[2]{\mathrel{\mbox{$\hspace{6pt}\not\hspace{-8pt}_{#1}\,     % no bisimilarity
  \raisebox{.3ex}{$\underline{\makebox[.7em]{$\leftrightarrow$}}$}
  \,_{#2}$}}}
