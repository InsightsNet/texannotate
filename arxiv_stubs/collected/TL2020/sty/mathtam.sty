\usepackage{varwidth}
\usepackage{environ}
\newlength{\MyMdframedWidthTweak}%

\NewEnviron{tbox}{%
	\setlength{\MyMdframedWidthTweak}{\dimexpr%
		+\mdflength{innerleftmargin}
		+\mdflength{innerrightmargin}
		+\mdflength{leftmargin}
		+\mdflength{rightmargin}
	}%
	\savebox0{%
		\begin{varwidth}{\textwidth}%
			\BODY
		\end{varwidth}%
	}%
	\begin{mdframed}[
		roundcorner = \roundness,
		linewidth=1pt,
		skipabove=12pt,
		skipbelow=2pt,
		linecolor=NavyBlue,
		align=center,
		nobreak=true,
		backgroundcolor=TealBlue!5,	
		userdefinedwidth=\dimexpr\wd0+\MyMdframedWidthTweak\relax
		]
		\usebox0
	\end{mdframed}
}


\NewEnviron{cbox}{%
	\setlength{\MyMdframedWidthTweak}{\dimexpr%
		+\mdflength{innerleftmargin}
		+\mdflength{innerrightmargin}
		+\mdflength{leftmargin}
		+\mdflength{rightmargin}
	}%
	\savebox0{%
		\begin{varwidth}{\textwidth}%
			\BODY
		\end{varwidth}%
	}%
	\begin{mdframed}[
		roundcorner = \roundness,
		linewidth=1pt,
		skipabove=12pt,
		skipbelow=2pt,
		linecolor=NavyBlue,
		align=center,
		nobreak=true,
		backgroundcolor=TealBlue!5,	
		userdefinedwidth=\dimexpr\wd0+\MyMdframedWidthTweak\relax
		]
		\usebox0
	\end{mdframed}
}


\NewEnviron{blankbox}{%
	\setlength{\MyMdframedWidthTweak}{\dimexpr%
		+\mdflength{innerleftmargin}
		+\mdflength{innerrightmargin}
		+\mdflength{leftmargin}
		+\mdflength{rightmargin}
	}%
	\savebox0{%
		\begin{varwidth}{\dimexpr\linewidth-\MyMdframedWidthTweak\relax}%
			\BODY
		\end{varwidth}%
	}%
	\begin{mdframed}[
		roundcorner = \roundness,
		linewidth=1pt,
		skipabove=12pt,
		skipbelow=2pt,
		align=center,
		nobreak=true,
		userdefinedwidth=\dimexpr\wd0+\MyMdframedWidthTweak\relax
		]
		\usebox0
	\end{mdframed}
}


%%fakesection Theorem setup
\iftamthm
	\theoremstyle{plain}
%	Branching here: the option secthm changes theorems to be labelled by section
	\iftammdthm
		\iftamsecthm
			\declaretheorem[style=thmyellowbox,name=Theorem,numberwithin=section]{theorem}
		\else
			\declaretheorem[style=thmyellowbox,name=Theorem]{theorem}
		\fi
		
		\declaretheorem[style=thmyellowbox,name=Lemma,sibling=theorem]{lemma}
		\declaretheorem[style=thmbluebox,name=Proposition,sibling=theorem]{proposition}
		\declaretheorem[style=thmyellowbox,name=Corollary,sibling=theorem]{corollary}
		\declaretheorem[style=thmyellowbox,name=Theorem,numbered=no]{theorem*}
		\declaretheorem[style=thmbluebox,name=Lemma,numbered=no]{lemma*}
		\declaretheorem[style=thmbluebox,name=Proposition,numbered=no]{proposition*}
		\declaretheorem[style=thmyellowbox,name=Corollary,numbered=no]{corollary*}
		
		\declaretheorem[style=thmblankbox,name=Definition,sibling=theorem]{definition}
		\declaretheorem[style=thmblankbox,name=Definition,numbered=no]{definition*}
		
%		\declaretheorem[style=thmpurplebox,name=Note,within=section]{note}
%		\declaretheorem[style=thmpurplebox,name=Note,numbered=no]{note*}
%		\declaretheorem[style=emptycolorthm,numbered=no]{cbox}
%		\declaretheorem[style=emptythm,numbered=no]{blankbox}
	\else
		\iftamsecthm
			\newtheorem{theorem}{Theorem}[section]
		\else
			\newtheorem{theorem}{Theorem}
		\fi
		\newtheorem{lemma}[theorem]{Lemma}
		\newtheorem{proposition}[theorem]{Proposition}
		\newtheorem{corollary}[theorem]{Corollary}
		\newtheorem*{theorem*}{Theorem}
		\newtheorem*{lemma*}{Lemma}
		\newtheorem*{proposition*}{Proposition}
		\newtheorem*{corollary*}{Corollary}
	\fi

	%Def-style theorems
	\theoremstyle{definition}
	% This ought to be a real theorem, but would be too much italics
	\iftammdthm
		\declaretheorem[style=thmgreenbox,name=Algorithm,sibling=theorem]{algorithm}
		\declaretheorem[style=thmgreenbox,name=Algorithm,numbered=no]{algorithm*}
		\declaretheorem[style=thmgreenbox,name=Claim,sibling=theorem]{claim}
		\declaretheorem[style=thmgreenbox,name=Claim,numbered=no]{claim*}
	\else
		\newtheorem{algorithm}[theorem]{Algorithm}
		\newtheorem*{algorithm*}{Algorithm}
		\newtheorem{claim}[theorem]{Claim}
		\newtheorem*{claim*}{Claim}
	\fi
	\newtheorem{conjecture}[theorem]{Conjecture}
%	\newtheorem{definition}[theorem]{Definition}
	\newtheorem{fact}[theorem]{Fact}
	\newtheorem{answer}[theorem]{Answer}
% 	\newtheorem{case}[theorem]{Case}
% 	\newtheorem{ques}[theorem]{Question}
% 	\newtheorem{exercise}[theorem]{Exercise}
% 	\newtheorem{problem}[theorem]{Problem}
% 	\newtheorem*{conjecture*}{Conjecture}
%	\newtheorem*{definition*}{Definition}
% 	\newtheorem*{fact*}{Fact}
% 	\newtheorem*{answer*}{Answer}
% 	\newtheorem*{case*}{Case}
% 	\newtheorem*{joke*}{Joke}
% 	\newtheorem*{ques*}{Question}
% 	\newtheorem*{exercise*}{Exercise}
% 	\newtheorem*{problem*}{Problem}
	\iftammdthm
		\declaretheorem[style=thmredbox,name=Example,sibling=theorem]{example}
		\declaretheorem[style=thmredbox,name=Example,numbered=no]{example*}
	\else
		\newtheorem{example}[theorem]{Example}
		\newtheorem*{example*}{Example}
	\fi
	
%	 Remark-style theorems
	\theoremstyle{remark}
	\iftammdthm
		\declaretheorem[style=thmblackbox,name=Remark,sibling=theorem]{remark}
		\declaretheorem[style=thmblackbox,name=Remark,numbered=no]{remark*}
	\else
		\newtheorem{remark}[theorem]{Remark}
		\newtheorem*{remark*}{Remark}
	\fi
		\newtheorem{abuse}[theorem]{Abuse of Notation}
		\newtheorem*{abuse*}{Abuse of Notation}
\fi