%%%%%% Global Search %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand{\algOuterLoop}{
\begin{algorithm}[t]
\scriptsize
\label{alg:outerloop}

\SetKwFor{Loop}{Loop}{}{EndLoop}
$N_g \leftarrow \{\mathbf{q}_{init}\} \ ; \ E_g \leftarrow \emptyset \ ; \ M \leftarrow \{ \mathbf{q}_{goal} \} \ ; \ R_{localmin} \leftarrow \emptyset \ ; \ \textit{k} \leftarrow 50 $ \\

\Loop{either indefinitely or until some run-time limit is met} { % beginning of loop 
% \tcp{in practice, this outer loop may exit at a certain point to avoid an infinite loop in the case of no solution existing}
\While{$|M| < \textit{k}$}{ $M \stackrel{+}\leftarrow$ \text{randomly sampled state from $\chi_{free}$} }

% \For{$i = 0 \cdots j$}{ % beginning of for loop
\Loop{} {
    $R[\mathbf{q}_n^*, \mathbf{q}_m^*]  \leftarrow \texttt{\textcolor{Green}{probability\_heuristic\_1}(}N_g, M, R_{localmin} \texttt{)}$ \\
    \If{$R[\mathbf{q}_n^*, \mathbf{q}_m^*] \equiv \emptyset$}{
        $\textit{k} \leftarrow 1.5 * \textit{k}$ \\
        \textbf{break} \tcp{go to line 2 to add more milestones to M}
    }
    
    (\textit{success}, $T_{\ell}$) $ \leftarrow \texttt{local\_tree\_search(}\mathbf{q}_n^*, \mathbf{q}_m^* \texttt{)}$    
    
        \If{\textit{success}}{ % if 1
            $N_g \stackrel{+}\leftarrow \mathbf{q}_m^* \ ; \ \ E_g \stackrel{+}\leftarrow \Gamma[\mathbf{q}_n^*, \mathbf{q}_m^*] \ ; \ \  M \stackrel{-}\leftarrow \mathbf{q}_m^* $
            
            \If{$\mathbf{q}_m^* \equiv \mathbf{q}_{goal}$}{ % if 2
            \Return{ $\Gamma[\mathbf{q}_{init}, \mathbf{q}_{goal}]$ \tcp{solution found}} 
            } % end if 2
            
        } % end if 1
        \Else{ % beginning of else
            $R_{localmin} \stackrel{+}\leftarrow R[\mathbf{q}_n^*, \mathbf{q}_m^*]$ \tcp{remember that this search-space region appears to be a local minimum trap}
        } % end of else
    } % end for loop
% } % end loop
}

\caption{\small \texttt{sprint(}$\mathbf{q}_{init}$, $\mathbf{q}_{goal} \texttt{)}$ }
\end{algorithm}
}



%%%%%% Local Search %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand{\algLocalSearch}{
\begin{algorithm}[t]
\scriptsize
\label{alg:localsearch}

\SetKwFor{Loop}{Loop}{}{EndLoop}
$N_{\ell} \leftarrow \{\mathbf{q}_n^*\} ; \ E_{\ell} \leftarrow \emptyset ; \ N_{stack} \leftarrow \emptyset; \ N_{checkpoints} \leftarrow \{\mathbf{q}_n^*\}; \ \mathbf{q}_x \leftarrow \mathbf{q}_n^*$ \\ 
$H_{exploit} \leftarrow \emptyset$ \tcp{hashmap with ($\mathbf{q}$, (float, float)) key-value pairs}
$H_{explore} \leftarrow \emptyset$  \tcp{hashmap with ($\mathbf{q}$, (float, float)) key-value pairs} 
$H_{obs} \leftarrow \emptyset$ \tcp{hashmap with  ($\mathbf{q}$, \{$\mathbf{q}$\} sets) key-value pairs}
$H_{num} \leftarrow \emptyset$ \tcp{hashmap with  ($\mathbf{q}$, float) key-value pairs}
$\textit{add\_checkpoint} \leftarrow true$ \tcp{the root node is always labeled as a checkpoint}

% \tcp{The $D$ is a dictionary with configuration state keys and tuple (number, number, set of configuration states) values} 

% \tcp{C is a dictionary with configuration state keys and tuple (number, number, set of configuration states) values}

\Loop{}{ % beginning of for loop
    \If{  \texttt{  \textcolor{Green}{probability\_heuristic\_2}(}$\mathbf{q}_x, T_{\ell}, \Omega_{\ell}  \texttt{)}$ } { % beginning of if 2
    
        \If{$\textit{add\_checkpoint} $ }{ % beginning of if 8
            $N_{checkpoints} \stackrel{+}\leftarrow \mathbf{q}_x$ \tcp{label $\mathbf{q}_x$ as checkpoint}
            $\textit{exploit} \leftarrow ||\mathbf{q}_x - \mathbf{q}_m^*||; \ \textit{explore} \leftarrow ||\mathbf{q}_n^* - \mathbf{q}_x||$ \\
            $H_{exploit} \stackrel{+}\leftarrow (\mathbf{q}_x, (0, \textit{exploit})); \ H_{explore} \stackrel{+}\leftarrow (\mathbf{q}_x, (0, \textit{explore}))$
            $H_{obs} \stackrel{+}\leftarrow (\mathbf{q}_x, \emptyset); \ H_{num} \stackrel{+}\leftarrow (\mathbf{q}_x, 1)$
        } % end of if 8
    
        $R[\mathbf{q}_x, \mathbf{q}_c^*] \leftarrow \texttt{ \textcolor{Green}{probability\_heuristic\_3}(}\mathbf{q}_x, T_{\ell}, \Omega_{\ell} \texttt{)}$ \\
        \If{ $\texttt{in\_collision(} \mathbf{q}_c^* \texttt{)} $}{ % beginning of if 3
            \For{$\text{all} \ \mathbf{q} \in N_{checkpoints} \cap \Gamma[\mathbf{q}_n^*, \mathbf{q}_x]$ \tcp{all checkpoints on the path from $\mathbf{q}_x$ back to $\mathbf{q}_n^*$}}{ % beginning for 6
                $H_{exploit}[\mathbf{q}][0] \mathrel{+}=1; \ H_{explore}[\mathbf{q}][0] \mathrel{+}=1; \ H_{obs}[\mathbf{q}] \stackrel{+}\leftarrow \mathbf{q}_c^*$
            } % end for 6
            
            \If{$N_{stack}$.\texttt{is\_empty()}}{ % beginning of if 1
                \Return{ (false, $T_{\ell}$) \tcp{if the stack is empty, the local search has failed }}
            } % end of if 1 
            $\mathbf{q}_x \leftarrow N_{stack}.\texttt{pop\_last\_added()}$ \\
            $\textit{add\_checkpoint} \leftarrow true$
        } % end of if 3
        \Else{ \tcp{if $\mathbf{q}_c^*$ is not in collision}  % beginning of else 1 
            $\Gamma[\mathbf{q}_x, \mathbf{q}_c^*] \leftarrow  \mathbf{q}_x + u * ( \mathbf{q}_c^* - \mathbf{q}_x ) \ , u \in [0,1] $\\
            $N_{\ell} \stackrel{+}\leftarrow \mathbf{q}_c^* \ ; \ E_{\ell} \stackrel{+}\leftarrow \Gamma[\mathbf{q}_x, \mathbf{q}_c^*] \ ; \  N_{stack} \stackrel{+}\leftarrow  \mathbf{q}_x \ ; \ \mathbf{q}_x \leftarrow \mathbf{q}_c^*$ \\
            \If{ $\mathbf{q}_c^* \equiv \mathbf{q}_m^*$ }{ % beginning of if 4
                \Return{ (true, $T_{\ell}$) \tcp{local search solution was found}}
            } % end of if 4
            $\textit{exploit} \leftarrow ||\mathbf{q}_c^* - \mathbf{q}_m^*||; \ \textit{explore} \leftarrow ||\mathbf{q}_n^* - \mathbf{q}_c^*||$ \\
            
            \For{$\text{all} \ \mathbf{q} \in N_{checkpoints} \cap \Gamma[\mathbf{q}_n^*, \mathbf{q}_x]$ \tcp{all checkpoints on the path from $\mathbf{q}_x$ back to $\mathbf{q}_n^*$} }{ % beginning for 9
                \tcp{update checkpoints with information about $\mathbf{q}_c^*$}
                $H_{num}[\mathbf{q}]\mathrel{+}=1$\\
                \If{$\textit{exploit} < H_{exploit}[\mathbf{q}][1]$}{ % if exploit start
                    $H_{exploit}[\mathbf{q}][0] \leftarrow 0; \  H_{exploit}[\mathbf{q}][1] \leftarrow \textit{exploit}$
                } % if exploit end
                \Else {
                    $H_{exploit}[\mathbf{q}][0] \mathrel{+}=1$
                }
                
                \If{$\textit{explore} > H_{explore}[\mathbf{q}][1]$}{ % if explore start
                    $H_{explore}[\mathbf{q}][0] \leftarrow 0; \  H_{exploit}[\mathbf{q}][1] \leftarrow \textit{explore}$
                } % if explore end
                \Else {
                    $H_{explore}[\mathbf{q}][0] \mathrel{+}=1$
                }
            } % end for 9
            $\textit{add\_checkpoint} \leftarrow false$
        } % end of else 1
    } % end of if 2
    
    \Else { \tcp{if Probability Heuristic 2 considered the most recent $\mathbf{q}_x$ as not worthwhile to extend, try the next node on the stack} % beginning of else 2
        \If{$N_{stack}$.\texttt{is\_empty()}}{ % beginning of if 1
            \Return{ (false, $T_{\ell}$) \tcp{if the stack is empty, the local search has failed } }
        } % end of if 1 
        $\mathbf{q}_x \leftarrow N_{stack}.\texttt{pop\_last\_added()}$ \\
    } % end of else 2
    
} % end for loop

\caption{ \small \texttt{local\_tree\_search(}$\mathbf{q}_n^*$, $\mathbf{q}_m^* \texttt{)}$ }
\end{algorithm}
}



%%%%%% GLOBAL EDGE %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand{\algGlobalEdge}{
\begin{algorithm}[t]
\scriptsize
\label{alg:global_edge}

$R[\mathbf{q}_n^*, \mathbf{q}_m^*] \leftarrow \emptyset \ ; \ \textit{best\_value} = -\infty$ \\
$\textit{c}_1 \leftarrow 1 \ ; \ \textit{c}_2 \leftarrow 0.25 \ ; \textit{w}_1 \leftarrow 1 \ ; \ \textit{w}_2 \leftarrow 1.5$

\For{$\text{all} \ \mathbf{q}_n \in N_g$}{ % begin for 1
    \For{$\text{all} \ \mathbf{q}_m \in M$}{ % begin for 2
        \If{ $R[\mathbf{q}_n, \mathbf{q}_m] \notin R_{localmin}$ }{
            % $\textit{x}_1 \leftarrow || \mathbf{q}_g - \mathbf{q}_m || \ ; \ \textit{g}_1 \leftarrow \textit{w}_1 * \textit{exp}( \ -\textit{x}_1^2 \ / \ 2\textit{c}^2 ) $ \\
            $\textit{x}_1 \leftarrow \frac{|| \mathbf{q}_m - \mathbf{q}_{goal}||}{||\mathbf{q}_n - \mathbf{q}_{goal}||}$ \tcp{characterizes how much closer region would be getting to $\mathbf{q}_{goal}$}
            $\textit{g}_1 \leftarrow \textit{exp}( \ -\textit{x}_1^2 \ / \ 2\textit{c}_1^2 )$ \tcp{first Gaussian term}
            $\textit{x}_2 \leftarrow 1 $ \tcp{initialization, iteratively constructed in for loop below}
            
            \For{$\text{all} \ R[\mathbf{q}_a, \mathbf{q}_b] \in R_{localmin}$}{ % begin for 3
                $\mathbf{p}_1 \leftarrow \texttt{proj}_+(\mathbf{q}_n, R[\mathbf{q}_b, \mathbf{q}_a])$ \tcp{projection point 1}
                $\mathbf{p}_2 \leftarrow \texttt{proj}_+(\mathbf{q}_m, R[\mathbf{q}_a, \mathbf{q}_b])$ \tcp{projection point 2}
                $\textit{d}_1 \leftarrow || \mathbf{p}_1 - \mathbf{q}_n || \ ; \ \textit{d}_2 \leftarrow || \mathbf{p}_2 - \mathbf{q}_m ||$ \tcp{distances to projection points}
                $\textit{x}_2 \leftarrow \textit{x}_2 * ( \frac{\textit{d}_1 + \textit{d}_2}{0.5*||\mathbf{q}_{init} - \mathbf{q}_{goal}||} )$
                % \If{$ \textit{d}_1 + \textit{d}_2 < \textit{x}_2$}{ % begin if 1
                %     $\textit{x}_2 \leftarrow \textit{d}_1 + \textit{d}_2$ \tcp{shortest distance to a local minimum search-space region found thus far}
                % } % end if 1
        
            } % end for 3
            
            $\textit{g}_2 \leftarrow  (\ -\textit{exp}( \ -\textit{x}_2^2 \ / \ 2\textit{c}_2^2 ) + 1 \ ) $ \tcp{second Gaussian term}
            \If{ $ (\textit{w}_1 * \textit{g}_1) * (\textit{w}_2 * \textit{g}_2) > \textit{best\_value} $ }{ % begin if 2
                $\textit{best\_value} =(\textit{w}_1 * \textit{g}_1) * (\textit{w}_2 * \textit{g}_2)$ \\
                $ R[\mathbf{q}_n^*, \mathbf{q}_m^*] \leftarrow R[\mathbf{q}_n, \mathbf{q}_m]$ \tcp{update best search-space region found thus far}
            } % end if 2
            
        } % end for 2
    } % end for 1
}

\Return{$R[\mathbf{q}_n^*, \mathbf{q}_m^*]$ \tcp{return best overall search-space region found} }

\caption{ \footnotesize \texttt{probability\_heuristic\_1(}$ N_g, M, R_{localmin} \texttt{)}$ }
\end{algorithm}
}


%%%%%% VALID EXTEND NODE %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand{\algValidNode}{
\begin{algorithm}[t]
\scriptsize
\label{alg:valid_node}
\If{$\mathbf{q}_x \in N_{checkpoints}$}{
    \Return{false} \tcp{prevents a node from being extended more than twice}
}

$\kappa \leftarrow 0.3$ \tcp{lower bound for allowable probability}
\For{$\text{all} \ \mathbf{q} \in N_{checkpoints} \cap \Gamma[(\mathbf{q}_n^*, \mathbf{q}_x)]$ \tcp{all checkpoints on the path from $\mathbf{q}_x$ back to $\mathbf{q}_n^*$}}{ % start for 1 
    $\textit{x}_1 \leftarrow H_{exploit}[\mathbf{q}][0] \ / \ H_{num}[\mathbf{q}]; \ \textit{x}_2 \leftarrow H_{explore}[\mathbf{q}][0] \ / \ H_{num}[\mathbf{q}]$ \\
    $\textit{x} \leftarrow \texttt{min(} \textit{x}_1, \textit{x}_2 \texttt{)}$ \\
    $c \leftarrow log_{2}(H_{num}[\mathbf{q}])^{-1}$ \\
    $\textit{g} \leftarrow \textit{exp}( \ -\textit{x}^2 \ / \ 2\textit{c}^2 )$ \tcp{Gaussian value}
    \If{ $\textit{g} < \kappa$ }{ % if 1
        \Return{false} \tcp{if even one checkpoint is below the probability threshold, the node is considered invalid to extend}
    } % end if 1

} % end for 1
\Return{true}

% \caption{\footnotesize $\texttt{is\_valid\_extend\_node(}\mathbf{q}_x, T_{\ell},  N_{checkpoints}, \newline  D_{exploit}, D_{explore}, D_{num} \texttt{)}$ }
\caption{\footnotesize $\texttt{probability\_heuristic\_2(} \mathbf{q}_x, T_{\ell}, \Omega_{\ell}  \texttt{)}$}
\end{algorithm}
}

%%%%%% LOCAL EDGE %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand{\algLocalEdge}{
\begin{algorithm}[t]
\footnotesize
\label{alg:local_edge}
$\textit{w}_1 \leftarrow 0.5; \ \textit{w}_2 \leftarrow 1; \ \textit{w}_3 \leftarrow 1.2$ \\ 
$\mathbf{q}_c \leftarrow \mathbf{q}_x + (\mathbf{q}_x - \mathbf{q}_p)$ \tcp{initial condition prior to gradient ascent}
$N_{obs} \leftarrow \texttt{get\_nearby\_collision\_points}(\mathbf{q}_x, T_{\ell}, \Omega_{\ell})$
\If{$|N_{obs}| > 0$}{ $\mathbf{q}_c \mathrel{+}= \xi$ \tcp{small amount of noise} }
\For{ $0...$\text{num\_iters} }{ % for loop
    $\mathbf{q}_c \mathrel{+}= (\textit{w}_1 \frac{\partial \textit{g}_1}{\partial \mathbf{q}_c}) + (\textit{w}_2 \frac{\partial \textit{g}_2}{\partial \mathbf{q}_c}) + (\texttt{hvs}(|N_{obs}|) * \textit{w}_3 \frac{\partial \textit{g}_3}{\partial \mathbf{q}_c})$ \tcp{ Equations \ref{eq:probability_model3_1}, \ref{eq:probability_model3_2}, and \ref{eq:probability_model3_3}, respectively }
    % $\mathbf{q}_c \mathrel{+}= \textit{w}_1 * \frac{\partial \textit{g}_1}{\partial \mathbf{q}_c}$ \tcp{Equation \ref{eq:probability_model3_1}}
    % $\mathbf{q}_c \mathrel{+}= \textit{w}_2 * \frac{\partial \textit{g}_2}{\partial \mathbf{q}_c}$ \tcp{Equation \ref{eq:probability_model3_2}}
    % \If{$|N_{obs}| > 0$}{
    %    $\mathbf{q}_c \mathrel{+}=\textit{w}_3 * \frac{\partial \textit{g}_3}{\partial \mathbf{q}_c}$ \tcp{Equation \ref{eq:probability_model3_3}}    
    % }
    $\mathbf{q}_c \leftarrow \mathbf{q}_x + \lambda * \frac{\mathbf{q_c} - \mathbf{q_x}}{||\mathbf{q_c} - \mathbf{q_x}||}$ \tcp{re-set to length $\lambda$}
}
\Return{ $R[\mathbf{q}_x, \mathbf{q}_c]$ }

\caption{\footnotesize $\texttt{probability\_heuristic\_3(} \mathbf{q}_x, T_{\ell}, \Omega_{\ell} \texttt{)}$}
\end{algorithm}
}



%%%%%% COLLISION POINTS %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand{\algCollisionPoints}{
\begin{algorithm}[t]
\scriptsize
\label{alg:collision_points}

$N_{obs} \leftarrow \emptyset$ \\
\For{$\mathbf{q}_{checkpoint} \in N_{checkpoints} \cap \Gamma[\mathbf{q}_n^*, \mathbf{q}_x]$ \tcp{Ordered set of checkpoints from $\mathbf{q}_x$ back to $\mathbf{q}_n^*$}}{
    
    \For{$\mathbf{q}_{obs} \in H_{obs}[\mathbf{q}_{checkpoint}]$} {
        \If{$\mathbf{q}_{obs} \notin N_{obs}$}{
            $N_{obs} \stackrel{+}\leftarrow \mathbf{q}_{obs}$ \tcp{add collision point to $N_{obs}$}
        }
        \If{$ | N_{obs} | > \textit{m}$}{ \tcp{$m$ is some maximum capacity of $N_{obs}$, \textit{e.g.} 10}
            \Return{$N_{obs}$}
        }
    }
}
% $N_{obs} \leftarrow D_{obs}[B[j]]$ \tcp{Set of collision points mapped from the $j$th checkpoint ``behind'' $\mathbf{q}_x$ ($j$ clipped to $ \leq |B|$)}
% \For{}{}
% \If{ $\rvert N_{obs} \rvert > \textit{m}$ }{
%    $N_{obs} \leftarrow \text{the last} \ \textit{m} \ \text{points added to} \ D_{obs}[B[j]]$
% }
\Return{$N_{obs}$}
\caption{\scriptsize $\texttt{get\_nearby\_collision\_points(} \mathbf{q}_x, T_{\ell}, \Omega_{\ell} \texttt{)}$}
\end{algorithm}
}


%%%%%%% TOUGH GRADIENT %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand{\algToughGradient}{
\begin{algorithm}[t]
\scriptsize
\label{alg:tough_gradient}
$\textit{d}_1 \leftarrow ((\mathbf{q}_c - \mathbf{q}_x) \cdot (\mathbf{q}_c - \mathbf{q}_x))^{1/2} \ ; \ \textit{d}_2 \leftarrow ((\mathbf{q}_c - \mathbf{q}_x) \cdot (\mathbf{q}_c - \mathbf{q}_x))^{3/2}$ \\ 
$\vec{v}_c \leftarrow \frac{\mathbf{q}_c - \mathbf{q}_x}{|| \mathbf{q}_c - \mathbf{q}_x ||}$ \\
$\frac{\partial \textit{y}}{\partial \mathbf{q}_c} \leftarrow \mathbf{0} \in \mathbb{R}^n $ \\ 
\For{$i = 0 \cdots n$}{
    $\textit{u} \leftarrow 0$ \\
    \For{$j = 0 \dots n, j \neq \ i$}{
        $\textit{u} \leftarrow \textit{u} - \frac{\vec{v}[i] * \vec{v}_c[i] * \vec{v}_c[j]}{\textit{d}_2}$
    }
    $\frac{\partial \textit{y}}{\partial \mathbf{q}_c}[i] \leftarrow \frac{\vec{v}[i]}{\textit{d}_1} - \frac{\vec{v}[i] * \vec{v}_c[i]^2}{\textit{d}_2} - \textit{u}$
}
\Return{$\frac{\partial \textit{y}}{\partial \mathbf{q}_c}$}


\caption{\scriptsize $\texttt{ gradient\_y\_with\_respect\_to\_qc (} \vec{v}, \mathbf{q}_c, \mathbf{q}_x \texttt{)}$}
\end{algorithm}
}


%%%%%% TERM GRADIENT %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand{\algTermGradient}{
\begin{algorithm}[t]
\scriptsize
\label{alg:term_gradient}
% $\vec{v}_c \leftarrow \frac{\mathbf{q}_c - \mathbf{q}_x}{|| \mathbf{q}_c - \mathbf{q}_x ||}$ \\

$\frac{\partial \textit{x}}{\partial \textit{y}} \leftarrow - 1 \ / \ \sqrt{1 - \textit{y}^2}$

% $\frac{\partial \textit{y}}{\partial \mathbf{q}_c} \leftarrow \mathbf{0} \in \mathbb{R}^n $ \tcp{initialization, constructed iteratively below}

$\vec{v}_d \leftarrow (\mathbf{q}_c - \mathbf{q}_x) \ ; \ \textit{d}_0 \leftarrow \vec{v}_d \cdot \vec{v}_d \ ; \ \textit{d}_1 \leftarrow \textit{d}_0^{1/2} \ ; \ \textit{d}_2 \leftarrow \textit{d}_0^{3/2}$ \\ 


$\frac{\partial \textit{y}}{\partial \mathbf{q}_c} \leftarrow -\textit{d}_2^{-1} * [(\vec{v} \cdot\vec{v}_d) * \vec{v}_d] + \textit{d}_1^{-1} * \vec{v}$ \\


\Return{ $\frac{\partial \textit{g}}{\partial \textit{x}} \frac{\partial \textit{x}}{\partial \textit{y}} \frac{\partial \textit{y}}{\partial \mathbf{q}_c}$ }

\caption{\scriptsize $\texttt{ get\_full\_term\_gradient(} \mathbf{q}_c, \mathbf{q}_x, \vec{v}, \textit{x}, \textit{y}, \frac{\partial \textit{g}}{\partial \textit{x}} \texttt{)}$}
\end{algorithm}
}

%%%%% COMMON FUNCTIONS %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand{\algCommonFunctions}{
\begin{algorithm}[t]
\footnotesize
\label{alg:common_functions}
$\texttt{proj\_scalar}(\mathbf{q}, R[\mathbf{q}_a, \mathbf{q}_b]) = \frac{(\mathbf{q} - \mathbf{q}_a) \cdot (\mathbf{q}_b - \mathbf{q}_a)}{ (\mathbf{q}_b - \mathbf{q}_a) \cdot (\mathbf{q}_b - \mathbf{q}_a) } $\\
$\texttt{proj}(\mathbf{q}, R[\mathbf{q}_a, \mathbf{q}_b]) = \mathbf{q}_a + \texttt{proj\_scalar}(\mathbf{q}, R[\mathbf{q}_a, \mathbf{q}_b]) * (\mathbf{q}_b - \mathbf{q}_a)$\\
$\texttt{proj}_+(\mathbf{q}, R[\mathbf{q}_a, \mathbf{q}_b]) = \mathbf{q}_a + \texttt{max}(\texttt{proj\_scalar}(\mathbf{q}, R[\mathbf{q}_a, \mathbf{q}_b]), 0) * (\mathbf{q}_b - \mathbf{q}_a)$\\
$\texttt{hvs}(\textit{x}) = \begin{cases}  0 & \text{if $\textit{x} \leq 0$} \\ 1 & \text{if $\textit{x} > 0$}   \end{cases}$ \tcp{Heaviside step function}
\caption{Common Functions}
\end{algorithm}
}
