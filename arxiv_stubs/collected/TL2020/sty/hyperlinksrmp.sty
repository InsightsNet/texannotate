%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Hyperlinks with "title" included in the clickable part.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Various
\newcommand{\charef}[1]{Chapter~\ref{#1}} % Chapter #
\newcommand{\appendixref}[1]{Appendix~\ref{#1}} % Appendix #
\newcommand{\secref}[1]{Sec.~\ref{#1}} % Section #
%\newcommand{\secsref}[1]{Sections \ref{#1}} % Sections #
\newcommand{\figref}[1]{Fig.~\ref{#1}} % Figure #
\newcommand{\tableref}[1]{Table~\ref{#1}} % Table  #
\newcommand{\pref}[1]{page~\pageref*{#1}} % page #
\newcommand{\caseref}[1]{Case~\ref{#1}} % Case #
\newcommand{\footnoteref}[1]{Footnote~\ref{#1}} % Footnote #

% Equations
\newcommand{\eqnref}[1]{Eq.~(\ref{#1})} % Eq. (#)
\newcommand{\eqnsref}[1]{Eqs.~\eqref{#1}} % Eqs. (#)
\newcommand{\critref}[1]{Criterion~(\ref{#1})} % Criterion. (#)

% Theorems and definitions
\newcommand{\thmref}[1]{Theorem~\ref{#1}}
\newcommand{\lemref}[1]{Lemma~\ref{#1}}
\newcommand{\lemsref}[1]{Lemmas \ref{#1}}
\newcommand{\corref}[1]{Corollary~\ref{#1}}
\newcommand{\claimref}[1]{Claim~\ref{#1}}
\newcommand{\defref}[1]{Definition~\ref{#1}}
\newcommand{\defsref}[1]{Definitions \ref{#1}}
\newcommand{\conjecref}[1]{Conjecture~\ref{#1}}
\newcommand{\propref}[1]{Proposition~\ref{#1}}
\newcommand{\problemref}[1]{Problem~\ref{#1}}
\newcommand{\noteref}[1]{Note~\ref{#1}}
\newcommand{\remref}[1]{Remark~\ref{#1}}
\newcommand{\exref}[1]{Example~\ref{#1}}

% short hyperlinks

\newcommand{\shortthmref}[1]{Thm.~\ref{#1}}
\newcommand{\shortlemref}[1]{Lem.~\ref{#1}}
\newcommand{\shortcorref}[1]{Cor.~\ref{#1}}
\newcommand{\shortthmrefbreak}[1]{Thm.\ \ref{#1}}
\newcommand{\shortlemrefbreak}[1]{Lem.\ \ref{#1}}
\newcommand{\shortcorrefbreak}[1]{Cor.\ \ref{#1}}


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%  multiple links to the same footnote
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\footnoteremember}[2]{\footnote{\label{#1}#2}\newcounter{#1}\setcounter{#1}{\value{footnote}}}
\newcommand{\footnoterecall}[1]{\hyperref[#1]{\footnotemark[\value{#1}]}}