%Set Directory to store externalized graphics
\DeclareStringOption[Externals/]{Externaldir}

\DeclareBoolOption{Remake}
%remake all tikzpictures if set
\DeclareBoolOption{Publish}
%switch off tikz and pgf completely, just load pictures instead, useful for submitting a paper when one can't rely on a tikz system beeing present
\DeclareBoolOption{BW}
%color model gray for black and white printing
\DeclareBoolOption{ComplainAboutUnexternalized}
%issue warning for non externalized tikzpictures
\DeclareBoolOption{PatchTodo}
%Patch todo command to get rid of all the non externalized tikzpicture warnings
\DeclareBoolOption{PatchBeamer}
%Patch the maketitle command of Beamer to get rid of non externalized tikzpicture warning due to tikzpictures in head and footline
\DeclareBoolOption{Disable}
%Plottet Platzhalter statt grafiken
\DeclareBoolOption{Help}
%print all options

\ProcessKeyvalOptions*

\relax


