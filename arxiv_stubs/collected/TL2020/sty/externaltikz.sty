\newcommand\tikzremakenext{\tikzset{external/remake next}\PackageWarning{externaltikz}{tikz remake next aktiv !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!}}

\ifext@Publish
	%nichts tun, da bilder nur eingebunden werden. 	
\else
	%externalize initialisieren
	\usepgfplotslibrary{external}
	\tikzexternalize[prefix=\ext@Externaldir,up to date check=md5]
	\tikzexternaldisable
	\pgfplotscreateplotcyclelist{color mod}{% 
	blue!30,every mark/.append style={fill=blue!30!black},mark=*\\%
	red!60,every mark/.append style={fill=red!30!black},mark=square*\\%
	brown!60!black,every mark/.append style={fill=brown!80!black},mark=diamond\\%
	black,mark=triangle\\%
	blue,every mark/.append style={fill=blue!80!black},mark=diamond*\\%
	red,densely dashed,every mark/.append style={solid,fill=red!80!black},mark=*\\%
	brown!60!black,densely dashed,every mark/.append style={
		solid,fill=brown!80!black},mark=square*\\%
	black,densely dashed,every mark/.append style={solid,fill=gray},mark=otimes*\\%
	blue,densely dashed,mark=star,every mark/.append style=solid\\%
	red,densely dashed,every mark/.append style={solid,fill=red!80!black},mark=diamond*\\%
	}
	\ifext@BW
		\selectcolormodel{gray} 	%black/white switch
	\fi
	
	\newlength{\Bildb}
	\newlength{\Bildh}
	\newlength{\Bildanker}
	\newlength{\Bildbbig}
	
\fi

\newif\ifinsideexternaltikz
\insideexternaltikzfalse

\newcommand{\externaltikz}[2]{
	\ifext@BW
		\def\externaltikzfigurename{#1-BW}
	\else
		\def\externaltikzfigurename{#1}
	\fi
	\ifext@Publish
		\includegraphics{\ext@Externaldir\externaltikzfigurename}		
	\else
		\ifext@Remake
		\tikzremakenext
		\fi
		\insideexternaltikztrue
		\tikzexternalenable
		%\tikzset{external/export next=true} 	
		\tikzsetnextfilename{\externaltikzfigurename} #2%
		\tikzexternaldisable	
		\insideexternaltikzfalse
	\fi
}

\ifext@Disable
\renewcommand{\externaltikz}[2]{
	\begin{tikzpicture}
		\node[draw,shape=rectangle,scale=10] (N1) {Draft};
	\end{tikzpicture}
}	
\fi


%Patch tikzpicture to include warning if not inside an externaltikz command
\ifext@ComplainAboutUnexternalized
\def\tikz@picture[#1]{%
	\ifinsideexternaltikz\else\PackageWarning{externaltikz}{Non externalized tikzpicture!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!}\fi
	\pgfpicture%
	\let\tikz@atbegin@picture=\pgfutil@empty%
	\let\tikz@atend@picture=\pgfutil@empty%
	\let\tikz@transform=\relax%
	\def\tikz@time{.5}%
	\tikz@installcommands\scope[every picture,#1]%
	\expandafter\tikz@atbegin@picture%
	\tikz@lib@scope@check%
}
\fi

%patch \todo to avoid all those warnings about non externalized tikzpictures
\ifext@PatchTodo
\renewcommand{\todo}[2][]{\insideexternaltikztrue\@bsphack\@todo[#1]{#2}\@esphack\ignorespaces\insideexternaltikzfalse}%
%\pretocmd{\todo}{\insideexternaltikztrue}{}{}
%\apptocmd{\todo}{\insideexternaltikzfalse}{}{}
\fi

\ifext@PatchBeamer     
%Patch the maketitle command of Beamer to get rid of non externalized tikzpicture warning due to tikzpictures in head and footline 
\apptocmd{\maketitle}{             
\addtobeamertemplate{headline}{\insideexternaltikztrue}{\insideexternaltikzfalse}
\addtobeamertemplate{footline}{\insideexternaltikztrue}{\insideexternaltikzfalse}
\insideexternaltikzfalse
}{}{}
\pretocmd{\maketitle}{\insideexternaltikztrue}{}{}
\fi
                           
