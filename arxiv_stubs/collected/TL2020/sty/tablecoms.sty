
\usepackage{calc}
\usepackage{forloop}
\usepackage{tikz}
\usetikzlibrary{math}
\usetikzlibrary{fpu}
\usepackage{tablecoms}

        \newcommand{\findmax}[5]{
        \pgfplotstablevertcat{\datatable}{#1}
    
 \tikzmath{\mathVal=0;}
 \tikzmath{\x=0;}
 \tikzmath{\row = #3;}
 \tikzmath{\maxrow=0;}
 \foreach \n[remember=\mathVal as \mathVal,remember=\maxrow as \maxrow,remember
=\row as \row] in {0, ..., #4}{
 \pgfmathtruncatemacro{\idx}{\row}
           \pgfplotstablegetelem{\idx}{#2}\of{\datatable}
 \tikzmath{\x=\pgfplotsretval;}
 \tikzmath{
      if \x>\mathVal then {
      \mathVal=\x;
      \maxrow=\row;
      };
      } 
  \tikzmath{\row= \row + 1;}


\xdef\lastv{\maxrow}
}
 \pgfmathtruncatemacro#5{\lastv}
  
  }

        \newcommand{\findmin}[5]{
        \pgfplotstablevertcat{\datatable}{#1}
    
 \tikzmath{\mathVal=2;}
 \tikzmath{\x=0;}
 \tikzmath{\row = #3;}
 \tikzmath{\maxrow=0;}
 \foreach \n[remember=\mathVal as \mathVal,remember=\maxrow as \maxrow,remember
=\row as \row] in {0, ..., #4}{
 \pgfmathtruncatemacro{\idx}{\row}
           \pgfplotstablegetelem{\idx}{#2}\of{\datatable}
 \tikzmath{\x=\pgfplotsretval;}
 \tikzmath{
      if \x<\mathVal then {
      \mathVal=\x;
      \maxrow=\row;
      };
      } 
  \tikzmath{\row= \row + 1;}


\xdef\lastv{\maxrow}
}
 \pgfmathtruncatemacro#5{\lastv}
  
  }


\pgfplotstableset{
    highlight col max/.code 2 args={
        \findmax{#1}{#2}{0}{4}{\lastv}
        \edef\setstyles{\noexpand\pgfplotstableset{
                every row \lastv\noexpand\space column #2/.style={
                    postproc cell content/.append style={
                        /pgfplots/table/@cell content/.add={$\noexpand\bf}{$}
                    },
                }
            }
        }\setstyles
    }
}
