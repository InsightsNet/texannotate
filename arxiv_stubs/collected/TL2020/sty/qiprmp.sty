\newcommand{\id}{\ensuremath{\operatorname{id}}}
\newcommand{\I}{\ensuremath{\mathds{I}}}
\newcommand{\1}{\ensuremath{\mathds{1}}}
\newcommand{\conj}[1]{\ensuremath{#1^*}}
\newcommand{\trans}[1]{\ensuremath{#1^{\mathsf{T}}}}
\newcommand{\hconj}[1]{\ensuremath{#1^\dag}}

% trace operator
% usage: \trace{\rho} for simple trace with argument
% usage: \trace[A]{\rho_{AB}} to trace out system A
% usage: \ktrace to get square brackets
% usage: \tr for just the operator, no argument or brackets
\DeclareMathOperator{\tr}{tr}
\newcommand{\strace}[2][@]{\ensuremath{\tr\ifthenelse{\equal{#1}{@}}{}{_{#1}}(#2)}}
\newcommand{\ltrace}[2][@]{\ensuremath{\tr\ifthenelse{\equal{#1}{@}}{}{_{#1}}\left(#2\right)}}
\newcommand{\ktrace}[2][@]{\ensuremath{\tr\ifthenelse{\equal{#1}{@}}{}{_{#1}}\left[#2\right]}}
\newcommand{\trace}[2][@]{\if@display\ltrace[#1]{#2}\else\strace[#1]{#2}\fi}


\newcommand{\sspan}[1]{{\ensuremath{\operatorname{span}(#1)}}}
\newcommand{\lspan}[1]{{\ensuremath{\operatorname{span}\left(#1\right)\!}}}
\newcommand{\vspan}[1]{\if@display\lspan{#1}\else\sspan{#1}\fi}

\newcommand{\vectorclosure}[1]{\ensuremath{\mathrm{clos}\left(#1\right)}} % Undocumented

\newcommand{\rank}[1]{{\ensuremath{\operatorname{rank}(#1)}}}


