\newcommand{\distinguishOp}{p_{\operatorname{distinguish}}}
\newcommand{\sdistinguish}[1]{\ensuremath{\distinguishOp(#1)}}
\newcommand{\ldistinguish}[1]{\ensuremath{\distinguishOp\left(#1\right)}}
\newcommand{\distinguish}[1]{\if@display\ldistinguish{#1}\else\sdistinguish{#1}\fi}

\newcommand{\ddistinguishOp}{p^{\fD}_{\operatorname{distinguish}}}
\newcommand{\sddistinguish}[1]{\ensuremath{\ddistinguishOp(#1)}}
\newcommand{\lddistinguish}[1]{\ensuremath{\ddistinguishOp\left(#1\right)}}
