\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{custom}

%%%% MATHS

%% Provide dcases (better display of fractions than cases from AMS), definition of new delimiters with \DeclarePairedDelimiter, fine math adjustments
\usepackage{mathtools} 

%% Provides mathscr command
\usepackage{mathrsfs}  

%% Non built-in functions
\newcommand{\sgn}{\mbox{sgn}} 

%% Dimensionless groups: Italic font
\let\Ree=\Re % rename builtin command \Re to \Ree
\let\Prr=\Pr % rename builtin command \Pr to \Prr
\renewcommand{\Re}{\mbox{\textit{Re}}}
\newcommand{\Fr}{\mbox{\textit{Fr}}}
\newcommand{\We}{\mbox{\textit{We}}}
\newcommand{\Ar}{\mbox{\textit{Ar}}}
\newcommand{\Eo}{\mbox{\textit{Eo}}}
\newcommand{\Bo}{\mbox{\textit{Bo}}}
\newcommand{\Mo}{\mbox{\textit{Mo}}}
\newcommand{\Ga}{\mbox{\textit{Ga}}}
\newcommand{\Ca}{\mbox{\textit{Ca}}}
\newcommand{\Pe}{\mbox{\textit{Pe}}}
\newcommand{\Sh}{\mbox{\textit{Sh}}}
\newcommand{\St}{\mbox{\textit{St}}}
\newcommand{\Sr}{\mbox{\textit{Sr}}}
\renewcommand{\Pr}{\mbox{\textit{Pr}}}
\newcommand{\Sc}{\mbox{\textit{Sc}}}

%% Constants: Upright Roman font
\let\dotlessi=\i % rename builtin command \i{} to \dotlessi{}
\renewcommand{\i}{\mathrm{i}}

%% Orders: Italic font
\let\OO=\O % rename builtin command \O to \OO
\let\oo=\o % rename builtin command \o to \oo
\renewcommand{\O}{\textit{O}}
\renewcommand{\o}{\textit{o}}

%% Vectors: Bold italic font
\let\vaccent=\v % rename builtin command \v{} to \vaccent{}
\let\divsymb=\div % rename builtin command \div to \divsymb
\renewcommand*{\v}[1]{\boldsymbol{#1}}
\newcommand{\grad}{\bnabla} % gradient
\renewcommand{\div}{\bnabla\bcdot} % divergence
\newcommand{\curl}{\bnabla\times} % curl

%% Tensors and matrices: Bold sloping sans serif font
\newcommand{\m}[1]{\mathsfbi{#1}}

%% Differential and derivatives
\let\underdot=\d
\renewcommand{\d}{\mathrm{d}}
\newcommand{\id}{\, \d} % integral upright d
\newcommand{\pd}[3][]{\frac{\partial^{#1} #2}{\partial #3^{#1}}} % multiple partial derivatives \pd[order(optional)]{top}{bottom}

%% Delimiters
\usepackage{ifthen}
\newcommand{\autodelimiters}[3][-1]{
% arg1: control the size (optional)
% arg2: inside
% arg3: type of delimiter
\ifthenelse{\equal{#1}{-1}}{ % if
#3*{#2}}{}
\ifthenelse{\equal{#1}{0}}{ % if
#3{#2}}{}
\ifthenelse{\equal{#1}{1}}{ % if
#3[\big]{#2}}{}
\ifthenelse{\equal{#1}{2}}{ % if
#3[\Big]{#2}}{}
\ifthenelse{\equal{#1}{3}}{ % if
#3[\bigg]{#2}}{}
\ifthenelse{\equal{#1}{4}}{ % if
#3[\Bigg]{#2}}{}
}

\DeclarePairedDelimiter\delimparen{(}{)}
\DeclarePairedDelimiter\delimsquare{[}{]}
\DeclarePairedDelimiter\delimcurly{\{}{\}}
\DeclarePairedDelimiter\delimvert{\lvert}{\rvert}
\DeclarePairedDelimiter\delimVert{\lVert}{\rVert}
\DeclarePairedDelimiter\delimangle{\langle}{\rangle}

\newcommand{\pa}[2][-1]{\autodelimiters[#1]{#2}{\delimparen}}
\newcommand{\sq}[2][-1]{\autodelimiters[#1]{#2}{\delimsquare}}
\newcommand{\cb}[2][-1]{\autodelimiters[#1]{#2}{\delimcurly}}

\newcommand{\abs}[2][-1]{\autodelimiters[#1]{#2}{\delimvert}}
\newcommand{\norm}[2][-1]{\autodelimiters[#1]{#2}{\delimvert}}
\newcommand{\normtwo}[2][-1]{\autodelimiters[#1]{#2}{\delimVert}}
\newcommand{\avg}[2][0]{\autodelimiters[#1]{#2}{\delimangle}}


%%%% MISC

% Tables
\usepackage{multicol, multirow}

% Smart cross-referencing: automatically includes ``Figure'', ``Equation'', etc. when referencing. Command is \cref
\usepackage[noabbrev]{cleveref}

% Do not write ``Equation'' (X) but just (X)
\crefformat{equation}{(#2#1#3)} % for simple equation
\crefrangeformat{equation}{(#3#1#4) to~(#5#2#6)} % for range
\crefmultiformat{equation}{(#2#1#3)}{ and~(#2#1#3)}{, (#2#1#3)}{ and~(#2#1#3)} % for list with ``and''

