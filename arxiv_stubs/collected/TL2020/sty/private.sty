%Definition of Environments for Theorems, Lemmata, 
%Propositions and Definitions
%\theoremstyle{break}
\theoremheaderfont{\normalfont\bfseries}
\theorembodyfont{\normalfont} 
%\theoremsymbol{\ensuremath{\bullet}}
\theoremsymbol{\ensuremath{\varspade}}
\theorempreskip{0.3cm}
\theoremseparator{\vspace{0.1em}}%\medskip

\newtheorem{thm}{Theorem}

\newtheorem{theorem}{Theorem}[section]

\newtheorem{lemma}[theorem]{Lemma}

\newtheorem{assumption}[theorem]{Assumption}

\newtheorem{example}[theorem]{Example}

\newtheorem{proposition}[theorem]{Proposition}

\newtheorem{notation}[theorem]{Notation}

\newtheorem{definition}[theorem]{Definition}

\newtheorem{remark}[theorem]{Remark}

\newtheorem{corollary}[theorem]{Corollary}

\newframedtheorem{fproposition}[theorem]{Proposition}

\theoremstyle{break}
\theoremheaderfont{\normalfont\bfseries}
\theorembodyfont{\normalfont} 
\theoremsymbol{}
\theoremseparator{\vspace{0.01em}}%\medskip 

\theoreminframepreskip{0cm}
\theoreminframepostskip{0cm}
\theoremframepreskip{0.5cm}
\theoremframepostskip{0.5cm}
\newframedtheorem{framedtheorem}{Theorem}[section]



%Definition of an Environment for Proofs 
\theoremstyle{nonumberbreak}
\theoremheaderfont{\itshape}
\theorembodyfont{\upshape} 
\theoremseparator{.} 
\theoremsymbol{\rule{1ex}{1ex}}
