\ProvidesPackage{quantum}[2012/03/12 v0.1 Provides notation for quantum theory such as Dirac notation, and includes shortcuts for commonly used functions, operators and delimiters in quantum information theory.]

%%
%% Options: change the brackets of the trace from round to square and
%% change to lower case forms of Tr, Prob, and Pr.
%%
\newcommand{\TraceCase}{\mathrm{Tr}}
\newcommand{\ProbCase}{\mathrm{Prob}}
\newcommand{\PrCase}{\mathrm{Pr}}
\newcommand{\LeftTraceBracket}{(}
\newcommand{\RightTraceBracket}{)}
\DeclareOption{SquareTraceBrackets}{%
\renewcommand{\LeftTraceBracket}{[}%
\renewcommand{\RightTraceBracket}{]}%
}
\DeclareOption{LowerCaseTrace}{%
\renewcommand{\TraceCase}{\mathrm{tr}}%
}
\DeclareOption{LowerCaseProb}{%
\renewcommand{\ProbCase}{\mathrm{pr}}%
}
\DeclareOption{LowerCasePr}{%
\renewcommand{\PrCase}{\mathrm{pr}}%
}
\DeclareOption*{\PackageWarning{quantum}{Unknown option `\CurrentOption'}}
\ProcessOptions\relax

\RequirePackage{amsmath} % required for \DeclareMathOperator, etc.
\RequirePackage{mathtools} % used for \prescript
\RequirePackage{xparse} % used for overloading function definitions
\RequirePackage{bbm} % for double-struck math fonts

%% ket
%% PK: I added an option that puts a subscript on the ket (and the bra).
%%
\newcommand{\ket}[2][]{\lvert #2\rangle_{#1}}
\newcommand{\Ket}[2][]{\left\lvert #2\right\rangle_{#1}}
\newcommand{\bigket}[2][]{\bigl\lvert #2\bigr\rangle_{#1}}
\newcommand{\Bigket}[2][]{\Bigl\lvert #2\Bigr\rangle_{#1}}
\newcommand{\biggket}[2][]{\biggl\lvert #2\biggr\rangle_{#1}}
\newcommand{\Biggket}[2][]{\Biggl\lvert #2\Biggr\rangle_{#1}}
%%
%% bra
%%
\newcommand{\bra}[2][]{{}_{#1} \langle #2\rvert}
\newcommand{\Bra}[2][]{\prescript{}{#1}{\left\langle #2\right\rvert}}
\newcommand{\bigbra}[2][]{{}_{#1} \bigl\langle #2\bigr\rvert}
\newcommand{\Bigbra}[2][]{{}_{#1} \Bigl\langle #2\Bigr\rvert}
\newcommand{\biggbra}[2][]{{}_{#1} \biggl\langle #2\biggr\rvert}
\newcommand{\Biggbra}[2][]{{}_{#1} \Biggl\langle #2\Biggr\rvert}


%% braket
%%
%% PK: I would like two options to this command, corresponding to
%% subscripts on the left and the right.
%% STF: I have something nice to show everyone:

\NewDocumentCommand \braket
{ >{ \SplitArgument{2}{|} } m o }
    { \InternalFunctionbraket #1 }

\NewDocumentCommand \InternalFunctionbraket
{ m m m o }
    {\IfValueTF {#3}
       { \langle \mathopen{}#1\mathclose{} \vert \mathopen{}#2\mathclose{} \vert \mathopen{}#3\mathclose{} \rangle }
       {\IfValueTF{#2}
           { \langle  \mathopen{}#1\mathclose{} \vert \mathopen{}#2\mathclose{} \rangle}
           { \langle \mathopen{}#1\mathclose{} \rangle }
       }
    }


\NewDocumentCommand \Braket
{ >{ \SplitArgument{2}{|} } m o }
    { \InternalFunctionBraket #1 }

\NewDocumentCommand \InternalFunctionBraket
{ m m m o }
    {\IfValueTF {#3}
       { \left\langle #1 \middle\vert #2 \middle\vert #3 \right\rangle }
       {\IfValueTF{#2}
           { \left\langle #1 \middle\vert #2 \right\rangle}
           { \left\langle #1 \right\rangle }
       }
    }

