% This pair of commands parses the input and resizes the internal \vert commands appropriately. :)
% I just added room for an optional argument at the end, but I didnÕt give it any functionality yet...
% I envision a command which works as follows:
% \braket{<arg1> | <arg2> | <arg3>}[<size>]
% here <size> is an optional command:
% if it is omitted, then you get the regular braket with default size,
% 0 = \left \right delimited, i.e. expandable
% 1 = \big delimited
% 2 = \Big delimited
% 3 = \bigg delimited
% 4 = \Bigg delimited
% else default size again.
% This would have the advantage that we always have just ONE command, and a single optional argument with some logical (albeit unconventional) way to resize everything simultaneously.
% Another option would be to have two functions, \braket and \Braket, where only the second one automatically resizes, but the first one takes an optional input for resizing.  

%%
%%
%%
\newcommand{\tr}[2][]{\TraceCase_{#1} \LeftTraceBracket #2 \RightTraceBracket}
\newcommand{\Tr}[2][]{\TraceCase_{#1} \mathopen{}\left\LeftTraceBracket #2 \right\RightTraceBracket\mathclose{}}

\newcommand{\prob}[1]{\ProbCase(#1)}
\NewDocumentCommand \Prob
{ >{ \SplitArgument{1}{|} } m o }
    { \InternalFunctionProb #1 }

\NewDocumentCommand \InternalFunctionProb
{ m m o }
     {\IfValueTF{#2}
         {\ProbCase \mathopen{}\left( #1 \middle\vert #2 \right)\mathclose{}}
         {\ProbCase \mathopen{}\left( #1 \right)\mathclose{}}
    }

\newcommand{\pr}[1]{\PrCase(#1)}
\RenewDocumentCommand \Pr
{ >{ \SplitArgument{1}{|} } m o }
    { \InternalFunctionPr #1 }

\NewDocumentCommand \InternalFunctionPr
{ m m o }
     {\IfValueTF{#2}
         {\PrCase \mathopen{}\left( #1 \middle\vert #2 \right)\mathclose{}}
         {\PrCase \mathopen{}\left( #1 \right)\mathclose{}}
    }

\DeclareMathOperator{\rank}{rank}

