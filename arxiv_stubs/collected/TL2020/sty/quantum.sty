%% Start MJE additions - to make my most used macros work.
%
% Please place after \usepackage{quantum} and before \begin{document}
%
% space makes macros that use math work with punctuation marks when used inline.
\usepackage{xspace}
% make it easy to colour text in primary colours.
\newcommand{\RED}[1]{\textcolor{red}{#1}\xspace}
\newcommand{\BLUE}[1]{\textcolor{blue}{#1}\xspace}
\newcommand{\GREEN}[1]{\textcolor{green}{#1}\xspace}
% Matrix Element
\newcommand{\ME}[3] {\ensuremath{\left\langle {#1} {\left| {#2} \right|} {#3}\right\rangle}\xspace}
% Inner Product
\newcommand{\IP}[2] {\ensuremath{\left\langle {#1} | {#2}\right\rangle}\xspace}
% Commutator
\newcommand{\COM}[2] {\ensuremath{\left[ {#1} , {#2}\right]}\xspace}
% Outer product 
\newcommand{\OP}[2] {\ensuremath{\left| {#1} \right\rangle \left\langle{#2}\right|}\xspace}
% Yes, I am this lazy
\newcommand{\Half} {\ensuremath{\frac{1}{2}}\xspace}
\newcommand{\ihbar}{\ensuremath{\frac{i}{\hbar}}\xspace}
% Override Pieters ket and bra commands so that they also work in plain text
% adding this not effect the compilability of his latex at all
\renewcommand{\ket}[1]{\ensuremath{\left| #1 \right\rangle}\xspace}
\renewcommand{\bra}[1]{\ensuremath{\left\langle #1 \right|}\xspace}
% For the proper typesetting of differential d
\newcommand{\ud}{\mathrm{d}}
