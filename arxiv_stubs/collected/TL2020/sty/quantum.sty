%%
%% PK: Here I would like a single option for a subscript between the ket and the bra.
%%

\NewDocumentCommand \ketbra
{ >{ \SplitArgument{1}{|} } m m o }
    { \InternalFunctionketbra #1 }

\NewDocumentCommand \InternalFunctionketbra
{ m m o }
    {\IfValueTF{#2}
       { \vert \mathopen{}#1\mathclose{} \rangle\langle \mathopen{}#2\mathclose{} \vert}
       { \vert \mathopen{}#1\mathclose{} \rangle\langle \mathopen{}#1\mathclose{} \vert}
    }

\NewDocumentCommand \Ketbra
{ >{ \SplitArgument{1}{|} } m m o }
    { \InternalFunctionKetbra #1}

\NewDocumentCommand \InternalFunctionKetbra
{ m m o }
    {\IfValueTF{#2}
       {\left\vert #1 \middle\rangle\middle\langle #2 \right\vert}
       {\left\vert #1 \middle\rangle\middle\langle #1 \right\vert}
    }

