\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{newalg}

\newcommand{\algoname}{Algorithmus}

\newcounter{linenno}
\setcounter{linenno}{0}

\newlength{\@algindent}
\setlength{\@algindent}{1.5em}
\newlength{\@totalindent}
\setlength{\@totalindent}{0cm}

\newcommand{\algkey}[1]{\textbf{\bfseries #1}}
\newcommand{\algtitle}[1]{\textbf{#1}}

\newcommand{\State}{\let\\\@algbreak\hspace*{\@totalindent}\refstepcounter{linenno}}
\newcommand{\Statex}{\let\\\newline\hspace*{\@totalindent}}

\newcommand{\@algpush}{\addtolength{\@totalindent}{\@algindent}}
\newcommand{\@algpop}{\addtolength{\@totalindent}{-\@algindent}}

\newcommand{\If}[1]{\State\algkey{if} #1 \algkey{then}\@algpush \\}
\newcommand{\Ifx}[2]{\State\algkey{if} #1 \algkey{then} #2 \\}
\newcommand{\Ifxx}[1]{\Statex\algkey{if} #1 \algkey{then}\@algpush \\}
\newcommand{\Else}{\@algpop\State\algkey{else}\@algpush\\}
\newcommand{\Elsex}[1]{\State\algkey{else} #1 \\}
\newcommand{\Elsexx}{\@algpop\Statex\algkey{else}\@algpush\\}
\newcommand{\ElseIf}[1]{\@algpop\State\algkey{else if} #1 \algkey{then}\@algpush \\}
\newcommand{\EndIf}{\@algpop}

\newcommand{\While}[1]{\State\algkey{while} #1 \algkey{do}\@algpush\\\ignorespaces}
\newcommand{\Whilex}[1]{\Statex\algkey{while} #1 \algkey{do}\@algpush\\\ignorespaces}
\newcommand{\EndWhile}{\@algpop}

\newcommand{\Repeat}{\State\algkey{repeat}\@algpush \\}
\newcommand{\Until}[1]{\@algpop\State\algkey{until} #1 \\}

\newcommand{\For}[1]{\State\algkey{for} #1 \algkey{do}\@algpush \\ }
\newcommand{\Forx}[1]{\Statex\algkey{for} #1 \algkey{do}\@algpush \\ }
\newcommand{\ForEach}[1]{\State\algkey{for each} #1 \algkey{do}\@algpush \\ }
\newcommand{\ForEachx}[1]{\Statex\algkey{for each} #1 \algkey{do}\@algpush \\ }
\newcommand{\ForAll}[1]{\State\algkey{for all} #1 \algkey{do}\@algpush \\ }
\newcommand{\ForAllx}[1]{\Statex\algkey{for all} #1 \algkey{do}\@algpush \\ }

\newcommand{\EndFor}{\@algpop}

\newcommand{\Return}[1]{\State\algkey{return} #1 \\}
\newcommand{\Returnx}[1]{\Statex\algkey{return} #1 \\}

% \newcommand{\@algbreak}{\hspace*{\fill}\begin{footnotesize}$(\arabic{linenno})$\end{footnotesize}\newline}
\newcommand{\@algbreak}{\hspace*{\fill}\newline}
\newlength{\save@indent}
\newenvironment{newalgorithm}[2]{%
  \setlength{\save@indent}{\parindent}
  \setlength{\parindent}{0pt}
  \par\vspace{0.5\baselineskip}
  \let\\\@algbreak
  \setcounter{linenno}{0}
  \algtitle{#1}(#2)\@algpush\newline
}{%
  \@algpop
  \setlength{\parindent}{\save@indent}
}

\endinput
