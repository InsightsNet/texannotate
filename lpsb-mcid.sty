\providecommand{\lpsb@tag@end}[2]{}    % {elem_id}{page}
\providecommand{\lpsb@tag@atom}[5]{}   % {elem_id}{type}{mcid}{page}{parent_id}
\providecommand{\lpsb@mcid@cont}[3]{}  % {elem_id}{mcid}{page}
\providecommand{\lpsb@summary}[3]{}    % {total_elem}{total_mcid}{total_pages}

%% =========================================
%% 9. PDF Metadata Safety (hyperref)
%% =========================================
% FIX: Prevent LPSB commands from corrupting PDF metadata (Title, Author)
% generated by hyperref. When hyperref builds PDF strings for bookmarks
% or document info, it fully expands macros. LPSB tags must be neutralized.
\AtBeginDocument{%
  \@ifpackageloaded{hyperref}{%
    \pdfstringdefDisableCommands{%
      \def\lpsbTagBegin#1{}%
      \def\lpsbTagEnd{}%
      \def\lpsbTagAtom#1#2{#2}%
      \def\lpsbTagReferenceAtom#1#2{#2}%
      \def\lpsbTagBeginFloat#1{}%
      \def\lpsbTagEndFloat{}%
      % Also disable aux commands that might appear
      \def\lpsb@tag@data#1#2#3#4{}%
      \def\lpsb@tag@atom#1#2#3#4#5{}%
      \def\lpsb@tag@end#1#2{}%
      \def\lpsb@mcid@cont#1#2#3{}%
    }%
  }{}%
}

%% =========================================
%% 10. Image Position Tracking (\includegraphics)
%% =========================================
% Hook \includegraphics to emit image-specific MCID markers.
% This allows accurate image bbox extraction from the PDF content stream
% even for embedded PDF/Form XObjects where standard extraction fails.
%
% Approach: Wrap the image in a dedicated MCID marker:
%   /LPSBImg << /MCID N /ImgID M >> BDC ... EMC
% The Python visualizer can then detect these markers and extract accurate
% bounding boxes from the marked content.
%
\AtBeginDocument{%
  \@ifpackageloaded{graphicx}{%
    \let\lpsb@orig@includegraphics\includegraphics
    \renewcommand{\includegraphics}[2][]{%
      \stepcounter{lpsb@imgID}%
      % Only emit markers if active and inside a figure
      \if@lpsb@active
        \if@lpsb@in@float
          % Emit custom BDC with image ID for tracking
          \lpsb@pdfliteralcmd{ /LPSBImg \thelpsb@imgID\space BDC }%
          \lpsb@orig@includegraphics[#1]{#2}%
          \lpsb@pdfliteralcmd{ EMC }%
          % Record image info to aux (page known at shipout, use current estimate)
          \immediate\write\@auxout{%
            \string\lpsb@img@pos{\thelpsb@imgID}{0}{0}{0}{0}{\thelpsb@currentPage}%
          }%
        \else
          % Not in float - just render normally
          \lpsb@orig@includegraphics[#1]{#2}%
        \fi
      \else
        % LPSB not active - just render normally
        \lpsb@orig@includegraphics[#1]{#2}%
      \fi
    }%
  }{}%
}

