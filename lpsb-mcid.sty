%% =========================================
%% 4g. Multicol Environment Tagging
%% =========================================
% multicols environment collects content in a vbox before splitting into columns
% This can suppress normal everypar behavior. We explicitly start a P tag.
\AtBeginDocument{%
  \@ifpackageloaded{multicol}{%
    \BeforeBeginEnvironment{multicols}{%
      % End any active tag and start fresh P for multicol content
      \if@lpsb@active
        \lpsbTagEnd
      \fi
      \lpsbTagBegin{P}%
    }%
    \AfterEndEnvironment{multicols}{%
      \lpsbTagEnd
      % Start new P for content after multicol
      \lpsbTagBegin{P}%
    }%
  }{}%
}

%% =========================================
%% 4h. Longtable Environment Tagging
%% =========================================
% longtable creates multi-page tables outside of float environments.
% Tag as Table and suppress inline formatting to avoid fragmentation.
\AtBeginDocument{%
  \@ifpackageloaded{longtable}{%
    \BeforeBeginEnvironment{longtable}{%
      \if@lpsb@active
        \lpsbTagEnd
      \fi
      \lpsbTagBegin{Table}%
      \global\@lpsb@suppress@inlinetrue
    }%
    \AfterEndEnvironment{longtable}{%
      \global\@lpsb@suppress@inlinefalse
      \lpsbTagEnd
      \lpsbTagBegin{P}%
    }%
  }{}%
}

%% =========================================
%% 4i. Theorem Environment Tagging
%% =========================================
% Theorem-like environments (theorem, lemma, definition, etc.) should
% suppress inline tags to avoid fragmentation. We use a generic approach
% that hooks into amsthm's \@thm command.
%
% IMPORTANT: Skip these hooks when certain packages are loaded that have
% incompatible theorem internals (smfthm, thmtools, etc.)
\AtBeginDocument{%
  % Check for incompatible theorem packages
  \newif\if@lpsb@skip@thmhooks \@lpsb@skip@thmhooksfalse
  \@ifpackageloaded{smfthm}{\global\@lpsb@skip@thmhookstrue}{}%
  \@ifpackageloaded{thmtools}{\global\@lpsb@skip@thmhookstrue}{}%
  % smf class also uses incompatible theorem handling
  \def\lpsb@tmp@smf{smf}%
  \ifx\lpsb@detected@template\lpsb@tmp@smf\global\@lpsb@skip@thmhookstrue\fi
  %
  \if@lpsb@skip@thmhooks
    \typeout{LPSB-MCID Info: Skipping theorem hooks (incompatible package detected)}%
  \else
    \@ifpackageloaded{amsthm}{%
      % Hook \@thm which is called for all theorem environments
      \@ifundefined{@thm}{}{%
        \let\lpsb@orig@@thm\@thm
        \def\@thm#1#2#3{%
          \if@lpsb@active
            \lpsbTagEnd
            \lpsbTagBegin{P}%  % Use P for theorem content (semantic role unclear in PDF/UA)
            \global\@lpsb@suppress@inlinetrue
          \fi
          \lpsb@orig@@thm{#1}{#2}{#3}%
        }%
      }%
      % Hook \@endtheorem to restore inline tagging
      \@ifundefined{@endtheorem}{}{%
        \let\lpsb@orig@@endtheorem\@endtheorem
        \def\@endtheorem{%
          \lpsb@orig@@endtheorem
          \global\@lpsb@suppress@inlinefalse
        }%
      }%
    }{}%
    % Also handle old-style theorem package
    \@ifpackageloaded{theorem}{%
      \@ifundefined{@thm}{}{%
        \@ifundefined{lpsb@orig@@thm}{%  % Don't double-hook if amsthm already did
          \let\lpsb@orig@@thm\@thm
          \def\@thm#1#2#3{%
            \if@lpsb@active
              \lpsbTagEnd
              \lpsbTagBegin{P}%
              \global\@lpsb@suppress@inlinetrue
            \fi
            \lpsb@orig@@thm{#1}{#2}{#3}%
          }%
        }{}%
      }%
      \@ifundefined{@endtheorem}{}{%
        \@ifundefined{lpsb@orig@@endtheorem}{%
          \let\lpsb@orig@@endtheorem\@endtheorem
          \def\@endtheorem{%
            \lpsb@orig@@endtheorem
            \global\@lpsb@suppress@inlinefalse
          }%
        }{}%
      }%
    }{}%
  \fi
}

%% =========================================
%% 4j. Tcolorbox/Mdframed Environment Tagging
%% =========================================
% These packages create colored/framed boxes. Suppress inline tags inside.
\AtBeginDocument{%
  \@ifpackageloaded{tcolorbox}{%
    \BeforeBeginEnvironment{tcolorbox}{%
      \if@lpsb@active
        \lpsbTagEnd
      \fi
      \lpsbTagBegin{Aside}%  % Use Aside for informational boxes
      \global\@lpsb@suppress@inlinetrue
    }%
    \AfterEndEnvironment{tcolorbox}{%
      \global\@lpsb@suppress@inlinefalse
      \lpsbTagEnd
      \lpsbTagBegin{P}%
    }%
  }{}%
  \@ifpackageloaded{mdframed}{%
    \BeforeBeginEnvironment{mdframed}{%
      \if@lpsb@active
        \lpsbTagEnd
      \fi
      \lpsbTagBegin{Aside}%
      \global\@lpsb@suppress@inlinetrue
    }%
    \AfterEndEnvironment{mdframed}{%
      \global\@lpsb@suppress@inlinefalse
      \lpsbTagEnd
      \lpsbTagBegin{P}%
    }%
  }{}%
}

%% =========================================
%% 4k. Quote/Quotation/Verse Environment Tagging
%% =========================================
% These environments should be tagged as BlockQuote, not LI.
% Suppress inline tags to avoid fragmentation.
\AtBeginEnvironment{quote}{%
  \if@lpsb@active
    \lpsbTagEnd
    \lpsbTagBegin{BlockQuote}%
    \global\@lpsb@suppress@inlinetrue
  \fi
}
\AtEndEnvironment{quote}{%
  \if@lpsb@active
    \global\@lpsb@suppress@inlinefalse
    \lpsbTagEnd
    \lpsbTagBegin{P}%
  \fi
}

\AtBeginEnvironment{quotation}{%
  \if@lpsb@active
    \lpsbTagEnd
    \lpsbTagBegin{BlockQuote}%
    \global\@lpsb@suppress@inlinetrue
  \fi
}
\AtEndEnvironment{quotation}{%
  \if@lpsb@active
    \global\@lpsb@suppress@inlinefalse
    \lpsbTagEnd
    \lpsbTagBegin{P}%
  \fi
}

\AtBeginEnvironment{verse}{%
  \if@lpsb@active
    \lpsbTagEnd
    \lpsbTagBegin{BlockQuote}%  % Verse is similar to quote semantically
    \global\@lpsb@suppress@inlinetrue
  \fi
}
\AtEndEnvironment{verse}{%
  \if@lpsb@active
    \global\@lpsb@suppress@inlinefalse
    \lpsbTagEnd
    \lpsbTagBegin{P}%
  \fi
}

%% =========================================
%% 5. Core API: Tag Begin/End
%% =========================================

% Begin a new tagged element
% #1 = tag type (P, H1, H2, Abstract, Figure, etc.)
\newcommand{\lpsbTagBegin}[1]{%
  % CRITICAL: Skip in non-typesetting contexts (moving arguments)
  \ifx\protect\@typeset@protect
    \if@lpsb@active
      % If already in a tag, save current state to stack
      \if@lpsb@in@tag
        \lpsb@push@tag{\lpsb@current@logical@id}{\lpsb@current@tag@type}%
        \lpsb@pdfliteralcmd{ EMC }%
      \fi
      %
      % Start new element
      \stepcounter{lpsb@logicalElemID}%
      \stepcounter{lpsb@globalMCID}%
      \xdef\lpsb@current@logical@id{\thelpsb@logicalElemID}%
      \xdef\lpsb@current@tag@type{#1}%
      \global\@lpsb@in@tagtrue
      %
      % Insert BDC into content stream
      \lpsb@pdfliteralcmd{ /#1 << /MCID \thelpsb@globalMCID >> BDC }%
      %
      % Record to aux file
      \immediate\write\@auxout{%
        \string\lpsb@tag@data{\thelpsb@logicalElemID}{#1}{\thelpsb@globalMCID}{\thelpsb@currentPage}%
      }%
    \fi % @lpsb@active
  \fi % @typeset@protect
}

% End current tagged element
\newcommand{\lpsbTagEnd}{%
  % CRITICAL: Skip in non-typesetting contexts (moving arguments)
  \ifx\protect\@typeset@protect
    \if@lpsb@active
      \if@lpsb@in@tag
        \lpsb@pdfliteralcmd{ EMC }%
        %
        % Record end
        \immediate\write\@auxout{%
          \string\lpsb@tag@end{\lpsb@current@logical@id}{\thelpsb@currentPage}%
        }%
        %
        % Restore parent from stack if any
        \ifx\lpsb@tag@stack\empty
          \global\@lpsb@in@tagfalse
        \else
          \lpsb@pop@tag
          % Check if restoring a section heading that is now complete
          % If @nobreak is false, the heading text has been output and we should
          % NOT reopen the heading - start P instead.
          \lpsb@maybe@close@heading@or@reopen
        \fi
      \fi
    \fi
  \fi
}

% Helper: Reopen parent tag normally (used when parent should continue)
\newcommand{\lpsb@reopen@parent@tag}{%
  \stepcounter{lpsb@globalMCID}%
  \lpsb@pdfliteralcmd{ /\lpsb@current@tag@type\space << /MCID \thelpsb@globalMCID >> BDC }%
  \immediate\write\@auxout{%
    \string\lpsb@mcid@cont{\lpsb@current@logical@id}{\thelpsb@globalMCID}{\thelpsb@currentPage}%
  }%
  \global\@lpsb@first@paratrue
}

% Helper: Check if restored parent is a completed section heading
% Section headings (H1-H6) should only continue if @nobreak is still true
% (meaning the heading text hasn't been output yet via everypar).
% Once @nobreak becomes false, the heading is complete and should not reopen.
\newcommand{\lpsb@maybe@close@heading@or@reopen}{%
  \edef\lpsb@tmp@restored{\lpsb@current@tag@type}%
  \def\lpsb@const@H{H}%
  % Check if tag type starts with "H" (H1, H2, H3, etc.)
  \expandafter\lpsb@check@heading@prefix\lpsb@tmp@restored\@nil
}
\def\lpsb@check@heading@prefix#1#2\@nil{%
  \def\lpsb@tmp@first{#1}%
  \ifx\lpsb@tmp@first\lpsb@const@H
    % It's a heading tag - check if heading text has been output
    % If @lpsb@heading@deferred is TRUE, heading is still pending - keep H1 open
    % If @lpsb@heading@deferred is FALSE, heading was output - close H1
    \if@lpsb@heading@deferred
      % Heading text is still pending output - keep H1 open
      % This ensures the heading is captured by H1 even across page breaks
      \lpsb@reopen@parent@tag
    \else
      % Heading text was output - close H1 and start P instead
      \immediate\write\@auxout{%
        \string\lpsb@tag@end{\lpsb@current@logical@id}{\thelpsb@currentPage}%
      }%
      \global\@lpsb@in@sectionfalse
      % Start new P for content after the block element
      \lpsbTagBegin{P}%
      \global\@lpsb@first@paratrue
    \fi
  \else
    % Not a heading - reopen parent normally
    \lpsb@reopen@parent@tag
  \fi
}

% End tagged element for FLOATS - closes tag but does NOT restore parent
% This is because floats appear at different positions than their source location,
% so restoring the parent P would cause it to incorrectly span the float's rendered content.
\newcommand{\lpsbTagEndFloat}{%
  % CRITICAL: Skip in non-typesetting contexts (moving arguments)
  \ifx\protect\@typeset@protect
    \if@lpsb@active
      \if@lpsb@in@tag
        \lpsb@pdfliteralcmd{ EMC }%
        % Record end
        \immediate\write\@auxout{%
          \string\lpsb@tag@end{\lpsb@current@logical@id}{\thelpsb@currentPage}%
        }%
        % Clear stack and mark not in tag - parent should NOT continue after float
        \gdef\lpsb@tag@stack{}%
        \global\@lpsb@in@tagfalse
      \fi
    \fi
  \fi
}

% Begin tagged element for FLOATS - starts tag WITHOUT pushing current to stack
% Use this inside @xfloat because the float box is placed asynchronously.
% We don't want to save/restore parent P since that would create incorrect nesting.
\newcommand{\lpsbTagBeginFloat}[1]{%
  % CRITICAL: Skip in non-typesetting contexts (moving arguments)
  \ifx\protect\@typeset@protect
    \if@lpsb@active
      % DON'T push current tag to stack - floats are self-contained
      % Just close current if any (but don't save it)
      \if@lpsb@in@tag
        \lpsb@pdfliteralcmd{ EMC }%
        % Record end of the parent tag that was open
        \immediate\write\@auxout{%
          \string\lpsb@tag@end{\lpsb@current@logical@id}{\thelpsb@currentPage}%
        }%
        % Clear stack since this P should not continue after float
        \gdef\lpsb@tag@stack{}%
      \fi
      % Start new element for the float
      \stepcounter{lpsb@logicalElemID}%
      \stepcounter{lpsb@globalMCID}%
      \xdef\lpsb@current@logical@id{\thelpsb@logicalElemID}%
      \xdef\lpsb@current@tag@type{#1}%
      \global\@lpsb@in@tagtrue
      % Insert BDC
      \lpsb@pdfliteralcmd{ /#1 << /MCID \thelpsb@globalMCID >> BDC }%
      % Record to aux file
      \immediate\write\@auxout{%
        \string\lpsb@tag@data{\thelpsb@logicalElemID}{#1}{\thelpsb@globalMCID}{\thelpsb@currentPage}%
      }%
    \fi
  \fi
}

% Inline tag (atom) - nested within current parent element
% For inline elements like Strong, Em, InlineMath, Reference
% Records parent element ID for proper nesting in output
% IMPORTANT: PDF MCIDs don't nest - must close parent, insert atom, reopen parent
\newcommand{\lpsb@TagAtomImpl}[2]{%
  % CRITICAL: Skip in non-typesetting contexts (moving arguments)
  \ifx\protect\@typeset@protect
    \if@lpsb@active
      \if@lpsb@in@tag
        % Save parent info - use \protected@edef to avoid expansion issues in subfigure
        \protected@edef\lpsb@saved@parent@id{\lpsb@current@logical@id}%
        \protected@edef\lpsb@saved@parent@type{\lpsb@current@tag@type}%
        % Close parent MCID temporarily
        \lpsb@pdfliteralcmd{ EMC }%
      \else
        \def\lpsb@saved@parent@id{}%
        \def\lpsb@saved@parent@type{}%
      \fi
      % Insert atom element
      \stepcounter{lpsb@logicalElemID}%
      \stepcounter{lpsb@globalMCID}%
      \lpsb@pdfliteralcmd{ /#1 << /MCID \thelpsb@globalMCID >> BDC }%
      \immediate\write\@auxout{%
        \string\lpsb@tag@atom{\thelpsb@logicalElemID}{#1}{\thelpsb@globalMCID}{\thelpsb@currentPage}{\lpsb@saved@parent@id}%
      }%
      #2%
      \lpsb@pdfliteralcmd{ EMC }%
      % Reopen parent with continuation MCID
      \if@lpsb@in@tag
        \stepcounter{lpsb@globalMCID}%
        \lpsb@pdfliteralcmd{ /\lpsb@saved@parent@type\space << /MCID \thelpsb@globalMCID >> BDC }%
        \immediate\write\@auxout{%
          \string\lpsb@mcid@cont{\lpsb@saved@parent@id}{\thelpsb@globalMCID}{\thelpsb@currentPage}%
        }%
      \fi
    \else
      #2%
    \fi
  \else
    #2%
  \fi
}

% IMPORTANT: Use \protected to prevent expansion during argument parsing
% This is critical for compatibility with subfigure.sty and similar packages
% that expand their arguments. The \protected prefix (e-TeX) ensures this
% macro is not expanded in expansion-only contexts.
\protected\def\lpsbTagAtom#1#2{%
  % Check if we're in a float and handle accordingly
  % Use pre-defined constant to avoid \def inside fragile contexts
  \if@lpsb@in@float
    % In float: only tag Caption type, pass through others
    % Compare #1 directly with pre-defined constant using \ifx after \edef
    \begingroup
      \edef\lpsb@tmp@atomtype{#1}%
      \ifx\lpsb@tmp@atomtype\lpsb@const@Caption
        \endgroup
        \lpsb@TagAtomImpl{#1}{#2}%
      \else
        \endgroup
        #2%
      \fi
  \else
    % Not in float: tag everything
    \lpsb@TagAtomImpl{#1}{#2}%
  \fi
}

% CRITICAL: Disable atom tagging entirely when legacy subfigure.sty is loaded.
% Even with \protected\def, the \def commands inside lpsbTagAtom cause
% layout issues when the macro is executed inside subfigure's internal context.
% The only safe solution is to make it a pure passthrough.
%
% We use AtEndOfPackage to run this check immediately after lpsb-mcid.sty
% is fully loaded (but before document content). Additionally, we use
% AtBeginDocument as a fallback in case subfigure is loaded after us.

% Flag to track if subfigure was detected
\newif\if@lpsb@subfigure@detected

% Primary check: run at end of our package (catches subfigure loaded before us)
\AtEndOfPackage{%
  \@ifpackageloaded{subfigure}{%
    \typeout{LPSB-MCID Info: Legacy subfigure.sty detected (at package end) - disabling atom tagging}%
    \@lpsb@subfigure@detectedtrue
    \protected\def\lpsbTagAtom#1#2{#2}%
  }{}%
}

% Secondary check: AtBeginDocument (catches subfigure loaded after us)
\AtBeginDocument{%
  \if@lpsb@subfigure@detected\else
    \@ifpackageloaded{subfigure}{%
      \typeout{LPSB-MCID Info: Legacy subfigure.sty detected (at begin doc) - disabling atom tagging}%
      \protected\def\lpsbTagAtom#1#2{#2}%
    }{}%
  \fi
}

% Reference atom that also records citation keys (for downstream parent/child structure).
% #1 = cite key string (verbatim-ish), #2 = content (expands to printed citation)
\newcommand{\lpsbTagReferenceAtom}[2]{%
  % CRITICAL: Skip in non-typesetting contexts (moving arguments)
  \ifx\protect\@typeset@protect
    \if@lpsb@active
      \if@lpsb@in@tag
        % Inside a parent tag: emit proper Reference atom with EMC/BDC
        \edef\lpsb@saved@parent@id{\lpsb@current@logical@id}%
        \edef\lpsb@saved@parent@type{\lpsb@current@tag@type}%
        \lpsb@pdfliteralcmd{ EMC }%
        \stepcounter{lpsb@logicalElemID}%
        \stepcounter{lpsb@globalMCID}%
        \lpsb@pdfliteralcmd{ /Reference << /MCID \thelpsb@globalMCID >> BDC }%
        \immediate\write\@auxout{%
          \string\lpsb@tag@atom{\thelpsb@logicalElemID}{Reference}{\thelpsb@globalMCID}{\thelpsb@currentPage}{\lpsb@saved@parent@id}%
        }%
        % Record keys (detokenized to keep aux robust)
        \begingroup
          \edef\lpsb@tmp@keys{\detokenize{#1}}%
          \immediate\write\@auxout{%
            \string\lpsb@refkey{\thelpsb@logicalElemID}{\lpsb@tmp@keys}%
          }%
        \endgroup
        #2%
        \lpsb@pdfliteralcmd{ EMC }%
        % Reopen parent tag
        \stepcounter{lpsb@globalMCID}%
        \lpsb@pdfliteralcmd{ /\lpsb@saved@parent@type\space << /MCID \thelpsb@globalMCID >> BDC }%
        \immediate\write\@auxout{%
          \string\lpsb@mcid@cont{\lpsb@saved@parent@id}{\thelpsb@globalMCID}{\thelpsb@currentPage}%
        }%
      \else
        % NOT inside a parent tag: emit standalone Reference BDC/EMC
        % After Reference ends, start a new P for subsequent text
        \stepcounter{lpsb@logicalElemID}%
        \stepcounter{lpsb@globalMCID}%
        \lpsb@pdfliteralcmd{ /Reference << /MCID \thelpsb@globalMCID >> BDC }%
        \immediate\write\@auxout{%
          \string\lpsb@tag@atom{\thelpsb@logicalElemID}{Reference}{\thelpsb@globalMCID}{\thelpsb@currentPage}{}%
        }%
        \begingroup
          \edef\lpsb@tmp@keys{\detokenize{#1}}%
          \immediate\write\@auxout{%
            \string\lpsb@refkey{\thelpsb@logicalElemID}{\lpsb@tmp@keys}%
          }%
        \endgroup
        #2%
        \lpsb@pdfliteralcmd{ EMC }%
        % Start new P for subsequent text (prevents untagged content after Reference)
        \lpsbTagBegin{P}%
        \global\@lpsb@first@paratrue
      \fi
    \else
      #2%
    \fi
  \else
    #2%
  \fi
}

%% =========================================
%% 6. Automatic Hooks for Standard Elements  
%% =========================================

% --- Title → H (Document Title) ---
% Hook \maketitle to capture title region
\AtBeginDocument{%
  \@ifundefined{maketitle}{}{%
    % Disabled: \maketitle is one of the most class-specific and fragile macros.
    % Wrapping it has caused stack overflows in real papers.
    \typeout{LPSB-MCID Info: skipping maketitle hook}%
  }%
  % Skip metadata hooks for templates with complex author/affiliation handling
  % These templates use different argument patterns that break the standard hooks
  \def\lpsb@tmp@acmart{acmart}%
  \def\lpsb@tmp@elsarticle{elsarticle}%
  \def\lpsb@tmp@amsart{amsart}%
  \def\lpsb@tmp@revtex{revtex}%
  \def\lpsb@tmp@aastex{aastex}%
  \def\lpsb@tmp@llncs{llncs}%
  \def\lpsb@tmp@svjour{svjour}%
  \def\lpsb@tmp@ieeetran{ieeetran}%
  \newif\if@lpsb@skip@metahooks \@lpsb@skip@metahooksfalse
  \ifx\lpsb@detected@template\lpsb@tmp@acmart \global\@lpsb@skip@metahookstrue \fi
  \ifx\lpsb@detected@template\lpsb@tmp@elsarticle \global\@lpsb@skip@metahookstrue \fi
  \ifx\lpsb@detected@template\lpsb@tmp@amsart \global\@lpsb@skip@metahookstrue \fi
  \ifx\lpsb@detected@template\lpsb@tmp@revtex \global\@lpsb@skip@metahookstrue \fi
  \ifx\lpsb@detected@template\lpsb@tmp@aastex \global\@lpsb@skip@metahookstrue \fi
  \ifx\lpsb@detected@template\lpsb@tmp@llncs \global\@lpsb@skip@metahookstrue \fi
  \ifx\lpsb@detected@template\lpsb@tmp@svjour \global\@lpsb@skip@metahookstrue \fi
  \ifx\lpsb@detected@template\lpsb@tmp@ieeetran \global\@lpsb@skip@metahookstrue \fi
  %
  \if@lpsb@skip@metahooks
    \typeout{LPSB-MCID Info: Skipping author/affiliation/institute hooks for template '\lpsb@detected@template'}%
  \else
  % Hook \author to capture author info (supports optional parameter)
  \@ifundefined{author}{}{%
    \let\lpsb@orig@author\author
    \renewcommand{\author}{%
      \@ifnextchar[\lpsb@author@opt\lpsb@author@noopt
    }%
    \def\lpsb@author@opt[#1]#2{%
      \stepcounter{lpsb@logicalElemID}%
      \immediate\write\@auxout{%
        \string\lpsb@meta{Author}{\thelpsb@logicalElemID}%
      }%
      \lpsb@orig@author[#1]{#2}%
    }%
    \def\lpsb@author@noopt#1{%
      \stepcounter{lpsb@logicalElemID}%
      \immediate\write\@auxout{%
        \string\lpsb@meta{Author}{\thelpsb@logicalElemID}%
      }%
      \lpsb@orig@author{#1}%
    }%
  }%
  % Hook \affiliation (common in many class files, supports optional parameter)
  \@ifundefined{affiliation}{}{%
    \let\lpsb@orig@affiliation\affiliation
    \renewcommand{\affiliation}{%
      \@ifnextchar[\lpsb@affiliation@opt\lpsb@affiliation@noopt
    }%
    \def\lpsb@affiliation@opt[#1]#2{%
      \stepcounter{lpsb@logicalElemID}%
      \immediate\write\@auxout{%
        \string\lpsb@meta{Affiliation}{\thelpsb@logicalElemID}%
      }%
      \lpsb@orig@affiliation[#1]{#2}%
    }%
    \def\lpsb@affiliation@noopt#1{%
      \stepcounter{lpsb@logicalElemID}%
      \immediate\write\@auxout{%
        \string\lpsb@meta{Affiliation}{\thelpsb@logicalElemID}%
      }%
      \lpsb@orig@affiliation{#1}%
    }%
  }%
  % Hook \institute (common in some classes like beamer, svjour, supports optional parameter)
  \@ifundefined{institute}{}{%
    \let\lpsb@orig@institute\institute
    \renewcommand{\institute}{%
      \@ifnextchar[\lpsb@institute@opt\lpsb@institute@noopt
    }%
    \def\lpsb@institute@opt[#1]#2{%
      \stepcounter{lpsb@logicalElemID}%
      \immediate\write\@auxout{%
        \string\lpsb@meta{Affiliation}{\thelpsb@logicalElemID}%
      }%
      \lpsb@orig@institute[#1]{#2}%
    }%
    \def\lpsb@institute@noopt#1{%
      \stepcounter{lpsb@logicalElemID}%
      \immediate\write\@auxout{%
        \string\lpsb@meta{Affiliation}{\thelpsb@logicalElemID}%
      }%
      \lpsb@orig@institute{#1}%
    }%
  }%
  \fi % @lpsb@skip@metahooks
}

% --- Sections → H1, H2, H3, etc. ---
% Section titles only - H1 wraps title text, then P starts for content
%
% IMPORTANT: LaTeX may defer section headings to the next page if there's
% insufficient space. For display-style headings (not run-in), the title
% is stored in \@svsechd and output via \everypar on the NEXT paragraph.
%
% Strategy: We hook into the actual heading output mechanism:
% 1. When \section is called, we DON'T emit H1 immediately
% 2. We set a flag indicating "next everypar should be H1"
% 3. In everypar, if the flag is set, we emit H1 for that content
% 4. After the heading content, we close H1 and start P
%
% This ensures H1 wraps the actual heading text, even across page breaks.
%
% SKIP SECTION HOOKS for templates with incompatible section internals.
% These templates use complex section formatting that breaks when LPSB
% wraps \section/\subsection commands.

\newif\if@lpsb@in@section \@lpsb@in@sectionfalse
\newif\if@lpsb@section@pending \@lpsb@section@pendingfalse
\gdef\lpsb@pending@heading@level{H1}
\gdef\lpsb@current@section@id{}

% Flag to track if we need to emit heading tag at next everypar
\newif\if@lpsb@heading@deferred \@lpsb@heading@deferredfalse

% Flag to skip section hooks for incompatible templates
\newif\if@lpsb@skip@sectionhooks \@lpsb@skip@sectionhooksfalse

\AtBeginDocument{%
  % Check for incompatible section handling templates
  % smf (Société Mathématique de France) uses complex \smf@sf and \smf@eebox
  \def\lpsb@tmp@smf{smf}%
  \ifx\lpsb@detected@template\lpsb@tmp@smf\global\@lpsb@skip@sectionhookstrue\fi
  % smfart class files define \smf@sf
  \@ifundefined{smf@sf}{}{\global\@lpsb@skip@sectionhookstrue}%
  %
  \if@lpsb@skip@sectionhooks
    \typeout{LPSB-MCID Info: Skipping section hooks (incompatible template detected)}%
  \else
  %
  % Hook \@afterheading - this is called after \@xsect but BEFORE
  % the heading text is actually output (for display headings).
  % We use this to set up deferred heading tagging.
  %
  % CRITICAL: The original \@afterheading SETS \@nobreaktrue for display headings.
  % We must call it FIRST, then check the flag, otherwise we always get false!
  \@ifundefined{@afterheading}{}{%
    \let\lpsb@orig@@afterheading\@afterheading
    \def\@afterheading{%
      % Call original FIRST - it sets \@nobreaktrue for display headings
      \lpsb@orig@@afterheading
      % Now check if heading is deferred (display-style)
      % \@nobreak is true for display headings, false for run-in
      \if@nobreak
        % Display heading - title will be output by everypar on next paragraph
        % Keep H1 open so the deferred title text is tagged correctly
        \global\@lpsb@heading@deferredtrue
      \else
        % Run-in heading - heading text already output, close H1 now
        \if@lpsb@in@section
          \lpsbTagEnd
          \lpsbTagBegin{P}%
          \global\@lpsb@in@sectionfalse
          \global\@lpsb@first@paratrue
        \fi
      \fi
    }%
  }%
  %
  % Hook \@sect to capture when heading text is about to be stored
  % \@sect handles numbered sections: \@sect{name}{level}{indent}{beforeskip}{afterskip}{style}{*heading}
  \@ifundefined{@sect}{}{%
    \let\lpsb@orig@@sect\@sect
    \def\@sect#1#2#3#4#5#6[#7]#8{%
      % Call original \@sect
      \lpsb@orig@@sect{#1}{#2}{#3}{#4}{#5}{#6}[#7]{#8}%
      % After \@sect returns, if heading was deferred, the H1 is still open
      % and will be closed when everypar outputs the heading
    }%
  }%
  %
  % Dynamic heading levels based on document class:
  % - If \chapter is defined (book/report): chapter=H1, section=H2, subsection=H3, etc.
  % - If \chapter is NOT defined (article): section=H1, subsection=H2, etc.
  %
  \@ifundefined{chapter}{%
    % Article-style: no chapter
    \def\lpsb@H@chapter{H1}%   (not used)
    \def\lpsb@H@section{H1}%
    \def\lpsb@H@subsection{H2}%
    \def\lpsb@H@subsubsection{H3}%
    \def\lpsb@H@paragraph{H4}%
    \def\lpsb@H@subparagraph{H5}%
  }{%
    % Book/Report-style: chapter is highest
    \def\lpsb@H@chapter{H1}%
    \def\lpsb@H@section{H2}%
    \def\lpsb@H@subsection{H3}%
    \def\lpsb@H@subsubsection{H4}%
    \def\lpsb@H@paragraph{H5}%
    \def\lpsb@H@subparagraph{H6}%
  }%
  %
  % acmart compatibility:
  % acmart.cls forbids redefining \section/\subsection/\paragraph (class error).
  % Use kernel-level \@startsection instead (no user-level redefinition).
  \@ifundefined{ACM@format}{}{%
    \@ifundefined{@startsection}{}{%
      \let\lpsb@orig@@startsection\@startsection
      \def\@startsection#1#2#3#4#5#6{%
        \lpsbTagEnd
        \ifnum#2=1
          \lpsbTagBegin{\lpsb@H@section}%
          \gdef\lpsb@pending@heading@level{\lpsb@H@section}%
        \else\ifnum#2=2
          \lpsbTagBegin{\lpsb@H@subsection}%
          \gdef\lpsb@pending@heading@level{\lpsb@H@subsection}%
        \else\ifnum#2=3
          \lpsbTagBegin{\lpsb@H@subsubsection}%
          \gdef\lpsb@pending@heading@level{\lpsb@H@subsubsection}%
        \else\ifnum#2=4
          \lpsbTagBegin{\lpsb@H@paragraph}%
          \gdef\lpsb@pending@heading@level{\lpsb@H@paragraph}%
        \else
          \lpsbTagBegin{\lpsb@H@paragraph}%
          \gdef\lpsb@pending@heading@level{\lpsb@H@paragraph}%
        \fi\fi\fi\fi
        \global\@lpsb@in@sectiontrue
        \global\@lpsb@heading@deferredfalse
        \lpsb@orig@@startsection{#1}{#2}{#3}{#4}{#5}{#6}%
      }%
    }%
  }%
  %
  % Hook \chapter (for book/report document classes)
  %
  \@ifundefined{chapter}{}{%
    \let\lpsb@orig@chapter\chapter
    \def\chapter{\@ifstar\lpsb@chapter@star\lpsb@chapter@nostar}%
    \def\lpsb@chapter@star#1{%
      \lpsb@orig@chapter*{#1}%
    }%
    \def\lpsb@chapter@nostar{%
      \@ifnextchar[\lpsb@chapter@opt\lpsb@chapter@noopt
    }%
    \def\lpsb@chapter@opt[#1]#2{%
      \stepcounter{lpsb@sectionID}%
      \xdef\lpsb@current@section@id{\thelpsb@sectionID}%
      \lpsbTagEnd
      \lpsbTagBegin{\lpsb@H@chapter}%
      \global\@lpsb@in@sectiontrue
      \global\@lpsb@heading@deferredfalse
      \gdef\lpsb@pending@heading@level{\lpsb@H@chapter}%
      \lpsb@orig@chapter[#1]{#2}%
      \lpsbTagEnd
      \lpsbTagBegin{P}%
      \global\@lpsb@in@sectionfalse
    }%
    \def\lpsb@chapter@noopt#1{%
      \stepcounter{lpsb@sectionID}%
      \xdef\lpsb@current@section@id{\thelpsb@sectionID}%
      \lpsbTagEnd
      \lpsbTagBegin{\lpsb@H@chapter}%
      \global\@lpsb@in@sectiontrue
      \global\@lpsb@heading@deferredfalse
      \gdef\lpsb@pending@heading@level{\lpsb@H@chapter}%
      \lpsb@orig@chapter{#1}%
      \lpsbTagEnd
      \lpsbTagBegin{P}%
      \global\@lpsb@in@sectionfalse
    }%
  }%
  %
  % Hook \section / \subsection.
  %
  % CRITICAL: Preserve the star form (\section*{...}). If we don't, LaTeX will
  % mis-parse \section*{References} as \section{*} and you'll literally typeset
  % "6 *" (section 6 with title '*'), with "References" falling into the next P.
  %
  \@ifundefined{ACM@format}{\@ifundefined{section}{}{%
    \let\lpsb@orig@section\section
    \def\section{\@ifstar\lpsb@section@star\lpsb@section@nostar}%
    \def\lpsb@section@star#1{%
      % Delegate to the original starred section; our \@ssect hook handles tagging.
      \lpsb@orig@section*{#1}%
    }%
    \def\lpsb@section@nostar{%
      \@ifnextchar[\lpsb@section@opt\lpsb@section@noopt
    }%
    \def\lpsb@section@opt[#1]#2{%
      \stepcounter{lpsb@sectionID}%
      \xdef\lpsb@current@section@id{\thelpsb@sectionID}%
      \lpsbTagEnd
      \lpsbTagBegin{\lpsb@H@section}%
      \global\@lpsb@in@sectiontrue
      \global\@lpsb@heading@deferredfalse
      \gdef\lpsb@pending@heading@level{\lpsb@H@section}%
      \lpsb@orig@section[#1]{#2}%
      % Close H1 and start P for body content
      \lpsbTagEnd
      \lpsbTagBegin{P}%
      \global\@lpsb@in@sectionfalse
    }%
    \def\lpsb@section@noopt#1{%
      \stepcounter{lpsb@sectionID}%
      \xdef\lpsb@current@section@id{\thelpsb@sectionID}%
      \lpsbTagEnd
      \lpsbTagBegin{\lpsb@H@section}%
      \global\@lpsb@in@sectiontrue
      \global\@lpsb@heading@deferredfalse
      \gdef\lpsb@pending@heading@level{\lpsb@H@section}%
      \lpsb@orig@section{#1}%
      % Close H1 and start P for body content
      \lpsbTagEnd
      \lpsbTagBegin{P}%
      \global\@lpsb@in@sectionfalse
    }%
  }}{}%
  \@ifundefined{ACM@format}{\@ifundefined{subsection}{}{%
    \let\lpsb@orig@subsec\subsection
    \def\subsection{\@ifstar\lpsb@subsection@star\lpsb@subsection@nostar}%
    \def\lpsb@subsection@star#1{%
      \lpsb@orig@subsec*{#1}%
    }%
    \def\lpsb@subsection@nostar{%
      \@ifnextchar[\lpsb@subsection@opt\lpsb@subsection@noopt
    }%
    \def\lpsb@subsection@opt[#1]#2{%
      \stepcounter{lpsb@sectionID}%
      \xdef\lpsb@current@section@id{\thelpsb@sectionID}%
      \lpsbTagEnd
      \lpsbTagBegin{\lpsb@H@subsection}%
      \global\@lpsb@in@sectiontrue
      \global\@lpsb@heading@deferredfalse
      \gdef\lpsb@pending@heading@level{\lpsb@H@subsection}%
      \lpsb@orig@subsec[#1]{#2}%
      \lpsbTagEnd
      \lpsbTagBegin{P}%
      \global\@lpsb@in@sectionfalse
    }%
    \def\lpsb@subsection@noopt#1{%
      \stepcounter{lpsb@sectionID}%
      \xdef\lpsb@current@section@id{\thelpsb@sectionID}%
      \lpsbTagEnd
      \lpsbTagBegin{\lpsb@H@subsection}%
      \global\@lpsb@in@sectiontrue
      \global\@lpsb@heading@deferredfalse
      \gdef\lpsb@pending@heading@level{\lpsb@H@subsection}%
      \lpsb@orig@subsec{#1}%
      \lpsbTagEnd
      \lpsbTagBegin{P}%
      \global\@lpsb@in@sectionfalse
    }%
  }}{}%
  % Hook \subsubsection
  \@ifundefined{ACM@format}{\@ifundefined{subsubsection}{}{%
    \let\lpsb@orig@subsubsec\subsubsection
    \def\subsubsection{\@ifstar\lpsb@subsubsection@star\lpsb@subsubsection@nostar}%
    \def\lpsb@subsubsection@star#1{%
      \lpsb@orig@subsubsec*{#1}%
    }%
    \def\lpsb@subsubsection@nostar{%
      \@ifnextchar[\lpsb@subsubsection@opt\lpsb@subsubsection@noopt
    }%
    \def\lpsb@subsubsection@opt[#1]#2{%
      \stepcounter{lpsb@sectionID}%
      \xdef\lpsb@current@section@id{\thelpsb@sectionID}%
      \lpsbTagEnd
      \lpsbTagBegin{\lpsb@H@subsubsection}%
      \global\@lpsb@in@sectiontrue
      \global\@lpsb@heading@deferredfalse
      \gdef\lpsb@pending@heading@level{\lpsb@H@subsubsection}%
      \lpsb@orig@subsubsec[#1]{#2}%
      \lpsbTagEnd
      \lpsbTagBegin{P}%
      \global\@lpsb@in@sectionfalse
    }%
    \def\lpsb@subsubsection@noopt#1{%
      \stepcounter{lpsb@sectionID}%
      \xdef\lpsb@current@section@id{\thelpsb@sectionID}%
      \lpsbTagEnd
      \lpsbTagBegin{\lpsb@H@subsubsection}%
      \global\@lpsb@in@sectiontrue
      \global\@lpsb@heading@deferredfalse
      \gdef\lpsb@pending@heading@level{\lpsb@H@subsubsection}%
      \lpsb@orig@subsubsec{#1}%
      \lpsbTagEnd
      \lpsbTagBegin{P}%
      \global\@lpsb@in@sectionfalse
    }%
  }}{}%
  % Hook \paragraph
  \@ifundefined{ACM@format}{\@ifundefined{paragraph}{}{%
    \let\lpsb@orig@paragraph\paragraph
    \def\paragraph{\@ifstar\lpsb@paragraph@star\lpsb@paragraph@nostar}%
    \def\lpsb@paragraph@star#1{%
      \lpsb@orig@paragraph*{#1}%
    }%
    \def\lpsb@paragraph@nostar{%
      \@ifnextchar[\lpsb@paragraph@opt\lpsb@paragraph@noopt
    }%
    \def\lpsb@paragraph@opt[#1]#2{%
      \stepcounter{lpsb@sectionID}%
      \xdef\lpsb@current@section@id{\thelpsb@sectionID}%
      \lpsbTagEnd
      \lpsbTagBegin{\lpsb@H@paragraph}%
      \global\@lpsb@in@sectiontrue
      \global\@lpsb@heading@deferredfalse
      \gdef\lpsb@pending@heading@level{\lpsb@H@paragraph}%
      \lpsb@orig@paragraph[#1]{#2}%
      \lpsbTagEnd
      \lpsbTagBegin{P}%
      \global\@lpsb@in@sectionfalse
    }%
    \def\lpsb@paragraph@noopt#1{%
      \stepcounter{lpsb@sectionID}%
      \xdef\lpsb@current@section@id{\thelpsb@sectionID}%
      \lpsbTagEnd
      \lpsbTagBegin{\lpsb@H@paragraph}%
      \global\@lpsb@in@sectiontrue
      \global\@lpsb@heading@deferredfalse
      \gdef\lpsb@pending@heading@level{\lpsb@H@paragraph}%
      \lpsb@orig@paragraph{#1}%
      \lpsbTagEnd
      \lpsbTagBegin{P}%
      \global\@lpsb@in@sectionfalse
    }%
  }}{}%
  % Hook \@ssect for starred sections (\section*, \subsection*)
  \@ifundefined{@ssect}{}{%
    \let\lpsb@orig@@ssect\@ssect
    \def\@ssect#1#2#3#4#5{%
      \stepcounter{lpsb@sectionID}%
      \xdef\lpsb@current@section@id{\thelpsb@sectionID}%
      %
      \lpsbTagEnd
      \global\@lpsb@in@sectiontrue
      \global\@lpsb@heading@deferredfalse
      % Determine heading level based on indent
      \ifdim#1<1em
        \lpsbTagBegin{H1}%
        \gdef\lpsb@pending@heading@level{H1}%
      \else
        \lpsbTagBegin{H2}%
        \gdef\lpsb@pending@heading@level{H2}%
      \fi
      \lpsb@orig@@ssect{#1}{#2}{#3}{#4}{#5}%
      \lpsbTagEnd
      \lpsbTagBegin{P}%
      \global\@lpsb@in@sectionfalse
    }%
  }%
  \fi % @lpsb@skip@sectionhooks
}

% --- Paragraph → P ---
% Use everyhook package for robust \everypar hooking (TL2016+)
% \PushPostHook{par} survives even when other packages reset \everypar

% Float environment flag (must be defined before everypar hook)
\newif\if@lpsb@in@float \@lpsb@in@floatfalse

% Flag for everyhook availability
\newif\if@lpsb@everyhook@available \@lpsb@everyhook@availablefalse

% Define first-para flag unconditionally (needed in both paths)
\newif\if@lpsb@first@para \@lpsb@first@paratrue
\def\lpsb@P@const{P}%

% Helper: Check if current tag type starts with "H" (heading)
% If so, close H1 and start P (heading text was output)
% Otherwise, don't close (we're inside a nested structure)
\def\lpsb@const@H@para{H}%
\def\lpsb@check@if@heading@type#1#2\@nil{%
  \def\lpsb@tmp@first@para{#1}%
  \ifx\lpsb@tmp@first@para\lpsb@const@H@para
    % Current tag is a heading - we're at section level
    % Heading text was output via everypar, close H1 and start P
    \global\@lpsb@heading@deferredfalse
    % Close the H1 tag
    \lpsb@pdfliteralcmd{ EMC }%
    \immediate\write\@auxout{%
      \string\lpsb@tag@end{\lpsb@current@logical@id}{\thelpsb@currentPage}%
    }%
    \global\@lpsb@in@tagfalse
    \global\@lpsb@in@sectionfalse
    % Start new P for content after heading
    \lpsbTagBegin{P}%
    \global\@lpsb@first@paratrue
  \fi
  % If not a heading, don't close - we're inside a nested structure
}

% Paragraph detection logic - defined separately to avoid \IfFileExists parsing issues
% with nested \if..\fi conditionals

% Inner paragraph hook - the core logic, extracted for conditional reuse
\newcommand{\lpsb@para@hook@inner}{%
  % Filter: skip section formatting (to prevent H1/H2 from being interrupted)
  \if@lpsb@in@section\else
  % Natural paragraph detected
  \if@lpsb@in@tag
    % Already in a tag
    \if@lpsb@first@para
      % First para after structure - don't CYCLE P
      \global\@lpsb@first@parafalse
    \else
      % if it's P, cycle it
      \ifx\lpsb@current@tag@type\lpsb@P@const
        \lpsbTagEnd
        \lpsbTagBegin{P}%
      \fi
    \fi
  \else
    % NOT in any tag - ALWAYS start new P (after float or other structure)
    \lpsbTagBegin{P}%
    \global\@lpsb@first@parafalse
  \fi
  \fi % @lpsb@in@section
}

\newcommand{\lpsb@para@hook}{%
  % Skip header/footer box construction (output routine): we mark those as /Artifact
  % and we must not emit structural paragraph tags there.
  \if@lpsb@in@headfoot\else
  % FIRST: Handle cross-page tag continuation
  \if@lpsb@needs@reopen
    \global\@lpsb@needs@reopenfalse
    \if@lpsb@in@tag
      % Reopen tag on new page with new MCID
      \stepcounter{lpsb@globalMCID}%
      \lpsb@pdfliteralcmd{ /\lpsb@current@tag@type\space << /MCID \thelpsb@globalMCID >> BDC }%
      \immediate\write\@auxout{%
        \string\lpsb@mcid@cont{\lpsb@current@logical@id}{\thelpsb@globalMCID}{\thelpsb@currentPage}%
      }%
    \fi
  \fi
  % SECOND: Detect when deferred heading text has been output
  % For display-style headings, @lpsb@heading@deferred is TRUE until the heading
  % text is output via everypar. When @nobreak becomes FALSE, the heading is done.
  % IMPORTANT: Only clear the deferred flag when we're at the section level
  % (current tag is H1/H2/etc.), not when inside nested structures like Algorithm.
  \if@lpsb@heading@deferred
    \if@nobreak
      % Still waiting for heading output - do nothing
    \else
      % @nobreak is false - but only clear deferred if we're at section level
      % Check if current tag is a heading (starts with H)
      \edef\lpsb@tmp@chk@type{\lpsb@current@tag@type}%
      \expandafter\lpsb@check@if@heading@type\lpsb@tmp@chk@type\@nil
    \fi
  \fi
  % Normal paragraph handling
  \if@lpsb@in@shipout\else  % Skip during shipout (header/footer)
  \if@lpsb@in@maketitle\else  % Skip during maketitle (title area)
  \if@lpsb@active
    % Filter: skip list items (@listdepth > 0)
    \ifnum\@listdepth=0
      % Filter: skip minipage
      \if@minipage\else
        % Filter floats when legacy subfigure.sty is loaded
        % (subfigure.sty's argument parsing can trigger everypar incorrectly)
        % Note: Without subfigure.sty, we do NOT filter by @lpsb@in@float because
        % float boxes may contain paragraph text that needs proper P tagging.
        \if@lpsb@subfigure@detected
          \if@lpsb@in@float
            % Skip - subfigure + float = no paragraph tagging
          \else
            % subfigure loaded but not in float - proceed with paragraph detection
            \lpsb@para@hook@inner
          \fi
        \else
          % No subfigure - always proceed with paragraph detection
          \lpsb@para@hook@inner
        \fi
      \fi % @minipage
    \fi % @listdepth
  \fi % @lpsb@active
  \fi % @lpsb@in@maketitle
  \fi % @lpsb@in@shipout
  \fi % @lpsb@in@headfoot
}%

% Set up paragraph hook using the best available method:
% 1. Modern LaTeX hook system (AddToHook{para/begin}) - TL2020+
% 2. Fallback to everyhook package if available - TL2016+
% 3. Warning if neither is available
%
% NOTE: Some conference templates (ICLR, NeurIPS, CVPR, etc.) redefine paragraph
% handling in ways that create infinite loops with para hooks. We detect these
% templates and skip para hook installation - basic tagging still works via
% explicit lpsbTagBegin calls.

\newif\if@lpsb@parahook@installed \@lpsb@parahook@installedfalse
\newif\if@lpsb@skip@parahook \@lpsb@skip@parahookfalse

% Check if we should skip para hook based on detected template
\AtBeginDocument{%
  \def\lpsb@tmp@iclr{iclr}%
  \def\lpsb@tmp@neurips{neurips}%
  \def\lpsb@tmp@cvpr{cvpr}%
  \def\lpsb@tmp@icml{icml}%
  \def\lpsb@tmp@acl{acl}%
  \def\lpsb@tmp@aaai{aaai}%
  \def\lpsb@tmp@iccv{iccv}%
  \def\lpsb@tmp@tmlr{tmlr}%
  \ifx\lpsb@detected@template\lpsb@tmp@iclr \global\@lpsb@skip@parahooktrue \fi
  \ifx\lpsb@detected@template\lpsb@tmp@neurips \global\@lpsb@skip@parahooktrue \fi
  \ifx\lpsb@detected@template\lpsb@tmp@cvpr \global\@lpsb@skip@parahooktrue \fi
  \ifx\lpsb@detected@template\lpsb@tmp@icml \global\@lpsb@skip@parahooktrue \fi
  \ifx\lpsb@detected@template\lpsb@tmp@acl \global\@lpsb@skip@parahooktrue \fi
  \ifx\lpsb@detected@template\lpsb@tmp@aaai \global\@lpsb@skip@parahooktrue \fi
  \ifx\lpsb@detected@template\lpsb@tmp@iccv \global\@lpsb@skip@parahooktrue \fi
  \ifx\lpsb@detected@template\lpsb@tmp@tmlr \global\@lpsb@skip@parahooktrue \fi
  \if@lpsb@skip@parahook
    \typeout{LPSB-MCID Info: Skipping para hook for template '\lpsb@detected@template' (known conflict)}%
  \fi
}

% Try modern LaTeX hook system first (available in TL2020+)
\@ifundefined{AddToHook}{%
  % AddToHook not available, try everyhook
  \IfFileExists{everyhook.sty}{%
    \RequirePackage{everyhook}%
    \global\@lpsb@everyhook@availabletrue
    \AtBeginDocument{%
      \if@lpsb@skip@parahook\else
        \PushPostHook{par}{\lpsb@para@hook}%
        \global\@lpsb@parahook@installedtrue
      \fi
    }%
  }{%
    \PackageWarning{lpsb-mcid}{Neither AddToHook nor everyhook.sty available. Paragraph detection disabled.}%
  }%
}{%
  % Use modern AddToHook (more reliable, kernel-managed)
  % Delay installation to AtBeginDocument so template detection is complete
  \AtBeginDocument{%
    \if@lpsb@skip@parahook\else
      \AddToHook{para/begin}{\lpsb@para@hook}%
      \global\@lpsb@parahook@installedtrue
    \fi
  }%
}

\AtBeginDocument{%
  % Activate tagging, then start first P.
  \global\@lpsb@activetrue
  % Skip initial P tag for templates that conflict with para hooks
  % These templates handle paragraph structure differently and lpsbTagBegin{P}
  % at document start causes infinite loops with their internal handling.
  \if@lpsb@skip@parahook
    \typeout{LPSB-MCID Info: Skipping initial P tag for template with para hook conflict}%
  \else
    \lpsbTagBegin{P}%
  \fi
}

% --- Abstract → P with abstract annotation ---
% Use P tag for PDF 2.0 compatibility, but record it as Abstract in aux
% NOTE: Disabled abstract hooks entirely because many conference templates
% (ICLR, NeurIPS, CVPR, etc.) redefine abstract using \begin{quote} internally,
% which causes stack overflow when etoolbox patches the environment.
% Abstract content will still be captured as P tags.
\newif\if@lpsb@in@abstract \@lpsb@in@abstractfalse

% We skip hooking abstract environment here because it conflicts with
% many conference templates. The abstract content is still captured as normal P.
% Future: add per-class detection to enable selectively.

% --- Lists → L, LI ---
% Note: These hooks must check @lpsb@active because they can fire
% before \begin{document} (e.g., inside conference style file definitions)
\AtBeginEnvironment{itemize}{%
  \if@lpsb@active
    \lpsbTagEnd
    \lpsbTagBegin{L}%
  \fi
}
\AtEndEnvironment{itemize}{%
  \if@lpsb@active
    \lpsbTagEnd
    \lpsbTagBegin{P}% Start P after list
  \fi
}

\AtBeginEnvironment{enumerate}{%
  \if@lpsb@active
    \lpsbTagEnd
    \lpsbTagBegin{L}%
  \fi
}
\AtEndEnvironment{enumerate}{%
  \if@lpsb@active
    \lpsbTagEnd
    \lpsbTagBegin{P}%
  \fi
}

\AtBeginEnvironment{description}{%
  \if@lpsb@active
    \lpsbTagEnd
    \lpsbTagBegin{L}%
    \global\@lpsb@suppress@inlinetrue  % Suppress inline in description lists
  \fi
}
\AtEndEnvironment{description}{%
  \if@lpsb@active
    \global\@lpsb@suppress@inlinefalse
    \lpsbTagEnd
    \lpsbTagBegin{P}%  % Resume P after description list
  \fi
}

% --- Bibliography → BibList ---
% Bibliography environment gets special treatment.
% The \bibsection command (from natbib) uses \section* internally,
% which will be handled by the @ssect hook. We just need to suppress
% the empty P tags that appear during transition.
\newif\if@lpsb@in@bib \@lpsb@in@bibfalse

\AtBeginDocument{%
  % Hook \bibsection to start BibList AFTER the heading is output
  % NOTE: Do NOT add H1 here - @ssect hook already handles that!
  \@ifundefined{bibsection}{}{%
    \let\lpsb@orig@bibsection\bibsection
    \renewcommand{\bibsection}{%
      % Call original - @ssect will handle the H1 tagging
      \lpsb@orig@bibsection
      % NOW start BibList after heading is done
      \if@lpsb@active
        \lpsbTagEnd  % Close whateverP is open
        \lpsbTagBegin{BibList}%
      \fi
    }%
  }%
}

\AtBeginEnvironment{thebibliography}{%
  \global\@lpsb@in@bibtrue
  \global\@lpsb@suppress@inlinetrue  % Suppress Em/Strong inside BibEntry
  % Don't start BibList here - bibsection hook handles it after heading
}
\AtEndEnvironment{thebibliography}{%
  \global\@lpsb@in@bibfalse
  \global\@lpsb@suppress@inlinefalse
  \if@lpsb@active
    \lpsbTagEnd
    \lpsbTagBegin{P}%
  \fi
}

% Hook \item for LI - but NOT inside Abstract
% MUST handle optional argument correctly: \item[label] vs \item
% CRITICAL: Check \@listdepth to ensure we're inside a real list environment
\AtBeginDocument{%
  \let\lpsb@orig@item\item
  \def\item{%
    \@ifnextchar[\lpsb@item@opt\lpsb@item@noopt
  }%
  \def\lpsb@item@opt[#1]{%
    \if@lpsb@in@abstract
      \lpsb@orig@item[#1]%
    \else\if@lpsb@in@bib
      % Inside bibliography: use BibEntry tag
      \lpsbTagEnd
      \lpsbTagBegin{BibEntry}%
      \lpsb@orig@item[#1]%
    \else
      % Only tag as LI if we're actually inside a list (\@listdepth > 0)
      \ifnum\@listdepth>0
        \lpsbTagEnd
        \lpsbTagBegin{LI}%
      \fi
      \lpsb@orig@item[#1]%
    \fi\fi
  }%
  \def\lpsb@item@noopt{%
    \if@lpsb@in@abstract
      \lpsb@orig@item
    \else\if@lpsb@in@bib
      \lpsbTagEnd
      \lpsbTagBegin{BibEntry}%
      \lpsb@orig@item
    \else
      % Only tag as LI if we're actually inside a list (\@listdepth > 0)
      \ifnum\@listdepth>0
        \lpsbTagEnd
        \lpsbTagBegin{LI}%
      \fi
      \lpsb@orig@item
    \fi\fi
  }%
}


% --- Figure/Table → Figure/Table ---
% SOLUTION: Patch \@xfloat and \end@float to inject BDC/EMC INSIDE the float box.
% This ensures markers appear at the actual placement position, not source location.

% Save float type for use in BDC
\newcommand{\lpsb@current@float@type}{}

\AtBeginDocument{%
  % Patch \@xfloat - this is called after the float box is opened
  \let\lpsb@orig@@xfloat\@xfloat
  \def\@xfloat#1[#2]{%
    \lpsb@orig@@xfloat{#1}[#2]%
    % Now we're INSIDE the float's vbox - BDC here will be in the float!
    \global\@lpsb@in@floattrue
    %
    % Two-pass: assign float ID and record source page
    \stepcounter{lpsb@floatID}%
    \edef\lpsb@this@float@id{\thelpsb@floatID}%
    \edef\lpsb@this@float@source@page{\thelpsb@currentPage}%
    %
    % Store float ID in the box for shipout tracking
    % We use \special or \pdfliteral to embed a marker
    \if@lpsb@pass@one
      % In pass-one, record the float ID and source page
      % The rendered page will be recorded at shipout
      \immediate\write\@auxout{%
        \string\lpsb@pass@float{\lpsb@this@float@id}{\lpsb@this@float@source@page}{\thelpsb@currentPage}{#1}%
      }%
    \fi
    %
    \if@lpsb@active
      % Skip BDC emission in pass-one mode
      \if@lpsb@pass@one\else
        \def\lpsb@temp@a{#1}%
        \def\lpsb@temp@figure{figure}%
        \def\lpsb@temp@table{table}%
        \ifx\lpsb@temp@a\lpsb@temp@figure
          \gdef\lpsb@current@float@type{Figure}%
          % In pass-2 with data: check if float lands on different page
          \if@lpsb@has@pass@data
            % We have positioning data - use smart tagging
            \lpsbTagBeginFloat{Figure}%
          \else
            % No pass data - use original behavior
            \lpsbTagBeginFloat{Figure}%
          \fi
        \else\ifx\lpsb@temp@a\lpsb@temp@table
          \gdef\lpsb@current@float@type{Table}%
          \if@lpsb@has@pass@data
            \lpsbTagBeginFloat{Table}%
          \else
            \lpsbTagBeginFloat{Table}%
          \fi
        \else
          % Unknown float type
          \gdef\lpsb@current@float@type{Figure}%
          \lpsbTagBeginFloat{Figure}%
        \fi\fi
      \fi
    \fi
  }%
  %
  % Patch \end@float - close tag before box ends
  \let\lpsb@orig@endfloat\end@float
  \def\end@float{%
    \if@lpsb@active
      \if@lpsb@pass@one\else
        \lpsbTagEndFloat  % EMC inside float box, don't restore parent
      \fi
      % Set first_para flag to prevent everypar from cycling P immediately
      \global\@lpsb@first@paratrue
    \fi
    \global\@lpsb@in@floatfalse
    \lpsb@orig@endfloat
  }%
  %
  % Double-column float variants
  \@ifundefined{@dbfloat}{}{%
    \let\lpsb@orig@@dbfloat\@dbfloat
    \def\@dbfloat#1{%
      \lpsb@orig@@dbfloat{#1}%
      \global\@lpsb@in@floattrue
      \if@lpsb@active
        \def\lpsb@temp@a{#1}%
        \def\lpsb@temp@figure{figure}%
        \def\lpsb@temp@table{table}%
        \ifx\lpsb@temp@a\lpsb@temp@figure
          \gdef\lpsb@current@float@type{Figure}%
          \lpsbTagBeginFloat{Figure}%
        \else\ifx\lpsb@temp@a\lpsb@temp@table
          \gdef\lpsb@current@float@type{Table}%
          \lpsbTagBeginFloat{Table}%
        \else
          \gdef\lpsb@current@float@type{Figure}%
          \lpsbTagBeginFloat{Figure}%
        \fi\fi
      \fi
    }%
  }%
  \@ifundefined{end@dblfloat}{}{%
    \let\lpsb@orig@enddblfloat\end@dblfloat
    \def\end@dblfloat{%
      \if@lpsb@active
        \lpsbTagEndFloat  % EMC inside float box, don't restore parent
        % Set first_para flag to prevent everypar from cycling P immediately
        \global\@lpsb@first@paratrue
      \fi
      \global\@lpsb@in@floatfalse
      \lpsb@orig@enddblfloat
    }%
  }%
  % Hook float package's float@endH for [H] option floats - DISABLED
  % These bypass standard end@float and use float@endH instead
  % 
  % WARNING: This hook causes "No counter 'l/d/r/p'" errors in documents
  % with complex math environments (eqnarray, etc.) due to conflicts with
  % array column specifier parsing. The exact cause is that defining this
  % hook in AtBeginDocument somehow corrupts LaTeX's internal parsing state.
  %
  % Impact of disabling: [H] floats still render correctly, but may not
  % have perfectly matched MCID end tags. Standard floats are unaffected.
  %
  % \@ifundefined{float@endH}{}{%
  %   \let\lpsb@orig@floatendH\float@endH
  %   \def\float@endH{%
  %     \if@lpsb@active
  %       \lpsbTagEndFloat
  %       \global\@lpsb@first@paratrue
  %     \fi
  %     \global\@lpsb@in@floatfalse
  %     \lpsb@orig@floatendH
  %   }%
  % }%
}

% At source location: CLOSE current P before float definition starts
% This is critical because P tags at source location would otherwise
% span across the async float placement, incorrectly wrapping content
% that appears after the float in the rendered PDF.
%
% SMART LOGIC (Pass 2 with pass-one data):
% - If float lands on SAME page: close P (conservative, correct)
% - If float lands on DIFFERENT page: DON'T close P (the P content is not interrupted)
\AtBeginEnvironment{figure}{%
  \if@lpsb@active\if@lpsb@in@tag%
    \lpsb@check@float@page  % Check where this float will land
    \if@lpsb@float@same@page
      % Float on same page - close P to avoid incorrect nesting
      \lpsb@pdfliteralcmd{ EMC }%
      \immediate\write\@auxout{\string\lpsb@tag@end{\lpsb@current@logical@id}{\thelpsb@currentPage}}%
      \gdef\lpsb@tag@stack{}%
      \global\@lpsb@in@tagfalse%
    \fi
  \fi\fi%
}
\AtBeginEnvironment{figure*}{%
  \if@lpsb@active\if@lpsb@in@tag%
    \lpsb@check@float@page
    \if@lpsb@float@same@page
      \lpsb@pdfliteralcmd{ EMC }%
      \immediate\write\@auxout{\string\lpsb@tag@end{\lpsb@current@logical@id}{\thelpsb@currentPage}}%
      \gdef\lpsb@tag@stack{}%
      \global\@lpsb@in@tagfalse%
    \fi
  \fi\fi%
}
\AtBeginEnvironment{table}{%
  \if@lpsb@active\if@lpsb@in@tag%
    \lpsb@check@float@page
    \if@lpsb@float@same@page
      \lpsb@pdfliteralcmd{ EMC }%
      \immediate\write\@auxout{\string\lpsb@tag@end{\lpsb@current@logical@id}{\thelpsb@currentPage}}%
      \gdef\lpsb@tag@stack{}%
      \global\@lpsb@in@tagfalse%
    \fi
  \fi\fi%
}
\AtBeginEnvironment{table*}{%
  \if@lpsb@active\if@lpsb@in@tag%
    \lpsb@check@float@page
    \if@lpsb@float@same@page
      \lpsb@pdfliteralcmd{ EMC }%
      \immediate\write\@auxout{\string\lpsb@tag@end{\lpsb@current@logical@id}{\thelpsb@currentPage}}%
      \gdef\lpsb@tag@stack{}%
      \global\@lpsb@in@tagfalse%
    \fi
  \fi\fi%
}

% At source location: start P after float definition if not already in a tag
% Note: end@float handles the EMC+tag closure at shipout time, not here.
% Here we ensure a P is open for content after the \end{figure} in source.
\AtEndEnvironment{figure}{\if@lpsb@active\if@lpsb@in@tag\else\lpsbTagBegin{P}\fi\global\@lpsb@first@paratrue\fi}
\AtEndEnvironment{figure*}{\if@lpsb@active\if@lpsb@in@tag\else\lpsbTagBegin{P}\fi\global\@lpsb@first@paratrue\fi}
\AtEndEnvironment{table}{\if@lpsb@active\if@lpsb@in@tag\else\lpsbTagBegin{P}\fi\global\@lpsb@first@paratrue\fi}
\AtEndEnvironment{table*}{\if@lpsb@active\if@lpsb@in@tag\else\lpsbTagBegin{P}\fi\global\@lpsb@first@paratrue\fi}
% --- Caption → Caption ---
% Hook \caption and \subcaption as Caption atoms.
%
% Rationale: patching caption internals (\caption@makecaption / \@makecaption) is
% fragile and can miss some code paths. Wrapping the user-level macros is much
% more reliable, and also gives us a parent_id (Figure/Table) via lpsbTagAtom.
\newcommand{\lpsb@patch@subfigure@caption}{%
  % subcaption's subfigure environment often rebinds \caption locally; that can
  % bypass our global \caption wrapper. Re-wrap the *current* \caption inside
  % the subfigure group so subcaptions get tagged as Caption atoms.
  \@ifundefined{caption}{}{%
    \let\lpsb@orig@subfig@caption\caption
    \renewcommand{\caption}{\@ifnextchar[\lpsb@subfigcap@opt\lpsb@subfigcap@noopt}%
    \def\lpsb@subfigcap@opt[##1]##2{\lpsbTagAtom{Caption}{\lpsb@orig@subfig@caption[##1]{##2}}}%
    \def\lpsb@subfigcap@noopt##1{\lpsbTagAtom{Caption}{\lpsb@orig@subfig@caption{##1}}}%
  }%
}
\AtBeginDocument{%
  % Skip caption hooks if legacy subfigure.sty is loaded (causes expansion conflicts)
  \@ifpackageloaded{subfigure}{%
    % Legacy subfigure.sty detected - it redefines \caption internally
    % and has incompatible expansion behavior with our hooks.
    % Caption tagging is sacrificed for compilation compatibility.
    \PackageInfo{lpsb-mcid}{Legacy subfigure.sty detected - skipping caption hooks}%
  }{%
    % Safe to hook captions (subcaption package or no subfigure package)
    \@ifundefined{caption}{}{%
      \let\lpsb@orig@caption\caption
      \renewcommand{\caption}{\@ifnextchar[\lpsb@cap@opt\lpsb@cap@noopt}%
      \def\lpsb@cap@opt[#1]#2{\lpsbTagAtom{Caption}{\lpsb@orig@caption[#1]{#2}}}%
      \def\lpsb@cap@noopt#1{\lpsbTagAtom{Caption}{\lpsb@orig@caption{#1}}}%
    }%
    % subcaption package: \subcaption has same optional-arg pattern.
    \@ifundefined{subcaption}{}{%
      \let\lpsb@orig@subcaption\subcaption
      \renewcommand{\subcaption}{\@ifnextchar[\lpsb@subcap@opt\lpsb@subcap@noopt}%
      \def\lpsb@subcap@opt[#1]#2{\lpsbTagAtom{Caption}{\lpsb@orig@subcaption[#1]{#2}}}%
      \def\lpsb@subcap@noopt#1{\lpsbTagAtom{Caption}{\lpsb@orig@subcaption{#1}}}%
    }%
    % subcaption package: subfigure environment can override \caption locally.
    % Hook the environment start and re-wrap \caption inside its group.
    \@ifundefined{subfigure}{}{%
      \AtBeginEnvironment{subfigure}{\lpsb@patch@subfigure@caption}%
    }%
    % subcaption: setcaptionsubtype triggers \caption@subtypehook; use that as a
    % reliable place to re-wrap \caption for sub-captions (works even if subcaption
    % swaps \caption behind our back).
    \@ifundefined{caption@subtypehook}{}{%
      \g@addto@macro\caption@subtypehook{\lpsb@patch@subfigure@caption}%
    }%
  }%
}

% --- Footnote → Note ---
% Hook \footnote to tag as Note (PDF/UA)
\AtBeginDocument{%
  \@ifundefined{footnote}{}{%
    \let\lpsb@orig@footnote\footnote
    % \footnote produces both a mark (superscript) and text (at page bottom)
    % We tag the mark as Lbl (label), the text will be tagged via @makefntext as Note
    \renewcommand{\footnote}[2][]{%
      \def\lpsb@fn@opt{#1}%
      \ifx\lpsb@fn@opt\@empty
        % The mark is tagged as Lbl, the text is tagged separately via @makefntext
        \lpsb@orig@footnote{#2}%
      \else
        \lpsb@orig@footnote[#1]{#2}%
      \fi
    }%
  }%
  % Many papers use split footnotes: \footnotemark + \footnotetext.
  % Footnotemark is the superscript reference - tag as Lbl (label)
  \@ifundefined{footnotemark}{}{%
    \let\lpsb@orig@footnotemark\footnotemark
    \renewcommand{\footnotemark}{%
      \@ifnextchar[\lpsb@fnmark@opt\lpsb@fnmark@noopt
    }%
    \def\lpsb@fnmark@opt[#1]{\lpsbTagAtom{Lbl}{\lpsb@orig@footnotemark[#1]}}%
    \def\lpsb@fnmark@noopt{\lpsbTagAtom{Lbl}{\lpsb@orig@footnotemark}}%
  }%
  \@ifundefined{footnotetext}{}{%
    \let\lpsb@orig@footnotetext\footnotetext
    \renewcommand{\footnotetext}{%
      \@ifnextchar[\lpsb@fntext@opt\lpsb@fntext@noopt
    }%
    \def\lpsb@fntext@opt[#1]#2{\lpsbTagAtom{Note}{\lpsb@orig@footnotetext[#1]{#2}}}%
    \def\lpsb@fntext@noopt#1{\lpsbTagAtom{Note}{\lpsb@orig@footnotetext{#1}}}%
  }%
  % Standard \footnote uses internal \@footnotemark/\@footnotetext; hook those too so the
  % footnote text itself gets tagged (not just the mark in the paragraph).
  %
  % CRITICAL: \@footnotetext uses \insert\footins{...} which is async (like floats).
  % The content is rendered at page bottom, not when the command is called.
  % To properly tag, we hook \@makefntext which formats the actual footnote content.
  %
  % Footnote structure in PDF/UA:
  % - Footnote mark (in paragraph): tagged as Lbl via \@footnotemark hook
  % - Footnote text (at page bottom): tagged as Note via \@makefntext hook
  %
  \newif\if@lpsb@in@footnote \@lpsb@in@footnotefalse
  %
  % Hook \@footnotemark to tag the superscript mark as Lbl
  \@ifundefined{@footnotemark}{}{%
    \let\lpsb@orig@@footnotemark\@footnotemark
    \def\@footnotemark{%
      \lpsbTagAtom{Lbl}{\lpsb@orig@@footnotemark}%
    }%
  }%
  %
  \@ifundefined{@makefntext}{}{%
    \let\lpsb@orig@@makefntext\@makefntext
    \long\def\@makefntext#1{%
      \if@lpsb@active
        % Open Note tag for footnote text, close current P if any
        \lpsbTagEnd
        \lpsbTagBegin{Note}%
        \global\@lpsb@in@footnotetrue
        \lpsb@orig@@makefntext{#1}%
        \lpsbTagEnd
        % Restore P for any content after footnote
        \lpsbTagBegin{P}%
        \global\@lpsb@in@footnotefalse
      \else
        \lpsb@orig@@makefntext{#1}%
      \fi
    }%
  }%
  % Also hook minipage footnotes
  \@ifundefined{@mpfootnotetext}{}{%
    \let\lpsb@orig@@mpfootnotetext\@mpfootnotetext
    \long\def\@mpfootnotetext#1{%
      % minipage footnotes use similar mechanism
      \lpsb@orig@@mpfootnotetext{#1}%
    }%
  }%
}

