  % No-op: older attempt to wrap \@svsechd was unreliable because LaTeX redefines
  % it in multiple places. We handle run-in headings by hooking \@xsect instead.
  \def\lpsb@wrap@svsechd{}%

  % Run-in heading capture (e.g. \paragraph): the title is output via \everypar.
  \newif\if@lpsb@runin@heading@pending \@lpsb@runin@heading@pendingfalse
  \newif\if@lpsb@runin@heading@armed \@lpsb@runin@heading@armedfalse
  \newif\if@lpsb@runin@heading@guard \@lpsb@runin@heading@guardfalse
  \newif\if@lpsb@heading@closedin@sect \@lpsb@heading@closedin@sectfalse
  \newif\if@lpsb@use@sict@heading \@lpsb@use@sict@headingfalse
  \@ifundefined{@sict}{}{\global\@lpsb@use@sict@headingtrue}
  \gdef\lpsb@runin@heading@level{H4}%
  \newif\if@lpsb@current@is@heading \@lpsb@current@is@headingfalse
  \def\lpsb@set@current@heading@flag{%
    \global\@lpsb@current@is@headingfalse
    \edef\lpsb@tmp@chk@type{\lpsb@current@tag@type}%
    \expandafter\lpsb@check@heading@prefix@flag\lpsb@tmp@chk@type\@nil
  }%
  \def\lpsb@check@heading@prefix@flag#1#2\@nil{%
    \def\lpsb@tmp@first{#1}%
    \ifx\lpsb@tmp@first\lpsb@const@H
      \global\@lpsb@current@is@headingtrue
    \fi
  }%
  \def\lpsb@set@heading@level@from@num#1{%
    \ifnum#1=1\gdef\lpsb@tmp@heading@level{\lpsb@H@section}\else
    \ifnum#1=2\gdef\lpsb@tmp@heading@level{\lpsb@H@subsection}\else
    \ifnum#1=3\gdef\lpsb@tmp@heading@level{\lpsb@H@subsubsection}\else
      \gdef\lpsb@tmp@heading@level{\lpsb@H@paragraph}%
    \fi\fi\fi
  }%

  % Hook \@xsect to handle run-in headings (\paragraph etc.).
  % For afterskip < 0, LaTeX outputs the title via \everypar (\@svsechd).
  % We patch \@xsect itself (kernel macro) so we can bracket \@svsechd precisely:
  % - before \@svsechd: start H4 (pending)
  % - after \hskip -\@tempskipa: end H4 and start P so the body continues in P
  \@ifundefined{@xsect}{}{%
    \let\lpsb@orig@@xsect\@xsect
    \def\@xsect#1{%
      \@tempskipa #1\relax
      \ifdim \@tempskipa>\z@
        \par \nobreak
        \vskip \@tempskipa
        \@afterheading
      \else
        \@nobreakfalse
        \global\@noskipsectrue
        \everypar{%
          \if@noskipsec
            \global\@noskipsecfalse
            {\setbox\z@\lastbox}%
            \clubpenalty\@M
            % LPSB: start run-in heading tag right before \@svsechd outputs the title.
            \if@lpsb@active
              \if@lpsb@runin@heading@pending
                \lpsbTagEnd
                \lpsbTagBegin{\lpsb@runin@heading@level}%
                \global\@lpsb@runin@heading@pendingfalse
                \global\@lpsb@runin@heading@armedtrue
                \global\@lpsb@runin@heading@guardtrue
              \else
                \lpsb@set@current@heading@flag
                \if@lpsb@in@section\if@lpsb@current@is@heading
                  \global\@lpsb@runin@heading@armedtrue
                  \global\@lpsb@runin@heading@guardtrue
                \fi\fi
              \fi
            \fi
            \begingroup \@svsechd \endgroup
            \unskip
            \@tempskipa #1\relax
            \hskip -\@tempskipa
            % LPSB: immediately switch back to P for the paragraph body.
            \if@lpsb@active\if@lpsb@runin@heading@armed
              \lpsbTagEnd
              \lpsbTagBegin{P}%
              \global\@lpsb@first@paratrue
              \global\@lpsb@heading@deferredfalse
              \global\@lpsb@in@sectionfalse
              \global\@lpsb@runin@heading@armedfalse
              \global\@lpsb@runin@heading@guardfalse
            \fi\fi
          \else
            \clubpenalty \@clubpenalty
            \everypar{}%
          \fi}%
      \fi
      \ignorespaces}%
  }%
  %
  % Dynamic heading levels based on document class:
  % - If \chapter is defined (book/report): chapter=H1, section=H2, subsection=H3, etc.
  % - If \chapter is NOT defined (article): section=H1, subsection=H2, etc.
  %
  \@ifundefined{chapter}{%
    % Article-style: no chapter
    \def\lpsb@H@chapter{H1}%   (not used)
    \def\lpsb@H@section{H1}%
    \def\lpsb@H@subsection{H2}%
    \def\lpsb@H@subsubsection{H3}%
    \def\lpsb@H@paragraph{H4}%
    \def\lpsb@H@subparagraph{H5}%
  }{%
    % Book/Report-style: chapter is highest
    \def\lpsb@H@chapter{H1}%
    \def\lpsb@H@section{H2}%
    \def\lpsb@H@subsection{H3}%
    \def\lpsb@H@subsubsection{H4}%
    \def\lpsb@H@paragraph{H5}%
    \def\lpsb@H@subparagraph{H6}%
  }%
  %
  % acmart compatibility:
  % acmart.cls forbids redefining \section/\subsection/\paragraph (class error).
  % Use kernel-level \@startsection instead (no user-level redefinition).
  \@ifundefined{ACM@format}{}{%
    \@ifundefined{@startsection}{}{%
      \let\lpsb@orig@@startsection\@startsection
      \def\@startsection#1#2#3#4#5#6{%
        \lpsbTagEnd
        \ifnum#2=1
          \lpsbTagBegin{\lpsb@H@section}%
          \gdef\lpsb@pending@heading@level{\lpsb@H@section}%
        \else\ifnum#2=2
          \lpsbTagBegin{\lpsb@H@subsection}%
          \gdef\lpsb@pending@heading@level{\lpsb@H@subsection}%
        \else\ifnum#2=3
          \lpsbTagBegin{\lpsb@H@subsubsection}%
          \gdef\lpsb@pending@heading@level{\lpsb@H@subsubsection}%
        \else\ifnum#2=4
          \lpsbTagBegin{\lpsb@H@paragraph}%
          \gdef\lpsb@pending@heading@level{\lpsb@H@paragraph}%
        \else
          \lpsbTagBegin{\lpsb@H@paragraph}%
          \gdef\lpsb@pending@heading@level{\lpsb@H@paragraph}%
        \fi\fi\fi\fi
        \global\@lpsb@in@sectiontrue
        \global\@lpsb@heading@deferredfalse
        \lpsb@orig@@startsection{#1}{#2}{#3}{#4}{#5}{#6}%
      }%
    }%
  }%
  %
  % Hook \chapter (for book/report document classes)
  %
  \@ifundefined{chapter}{}{%
    \let\lpsb@orig@chapter\chapter
    \def\chapter{\@ifstar\lpsb@chapter@star\lpsb@chapter@nostar}%
    \def\lpsb@chapter@star#1{%
      \lpsb@orig@chapter*{#1}%
    }%
    \def\lpsb@chapter@nostar{%
      \@ifnextchar[\lpsb@chapter@opt\lpsb@chapter@noopt
    }%
    \def\lpsb@chapter@opt[#1]#2{%
      \stepcounter{lpsb@sectionID}%
      \xdef\lpsb@current@section@id{\thelpsb@sectionID}%
      \lpsbTagEnd
      \lpsbTagBegin{\lpsb@H@chapter}%
      \global\@lpsb@in@sectiontrue
      \global\@lpsb@heading@deferredfalse
      \gdef\lpsb@pending@heading@level{\lpsb@H@chapter}%
      \lpsb@orig@chapter[#1]{#2}%
      \lpsbTagEnd
      \global\@lpsb@heading@deferredfalse
      \lpsbTagBegin{P}%
      \global\@lpsb@in@sectionfalse
    }%
    \def\lpsb@chapter@noopt#1{%
      \stepcounter{lpsb@sectionID}%
      \xdef\lpsb@current@section@id{\thelpsb@sectionID}%
      \lpsbTagEnd
      \lpsbTagBegin{\lpsb@H@chapter}%
      \global\@lpsb@in@sectiontrue
      \global\@lpsb@heading@deferredfalse
      \gdef\lpsb@pending@heading@level{\lpsb@H@chapter}%
      \lpsb@orig@chapter{#1}%
      \lpsbTagEnd
      \global\@lpsb@heading@deferredfalse
      \lpsbTagBegin{P}%
      \global\@lpsb@in@sectionfalse
    }%
  }%
  %
  % Hook \section / \subsection / \subsubsection.
  %
  % CRITICAL: Preserve the star form (\section*{...}). If we don't, LaTeX will
  % mis-parse \section*{References} as \section{*} and you'll literally typeset
  % "6 *" (section 6 with title '*'), with "References" falling into the next P.
  %
  % --- GENERIC SECTION HANDLER (TL2016 compatible) ---
  % Consolidates the common logic shared by \section, \subsection, \subsubsection.
  % #1 = Heading level constant (e.g., \lpsb@H@section)
  % #2 = Original command (e.g., \lpsb@orig@section)
  % #3 = Arguments to pass (pre-packaged as [opt]{mand} or {mand})
  \long\def\lpsb@generic@section@handler#1#2#3{%
    \lpsb@debug{generic@section@handler CALLED: level=#1}%
    \if@lpsb@use@sict@heading
      #2#3%
    \else
      \global\@lpsb@runin@heading@pendingfalse
      \global\@lpsb@runin@heading@armedfalse
      \stepcounter{lpsb@sectionID}%
      \xdef\lpsb@current@section@id{\thelpsb@sectionID}%
      % CRITICAL: Check pending P flags BEFORE lpsbTagEnd
      % This ensures text between previous section/float and this section has a P tag
      \if@lpsb@in@tag\else
        \if@lpsb@P@pending@after@section
          \global\@lpsb@P@pending@after@sectionfalse
          \lpsbTagBegin{P}%
        \else\if@lpsb@P@pending@after@float
          \global\@lpsb@P@pending@after@floatfalse
          \lpsbTagBegin{P}%
        \fi\fi
      \fi
      \lpsbTagEnd
      \lpsbTagBegin{#1}%
      \global\@lpsb@in@sectiontrue
      \global\@lpsb@heading@deferredfalse
      \gdef\lpsb@pending@heading@level{#1}%
      #2#3%
      % Defer P tag creation - everypar will handle it when real content appears
      % This prevents empty P tags when floats immediately follow \section{...}
      \if@lpsb@heading@closedin@sect
        \global\@lpsb@heading@closedin@sectfalse
      \else
        \if@lpsb@runin@heading@armed\else
          \if@lpsb@runin@heading@pending\else
            \lpsbTagEndForce
            \global\@lpsb@heading@deferredfalse
            \global\@lpsb@P@pending@after@sectiontrue
            \global\@lpsb@in@sectionfalse
            \lpsb@debug{generic@section@handler: H closed, P@pending@after@section=TRUE}%
          \fi
        \fi
      \fi
    \fi
  }%
  %
  \@ifundefined{ACM@format}{\@ifundefined{section}{%
    \typeout{LPSB-MCID Info: section NOT defined, skipping hook}%
  }{%
    \typeout{LPSB-MCID Info: Hooking section command}%
    \let\lpsb@orig@section\section
    \def\section{\@ifstar\lpsb@section@star\lpsb@section@nostar}%
    \long\def\lpsb@section@star#1{\lpsb@orig@section*{#1}}%
    \def\lpsb@section@nostar{\@ifnextchar[\lpsb@section@opt\lpsb@section@noopt}%
    \long\def\lpsb@section@opt[#1]#2{\lpsb@generic@section@handler{\lpsb@H@section}{\lpsb@orig@section}{[#1]{#2}}}%
    \long\def\lpsb@section@noopt#1{\lpsb@generic@section@handler{\lpsb@H@section}{\lpsb@orig@section}{{#1}}}%
  }}{%
    \typeout{LPSB-MCID Info: ACM@format defined, skipping section hook}%
  }%
  \@ifundefined{ACM@format}{\@ifundefined{subsection}{}{%
    \let\lpsb@orig@subsec\subsection
    \def\subsection{\@ifstar\lpsb@subsection@star\lpsb@subsection@nostar}%
    \long\def\lpsb@subsection@star#1{\lpsb@orig@subsec*{#1}}%
    \def\lpsb@subsection@nostar{\@ifnextchar[\lpsb@subsection@opt\lpsb@subsection@noopt}%
    \long\def\lpsb@subsection@opt[#1]#2{\lpsb@generic@section@handler{\lpsb@H@subsection}{\lpsb@orig@subsec}{[#1]{#2}}}%
    \long\def\lpsb@subsection@noopt#1{\lpsb@generic@section@handler{\lpsb@H@subsection}{\lpsb@orig@subsec}{{#1}}}%
  }}{}%
  % Hook \subsubsection
  \@ifundefined{ACM@format}{\@ifundefined{subsubsection}{}{%
    \let\lpsb@orig@subsubsec\subsubsection
    \def\subsubsection{\@ifstar\lpsb@subsubsection@star\lpsb@subsubsection@nostar}%
    \long\def\lpsb@subsubsection@star#1{\lpsb@orig@subsubsec*{#1}}%
    \def\lpsb@subsubsection@nostar{\@ifnextchar[\lpsb@subsubsection@opt\lpsb@subsubsection@noopt}%
    \long\def\lpsb@subsubsection@opt[#1]#2{\lpsb@generic@section@handler{\lpsb@H@subsubsection}{\lpsb@orig@subsubsec}{[#1]{#2}}}%
    \long\def\lpsb@subsubsection@noopt#1{\lpsb@generic@section@handler{\lpsb@H@subsubsection}{\lpsb@orig@subsubsec}{{#1}}}%
  }}{}%
  % Hook \paragraph
  \@ifundefined{ACM@format}{\@ifundefined{paragraph}{}{%
    \let\lpsb@orig@paragraph\paragraph
    \def\paragraph{\@ifstar\lpsb@paragraph@star\lpsb@paragraph@nostar}%
    \long\def\lpsb@paragraph@star#1{%
      \lpsb@orig@paragraph*{#1}%
    }%
    \def\lpsb@paragraph@nostar{%
      \@ifnextchar[\lpsb@paragraph@opt\lpsb@paragraph@noopt
    }%
    \long\def\lpsb@paragraph@opt[#1]#2{%
      \stepcounter{lpsb@sectionID}%
      \xdef\lpsb@current@section@id{\thelpsb@sectionID}%
      % CRITICAL: Check pending P flags BEFORE lpsbTagEnd
      % This ensures text between previous section and this paragraph has a P tag
      \if@lpsb@in@tag\else
        \if@lpsb@P@pending@after@section
          \global\@lpsb@P@pending@after@sectionfalse
          \lpsbTagBegin{P}%
        \else\if@lpsb@P@pending@after@float
          \global\@lpsb@P@pending@after@floatfalse
          \lpsbTagBegin{P}%
        \fi\fi
      \fi
      \lpsbTagEnd
      % Mark a pending run-in heading; \@xsect/\everypar will do the actual tagging.
      \global\@lpsb@runin@heading@pendingtrue
      \global\@lpsb@runin@heading@guardtrue
      \gdef\lpsb@runin@heading@level{\lpsb@H@paragraph}%
      \gdef\lpsb@pending@heading@level{\lpsb@H@paragraph}%
      \lpsb@orig@paragraph[#1]{#2}%
    }%
    \long\def\lpsb@paragraph@noopt#1{%
      \stepcounter{lpsb@sectionID}%
      \xdef\lpsb@current@section@id{\thelpsb@sectionID}%
      % CRITICAL: Check pending P flags BEFORE lpsbTagEnd
      \if@lpsb@in@tag\else
        \if@lpsb@P@pending@after@section
          \global\@lpsb@P@pending@after@sectionfalse
          \lpsbTagBegin{P}%
        \else\if@lpsb@P@pending@after@float
          \global\@lpsb@P@pending@after@floatfalse
          \lpsbTagBegin{P}%
        \fi\fi
      \fi
      \lpsbTagEnd
      \global\@lpsb@runin@heading@pendingtrue
      \global\@lpsb@runin@heading@guardtrue
      \gdef\lpsb@runin@heading@level{\lpsb@H@paragraph}%
      \gdef\lpsb@pending@heading@level{\lpsb@H@paragraph}%
      \lpsb@orig@paragraph{#1}%
    }%
  }}{}%
  % Hook \@ssect for starred sections (\section*, \subsection*)
  \@ifundefined{@ssect}{}{%
    \let\lpsb@orig@@ssect\@ssect
    \def\@ssect#1#2#3#4#5{%
      \if@lpsb@manual@star@section
        \global\@lpsb@manual@star@sectionfalse
        \lpsb@orig@@ssect{#1}{#2}{#3}{#4}{#5}%
      \else
      \global\@lpsb@runin@heading@pendingfalse
      \global\@lpsb@runin@heading@armedfalse
      \stepcounter{lpsb@sectionID}%
      \xdef\lpsb@current@section@id{\thelpsb@sectionID}%
      %
      \lpsbTagEnd
      \global\@lpsb@in@sectiontrue
      \global\@lpsb@heading@deferredfalse
      % Determine heading level based on indent
      \ifdim#1<1em
        \gdef\lpsb@pending@heading@level{H1}%
        \gdef\lpsb@tmp@heading@level{H1}%
      \else
        \gdef\lpsb@pending@heading@level{H2}%
        \gdef\lpsb@tmp@heading@level{H2}%
      \fi
      % Wrap the heading text directly so tags are inside the typeset box
      \lpsb@orig@@ssect{#1}{#2}{#3}{#4}{\lpsbTagBegin{\lpsb@tmp@heading@level}#5\lpsbTagEnd}%
      \if@lpsb@heading@closedin@sect
        \global\@lpsb@heading@closedin@sectfalse
      \else
        \if@lpsb@runin@heading@armed\else
          \if@lpsb@runin@heading@pending\else
            \global\@lpsb@heading@deferredfalse
            \global\@lpsb@P@pending@after@sectiontrue
            \global\@lpsb@in@sectionfalse
          \fi
        \fi
      \fi
      \fi
    }%
  }%
  \fi % @lpsb@skip@sectionhooks
}

% --- Paragraph → P ---
% Use everyhook package for robust \everypar hooking (TL2016+)
% \PushPostHook{par} survives even when other packages reset \everypar

% Float environment flag (must be defined before everypar hook)
\newif\if@lpsb@in@float \@lpsb@in@floatfalse

% Tabular environment flag - suppress InlineMath tagging inside tables
\newif\if@lpsb@in@tabular \@lpsb@in@tabularfalse

% Flag for everyhook availability
\newif\if@lpsb@everyhook@available \@lpsb@everyhook@availablefalse

% Define first-para flag unconditionally (needed in both paths)
\newif\if@lpsb@first@para \@lpsb@first@paratrue
\def\lpsb@P@const{P}%

% Helper: Check if current tag type starts with "H" (heading)
% If so, close H1 and start P (heading text was output)
% Otherwise, don't close (we're inside a nested structure)
\def\lpsb@const@H@para{H}%
\def\lpsb@check@if@heading@type#1#2\@nil{%
  \def\lpsb@tmp@first@para{#1}%
  \ifx\lpsb@tmp@first@para\lpsb@const@H@para
    % Current tag is a heading - we're at section level
    % Heading text was output via everypar, close H1 and start P
    \global\@lpsb@heading@deferredfalse
    % Close the H1 tag
    \lpsb@pdfliteralcmd{ EMC }%
    \immediate\write\@auxout{%
      \string\lpsb@tag@end{\lpsb@current@logical@id}{\thelpsb@currentPage}%
    }%
    \global\@lpsb@in@tagfalse
    \global\@lpsb@in@sectionfalse
    % Start new P for content after heading
    \lpsbTagBegin{P}%
    \global\@lpsb@first@paratrue
  \fi
  % If not a heading, don't close - we're inside a nested structure
}

% Paragraph detection logic - defined separately to avoid \IfFileExists parsing issues
% with nested \if..\fi conditionals

% Inner paragraph hook - the core logic, extracted for conditional reuse
% Implements the "deferred decision" pattern for robust tagging
\newcommand{\lpsb@para@hook@inner}{%
  % Filter: skip section formatting (to prevent H1/H2 from being interrupted)
  \if@lpsb@in@section
    \lpsb@debug{para@hook@inner: in@section=TRUE, checking heading flag}%
    \lpsb@set@current@heading@flag
    \if@lpsb@current@is@heading
      % Still inside a heading - do nothing here.
      \lpsb@debug{para@hook@inner: current@is@heading=TRUE, SKIPPED}%
    \else
      \lpsb@para@hook@inner@body
    \fi
  \else
    \lpsb@para@hook@inner@body
  \fi
}

\newcommand{\lpsb@para@hook@inner@body}{%
  %
  % [CRITICAL] Skip paragraph cycling inside abstract to keep it as one logical element
  % This prevents cross-column abstract content from being split into multiple P elements
  \if@lpsb@in@abstract\else
  %
  % [Phase 3] Layout Suppression: skip all pending logic inside center/minipage
  \if@lpsb@suppress@pending@trigger\else
  %
  % [Phase 4] Block Tag Lock: don't open block tags inside atomic constructs
  \if@lpsb@lock@block@tags\else
  %
  % === DEFERRED P TAG PATTERN ===
  % Check all pending flags in priority order. If any is set, handle it
  % instead of the normal paragraph cycling logic.
  %
  % [Phase 1] Deferred P after section heading
  \lpsb@debug{para@hook@inner@body: P@pending@after@section=\if@lpsb@P@pending@after@section TRUE\else FALSE\fi}%
  \if@lpsb@P@pending@after@section
    \lpsb@debug{everypar triggered with P@pending=TRUE, in@tag=\if@lpsb@in@tag TRUE\else FALSE\fi}%
    \global\@lpsb@P@pending@after@sectionfalse
    % Force close any existing tag and start fresh P after section heading
    \if@lpsb@in@tag
      \lpsbTagEnd
    \fi
    \lpsbTagBegin{P}%
    \global\@lpsb@first@parafalse
    \lpsb@debug{Started new P tag after section}%
  \else
  % [Phase 1] Deferred P after display math
  \if@lpsb@P@pending@after@math
    \global\@lpsb@P@pending@after@mathfalse
    \if@lpsb@in@tag\else
      \lpsbTagBegin{P}%
      \global\@lpsb@first@parafalse
    \fi
  \else
  % [Phase 2] Deferred P after list
  \if@lpsb@P@pending@after@list
    \global\@lpsb@P@pending@after@listfalse
    \if@lpsb@in@tag\else
      \lpsbTagBegin{P}%
      \global\@lpsb@first@parafalse
    \fi
  \else
  % [Phase 2] Deferred P after float
  \if@lpsb@P@pending@after@float
    \global\@lpsb@P@pending@after@floatfalse
    \if@lpsb@in@tag\else
      \lpsbTagBegin{P}%
      \global\@lpsb@first@parafalse
    \fi
  \else
    % Normal paragraph logic (no pending flags set)
    \if@lpsb@in@tag
      % Already in a tag
      \if@lpsb@first@para
        % First para after structure - don't CYCLE P
        \global\@lpsb@first@parafalse
      \else
        % if it's P, cycle it
        \ifx\lpsb@current@tag@type\lpsb@P@const
          \lpsbTagEnd
          \lpsbTagBegin{P}%
        \fi
      \fi
    \else
      % NOT in any tag - ALWAYS start new P (after float or other structure)
      \lpsbTagBegin{P}%
      \global\@lpsb@first@parafalse
    \fi
  \fi\fi\fi\fi % end pending flag checks
  %
  \fi % @lpsb@lock@block@tags
  \fi % @lpsb@suppress@pending@trigger
  \fi % @lpsb@in@abstract
}

% Re-entrancy guard flag for paragraph hook
\newif\if@lpsb@in@parahook \@lpsb@in@parahookfalse

\newcommand{\lpsb@para@hook}{%
  %% ===========================================
  %% Robust paragraph hook with proper guards
  %% ===========================================
  %% Key insight: The hook itself is correct (para/begin is the right place),
  %% but we must add context-awareness to avoid firing during:
  %% 1. Measurement boxes (templates use \setbox to measure title width)
  %% 2. Moving arguments (writing to .toc/.lof/.aux)
  %% 3. Header/footer construction
  %%
  %% The "silver bullet" is \ifx\protect\@typeset@protect - this tells LaTeX:
  %% "Only execute when we're truly typesetting to PDF, not measuring or writing"
  %%
  %% [Guard 1] Re-entrancy lock: prevent recursive calls
  \if@lpsb@in@parahook\else
  \global\@lpsb@in@parahooktrue
  %%
  %% [Guard 2] CRITICAL: Typesetting context check
  %% This is the key fix that prevents infinite loops in NeurIPS/ICLR/CVPR etc.
  %% These templates use \setbox to measure title width, which triggers \everypar
  %% inside the measurement box. Without this guard, we'd emit PDF literals
  %% or write to aux inside measurement mode, corrupting TeX's state.
  \ifx\protect\@typeset@protect
  %%
  %% [Guard 3] Skip header/footer box construction
  \if@lpsb@in@headfoot\else
  %% [Guard 4] Skip during page shipout
  \if@lpsb@in@shipout\else
  %% [Guard 5] Skip during maketitle
  \if@lpsb@in@maketitle\else
  %%
  \if@lpsb@active
    %%
    %% --- 1. Handle cross-page tag continuation ---
    \if@lpsb@needs@reopen
      \global\@lpsb@needs@reopenfalse
      \if@lpsb@in@tag
        % CRITICAL: Do NOT reopen Table/Figure containers
        \lpsb@if@container@type{%
          % Container type - do not reopen
        }{%
          % Normal type - reopen with continuation
          \lpsb@reopen@tag@with@cont{\lpsb@current@logical@id}{\lpsb@current@tag@type}%
        }%
      \fi
    \fi
    %%
    %% --- 2. Auto-close headings before paragraph body ---
    \if@lpsb@in@tag
      \if@lpsb@runin@heading@guard\else
        \edef\lpsb@tmp@chk@type{\lpsb@current@tag@type}%
        \expandafter\lpsb@check@if@heading@type\lpsb@tmp@chk@type\@nil
      \fi
    \fi
    %%
    %% --- 3. Handle deferred heading output ---
    \if@lpsb@heading@deferred
    % Display headings: title already typeset; close H and start P here.
    % Run-in headings are handled in \@xsect (pending/armed flags).
    \if@lpsb@runin@heading@pending\else
      \if@lpsb@runin@heading@armed\else
        \edef\lpsb@tmp@chk@type{\lpsb@current@tag@type}%
        \expandafter\lpsb@check@if@heading@type\lpsb@tmp@chk@type\@nil
      \fi
    \fi
    \fi
    %%
    %% --- 4. Normal paragraph detection ---
    \ifnum\@listdepth=0
      \if@minipage
        \if@lpsb@in@float\else
          \lpsb@para@hook@inner
        \fi
      \else
        \lpsb@para@hook@inner
      \fi
    \fi
    %%
  \fi % @lpsb@active
  %%
  \fi % @lpsb@in@maketitle
  \fi % @lpsb@in@shipout
  \fi % @lpsb@in@headfoot
  \fi % @typeset@protect
  %%
  \global\@lpsb@in@parahookfalse
  \fi % @lpsb@in@parahook
}%

% Set up paragraph hook using the best available method:
% 1. Modern LaTeX hook system (AddToHook{para/begin}) - TL2020+
% 2. Fallback to everyhook package if available - TL2016+
% 3. Warning if neither is available
%
% NOTE: With \ifx\protect\@typeset@protect guard in \lpsb@para@hook,
% we NO LONGER need to skip any templates. The guard prevents firing
% during measurement boxes (which was the cause of infinite loops in
% NeurIPS/ICLR/CVPR etc.).

\newif\if@lpsb@parahook@installed \@lpsb@parahook@installedfalse

% Try modern LaTeX hook system first (available in TL2020+)
\@ifundefined{AddToHook}{%
  % AddToHook not available, try everyhook
  \IfFileExists{everyhook.sty}{%
    \RequirePackage{everyhook}%
    \global\@lpsb@everyhook@availabletrue
    \AtBeginDocument{%
      \PushPostHook{par}{\lpsb@para@hook}%
      \global\@lpsb@parahook@installedtrue
    }%
  }{%
    \PackageWarning{lpsb-mcid}{Neither AddToHook nor everyhook.sty available. Paragraph detection disabled.}%
  }%
}{%
  % Use modern AddToHook (more reliable, kernel-managed)
  \AtBeginDocument{%
    \AddToHook{para/begin}{\lpsb@para@hook}%
    \global\@lpsb@parahook@installedtrue
    %% [Optional] Force our hook to run after other packages
    \@ifundefined{DeclareHookRule}{}{%
      \DeclareHookRule{para/begin}{lpsb-mcid}{after}{.}%
    }%
  }%
}

\AtBeginDocument{%
  % Activate tagging, then start first P.
  \global\@lpsb@activetrue
  \lpsbTagBegin{P}%
}

% --- Abstract → P with abstract annotation ---
% Use P tag for PDF 2.0 compatibility, but record it as Abstract in aux
% NOTE: Disabled abstract hooks entirely because many conference templates
% (ICLR, NeurIPS, CVPR, etc.) redefine abstract using \begin{quote} internally,
% which causes stack overflow when etoolbox patches the environment.
% Abstract content will still be captured as P tags.
\newif\if@lpsb@in@abstract \@lpsb@in@abstractfalse

% We skip hooking abstract environment here because it conflicts with
% many conference templates. The abstract content is still captured as normal P.
% Future: add per-class detection to enable selectively.

% --- Lists → L, LI ---
% Note: These hooks must check @lpsb@active because they can fire
% before \begin{document} (e.g., inside conference style file definitions)
\AtBeginEnvironment{itemize}{%
  \if@lpsb@active
    \lpsbTagEnd
    \lpsbTagBegin{L}%
  \fi
}
\AtEndEnvironment{itemize}{%
  \if@lpsb@active
    \lpsbTagEnd
    % Defer P - everypar will start it when real content arrives
    \global\@lpsb@P@pending@after@listtrue
  \fi
}

\AtBeginEnvironment{enumerate}{%
  \if@lpsb@active
    \lpsbTagEnd
    \lpsbTagBegin{L}%
  \fi
}
\AtEndEnvironment{enumerate}{%
  \if@lpsb@active
    \lpsbTagEnd
    \global\@lpsb@P@pending@after@listtrue
  \fi
}

\AtBeginEnvironment{description}{%
  \if@lpsb@active
    \lpsbTagEnd
    \lpsbTagBegin{L}%
    \global\@lpsb@suppress@inlinetrue  % Suppress inline in description lists
  \fi
}
\AtEndEnvironment{description}{%
  \if@lpsb@active
    \global\@lpsb@suppress@inlinefalse
    \lpsbTagEnd
    \global\@lpsb@P@pending@after@listtrue
  \fi
}

% --- Bibliography → BibList ---
% Bibliography environment gets special treatment.
% The \bibsection command (from natbib) uses \section* internally,
% which will be handled by the @ssect hook. We just need to suppress
% the empty P tags that appear during transition.
\newif\if@lpsb@in@bib \@lpsb@in@bibfalse

\AtBeginDocument{%
  % Hook \bibsection to start BibList AFTER the heading is output
  % NOTE: Do NOT add H1 here - @ssect hook already handles that!
  \@ifundefined{bibsection}{}{%
    \let\lpsb@orig@bibsection\bibsection
    \renewcommand{\bibsection}{%
      % Call original - @ssect will handle the H1 tagging
      \lpsb@orig@bibsection
      % Defer BibList start to first \item to avoid closing P too early
      \if@lpsb@active
        \global\@lpsb@biblist@pendingtrue
      \fi
    }%
  }%
}

\AtBeginEnvironment{thebibliography}{%
  \global\@lpsb@in@bibtrue
  \global\@lpsb@suppress@inlinetrue  % Suppress Em/Strong inside BibEntry
  % Don't start BibList here - bibsection hook handles it after heading
}
\AtEndEnvironment{thebibliography}{%
  \global\@lpsb@in@bibfalse
  \global\@lpsb@suppress@inlinefalse
  \if@lpsb@active
    \lpsbTagEnd
    \edef\lpsb@tmp@chk{\lpsb@current@tag@type}%
    \ifx\lpsb@tmp@chk\lpsb@tmp@biblist
      \lpsbTagEnd
    \fi
    \lpsbTagBegin{P}%
  \fi
}

% Hook \item for LI - but NOT inside Abstract
% MUST handle optional argument correctly: \item[label] vs \item
% CRITICAL: Check \@listdepth to ensure we're inside a real list environment
% FIX: Check for beamer class to prevent crash (beamer redefines item complexly for overlays)
\AtBeginDocument{%
  \@ifclassloaded{beamer}{%
    \PackageWarning{lpsb-mcid}{Beamer class detected. List tagging (LI) disabled to prevent conflicts.}%
  }{%
    % Only hook item if NOT beamer
    \let\lpsb@orig@item\item
    \def\item{%
      \@ifnextchar[\lpsb@item@opt\lpsb@item@noopt
    }%
    \def\lpsb@item@opt[#1]{%
      \if@lpsb@in@abstract
        \lpsb@orig@item[#1]%
      \else\if@lpsb@in@bib
        \if@lpsb@biblist@pending
          \global\@lpsb@biblist@pendingfalse
          \if@lpsb@in@tag\lpsbTagEnd\fi
          \lpsbTagBegin{BibList}%
        \fi
        % Inside bibliography: use BibEntry tag
        \lpsbTagEnd
        \lpsbTagBegin{BibEntry}%
        \lpsb@orig@item[#1]%
      \else
        % Only tag as LI if we're actually inside a list (\@listdepth > 0)
        \ifnum\@listdepth>0
          \lpsbTagEnd
          \lpsbTagBegin{LI}%
        \fi
        \lpsb@orig@item[#1]%
      \fi\fi
    }%
    \def\lpsb@item@noopt{%
      \if@lpsb@in@abstract
        \lpsb@orig@item
      \else\if@lpsb@in@bib
        \if@lpsb@biblist@pending
          \global\@lpsb@biblist@pendingfalse
          \if@lpsb@in@tag\lpsbTagEnd\fi
          \lpsbTagBegin{BibList}%
        \fi
        \lpsbTagEnd
        \lpsbTagBegin{BibEntry}%
        \lpsb@orig@item
      \else
        % Only tag as LI if we're actually inside a list (\@listdepth > 0)
        \ifnum\@listdepth>0
          \lpsbTagEnd
          \lpsbTagBegin{LI}%
        \fi
        \lpsb@orig@item
      \fi\fi
    }%
  }%
}


% --- Figure/Table → Figure/Table ---
% SOLUTION: Patch \@xfloat and \end@float to inject BDC/EMC INSIDE the float box.
% This ensures markers appear at the actual placement position, not source location.

% Save float type for use in BDC
\newcommand{\lpsb@current@float@type}{}

\AtBeginDocument{%
  % Patch \@xfloat - this is called after the float box is opened
  \let\lpsb@orig@@xfloat\@xfloat
  \def\@xfloat#1[#2]{%
    \lpsb@orig@@xfloat{#1}[#2]%
    % Now we're INSIDE the float's vbox - BDC here will be in the float!
    \global\@lpsb@in@floattrue
    %
    % Two-pass: assign float ID and record source page
    \stepcounter{lpsb@floatID}%
    \edef\lpsb@this@float@id{\thelpsb@floatID}%
    \edef\lpsb@this@float@source@page{\thelpsb@currentPage}%
    %
    % Store float ID in the box for shipout tracking
    % We use \special or \pdfliteral to embed a marker
    \if@lpsb@pass@one
      % In pass-one, record the float ID and source page
      % The rendered page will be recorded at shipout
      \immediate\write\@auxout{%
        \string\lpsb@pass@float{\lpsb@this@float@id}{\lpsb@this@float@source@page}{\thelpsb@currentPage}{#1}%
      }%
    \fi
    %
    \if@lpsb@active
      % Skip BDC emission in pass-one mode
      \if@lpsb@pass@one\else
        \def\lpsb@temp@a{#1}%
        \def\lpsb@temp@figure{figure}%
        \def\lpsb@temp@table{table}%
        \ifx\lpsb@temp@a\lpsb@temp@figure
          \gdef\lpsb@current@float@type{Figure}%
          % In pass-2 with data: check if float lands on different page
          \if@lpsb@has@pass@data
            % We have positioning data - use smart tagging
            \lpsbTagBeginFloat{Figure}%
          \else
            % No pass data - use original behavior
            \lpsbTagBeginFloat{Figure}%
          \fi
        \else\ifx\lpsb@temp@a\lpsb@temp@table
          \gdef\lpsb@current@float@type{Table}%
          \if@lpsb@has@pass@data
            \lpsbTagBeginFloat{Table}%
          \else
            \lpsbTagBeginFloat{Table}%
          \fi
        \else
          % Unknown float type
          \gdef\lpsb@current@float@type{Figure}%
          \lpsbTagBeginFloat{Figure}%
        \fi\fi
      \fi
    \fi
  }%
  %
  % Patch \end@float - close tag before box ends
  \let\lpsb@orig@endfloat\end@float
  % Helper command to start P after float group ends
  % FIX: Remove conditional checks - after a float ends, we ALWAYS need to start P
  % for any following text. The conditions were causing failures when flag states
  % were corrupted by nested environments (e.g., \resizebox inside table).
  \def\lpsb@start@P@after@float{%
    \lpsb@debug{lpsb@start@P@after@float called}%
    \lpsb@debug{  @lpsb@active = \if@lpsb@active TRUE\else FALSE\fi}%
    \lpsb@debug{  @lpsb@in@float = \if@lpsb@in@float TRUE\else FALSE\fi}%
    \lpsb@debug{  @lpsb@in@tag = \if@lpsb@in@tag TRUE\else FALSE\fi}%
    \lpsb@debug{  @lpsb@pass@one = \if@lpsb@pass@one TRUE\else FALSE\fi}%
    \if@lpsb@active
      \if@lpsb@in@float
        \lpsb@debug{  -> SKIPPED: still in float}%
      \else
        % Force close any existing tag and start fresh P
        \if@lpsb@in@tag
          \lpsb@debug{  -> Closing existing tag first}%
          \lpsbTagEnd
        \fi
        \lpsb@debug{  -> Starting P tag with lpsbTagBeginForce}%
        \lpsbTagBeginForce{P}%
      \fi
    \else
      \lpsb@debug{  -> SKIPPED: lpsb not active}%
    \fi
  }%
  %
  \def\end@float{%
    \lpsb@debug{end@float called}%
    \if@lpsb@active
      \lpsb@debug{  lpsb is active}%
      \if@lpsb@pass@one\else
        \lpsbTagEndFloat  % EMC inside float box, don't restore parent
      \fi
      % Set first_para flag to prevent everypar from cycling P immediately
      \global\@lpsb@first@paratrue
      % Set pending flag as backup for cases where aftergroup doesn't work
      \global\@lpsb@P@pending@after@floattrue
    \fi
    \global\@lpsb@in@floatfalse
    % CRITICAL: Use aftergroup to start P IMMEDIATELY after float group closes
    % This must be AFTER setting @lpsb@in@floatfalse so the check passes
    % and BEFORE \lpsb@orig@endfloat which closes the float's vbox
    \aftergroup\lpsb@start@P@after@float
    \lpsb@orig@endfloat
  }%
  %
  % Double-column float variants
  \@ifundefined{@dbfloat}{}{%
    \let\lpsb@orig@@dbfloat\@dbfloat
    \def\@dbfloat#1{%
      \lpsb@orig@@dbfloat{#1}%
      \global\@lpsb@in@floattrue
      \if@lpsb@active
        \def\lpsb@temp@a{#1}%
        \def\lpsb@temp@figure{figure}%
        \def\lpsb@temp@table{table}%
        \ifx\lpsb@temp@a\lpsb@temp@figure
          \gdef\lpsb@current@float@type{Figure}%
          \lpsbTagBeginFloat{Figure}%
        \else\ifx\lpsb@temp@a\lpsb@temp@table
          \gdef\lpsb@current@float@type{Table}%
          \lpsbTagBeginFloat{Table}%
        \else
          \gdef\lpsb@current@float@type{Figure}%
          \lpsbTagBeginFloat{Figure}%
        \fi\fi
      \fi
    }%
  }%
  \@ifundefined{end@dblfloat}{}{%
    \let\lpsb@orig@enddblfloat\end@dblfloat
    \def\end@dblfloat{%
      \if@lpsb@active
        \lpsbTagEndFloat  % EMC inside float box, don't restore parent
        % Set first_para flag to prevent everypar from cycling P immediately
        \global\@lpsb@first@paratrue
        % Defer P start until the next real paragraph
        \global\@lpsb@P@pending@after@floattrue
      \fi
      \global\@lpsb@in@floatfalse
      \lpsb@orig@enddblfloat
    }%
  }%
  % Hook float package's float@endH for [H] option floats.
  % These bypass standard end@float and use float@endH instead, which otherwise
  % leaves our float tag open and can mis-tag captions/algorithm content as /P.
  %
  % NOTE: This used to be disabled due to reports of parsing-state corruption in
  % some documents. We keep the wrapper as minimal as possible and mirror the
  % end@float behavior: close the tag inside the float box (pass-2 only), then
  % reset in-float state.
  \@ifundefined{float@endH}{}{%
    \let\lpsb@orig@floatendH\float@endH
    \def\float@endH{%
      \if@lpsb@active
        \if@lpsb@pass@one\else
          \lpsbTagEndFloat
        \fi
        \global\@lpsb@first@paratrue
      \fi
      \global\@lpsb@in@floatfalse
      \lpsb@orig@floatendH
    }%
  }%
}

% At source location: CLOSE current P before float definition starts
% This is critical because P tags at source location would otherwise
% span across the async float placement, incorrectly wrapping content
% that appears after the float in the rendered PDF.
%
% SMART LOGIC (Pass 2 with pass-one data):
% - If float lands on SAME page: close P (conservative, correct)
% - If float lands on DIFFERENT page: DON'T close P (the P content is not interrupted)
%
% --- UNIFIED FLOAT HOOKS (TL2016 compatible) ---
% Helper macro for float begin hooks
\newcommand{\lpsb@register@float@begin@hook}[1]{%
  % CRITICAL FIX: Use BeforeBeginEnvironment to start deferred P BEFORE the float group
  % AtBeginEnvironment runs INSIDE the float group, causing BDC to be in wrong place
  \BeforeBeginEnvironment{#1}{%
    \if@lpsb@active
      \if@lpsb@P@pending@after@float
        \global\@lpsb@P@pending@after@floatfalse
        \lpsb@debug{BeforeBeginEnvironment #1: starting deferred P before new float}%
        \lpsbTagBeginForce{P}%
        \global\@lpsb@first@parafalse
        % Set protection flag to prevent AtBeginEnvironment from closing this P immediately
        \global\@lpsb@just@started@P@before@floattrue
      \fi
    \fi
  }%
  \AtBeginEnvironment{#1}{%
    % Clear ALL pending P flags - floats don't need empty P before them
    \global\@lpsb@P@pending@after@sectionfalse
    \global\@lpsb@P@pending@after@mathfalse
    \global\@lpsb@P@pending@after@listfalse
    % Reset main caption emission guard for this float
    \global\@lpsb@caption@emittedfalse
    \gdef\lpsb@last@caption@text{}%
    % Check if we just started a P tag in BeforeBeginEnvironment
    % If so, DON'T close it - the P tag wraps the text before this float
    % and will be closed properly when the float content starts
    \if@lpsb@just@started@P@before@float
      \global\@lpsb@just@started@P@before@floatfalse
      \lpsb@debug{AtBeginEnvironment #1: preserving P tag for inter-float text}%
      % Do NOT close the P tag here - let it wrap the text content
      % The @xfloat hook will handle entering float context
    \else
      \if@lpsb@active\if@lpsb@in@tag%
        \lpsb@check@float@page  % Check where this float will land
        \if@lpsb@float@same@page
          % Float on same page - close P to avoid incorrect nesting
          \lpsb@pdfliteralcmd{ EMC }%
          \immediate\write\@auxout{\string\lpsb@tag@end{\lpsb@current@logical@id}{\thelpsb@currentPage}}%
          \gdef\lpsb@tag@stack{}%
          \global\@lpsb@in@tagfalse%
          % Ensure next page/column continuation opens a new P
          \global\@lpsb@P@pending@after@floattrue
        \fi
      \fi\fi%
    \fi
  }%
}
% Apply to all float types using etoolbox loop
\forcsvlist{\lpsb@register@float@begin@hook}{figure,figure*,table,table*}

% At source location: start P after float definition if not already in a tag
% Note: end@float handles the EMC+tag closure at shipout time, not here.
% Here we ensure a P is open for content after the \end{figure} in source.
%
% Helper for single-column float end hooks (immediate P start)
% CRITICAL: Use AfterEndEnvironment (not AtEndEnvironment) because end@float
% closes the Figure tag inside AtEndEnvironment. We need to start P AFTER that.
% FIX: Use lpsbTagBeginForce instead of conditional lpsbTagBegin to ensure
% P tag is created even when condition flags are in unexpected states after floats.
\newcommand{\lpsb@register@float@end@hook@single}[1]{%
  \AfterEndEnvironment{#1}{%
    \if@lpsb@active
      \if@lpsb@in@tag\else
        \lpsbTagBeginForce{P}%
      \fi
      \global\@lpsb@first@paratrue
    \fi
  }%
}
% Helper for double-column float end hooks (deferred P via pending flag)
\newcommand{\lpsb@register@float@end@hook@double}[1]{%
  \AtEndEnvironment{#1}{%
    \if@lpsb@active
      \global\@lpsb@P@pending@after@floattrue
      \global\@lpsb@first@paratrue
    \fi
  }%
}
% Apply to appropriate float types
% CRITICAL: ALL floats need immediate P start, because deferred P only works
% when everypar or lpsbTagAtom is triggered. Plain text after floats won't trigger either.
\forcsvlist{\lpsb@register@float@end@hook@single}{figure,figure*,table,table*}
% --- RECURSION GUARDS ---
% Flags to prevent infinite loops when hooks call each other
% (e.g. \caption calling \subcaption calling \caption)
\newif\if@lpsb@in@caption \@lpsb@in@captionfalse
\newif\if@lpsb@in@href    \@lpsb@in@hreffalse
% Guard against duplicate main captions within the same float
\newif\if@lpsb@caption@emitted \@lpsb@caption@emittedfalse
\def\lpsb@captype@figure{figure}%
\def\lpsb@captype@table{table}%
\def\lpsb@captype@algorithm{algorithm}%
\def\lpsb@last@caption@text{}%
\newif\if@lpsb@manual@star@section \@lpsb@manual@star@sectionfalse
\newif\if@lpsb@biblist@pending \@lpsb@biblist@pendingfalse
\def\lpsb@tmp@biblist{BibList}%
\newcommand{\lpsb@if@main@captype}[2]{%
  \edef\lpsb@tmp@captype{\@captype}%
  \ifx\lpsb@tmp@captype\lpsb@captype@figure
    #1%
  \else\ifx\lpsb@tmp@captype\lpsb@captype@table
    #1%
  \else\ifx\lpsb@tmp@captype\lpsb@captype@algorithm
    #1%
  \else
    #2%
  \fi\fi\fi
}
\newcommand{\lpsb@maybe@emit@caption}[1]{%
  \if@lpsb@in@float
    \lpsb@if@main@captype{%
      \ifx\lpsb@tmp@captext\lpsb@last@caption@text
        % Skip duplicate caption text within the same float
      \else
        \xdef\lpsb@last@caption@text{\lpsb@tmp@captext}%
        #1%
      \fi
    }{#1}%
  \else
    #1%
  \fi
}

% --- PHASE 3: LAYOUT ENVIRONMENT SUPPRESSION ---
% These environments are purely for layout (centering, sizing) and should not
% trigger spurious P tags. When inside them, suppress the pending trigger logic.
\AtBeginEnvironment{center}{%
  \global\@lpsb@suppress@pending@triggertrue
}
\AtEndEnvironment{center}{%
  \global\@lpsb@suppress@pending@triggerfalse
}
\AtBeginEnvironment{minipage}{%
  \global\@lpsb@suppress@pending@triggertrue
}
\AtEndEnvironment{minipage}{%
  \global\@lpsb@suppress@pending@triggerfalse
}
\AtBeginEnvironment{flushleft}{%
  \global\@lpsb@suppress@pending@triggertrue
}
\AtEndEnvironment{flushleft}{%
  \global\@lpsb@suppress@pending@triggerfalse
}
\AtBeginEnvironment{flushright}{%
  \global\@lpsb@suppress@pending@triggertrue
}
\AtEndEnvironment{flushright}{%
  \global\@lpsb@suppress@pending@triggerfalse
}

% Helper: Safe Caption Wrapper (checks guard)
% [PHASE 4] Uses block tag lock to prevent spurious P tags inside caption
%
% IMPORTANT:
% - Captions write to .lof/.lot and can execute in moving/expansion-only contexts.
% - Do NOT run tagging side effects unless we are in typesetting mode.
% - Skip tagging inside \setbox (measurement mode) to prevent content duplication
% Helper: Safe Caption Wrapper (checks guard)
% [PHASE 4] Uses block tag lock to prevent spurious P tags inside caption
% IMPORTANT: Made \protected to prevent expansion during .lof writing / calc
% NOTE: Duplicate prevention is handled by @lpsb@caption@measuring flag in \caption@@make hook
\protected\def\lpsb@safe@caption@wrapper#1#2{%
  \ifx\protect\@typeset@protect
    \if@lpsb@in@caption
       #1{#2}% Direct call to orig if already inside caption
    \else
       % Apply tagging
       \global\@lpsb@lock@block@tagstrue
       \lpsbTagAtom{Caption}{%
         \global\@lpsb@in@captiontrue
         #1{#2}%
         \global\@lpsb@in@captionfalse
       }%
       \global\@lpsb@lock@block@tagsfalse
    \fi
  \else
    #1{#2}%
  \fi
}
% Helper: Safe Caption Wrapper with Option
% [PHASE 4] Uses block tag lock
% Helper: Safe Caption Wrapper with Option
% [PHASE 4] Uses block tag lock
% IMPORTANT: Made \protected
% Helper: Safe Caption Wrapper with Option
% [PHASE 4] Uses block tag lock
% IMPORTANT: Made \protected
\protected\def\lpsb@safe@caption@wrapper@opt#1#2#3{%
  \ifx\protect\@typeset@protect
    % CRITICAL: Skip tagging inside inner mode (setbox measurement)
    \ifinner
      #1[#2]{#3}% Inside box: just execute, no tagging
    \else
    \if@lpsb@in@caption
       #1[#2]{#3}%
    \else
       % Prevent duplicate captions within a single float (figure*/table* repeats)
       \if@lpsb@in@float
         \edef\lpsb@current@caption@key{\@captype:\csname the\@captype\endcsname}%
         \ifx\lpsb@current@caption@key\lpsb@last@caption@key
           % Same figure/table number: skip duplicate typesetting
         \else
           \xdef\lpsb@last@caption@key{\lpsb@current@caption@key}%
           \global\@lpsb@caption@emittedtrue
           \global\@lpsb@lock@block@tagstrue  % LOCK
           \ifcsname if@lpsb@wf@boxing\endcsname
             \if@lpsb@wf@boxing
               \lpsb@TagAtomImplEndParent{Caption}{%
                 \global\@lpsb@in@captiontrue
                 #1[#2]{#3}%
                 \global\@lpsb@in@captionfalse
               }%
             \else
               \lpsbTagAtom{Caption}{%
                 \global\@lpsb@in@captiontrue
                 #1[#2]{#3}%
                 \global\@lpsb@in@captionfalse
               }%
             \fi
           \else
             \lpsbTagAtom{Caption}{%
               \global\@lpsb@in@captiontrue
               #1[#2]{#3}%
               \global\@lpsb@in@captionfalse
             }%
           \fi
           \global\@lpsb@lock@block@tagsfalse % UNLOCK
         \fi
       \else
         \global\@lpsb@lock@block@tagstrue  % LOCK
         \ifcsname if@lpsb@wf@boxing\endcsname
           \if@lpsb@wf@boxing
             \lpsb@TagAtomImplEndParent{Caption}{%
               \global\@lpsb@in@captiontrue
               #1[#2]{#3}%
               \global\@lpsb@in@captionfalse
             }%
           \else
             \lpsbTagAtom{Caption}{%
               \global\@lpsb@in@captiontrue
               #1[#2]{#3}%
               \global\@lpsb@in@captionfalse
             }%
           \fi
         \else
           \lpsbTagAtom{Caption}{%
             \global\@lpsb@in@captiontrue
             #1[#2]{#3}%
             \global\@lpsb@in@captionfalse
           }%
         \fi
         \global\@lpsb@lock@block@tagsfalse % UNLOCK
       \fi
    \fi
  \else
    % Not typesetting: preserve original behavior, no tagging.
    #1[#2]{#3}%
  \fi
}

% --- Caption → Caption ---

% Hook \caption and \subcaption as Caption atoms.
%
% Rationale: patching caption internals (\caption@makecaption / \@makecaption) is
% fragile and can miss some code paths. Wrapping the user-level macros is much
% more reliable, and also gives us a parent_id (Figure/Table) via lpsbTagAtom.
\newcommand{\lpsb@patch@subfigure@caption}{%
  % subcaption's subfigure environment often rebinds \caption locally; that can
  % bypass our global \caption wrapper. Re-wrap the *current* \caption inside
  % the subfigure group so subcaptions get tagged as Caption atoms.
  % Uses the same recursion guard to prevent infinite loops.
  \@ifundefined{caption}{}{%
    \let\lpsb@orig@subfig@caption\caption
    \renewcommand{\caption}{\@ifnextchar[\lpsb@subfigcap@opt\lpsb@subfigcap@noopt}%
    % IMPORTANT: Use \long\def to handle captions with paragraph breaks
    \long\def\lpsb@subfigcap@opt[##1]##2{\lpsb@safe@caption@wrapper@opt\lpsb@orig@subfig@caption{##1}{##2}}%
    \long\def\lpsb@subfigcap@noopt##1{\lpsb@safe@caption@wrapper\lpsb@orig@subfig@caption{##1}}%
  }%
}
\AtBeginDocument{%
  % Always hook user-level caption macros.
  %
  % We previously skipped caption hooks when legacy subfigure.sty is loaded due
  % to expansion/moving-argument conflicts. This is no longer necessary because:
  % - \lpsbTagAtom is \protected and guarded by \@typeset@protect
  % - our safe caption wrappers also guard non-typesetting contexts
  %
  % Result: figure/table captions are tagged as Caption atoms even under legacy
  % subfigure.sty (fixes missing caption identification).
  %
  % FIX (Jan 2026): If 'caption' package is loaded, it redefines \caption heavily.
  % We hook \caption@makecaption instead, which handles the actual typesetting
  % after argument parsing is complete. This is stable and preserves semantics.
  %
  % FIX (Jan 2026): Prevention of 4x duplication.
  % The caption package runs \caption@slc (single-line check) which typesets the
  % caption into a box to measure width. If we tag there, we get duplicate MCIDs.
  % We must detect this measurement phase and suppress tagging.
  %
  % FIX (Jan 2026): Safe Mode check.
  % If Safe Mode is active (e.g. axessibility loaded), skip ALL caption hooking.
  \if@lpsb@safe@mode
     \typeout{LPSB-MCID Info: Safe Mode active - skipping all caption/subcaption hooks.}%
  \else
    \@ifpackageloaded{caption}{%
      \typeout{LPSB-MCID Info: caption package detected - hooking internal \string\caption@makecaption}%
    % Define flag to track measurement phase
    \newif\if@lpsb@caption@measuring
    \@lpsb@caption@measuringfalse

    % Hook \caption@slc to set the flag during singlelinecheck
    \@ifundefined{caption@slc}{%
      \typeout{LPSB-DEBUG: caption@slc NOT DEFINED at hook time}%
    }{%
      \typeout{LPSB-DEBUG: caption@slc EXISTS at hook time - hooking now}%
      \let\lpsb@orig@caption@slc\caption@slc
      \long\def\caption@slc#1#2#3#4{%
        \typeout{LPSB-DEBUG: caption@slc CALLED}%
        \global\@lpsb@caption@measuringtrue
        \lpsb@orig@caption@slc{#1}{#2}{#3}{#4}%
        \global\@lpsb@caption@measuringfalse
      }%
    }%
    % Check at begin document if hook is still in place
    \AtBeginDocument{%
      \@ifundefined{caption@slc}{%
        \typeout{LPSB-DEBUG: caption@slc NOT DEFINED at BeginDocument}%
      }{%
        \typeout{LPSB-DEBUG: caption@slc EXISTS at BeginDocument}%
      }%
    }%

    % Hook \caption@@make - the lower-level function that actually typesets
    % This ensures ALL captions are processed (including figure[t])
    \let\lpsb@orig@caption@@make\caption@@make
    \long\def\caption@@make#1#2{%
      \if@lpsb@caption@measuring
        % Measurement phase: skip tagging
        \lpsb@orig@caption@@make{#1}{#2}%
      \else
        \ifinner
          % Inside box (e.g., figure* output routine): skip tagging
          \lpsb@orig@caption@@make{#1}{#2}%
        \else
          % Final typesetting: apply tagging
          \lpsb@safe@caption@wrapper{\lpsb@orig@caption@@make{#1}}{#2}%
        \fi
      \fi
    }%
  }{%
    \@ifundefined{caption}{}{%
      \let\lpsb@orig@caption\caption
      \renewcommand{\caption}{\@ifstar\lpsb@cap@star\@lpsb@cap@checkopt}%
      \def\@lpsb@cap@checkopt{\@ifnextchar[\lpsb@cap@opt\lpsb@cap@noopt}%
      % Use recursion guard to prevent infinite loops
      % IMPORTANT: Use \long\def to handle captions containing \par
      \long\def\lpsb@cap@star#1{\lpsb@safe@caption@wrapper{\lpsb@orig@caption*}{#1}}%
      \long\def\lpsb@cap@opt[#1]#2{\lpsb@safe@caption@wrapper@opt\lpsb@orig@caption{#1}{#2}}%
      \long\def\lpsb@cap@noopt#1{\lpsb@safe@caption@wrapper\lpsb@orig@caption{#1}}%
    }%
    % subcaption package: \subcaption has same optional-arg pattern.
    \@ifundefined{subcaption}{}{%
      \let\lpsb@orig@subcaption\subcaption
      \renewcommand{\subcaption}{\@ifstar\lpsb@subcap@star\@lpsb@subcap@checkopt}%
      \def\@lpsb@subcap@checkopt{\@ifnextchar[\lpsb@subcap@opt\lpsb@subcap@noopt}%
      % Use same recursion guard (caption flag) since subcaption may call caption
      \long\def\lpsb@subcap@star#1{\lpsb@safe@caption@wrapper{\lpsb@orig@subcaption*}{#1}}%
      \long\def\lpsb@subcap@opt[#1]#2{\lpsb@safe@caption@wrapper@opt\lpsb@orig@subcaption{#1}{#2}}%
      \long\def\lpsb@subcap@noopt#1{\lpsb@safe@caption@wrapper\lpsb@orig@subcaption{#1}}%
    }%
  }%
  % subcaption package: subfigure environment can override \caption locally.
  % Hook the environment start and re-wrap \caption inside its group.
  \@ifundefined{subfigure}{}{%
    % Check if \subfigure is a command (subfig package) or environment (subcaption package)
    % by testing if \endsubfigure exists (environments have \end... defined)
    \@ifundefined{endsubfigure}{%
      % \subfigure is a COMMAND (subfig package style): \subfigure[caption]{content}
      % Hook it directly to tag the caption text
      \let\lpsb@orig@subfigure@cmd\subfigure
      \renewcommand{\subfigure}{\@ifnextchar[\lpsb@subfigure@cmd@opt\lpsb@subfigure@cmd@noopt}%
      \def\lpsb@subfigure@cmd@opt[#1]#2{%
        \ifx\protect\@typeset@protect
          \if@lpsb@active
            \if@lpsb@in@float
              % Tag the entire subfigure (including caption) - caption text is in #1
              \lpsb@orig@subfigure@cmd[\lpsbTagAtom{Caption}{#1}]{#2}%
            \else
              \lpsb@orig@subfigure@cmd[#1]{#2}%
            \fi
          \else
            \lpsb@orig@subfigure@cmd[#1]{#2}%
          \fi
        \else
          \lpsb@orig@subfigure@cmd[#1]{#2}%
        \fi
      }%
      \def\lpsb@subfigure@cmd@noopt#1{%
        \lpsb@orig@subfigure@cmd{#1}%
      }%
    }{%
      % \subfigure is an ENVIRONMENT (subcaption package style)
      \AtBeginEnvironment{subfigure}{\lpsb@patch@subfigure@caption}%
    }%
  }%
  % subcaption: setcaptionsubtype triggers \caption@subtypehook; use that as a
  % reliable place to re-wrap \caption for sub-captions (works even if subcaption
  % swaps \caption behind our back).
  \@ifundefined{caption@subtypehook}{}{%
    \g@addto@macro\caption@subtypehook{\lpsb@patch@subfigure@caption}%
  }%
  %
  % LEGACY subfigure.sty support: Hook \@thesubfigure and \@thesubtable
  % These commands generate the (a), (b), (c) labels that appear below subfigures.
  % By wrapping them in Caption atoms, we ensure the labels are correctly tagged.
  %
  % Hook \@thesubfigure - generates "(a)", "(b)", etc. for subfigure labels
  \@ifundefined{@thesubfigure}{}{%
    \let\lpsb@orig@@thesubfigure\@thesubfigure
    \def\@thesubfigure{%
      \ifx\protect\@typeset@protect
        \if@lpsb@active
          \if@lpsb@in@float
            % Inside float: wrap label in Caption tag
            \lpsbTagAtom{Caption}{\lpsb@orig@@thesubfigure}%
          \else
            \lpsb@orig@@thesubfigure
          \fi
        \else
          \lpsb@orig@@thesubfigure
        \fi
      \else
        \lpsb@orig@@thesubfigure
      \fi
    }%
  }%
  % Hook \@thesubtable - same for subtables
  \@ifundefined{@thesubtable}{}{%
    \let\lpsb@orig@@thesubtable\@thesubtable
    \def\@thesubtable{%
      \ifx\protect\@typeset@protect
        \if@lpsb@active
          \if@lpsb@in@float
            \lpsbTagAtom{Caption}{\lpsb@orig@@thesubtable}%
          \else
            \lpsb@orig@@thesubtable
          \fi
        \else
          \lpsb@orig@@thesubtable
        \fi
      \else
        \lpsb@orig@@thesubtable
      \fi
    }%
  }%
  %
  % Hook \sf@subcaption which outputs the full caption text (label + text)
  \@ifundefined{sf@subcaption}{}{%
    \let\lpsb@orig@sf@subcaption\sf@subcaption
    \long\def\sf@subcaption#1#2{%
      \ifx\protect\@typeset@protect
        \if@lpsb@active
          \lpsbTagAtom{Caption}{%
            \lpsb@orig@sf@subcaption{#1}{#2}%
          }%
        \else
          \lpsb@orig@sf@subcaption{#1}{#2}%
        \fi
      \else
        \lpsb@orig@sf@subcaption{#1}{#2}%
      \fi
    }%
  }%

  % Fallback: Hook internal \@caption as well.
  %
  % Rationale:
  % - Some float packages (notably algorithm/float-based environments) bypass our
  %   user-level \caption wrapper by calling \@caption directly or rebinding
  %   \caption locally.
  % - \caption normally expands to \@caption, so we must avoid double-tagging.
  %   The recursion guard (@lpsb@in@caption) handles this: when \caption wrapper
  %   is active, \@caption sees the flag and passes through.
  %
  %
  % FIX: Always hook @caption as fallback (recursion guard prevents double tagging)
  \@ifundefined{@caption}{}{%
    \let\lpsb@orig@@caption\@caption
    \long\def\@caption#1[#2]#3{%
      \ifx\protect\@typeset@protect
        \if@lpsb@active
          \edef\lpsb@tmp@captext{\detokenize{#3}}%
          \if@lpsb@in@caption
            \lpsb@if@main@captype{%
              \global\@lpsb@caption@emittedtrue
            }{}%
            \lpsb@maybe@emit@caption{\lpsb@orig@@caption{#1}[#2]{#3}}%
          \else
            \if@lpsb@caption@emitted
              \lpsb@if@main@captype{%
                % Skip duplicate main caption to avoid double typesetting
              }{%
                \global\@lpsb@lock@block@tagstrue
                \lpsbTagAtom{Caption}{%
                  \global\@lpsb@in@captiontrue
                  \lpsb@maybe@emit@caption{\lpsb@orig@@caption{#1}[#2]{#3}}%
                  \global\@lpsb@in@captionfalse
                }%
                \global\@lpsb@lock@block@tagsfalse
              }%
            \else
              \lpsb@if@main@captype{%
                \global\@lpsb@caption@emittedtrue
              }{}%
              \global\@lpsb@lock@block@tagstrue
              \lpsbTagAtom{Caption}{%
                \global\@lpsb@in@captiontrue
                \lpsb@maybe@emit@caption{\lpsb@orig@@caption{#1}[#2]{#3}}%
                \global\@lpsb@in@captionfalse
              }%
              \global\@lpsb@lock@block@tagsfalse
            \fi
          \fi
        \else
          \lpsb@orig@@caption{#1}[#2]{#3}%
        \fi
      \else
        \lpsb@orig@@caption{#1}[#2]{#3}%
      \fi
    }%
  }%


  % float.sty / newfloat support: tag \@floatcapt at UNBOX time, not at CAPTURE time.
  %
  % float.sty stores the formatted caption into the \@floatcapt box and later
  % unboxes it inside \float@makebox. Tagging at capture time can subtly change
  % layout (e.g. algorithm captions becoming centered). To keep TeX output
  % identical, we tag the unboxed caption content instead.
  \@ifundefined{float@makebox}{}{%
    \let\lpsb@orig@float@makebox\float@makebox
    % Re-implement float@makebox with only one change: wrap \unvbox\@floatcapt
    % in a Caption atom tag.
    \renewcommand\float@makebox[1]{%
      \vbox{\hsize=#1 \@parboxrestore
        \@fs@pre\@fs@iftopcapt
          \ifvoid\@floatcapt\else
            \global\@lpsb@lock@block@tagstrue
            \lpsbTagAtom{Caption}{%
              \global\@lpsb@in@captiontrue
              \unvbox\@floatcapt
              \global\@lpsb@in@captionfalse
            }%
            \global\@lpsb@lock@block@tagsfalse
            \par\@fs@mid
          \fi
          \unvbox\@currbox
        \else\unvbox\@currbox
          \ifvoid\@floatcapt\else
            \par\@fs@mid
            \global\@lpsb@lock@block@tagstrue
            \lpsbTagAtom{Caption}{%
              \global\@lpsb@in@captiontrue
              \unvbox\@floatcapt
              \global\@lpsb@in@captionfalse
            }%
            \global\@lpsb@lock@block@tagsfalse
          \fi
        \fi\par\@fs@post\vskip\z@}%
    }%
  }%
  \fi
}

% --- Footnote → Note ---
% Hook \footnote to tag as Note (PDF/UA)
\AtBeginDocument{%
  \@ifundefined{footnote}{}{%
    \let\lpsb@orig@footnote\footnote
    % \footnote produces both a mark (superscript) and text (at page bottom)
    % We tag the mark as Lbl (label), the text will be tagged via @makefntext as Note
    \renewcommand{\footnote}[2][]{%
      \def\lpsb@fn@opt{#1}%
      \ifx\lpsb@fn@opt\@empty
        % The mark is tagged as Lbl, the text is tagged separately via @makefntext
        \lpsb@orig@footnote{#2}%
      \else
        \lpsb@orig@footnote[#1]{#2}%
      \fi
    }%
  }%
  % Many papers use split footnotes: \footnotemark + \footnotetext.
  % Footnotemark is the superscript reference - tag as Lbl (label)
  \@ifundefined{footnotemark}{}{%
    \let\lpsb@orig@footnotemark\footnotemark
    \renewcommand{\footnotemark}{%
      \@ifnextchar[\lpsb@fnmark@opt\lpsb@fnmark@noopt
    }%
    \def\lpsb@fnmark@opt[#1]{\lpsbTagAtom{Lbl}{\lpsb@orig@footnotemark[#1]}}%
    \def\lpsb@fnmark@noopt{\lpsbTagAtom{Lbl}{\lpsb@orig@footnotemark}}%
  }%
  \@ifundefined{footnotetext}{}{%
    % Hook \footnotetext for tagging. Use \long\def to handle paragraph breaks
    % in the argument (common in complex macro content like ICML's \printAffiliationsAndNotice).
    \let\lpsb@orig@footnotetext\footnotetext
    %
    % The challenge: \footnotetext[num]{text} has optional arg.
    % We use \@ifnextchar to detect [...], then capture args with \long\def.
    \renewcommand{\footnotetext}{%
      \@ifnextchar[\lpsb@fntext@opt\lpsb@fntext@noopt
    }%
    % Optional argument version: \footnotetext[num]{text}
    \long\def\lpsb@fntext@opt[#1]#2{%
      \lpsbTagAtom{Note}{\lpsb@orig@footnotetext[#1]{#2}}%
    }%
    % No optional argument: \footnotetext{text}
    % IMPORTANT: Use \long to handle \par and complex macro content
    \long\def\lpsb@fntext@noopt#1{%
      \lpsbTagAtom{Note}{\lpsb@orig@footnotetext{#1}}%
    }%
  }%
  % Standard \footnote uses internal \@footnotemark/\@footnotetext; hook those too so the
  % footnote text itself gets tagged (not just the mark in the paragraph).
  %
  % CRITICAL: \@footnotetext uses \insert\footins{...} which is async (like floats).
  % The content is rendered at page bottom, not when the command is called.
  % To properly tag, we hook \@makefntext which formats the actual footnote content.
  %
  % Footnote structure in PDF/UA:
  % - Footnote mark (in paragraph): tagged as Lbl via \@footnotemark hook
  % - Footnote text (at page bottom): tagged as Note via \@makefntext hook
  %
  \newif\if@lpsb@in@footnote \@lpsb@in@footnotefalse
  %
  % Hook \@footnotemark to tag the superscript mark as Lbl
  \@ifundefined{@footnotemark}{}{%
    \let\lpsb@orig@@footnotemark\@footnotemark
    \def\@footnotemark{%
      \lpsbTagAtom{Lbl}{\lpsb@orig@@footnotemark}%
    }%
  }%
  %
  \@ifundefined{@makefntext}{}{%
    \let\lpsb@orig@@makefntext\@makefntext
    \long\def\@makefntext#1{%
      \if@lpsb@active
        % Open Note tag for footnote text, close current P if any
        \lpsbTagEnd
        \lpsbTagBegin{Note}%
        \global\@lpsb@in@footnotetrue
        \lpsb@orig@@makefntext{#1}%
        \lpsbTagEnd
        % Restore P for any content after footnote
        \lpsbTagBegin{P}%
        \global\@lpsb@in@footnotefalse
      \else
        \lpsb@orig@@makefntext{#1}%
      \fi
    }%
  }%
  % Also hook minipage footnotes
  \@ifundefined{@mpfootnotetext}{}{%
    \let\lpsb@orig@@mpfootnotetext\@mpfootnotetext
    \long\def\@mpfootnotetext#1{%
      % minipage footnotes use similar mechanism
      \lpsb@orig@@mpfootnotetext{#1}%
    }%
  }%
}

% --- URL/Hyperlinks → Link ---
% Tag \url and \href as Link (PDF/UA) for accessibility
% Uses \UrlLeft/\UrlRight hooks from url.sty to safely inject tags
% around URL content WITHOUT interfering with verbatim scanning.
% This fixes "File ended while scanning use of \url" errors.
\AtBeginDocument{%
  % Check if url package is loaded (hyperref also loads it internally)
  \@ifundefined{url}{}{%
    
    % 1. Define the left hook (start Link tag)
    \def\lpsb@url@left{%
      \ifx\protect\@typeset@protect
        \if@lpsb@active
          \if@lpsb@suppress@inline\else
             \lpsb@pdfliteralcmd{ EMC }% Pause parent tag
             \stepcounter{lpsb@logicalElemID}%
             \stepcounter{lpsb@globalMCID}%
             \lpsb@pdfliteralcmd{ /Link << /MCID \thelpsb@globalMCID >> BDC }%
             \immediate\write\@auxout{%
               \string\lpsb@tag@atom{\thelpsb@logicalElemID}{Link}{\thelpsb@globalMCID}{\thelpsb@currentPage}{\lpsb@current@logical@id}%
             }%
          \fi
        \fi
      \fi
    }%

    % 2. Define the right hook (end Link tag, reopen parent)
    \def\lpsb@url@right{%
      \ifx\protect\@typeset@protect
        \if@lpsb@active
          \if@lpsb@suppress@inline\else
             \lpsb@pdfliteralcmd{ EMC }% Close Link
             % Reopen parent (unless it's a container)
             \lpsb@reopen@unless@container{\lpsb@current@logical@id}{\lpsb@current@tag@type}%
          \fi
        \fi
      \fi
    }%

    % 3. Safely hook into url.sty's \UrlLeft/\UrlRight
    \@ifundefined{UrlLeft}{%
       % Not defined, create it
       \gdef\UrlLeft{\lpsb@url@left}%
    }{%
       % Already defined, append to it
       \g@addto@macro\UrlLeft{\lpsb@url@left}%
    }%

    \@ifundefined{UrlRight}{%
       \gdef\UrlRight{\lpsb@url@right}%
    }{%
       % Append our closing operation at the end
       \g@addto@macro\UrlRight{\lpsb@url@right}%
    }%
  }%
  
  % Hook \href from hyperref.sty
  % (href takes normal arguments, not verbatim, so direct wrapping is safe)
  % Use recursion guard to prevent infinite loops with RevTeX bibliography etc.
  \@ifundefined{href}{}{%
    \let\lpsb@orig@href\href
    \renewcommand{\href}[2]{%
      \if@lpsb@suppress@inline
        \lpsb@orig@href{#1}{#2}%
      \else
        \if@lpsb@in@href
          \lpsb@orig@href{#1}{#2}%  % Already inside href, skip tagging
        \else
          \lpsbTagAtom{Link}{%
            \global\@lpsb@in@hreftrue
            \lpsb@orig@href{#1}{#2}%
            \global\@lpsb@in@hreffalse
          }%
        \fi
      \fi
    }%
  }%
  
  % Hook \nolinkurl from hyperref.sty (uses url.sty mechanism, so UrlLeft/UrlRight handles it)
  % No need for explicit hook here - \UrlLeft/\UrlRight already cover it
}


% --- Emphasis → Em/Strong ---
% Use atom tags for inline formatting
% Skip tagging when inside algorithm environment (@lpsb@suppress@inline)
\let\lpsb@orig@emph\emph
\renewcommand{\emph}[1]{%
  \if@lpsb@suppress@inline
    \lpsb@orig@emph{#1}%
  \else
    \lpsbTagAtom{Em}{\lpsb@orig@emph{#1}}%
  \fi
}

\let\lpsb@orig@textbf\textbf
\renewcommand{\textbf}[1]{%
  \if@lpsb@suppress@inline
    \lpsb@orig@textbf{#1}%
  \else
    \lpsbTagAtom{Strong}{\lpsb@orig@textbf{#1}}%
  \fi
}

\let\lpsb@orig@textit\textit
\renewcommand{\textit}[1]{%
  \if@lpsb@suppress@inline
    \lpsb@orig@textit{#1}%
  \else
    \lpsbTagAtom{Em}{\lpsb@orig@textit{#1}}%
  \fi
}

% --- Declarative Font Commands (DISABLED) ---
% Old-style font switches like \bf/\it/\em are heavily used by class files in
% fragile places (notably \maketitle). Hooking them reliably without breaking
% real-world documents is hard; it also isn't required for inline-math tagging.
%
% Keep tagging on the semantic commands (\textbf/\textit/\emph) only.

% --- Math → Formula/InlineMath ---
% Inline math tagging:
% Do NOT play games with catcodes (making '$' active breaks real papers).
% Instead, use TeX's math entry hooks and close the tag using \aftergroup,
% which runs at the end of the math group.
\newif\if@lpsb@in@inline@math \@lpsb@in@inline@mathfalse
\gdef\lpsb@math@parent@id{}
\gdef\lpsb@math@parent@type{}

\newcommand{\lpsb@inline@math@begin}{%
  % UNCONDITIONAL TRACE: Write to log for every \( invocation
  \typeout{[LPSB-TRACE] InlineMath BEGIN called on page \thelpsb@currentPage}%
  \typeout{[LPSB-TRACE] InlineMath: checking protect...}%
  % CRITICAL: Skip in non-typesetting contexts (moving arguments like \section{})
  % This prevents "Missing \endcsname" errors when \(...\) appears in titles
  \ifx\protect\@typeset@protect
    \typeout{[LPSB-TRACE] InlineMath: protect OK}%
    \if@lpsb@active
      \typeout{[LPSB-TRACE] InlineMath: active OK}%
      \if@lpsb@in@shipout
        \typeout{[LPSB-TRACE] InlineMath: SKIPPED in shipout}%
      \else
        \if@lpsb@in@tag
          \xdef\lpsb@math@parent@id{\lpsb@current@logical@id}%
          \xdef\lpsb@math@parent@type{\lpsb@current@tag@type}%
          % Close parent MCID temporarily
          \lpsb@pdfliteralcmd{ EMC }%
        \else
          \gdef\lpsb@math@parent@id{}%
          \gdef\lpsb@math@parent@type{}%
        \fi
        % Start InlineMath atom
        \stepcounter{lpsb@logicalElemID}%
        \stepcounter{lpsb@globalMCID}%
        \lpsb@pdfliteralcmd{ /InlineMath << /MCID \thelpsb@globalMCID >> BDC }%
        \immediate\write\@auxout{%
          \string\lpsb@tag@atom{\thelpsb@logicalElemID}{InlineMath}{\thelpsb@globalMCID}{\thelpsb@currentPage}{\lpsb@math@parent@id}%
        }%
        \global\@lpsb@in@inline@mathtrue
        \typeout{[LPSB-TRACE] InlineMath: CREATED MCID=\thelpsb@globalMCID}%
      \fi
    \else
      \typeout{[LPSB-TRACE] InlineMath: SKIPPED - not active}%
    \fi
  \else
    \typeout{[LPSB-TRACE] InlineMath: SKIPPED - protect mismatch}%
  \fi
}

\newcommand{\lpsb@inline@math@end}{%
  % CRITICAL: Skip in non-typesetting contexts (moving arguments like \section{})
  \ifx\protect\@typeset@protect
    \if@lpsb@active
      \if@lpsb@in@inline@math
        % Close InlineMath MCID
        \lpsb@pdfliteralcmd{ EMC }%
        \global\@lpsb@in@inline@mathfalse
        % Reopen parent MCID (unless it's a container)
        \ifx\lpsb@math@parent@id\@empty\else
          \lpsb@reopen@unless@container{\lpsb@math@parent@id}{\lpsb@math@parent@type}%
        \fi
      \fi
    \fi
  \fi
}

% Reliable inline-math hook using \everymath (TeX primitive, TL 2016 compatible).
% \everymath is executed at the START of every math mode.
% We use an explicit @lpsb@in@display@math flag to distinguish inline from display math.
% Display math environments set this flag, so \everymath knows to skip.
%
% IMPORTANT: We append to \everymath rather than replacing it, so other packages
% (like amsmath) can also use \everymath without conflict.

% Flag to track if we're in display math (set by equation/align hooks)
\newif\if@lpsb@in@display@math \@lpsb@in@display@mathfalse

% Flag to track if we already started an InlineMath tag in this math group
\newif\if@lpsb@everymath@started \@lpsb@everymath@startedfalse

\def\lpsb@everymath@hook{%
  % Only process if LPSB is active and we're in typeset mode
  \if@lpsb@active
    \ifx\protect\@typeset@protect
      % Skip during shipout (header/footer processing)
      \if@lpsb@in@shipout\else
        % Skip if we're inside maketitle (author area with $^{...}$ superscripts)
        \if@lpsb@in@maketitle\else
          % Skip if we're inside a tabular environment
          \if@lpsb@in@tabular\else
            % Skip if we're in display math (equation, align, etc.)
            \if@lpsb@in@display@math\else
              % CRITICAL: Skip inside Caption to prevent content duplication
              % Caption with inline math ($\mathcal{L}_{...}$) should flow continuously
              \if@lpsb@in@caption\else
              % Avoid double-starting if already in InlineMath
              \if@lpsb@in@inline@math\else
                \if@lpsb@everymath@started\else
                  \global\@lpsb@everymath@startedtrue
                  % Close parent tag temporarily
                  \if@lpsb@in@tag
                    \xdef\lpsb@math@parent@id{\lpsb@current@logical@id}%
                    \xdef\lpsb@math@parent@type{\lpsb@current@tag@type}%
                    \lpsb@pdfliteralcmd{ EMC }%
                  \else
                    \gdef\lpsb@math@parent@id{}%
                    \gdef\lpsb@math@parent@type{}%
                  \fi
                % Start InlineMath atom
                \stepcounter{lpsb@logicalElemID}%
                \stepcounter{lpsb@globalMCID}%
                \lpsb@pdfliteralcmd{ /InlineMath << /MCID \thelpsb@globalMCID >> BDC }%
                \immediate\write\@auxout{%
                  \string\lpsb@tag@atom{\thelpsb@logicalElemID}{InlineMath}{\thelpsb@globalMCID}{\thelpsb@currentPage}{\lpsb@math@parent@id}%
                }%
                \global\@lpsb@in@inline@mathtrue
                % Use \aftergroup to close InlineMath when math mode ends
              \aftergroup\lpsb@everymath@end@hook
            \fi
          \fi
        \fi
      \fi
  \fi
  \fi
  \fi
  \fi
  \fi
}

\def\lpsb@everymath@end@hook{%
  \global\@lpsb@everymath@startedfalse
  \if@lpsb@in@inline@math
    % Close InlineMath MCID
    \lpsb@pdfliteralcmd{ EMC }%
    \global\@lpsb@in@inline@mathfalse
    % Reopen parent MCID with a continuation MCID (unless it's a container or caption)
    % CRITICAL: Skip reopen inside Caption to prevent content duplication
    % Caption content should flow continuously without continuation MCIDs
    \if@lpsb@in@caption
      % Inside Caption: do NOT reopen - just continue the Caption's MCID stream
    \else
      \ifx\lpsb@math@parent@id\@empty\else
        % Use helper to avoid reopening Table/Figure containers
        \lpsb@reopen@unless@container{\lpsb@math@parent@id}{\lpsb@math@parent@type}%
      \fi
    \fi
  \fi
}

% Install the \everymath hook at begin document (after all packages loaded)
\AtBeginDocument{%
  \everymath\expandafter{\the\everymath\lpsb@everymath@hook}%
}

% Hook equation/align environments to set display math flag
\AtBeginEnvironment{equation}{%
  \global\@lpsb@in@display@mathtrue
  \lpsbTagEnd
  \lpsbTagBegin{Formula}%
}
% IMPORTANT:
% etoolbox's \AtEndEnvironment runs at the START of \end{equation}, which is
% too early for amsmath: equation numbers/tags may be typeset during \endequation.
% Use \AfterEndEnvironment when available; otherwise patch \endequation.
\@ifundefined{AfterEndEnvironment}{%
  \AtBeginDocument{%
    \@ifundefined{endequation}{}{%
      \apptocmd{\endequation}{%
        \lpsbTagEnd
        \global\@lpsb@in@display@mathfalse
        % Reinstall everymath hook (amsmath clears it during equation processing)
        \everymath\expandafter{\the\everymath\lpsb@everymath@hook}%
        % Start P immediately for text following \end{equation} without blank line
        % Using aftergroup ensures it runs after the environment group closes
        \aftergroup\lpsb@start@P@after@float
      }{}{}%
    }%
  }%
}{%
  \AfterEndEnvironment{equation}{%
    \lpsbTagEnd
    \global\@lpsb@in@display@mathfalse
    % Reinstall everymath hook (amsmath clears it during equation processing)
    \everymath\expandafter{\the\everymath\lpsb@everymath@hook}%
    % Start P immediately - don't rely on everypar which may not trigger
    \lpsb@start@P@after@float
  }%
}

% AMS math environments: align, gather, multline, flalign, alignat
% These should all be tagged as Formula
% --- UNIFIED AMS MATH HOOKS (using etoolbox loop) ---
\newcommand{\lpsb@register@ams@math@hook}[1]{%
  \AtBeginEnvironment{#1}{%
    \global\@lpsb@in@display@mathtrue
    \lpsbTagEnd
    \lpsbTagBegin{Formula}%
  }%
  \AfterEndEnvironment{#1}{%
    \lpsbTagEnd
    \global\@lpsb@in@display@mathfalse
    % Reinstall everymath hook (amsmath clears it during equation processing)
    \everymath\expandafter{\the\everymath\lpsb@everymath@hook}%
    % Start P immediately - don't rely on everypar which may not trigger
    \lpsb@start@P@after@float
  }%
}
% Apply to all AMS math environments
\forcsvlist{\lpsb@register@ams@math@hook}{align,align*,gather,gather*,multline,multline*,flalign,flalign*,equation*}

% Plain display math: \[ ... \]
% Some templates use display math in Algorithm without equation/align environments.
\AtBeginDocument{%
  \@ifundefined{[}{}{%
    \let\lpsb@orig@display@lbrack\[
    \def\[{%
      \global\@lpsb@in@display@mathtrue
      \lpsbTagEnd
      \lpsbTagBegin{Formula}%
      \lpsb@orig@display@lbrack
    }%
  }%
  \@ifundefined{]}{}{%
    \let\lpsb@orig@display@rbrack\]
    \def\]{%
      \lpsb@orig@display@rbrack
      \lpsbTagEnd
      \global\@lpsb@in@display@mathfalse
      % Reinstall everymath hook (amsmath can clear it)
      \everymath\expandafter{\the\everymath\lpsb@everymath@hook}%
      \lpsb@start@P@after@float
    }%
  }%
}

% --- Wrapfigure/Wraptable Tagging ---
% wrapfig does NOT behave like a normal float:
% - It builds the wrapped object into \WF@box, then injects that box later via \everypar.
% - In collision cases it can also "force to float".
%
% Environment-level tagging (BeforeBeginEnvironment/AfterEndEnvironment) is wrong here:
% it tends to tag the wrapped *text* as Table/Figure and the wrapped object as P,
% swapping semantics (e.g. Table 8 on page 13 in 2401.00006).
%
% Correct approach: tag INSIDE the wrapped object box (\WF@box), not around the env.
\AtBeginDocument{%
  \@ifpackageloaded{wrapfig}{%
    \typeout{LPSB-MCID Info: wrapfig detected - tagging wrap box via WF@rapt/endwrapfloat}%
    % Tracks whether we isolated tagging state for a wrap box.
    \newif\if@lpsb@wf@boxing \@lpsb@wf@boxingfalse
    % Tracks whether we need to resume a P after wrap box injection.
    \newif\if@lpsb@wf@resumeP \@lpsb@wf@resumePfalse
    % True only while wrapfig injects \WF@box via \everypar.
    \newif\if@lpsb@wrapfig@inject \@lpsb@wrapfig@injectfalse
    % Patch \WF@rapt: called after placement args are parsed, right before
    % wrap content starts. At this point wrapfig has opened \WF@box (vtop/hbox)
    % and is about to read the environment body into it.
    \@ifundefined{WF@rapt}{}{%
      \let\lpsb@orig@WF@rapt\WF@rapt
      \def\WF@rapt[#1]#2{%
        \lpsb@orig@WF@rapt[#1]{#2}%
        \if@lpsb@active
          % CRITICAL:
          % wrapfig builds content into \WF@box (a \vtop/\hbox) using \setbox.
          % Our tagging state (\lpsb@current@logical@id/type, stack, in@tag) is GLOBAL.
          % If we mutate it inside \WF@box without restoring, we corrupt the outer
          % document state and can swap Table/P semantics in the surrounding text.
          %
          % So: snapshot outer state, isolate box state, tag inside the box, and
          % restore the outer state in \endwrapfloat.
          \xdef\lpsb@wf@saved@tag@stack{\lpsb@tag@stack}%
          \xdef\lpsb@wf@saved@curid{\lpsb@current@logical@id}%
          \xdef\lpsb@wf@saved@curtype{\lpsb@current@tag@type}%
          \if@lpsb@in@tag
            \gdef\lpsb@wf@saved@in@tag{1}%
          \else
            \gdef\lpsb@wf@saved@in@tag{0}%
          \fi
          \global\@lpsb@wf@boxingtrue
          % Isolate state for box tagging: start from a clean stack.
          \gdef\lpsb@tag@stack{}%
          \global\@lpsb@in@tagfalse
          % Determine Figure vs Table from \@captype (set by wrapfig)
          \edef\lpsb@wf@captype{\@captype}%
          \def\lpsb@wf@table{table}%
          \ifx\lpsb@wf@captype\lpsb@wf@table
            \lpsbTagBegin{Table}%
          \else
            \lpsbTagBegin{Figure}%
          \fi
          \global\@lpsb@suppress@inlinetrue
        \fi
      }%
    }%
    % Patch \endwrapfloat: close Table/Figure tag inside \WF@box before
    % wrapfig finalizes and stores the box.
    \@ifundefined{endwrapfloat}{}{%
      \let\lpsb@orig@endwrapfloat\endwrapfloat
      \def\endwrapfloat{%
        \if@lpsb@active
          \global\@lpsb@suppress@inlinefalse
          \lpsbTagEnd
          % Restore outer tagging state if we isolated it in \WF@rapt.
          \if@lpsb@wf@boxing
            \xdef\lpsb@tag@stack{\lpsb@wf@saved@tag@stack}%
            \xdef\lpsb@current@logical@id{\lpsb@wf@saved@curid}%
            \xdef\lpsb@current@tag@type{\lpsb@wf@saved@curtype}%
            \ifnum\lpsb@wf@saved@in@tag=1\relax
              \global\@lpsb@in@tagtrue
            \else
              \global\@lpsb@in@tagfalse
            \fi
            \global\@lpsb@wf@boxingfalse
            % Start P tag for text following wraptable/wrapfigure
            \global\@lpsb@P@pending@after@floattrue
            \global\@lpsb@first@paratrue
          \fi
        \fi
        \lpsb@orig@endwrapfloat
        % Call lpsb@start@P@after@float AFTER original endwrapfloat completes
        \if@lpsb@active
          \lpsb@start@P@after@float
        \fi
      }%
    }%
    % Patch \WF@floathand: wrapfig injects \WF@box later via \everypar.
    % If we leave a /P BDC open, the injected box (and its tagging) can end up
    % splitting the paragraph stream, causing Table/P semantics to swap.
    % Close any open tag before injection, then resume P for the paragraph text.
    \@ifundefined{WF@floathand}{}{%
      \let\lpsb@orig@WF@floathand\WF@floathand
      \def\WF@floathand{%
        \if@lpsb@active
          \if@lpsb@in@tag
            \lpsbTagEnd
          \fi
        \fi
        \global\@lpsb@wrapfig@injecttrue
        \lpsb@orig@WF@floathand
        \global\@lpsb@wrapfig@injectfalse
        \if@lpsb@active
          % Ensure paragraph text after wrapfig injection is tagged.
          \if@lpsb@in@tag\else
            \lpsbTagBegin{P}%
            \global\@lpsb@first@paratrue
          \fi
        \fi
      }%
    }%
  }{}%
}

% --- Tabular/TabularX Outside Float ---
% When tabular environments appear outside of table floats, they should
% still be tagged as Table and have inline suppression.
% Note: We detect this by checking if we're NOT inside a float.
\AtBeginDocument{%
  \@ifpackageloaded{tabularx}{%
    \BeforeBeginEnvironment{tabularx}{%
      \if@lpsb@active
        \if@lpsb@in@float\else
          \lpsbTagEnd
          \lpsbTagBegin{Table}%
          \global\@lpsb@suppress@inlinetrue
        \fi
      \fi
    }%
    \AfterEndEnvironment{tabularx}{%
      \if@lpsb@active
        \if@lpsb@in@float\else
          \global\@lpsb@suppress@inlinefalse
          \lpsbTagEnd
          \lpsbTagBegin{P}%
        \fi
      \fi
    }%
  }{}%
}

% Standard tabular: suppress inline when outside float, set tabular flag
% CRITICAL: Skip tabular flag during maketitle so author content gets tagged
\BeforeBeginEnvironment{tabular}{%
  \if@lpsb@active
    \if@lpsb@in@maketitle\else
      \global\@lpsb@in@tabulartrue
    \fi
    \if@lpsb@in@float\else
      \if@lpsb@in@maketitle\else
        \global\@lpsb@suppress@inlinetrue
      \fi
    \fi
  \fi
}
\AfterEndEnvironment{tabular}{%
  \if@lpsb@active
    \if@lpsb@in@maketitle\else
      \global\@lpsb@in@tabularfalse
    \fi
    \if@lpsb@in@float\else
      \if@lpsb@in@maketitle\else
        \global\@lpsb@suppress@inlinefalse
      \fi
    \fi
  \fi
}

% --- Citations → Reference ---
% Keep citations as atom tags so they don't split /P into separate logical elements.
% NOTE: natbib supports up to two optional args: \citep[pre][post]{key}.
%
% SOLUTION: Instead of hooking user-level commands (\cite, \citep, \citet),
% we hook natbib's internal output primitive \NAT@citetp which is called
% AFTER all argument parsing is complete. This avoids:
% 1. Misplaced alignment tab errors from & in bibcodes
% 2. Breaking natbib's complex argument scanning logic
%
% For non-natbib documents, we hook the standard \@citex command.
%
\AtBeginDocument{%
  \@ifpackageloaded{natbib}{%
    \typeout{LPSB-MCID Info: natbib detected - hooking internal citation output}%
    % Hook \NAT@citetp - this is called to output the final citation text
    % It receives the formatted citation as its argument
    \ifdefined\NAT@citetp
      \let\lpsb@orig@NAT@citetp\NAT@citetp
      \long\def\NAT@citetp#1{%
        \lpsbTagAtom{Reference}{\lpsb@orig@NAT@citetp{#1}}%
      }%
    \fi
    % Also hook \NAT@citexnum for numeric citations
    \ifdefined\NAT@citexnum
      \let\lpsb@orig@NAT@citexnum\NAT@citexnum
      % NAT@citexnum doesn't take an argument in the same way,
      % it builds output internally. We hook at hyper@natlinkstart instead.
    \fi
  }{%
    % Non-natbib: hook standard \@citex if available
    \ifdefined\@citex
      \let\lpsb@orig@citex\@citex
      \long\def\@citex[#1]#2{%
        \lpsbTagAtom{Reference}{\lpsb@orig@citex[#1]{#2}}%
      }%
      \typeout{LPSB-MCID Info: standard LaTeX citation hook installed}%
    \fi
  }%
}

% --- Hyperlinks → Link ---
