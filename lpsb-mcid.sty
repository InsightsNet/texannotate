%% lpsb-mcid.sty - MCID-based Tagged PDF for LPSB
%% Complete implementation with all semantic element types
%% TL2016 compatible (uses \pdfliteral and atbegshi)
%%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{lpsb-mcid}[2026/01/11 LPSB MCID-based Tagging]

% Prevent multiple loading
\@ifundefined{lpsb@mcid@loaded}{%
  \global\let\lpsb@mcid@loaded\relax
}{%
  \PackageWarning{lpsb-mcid}{Package already loaded, skipping}%
  \endinput
}

\RequirePackage{atbegshi}
\RequirePackage{etoolbox}

\makeatletter

%% =========================================
%% 1. Package Options and Engine Detection
%% =========================================
% FORCE PDF OUTPUT MODE
% Some papers (e.g. 2001.00171) force DVI mode via %&latex or \pdfoutput=0
% We must override this because LPSB relies on PDF tagging primitives.
\unless\ifdefined\pdfoutput \else \pdfoutput=1 \fi

\RequirePackage{iftex}

% Debug mode flag - controls verbose debug output
% Use \usepackage[debug]{lpsb-mcid} to enable
\newif\if@lpsb@debug \@lpsb@debugfalse

% Debug output macro - only outputs when debug mode is enabled
% Usage: \lpsb@debug{message text}
\newcommand{\lpsb@debug}[1]{%
  \if@lpsb@debug
    \typeout{[LPSB-DEBUG] #1}%
  \fi
}

% Active flag - enables tagging logic
\newif\if@lpsb@active \@lpsb@activefalse

% Package options
\DeclareOption{active}{\@lpsb@activetrue}
\DeclareOption{tagged}{\@lpsb@activetrue}

% Package option: debug (enables verbose debug output)
\DeclareOption{debug}{%
  \AtEndOfPackage{\global\@lpsb@debugtrue}%
}
% Package option: pass-one (enables positioning collection mode)
\DeclareOption{pass-one}{%
  \AtEndOfPackage{\global\@lpsb@pass@onetrue}%
}
\ProcessOptions\relax

% LuaTeX uses different primitive names
\ifLuaTeX
  \let\lpsb@pdfliteral\pdfextension
  \def\lpsb@pdfliteralcmd#1{\pdfextension literal direct {#1}}
\else
  \def\lpsb@pdfliteralcmd#1{\pdfliteral direct {#1}}
\fi

%% =========================================
%% 1b. Aux File Command Definitions (No-ops)
%% =========================================
% These commands are used within the package for the current run.
\providecommand{\lpsb@tag@data}[5]{}
\providecommand{\lpsb@tag@atom}[5]{}
\providecommand{\lpsb@tag@end}[2]{}
\providecommand{\lpsb@mcid@cont}[3]{}
\providecommand{\lpsb@summary}[3]{}
\providecommand{\lpsb@meta}[2]{}
\providecommand{\lpsb@refkey}[2]{}
\providecommand{\lpsb@pass@float}[4]{}
\providecommand{\lpsb@pass@pagebreak}[2]{}
\providecommand{\lpsb@pass@elempage}[3]{}
\providecommand{\lpsb@pass@section}[4]{}
\providecommand{\lpsb@layout}[1]{}
\providecommand{\lpsb@layout@switch}[2]{}
\providecommand{\lpsb@img@pos}[6]{}  % {img_id}{x0}{y0}{x1}{y1}{page} - image bbox in sp

% FIX: "Self-Healing" Aux File Strategy.
% We explicitly write \providecommand definitions into the .aux file itself.
% This ensures that if lpsb-mcid.sty fails to load in a subsequent run (Run 2),
% the .aux file (leftover from Run 1) will safely define these commands as no-ops
% instead of crashing with "Undefined control sequence".
\AtBeginDocument{%
  \if@filesw
    \immediate\write\@auxout{%
      \string\providecommand\string\lpsb@tag@data[5]{}^^J%
      \string\providecommand\string\lpsb@tag@atom[5]{}^^J%
      \string\providecommand\string\lpsb@tag@end[2]{}^^J%
      \string\providecommand\string\lpsb@mcid@cont[3]{}^^J%
      \string\providecommand\string\lpsb@summary[3]{}^^J%
      \string\providecommand\string\lpsb@meta[2]{}^^J%
      \string\providecommand\string\lpsb@refkey[2]{}^^J%
      \string\providecommand\string\lpsb@pass@float[4]{}^^J%
      \string\providecommand\string\lpsb@pass@pagebreak[2]{}^^J%
      \string\providecommand\string\lpsb@pass@elempage[3]{}^^J%
      \string\providecommand\string\lpsb@pass@section[4]{}^^J%
      \string\providecommand\string\lpsb@layout[1]{}^^J%
      \string\providecommand\string\lpsb@layout@switch[2]{}^^J%
      \string\providecommand\string\lpsb@img@pos[6]{}%
    }%
  \fi
}


%% =========================================
%% 1c. Two-Pass Compilation Options
%% =========================================
% Pass 1: Collect positioning information only (no BDC emission)
% Pass 2: Use collected info to emit precise BDC markers (default when pass-one data exists)

\newif\if@lpsb@pass@one \@lpsb@pass@onefalse  % Currently in pass-one mode
\newif\if@lpsb@has@pass@data \@lpsb@has@pass@datafalse  % Pass-one data exists in aux

% Counter for float tracking in pass-one
\newcounter{lpsb@floatID}
\setcounter{lpsb@floatID}{0}

% Counter for section tracking in pass-one
\newcounter{lpsb@sectionID}
\setcounter{lpsb@sectionID}{0}

% Counter for image tracking (for bbox recording)
\newcounter{lpsb@imgID}
\setcounter{lpsb@imgID}{0}

% Storage for pass-one float placement data (read from aux)
% Format: \lpsb@float@page@{float_id} -> rendered_page
\newcommand{\lpsb@record@float@page}[2]{%
  \expandafter\gdef\csname lpsb@float@page@#1\endcsname{#2}%
}
\newcommand{\lpsb@get@float@page}[1]{%
  \ifcsname lpsb@float@page@#1\endcsname
    \csname lpsb@float@page@#1\endcsname
  \else
    0%
  \fi
}

% Storage for pass-one section placement data (read from aux)
% Format: \lpsb@section@page@{section_id} -> rendered_page
\newcommand{\lpsb@record@section@page}[2]{%
  \expandafter\gdef\csname lpsb@section@page@#1\endcsname{#2}%
}
\newcommand{\lpsb@get@section@page}[1]{%
  \ifcsname lpsb@section@page@#1\endcsname
    \csname lpsb@section@page@#1\endcsname
  \else
    0%
  \fi
}

% Process pass-one aux commands when aux is read
\AtBeginDocument{%
  % Re-define aux readers to actually store the data
  \renewcommand{\lpsb@pass@float}[4]{%
    \global\@lpsb@has@pass@datatrue
    \lpsb@record@float@page{#1}{#3}% Store: float_id -> rendered_page
  }%
  \renewcommand{\lpsb@pass@section}[4]{%
    \global\@lpsb@has@pass@datatrue
    \lpsb@record@section@page{#1}{#3}% Store: section_id -> rendered_page
  }%
}

% Record document layout mode (single/two column) to aux file
% This allows post-processing to use definitive layout info instead of heuristics
\AtBeginDocument{%
  \if@twocolumn
    \immediate\write\@auxout{\string\lpsb@layout{twocolumn}}%
  \else
    \immediate\write\@auxout{\string\lpsb@layout{onecolumn}}%
  \fi
}

% Track layout switches mid-document using shipout hook
% This approach is more robust than wrapping \twocolumn/\onecolumn commands,
% as it avoids conflicts with templates that use complex \twocolumn[...] syntax
% (e.g., IEEEtran's \twocolumn[{\IEEEquantizevspace{...}}]).
%
% Strategy: At each page shipout, check \if@twocolumn and record if it changed.
% This records the ACTUAL layout of each page, not when the command was called.

% Track the last recorded layout to detect changes
\newif\if@lpsb@last@twocolumn \@lpsb@last@twocolumnfalse
\newif\if@lpsb@layout@initialized \@lpsb@layout@initializedfalse

% Record layout change at shipout time
\newcommand{\lpsb@record@layout@at@shipout}{%
  \if@lpsb@layout@initialized
    % Check if layout changed since last shipout
    \if@twocolumn
      \if@lpsb@last@twocolumn
        % Still twocolumn - no change
      \else
        % Changed to twocolumn
        \protected@write\@auxout{}{\string\lpsb@layout@switch{twocolumn}{\thepage}}%
        \global\@lpsb@last@twocolumntrue
      \fi
    \else
      \if@lpsb@last@twocolumn
        % Changed to onecolumn
        \protected@write\@auxout{}{\string\lpsb@layout@switch{onecolumn}{\thepage}}%
        \global\@lpsb@last@twocolumnfalse
      \else
        % Still onecolumn - no change
      \fi
    \fi
  \else
    % First shipout - initialize tracking state from base layout
    \if@twocolumn
      \global\@lpsb@last@twocolumntrue
    \else
      \global\@lpsb@last@twocolumnfalse
    \fi
    \global\@lpsb@layout@initializedtrue
  \fi
}

% Install shipout hook using LaTeX3 hook system (TL2020+) or atbegshi fallback
\@ifundefined{AddToHook}{%
  % Fallback for older LaTeX: use atbegshi if available
  \IfFileExists{atbegshi.sty}{%
    \RequirePackage{atbegshi}%
    \AtBeginShipout{\lpsb@record@layout@at@shipout}%
  }{%
    % No hook mechanism available - skip layout tracking
    \typeout{LPSB-MCID Warning: No shipout hook available, layout tracking disabled}%
  }%
}{%
  % LaTeX3 hook system available
  \AddToHook{shipout/before}{\lpsb@record@layout@at@shipout}%
}

% Define aux readers (no-op, just for parsing by Python)
\providecommand{\lpsb@layout}[1]{}
\providecommand{\lpsb@layout@switch}[2]{}


% Smart float handling: check if float lands on same page
% If we have pass-one data and float goes to a DIFFERENT page,
% we don't need to close the current P tag (since rendered content won't be interrupted)
\newif\if@lpsb@float@same@page \@lpsb@float@same@pagetrue  % Default: assume same page

\newcommand{\lpsb@check@float@page}{%
  % Get the float ID that will be assigned
  \edef\lpsb@next@float@id{\number\numexpr\value{lpsb@floatID}+1\relax}%
  %
  \if@lpsb@has@pass@data
    % We have pass-one data - check where this float lands
    \edef\lpsb@float@target@page{\lpsb@get@float@page{\lpsb@next@float@id}}%
    \ifnum\lpsb@float@target@page=0
      % No data for this float - assume same page (conservative)
      \global\@lpsb@float@same@pagetrue
    \else
      \ifnum\lpsb@float@target@page=\value{lpsb@currentPage}
        % Float lands on current page - need to close P
        \global\@lpsb@float@same@pagetrue
      \else
        % Float lands on different page - DON'T close P
        \global\@lpsb@float@same@pagefalse
      \fi
    \fi
  \else
    % No pass-one data - use conservative behavior (close P)
    \global\@lpsb@float@same@pagetrue
  \fi
}

%% =========================================
%% Compatibility / Safe Mode
\newif\if@lpsb@safe@mode
\@lpsb@safe@modefalse

% Implementation to check for conflicting packages
\newcommand{\lpsb@check@compatibility}{%
  % List of packages that are known to conflict with LPSB-MCID tagging
  % Format: package_name
  \def\lpsb@conflict@packages{axessibility,accsupp,tagpdf,accessibility,pdfcomment,floatrow}%
  %
  \@for\lpsb@pkg:=\lpsb@conflict@packages\do{%
    \@ifpackageloaded{\lpsb@pkg}{%
      \typeout{LPSB-MCID Warning: Conflicting package '\lpsb@pkg' detected!}%
      \typeout{LPSB-MCID Info: Enabling SAFE MODE - intrusive hooks (captions, sections) will be disabled.}%
      \global\@lpsb@safe@modetrue
      % Break loop if possible, or just let it continue (doesn't hurt)
    }{}%
  }%
}
\AtBeginDocument{\lpsb@check@compatibility}

%% =========================================
%% 2. Core MCID State Management
%% =========================================
\newif\if@lpsb@in@tag \@lpsb@in@tagfalse
\newif\if@lpsb@active  \@lpsb@activefalse

\newcounter{lpsb@globalMCID}        % Global MCID across all elements
\newcounter{lpsb@logicalElemID}     % Logical element ID
\newcounter{lpsb@currentPage}       % Current page number
\setcounter{lpsb@currentPage}{1}

% Current tag state
\gdef\lpsb@current@logical@id{0}
\gdef\lpsb@current@tag@type{P}

% Tag stack for nesting (stores: id,type,id,type,...)
\gdef\lpsb@tag@stack{}

%% =========================================
%% 3. Stack Operations for Nested Tags
%% =========================================
\newcommand{\lpsb@push@tag}[2]{%
  % Push id,type onto stack
  \xdef\lpsb@tag@stack{#1,#2,\lpsb@tag@stack}%
}

\newcommand{\lpsb@pop@tag}{%
  % Pop top id,type from stack and restore
  \expandafter\lpsb@do@pop\lpsb@tag@stack\@nil
}
\def\lpsb@do@pop#1,#2,#3\@nil{%
  \xdef\lpsb@current@logical@id{#1}%
  \xdef\lpsb@current@tag@type{#2}%
  \xdef\lpsb@tag@stack{#3}%
}

%% =========================================
%% 3b. Helper Macros for Code Reduction
%% =========================================
% These helpers consolidate frequently repeated patterns throughout the package.

% Global constants for container type checking (defined once, used everywhere)
\def\lpsb@const@Table{Table}%
\def\lpsb@const@Figure{Figure}%

% Helper: Check if current tag type is a container (Table/Figure)
% Containers should NOT be reopened after atoms - they are structural elements.
% Usage: \lpsb@if@container@type{<true-code>}{<false-code>}
% Checks \lpsb@current@tag@type against Table/Figure
\newcommand{\lpsb@if@container@type}[2]{%
  \ifx\lpsb@current@tag@type\lpsb@const@Table
    #1%
  \else\ifx\lpsb@current@tag@type\lpsb@const@Figure
    #1%
  \else
    #2%
  \fi\fi
}

% Helper: Check if a given tag type is a container
% Usage: \lpsb@if@type@is@container{<type>}{<true-code>}{<false-code>}
\newcommand{\lpsb@if@type@is@container}[3]{%
  \edef\lpsb@tmp@chk{#1}%  % Use \edef to expand macros like \lpsb@math@parent@type
  \ifx\lpsb@tmp@chk\lpsb@const@Table
    #2%
  \else\ifx\lpsb@tmp@chk\lpsb@const@Figure
    #2%
  \else
    #3%
  \fi\fi
}

% Helper: Reopen a parent tag with continuation MCID
% This is the most frequently duplicated pattern in the package.
% Usage: \lpsb@reopen@tag@with@cont{<parent_id>}{<parent_type>}
% Emits: BDC with new MCID, writes lpsb@mcid@cont to aux
\newcommand{\lpsb@reopen@tag@with@cont}[2]{%
  \stepcounter{lpsb@globalMCID}%
  \lpsb@pdfliteralcmd{ /#2\space << /MCID \thelpsb@globalMCID >> BDC }%
  \edef\lpsb@cont@parentid{#1}%
  \edef\lpsb@cont@mcid{\thelpsb@globalMCID}%
  \edef\lpsb@cont@page{\thelpsb@currentPage}%
  \immediate\write\@auxout{\string\lpsb@mcid@cont{\lpsb@cont@parentid}{\lpsb@cont@mcid}{\lpsb@cont@page}}%
}

% Helper: Reopen parent tag unless it's a container type
% Usage: \lpsb@reopen@unless@container{<parent_id>}{<parent_type>}
% If container type (Table/Figure), start a new P instead of reopening container
\newcommand{\lpsb@reopen@unless@container}[2]{%
  \lpsb@if@type@is@container{#2}{%
    % Container type - do not reopen, start a new P for subsequent content
    \lpsbTagBegin{P}%
  }{%
    % Normal parent type - reopen with continuation
    \lpsb@reopen@tag@with@cont{#1}{#2}%
  }%
}

%% =========================================
%% 4. Page Boundary Handlers (Cross-page)
%% =========================================
% Flag to disable tagging during shipout (for header/footer)
\newif\if@lpsb@in@shipout \@lpsb@in@shipoutfalse
% Flag to defer BDC insertion until first real content
\newif\if@lpsb@needs@reopen \@lpsb@needs@reopenfalse
% Store tag info for cross-page reopening
\gdef\lpsb@reopen@type{}
\gdef\lpsb@reopen@id{}

% Helper macro to reset shipout flag after shipout completes
\def\lpsb@reset@shipout@flag{%
  \global\@lpsb@in@shipoutfalse
}

\AtBeginShipout{%
  % Set shipout flag true during shipout processing
  \global\@lpsb@in@shipouttrue
  % Schedule reset after shipout group ends
  \aftergroup\lpsb@reset@shipout@flag
  \if@lpsb@active
    \stepcounter{lpsb@currentPage}%  % Increment page counter at each shipout
    \if@lpsb@in@tag
      % Always close tag at page boundary; reopen on next page with continuation.
      \lpsb@pdfliteralcmd{ EMC }%
      \xdef\lpsb@reopen@type{\lpsb@current@tag@type}%
      \xdef\lpsb@reopen@id{\lpsb@current@logical@id}%
      \global\@lpsb@needs@reopentrue
    \fi
  \fi
}

% After shipout completes, reopen the tag for continued content
\AtBeginShipoutNext{%
  \global\@lpsb@in@shipoutfalse
  \if@lpsb@active
    \if@lpsb@needs@reopen
      \global\@lpsb@needs@reopenfalse
      % Floats (Figure/Table) are self-contained - don't reopen them
      % Check @lpsb@in@float flag which is set during float environments
      \if@lpsb@in@float
        % We're inside a float - use P for any subsequent content
        \xdef\lpsb@actual@reopen@type{P}%
      \else
        % Headings should not span pages; always reopen as P.
        \if@lpsb@in@section
          \xdef\lpsb@actual@reopen@type{P}%
          \global\@lpsb@in@sectionfalse
        \else
          \xdef\lpsb@actual@reopen@type{\lpsb@reopen@type}%
        \fi
      \fi
      % CRITICAL: Do NOT reopen Table/Figure containers - they are structural elements
      \lpsb@if@type@is@container{\lpsb@actual@reopen@type}{%
        % Container type (Table/Figure) - do not reopen
      }{%
        % Normal parent type - reopen with continuation
        \lpsb@reopen@tag@with@cont{\lpsb@reopen@id}{\lpsb@actual@reopen@type}%
        % CRITICAL: Set @lpsb@in@tag to true and restore current tag state
        \global\@lpsb@in@tagtrue
        \xdef\lpsb@current@logical@id{\lpsb@reopen@id}%
        \xdef\lpsb@current@tag@type{\lpsb@actual@reopen@type}%
      }%
    \fi
    % If a P is pending and no tag is open, start it at page top.
    \if@lpsb@in@tag\else
      \if@lpsb@P@pending@after@section
        \global\@lpsb@P@pending@after@sectionfalse
        \lpsbTagBegin{P}%
      \else\if@lpsb@P@pending@after@float
        \global\@lpsb@P@pending@after@floatfalse
        \lpsbTagBegin{P}%
      \else\if@lpsb@P@pending@after@math
        \global\@lpsb@P@pending@after@mathfalse
        \lpsbTagBegin{P}%
      \else\if@lpsb@P@pending@after@list
        \global\@lpsb@P@pending@after@listfalse
        \lpsbTagBegin{P}%
      \fi\fi\fi\fi
    \fi
    % Fallback: ensure a P is open at page top for continuation text.
    \if@lpsb@in@tag\else
      \lpsbTagBegin{P}%
      \global\@lpsb@first@parafalse
    \fi
  \fi
}

% --- Header/Footer: Mark as Artifact (non-structural content) ---
% Page numbers, running heads, etc. should be marked as /Artifact (PDF/UA standard)
% not as P. This is cleaner than trying to suppress MCIDs entirely.

% IMPORTANT:
% Do NOT patch fancyhdr internals (\f@nch@head/\f@nch@foot). Many classes patch
% fancyhdr aggressively and those internals are fragile.
%
% Instead we wrap the *output-level* header/footer macros (\@oddhead/\@oddfoot/...):
% this is lower-level and it also lets us disable paragraph tagging while the
% head/foot boxes are built (otherwise \everypar can emit stray P tags there).
%
% However: some classes (notably acmart) bypass \@oddhead/\@thehead and build
% headers/footers via fancyhdr internals. In that case we must wrap fancyhdr too.

% Flag: building header/footer content (output routine, not shipout)
\newif\if@lpsb@in@headfoot \@lpsb@in@headfootfalse
\newif\if@lpsb@in@artifact \@lpsb@in@artifactfalse

% Wrap header/footer content as /Artifact and suppress paragraph tagging inside.
\long\def\lpsb@headfoot@artifact#1{%
  \begingroup
    \@lpsb@in@headfoottrue
    \@ifundefined{lpsb@seen@headfoot@artifact}{%
      \gdef\lpsb@seen@headfoot@artifact{1}%
      \typeout{LPSB-MCID Info: head/foot artifact wrapper EXECUTED}%
    }{}%
    \if@lpsb@in@artifact
      #1%
    \else
      \@lpsb@in@artifacttrue
      \lpsb@pdfliteralcmd{ /Artifact BMC }%
      #1%
      \lpsb@pdfliteralcmd{ EMC }%
    \fi
  \endgroup
}

% Wrap fancyhdr internals (when present) with /Artifact, for classes that bypass
% \@oddhead/\@thehead.
%
% NOTE: fancyhdr internals are not stable across versions/classes. A wrong
% signature here will corrupt the argument stream (catastrophic). Keep this
% disabled until we detect and match the correct definition in the target setup.
\newcommand{\lpsb@wrap@fancyhdr@artifact}{}

% Wrap header/footer at the output routine level via \@thehead/\@thefoot.
% This catches fancyhdr, custom pagestyles, and templates that redefine \@oddhead
% after begin document.
%
% NOTE: We do NOT call \lpsb@wrap@headfoot@artifact globally at \AtBeginDocument
% because output routine hooks already wrap headers/footers locally in each call.
% Global wrapping + output routine wrapping causes recursive \begingroup overflow.
\AtBeginDocument{%
  \@ifundefined{@outputpage}{}{%
    \@ifundefined{lpsb@orig@@outputpage}{%
      \let\lpsb@orig@@outputpage\@outputpage
      \typeout{LPSB-MCID Info: outputpage wrapped for head/foot artifacts}%
      \def\@outputpage{%
        \begingroup
          \@ifundefined{lpsb@seen@outputpage}{%
            \gdef\lpsb@seen@outputpage{1}%
            \typeout{LPSB-MCID Info: outputpage CALLED (shipout path uses @outputpage)}%
          }{}%
          \@ifundefined{@oddhead}{}{%
            \let\lpsb@orig@oddhead\@oddhead
            \def\@oddhead{\lpsb@headfoot@artifact{\lpsb@orig@oddhead}}%
          }%
          \@ifundefined{@evenhead}{}{%
            \let\lpsb@orig@evenhead\@evenhead
            \def\@evenhead{\lpsb@headfoot@artifact{\lpsb@orig@evenhead}}%
          }%
          \@ifundefined{@oddfoot}{}{%
            \let\lpsb@orig@oddfoot\@oddfoot
            \def\@oddfoot{\lpsb@headfoot@artifact{\lpsb@orig@oddfoot}}%
          }%
          \@ifundefined{@evenfoot}{}{%
            \let\lpsb@orig@evenfoot\@evenfoot
            \def\@evenfoot{\lpsb@headfoot@artifact{\lpsb@orig@evenfoot}}%
          }%
          \@ifundefined{@thehead}{}{%
            \let\lpsb@orig@thehead\@thehead
            \def\@thehead{\lpsb@headfoot@artifact{\lpsb@orig@thehead}}%
          }%
          \@ifundefined{@thefoot}{}{%
            \let\lpsb@orig@thefoot\@thefoot
            \def\@thefoot{\lpsb@headfoot@artifact{\lpsb@orig@thefoot}}%
          }%
          \lpsb@orig@@outputpage
        \endgroup
      }%
    }{}%
  }%
  % NOTE: We do NOT wrap \@outputdblcol separately because it internally calls
  % \@outputpage, which already handles header/footer artifact wrapping.
  % Wrapping both causes recursive \begingroup overflow.
  %
  % HOWEVER: We DO hook \@outputdblcol to handle cross-column tag continuation.
  % When content flows from left column to right column, we need to ensure
  % the tag state is preserved so that cross-column paragraphs remain as
  % one logical element with multiple MCIDs (via \lpsb@mcid@cont).
  \@ifundefined{@outputdblcol}{}{%
    \let\lpsb@orig@@outputdblcol\@outputdblcol
    \def\@outputdblcol{%
      % Save current tag state before column switch
      \xdef\lpsb@saved@col@tag@type{\lpsb@current@tag@type}%
      \xdef\lpsb@saved@col@logical@id{\lpsb@current@logical@id}%
      \xdef\lpsb@saved@col@in@tag{\if@lpsb@in@tag 1\else 0\fi}%
      \xdef\lpsb@saved@col@in@abstract{\if@lpsb@in@abstract 1\else 0\fi}%
      % If no tag is open, wrap left-column box in P to avoid untagged carryover
      \if@lpsb@active
        \if@lpsb@in@tag\else
          \setbox\@leftcolumn\vbox{%
            \lpsbTagBeginForce{P}%
            \unvbox\@leftcolumn
            \lpsbTagEndForce
          }%
        \fi
      \fi
      % Call original output routine
      \lpsb@orig@@outputdblcol
      % After column switch, check if we need to continue a tag
      % This is triggered when moving from left column to right column
      \if@firstcolumn\else
        % We just switched to right column - restore abstract flag if it was set
        \ifnum\lpsb@saved@col@in@abstract=1
          \global\@lpsb@in@abstracttrue
        \fi
      \fi
    }%
  }%
  % Patch standard pagestyles so they wrap headers/footers after defining them
  % This is critical for first page where \thispagestyle{plain} overwrites our wrapping
  \lpsb@patch@pagestyles
}

% Fallback: wrap standard LaTeX header/footer commands with Artifact
\newcommand{\lpsb@wrap@headfoot@artifact}{%
  \@ifundefined{@oddfoot}{}{%
    \let\lpsb@orig@oddfoot\@oddfoot
    \def\@oddfoot{\lpsb@headfoot@artifact{\lpsb@orig@oddfoot}}%
  }%
  \@ifundefined{@evenfoot}{}{%
    \let\lpsb@orig@evenfoot\@evenfoot
    \def\@evenfoot{\lpsb@headfoot@artifact{\lpsb@orig@evenfoot}}%
  }%
  \@ifundefined{@oddhead}{}{%
    \let\lpsb@orig@oddhead\@oddhead
    \def\@oddhead{\lpsb@headfoot@artifact{\lpsb@orig@oddhead}}%
  }%
  \@ifundefined{@evenhead}{}{%
    \let\lpsb@orig@evenhead\@evenhead
    \def\@evenhead{\lpsb@headfoot@artifact{\lpsb@orig@evenhead}}%
  }%
}

% Wrap current header/footer definitions with Artifact markers using \edef
% This captures the current definition at call time, avoiding double-wrap issues
% when pagestyles redefine \@oddfoot etc.
\newcommand{\lpsb@wrap@current@headfoot}{%
  \@ifundefined{@oddfoot}{}{%
    \ifx\@oddfoot\@empty\else
      \edef\@oddfoot{%
        \noexpand\lpsb@headfoot@artifact{%
          \unexpanded\expandafter{\@oddfoot}%
        }%
      }%
    \fi
  }%
  \@ifundefined{@evenfoot}{}{%
    \ifx\@evenfoot\@empty\else
      \edef\@evenfoot{%
        \noexpand\lpsb@headfoot@artifact{%
          \unexpanded\expandafter{\@evenfoot}%
        }%
      }%
    \fi
  }%
  \@ifundefined{@oddhead}{}{%
    \ifx\@oddhead\@empty\else
      \edef\@oddhead{%
        \noexpand\lpsb@headfoot@artifact{%
          \unexpanded\expandafter{\@oddhead}%
        }%
      }%
    \fi
  }%
  \@ifundefined{@evenhead}{}{%
    \ifx\@evenhead\@empty\else
      \edef\@evenhead{%
        \noexpand\lpsb@headfoot@artifact{%
          \unexpanded\expandafter{\@evenhead}%
        }%
      }%
    \fi
  }%
}

% Patch standard pagestyles to wrap headers/footers after they are defined
% This is necessary because \thispagestyle{plain} etc. redefine \@oddfoot,
% overwriting any previous wrapping done at \AtBeginDocument.
%
% NOTE: When fancyhdr is loaded, we SKIP pagestyle patching because:
% 1. fancyhdr uses complex \@oddhead definitions that cannot be safely wrapped with \edef
% 2. The \@outputpage wrapper already handles artifact marking at output time
% 3. Attempting to wrap fancyhdr's \@oddhead causes infinite expansion (page explosion)
\newcommand{\lpsb@patch@pagestyles}{%
  % Skip if fancyhdr is loaded - it uses complex macros that break with \edef wrapping
  \@ifpackageloaded{fancyhdr}{%
    \typeout{LPSB-MCID Info: fancyhdr detected - skipping pagestyle patches (outputpage wrapper handles artifacts)}%
  }{%
    % Patch \ps@plain
    \@ifundefined{ps@plain}{}{%
      \let\lpsb@orig@ps@plain\ps@plain
      \def\ps@plain{%
        \lpsb@orig@ps@plain
        \lpsb@wrap@current@headfoot
      }%
    }%
    % Patch \ps@empty
    \@ifundefined{ps@empty}{}{%
      \let\lpsb@orig@ps@empty\ps@empty
      \def\ps@empty{%
        \lpsb@orig@ps@empty
        \lpsb@wrap@current@headfoot
      }%
    }%
    % Patch \ps@headings
    \@ifundefined{ps@headings}{}{%
      \let\lpsb@orig@ps@headings\ps@headings
      \def\ps@headings{%
        \lpsb@orig@ps@headings
        \lpsb@wrap@current@headfoot
      }%
    }%
    % Patch \ps@myheadings
    \@ifundefined{ps@myheadings}{}{%
      \let\lpsb@orig@ps@myheadings\ps@myheadings
      \def\ps@myheadings{%
        \lpsb@orig@ps@myheadings
        \lpsb@wrap@current@headfoot
      }%
    }%
  }%
}

%% =========================================
%% 4c. Table of Contents Tagging
%% =========================================
% TOC entries should be tagged as TOCI (TOC Item) instead of P
% We hook \@starttoc to set a flag, then modify tag emission in contentsline

\newif\if@lpsb@in@toc \@lpsb@in@tocfalse

% Hook \@starttoc to set TOC flag
\AtBeginDocument{%
  \@ifundefined{@starttoc}{}{%
    \let\lpsb@orig@starttoc\@starttoc
    \def\@starttoc#1{%
      \global\@lpsb@in@toctrue
      \lpsb@orig@starttoc{#1}%
      \global\@lpsb@in@tocfalse
    }%
  }%
}

% Hook \contentsline to wrap each entry with TOCI tag
\AtBeginDocument{%
  \@ifundefined{contentsline}{}{%
    \let\lpsb@orig@contentsline\contentsline
    \def\contentsline#1#2#3#4{%
      % #1 = level (section, subsection, etc.)
      % #2 = title text
      % #3 = page number
      % #4 = hyperref destination
      \if@lpsb@in@toc
        % End any active P tag first
        \if@lpsb@active
          \lpsbTagEnd
        \fi
        % Start TOCI tag
        \lpsbTagBegin{TOCI}%
        \lpsb@orig@contentsline{#1}{#2}{#3}{#4}%
        % End TOCI tag
        \lpsbTagEnd
      \else
        \lpsb@orig@contentsline{#1}{#2}{#3}{#4}%
      \fi
    }%
  }%
}

%% =========================================
%% 4d. Title Area Semantic Tagging (Template-Aware)
%% =========================================
% Title, Author, Date, and Abstract need semantic tags instead of P
% This section provides template-aware hooks for various document classes
% and conference styles used in academic publishing.
%
% Supported patterns:
% 1. Standard article class: \@title, \@author, \@date
% 2. Conference styles (ACL, NeurIPS, ICLR, CVPR, AAAI): \@title, \@author
% 3. Springer (llncs, svjour): \@title, \@author, \institute
% 4. Elsevier (elsarticle): \@title, \elsauthors
% 5. AMS (amsart): \@title, \authors
% 6. Complex frontmatter (revtex, aastex, acmart): special handling

% Flag to track if we're inside maketitle
\newif\if@lpsb@in@maketitle \@lpsb@in@maketitlefalse

% Template detection flags
\newif\if@lpsb@template@detected \@lpsb@template@detectedfalse
\gdef\lpsb@detected@template{unknown}

% Helper: Detect template type based on defined macros/classes
% Uses smart detection based on characteristic macros instead of explicit package names
% This avoids needing to list every year variant (aaai24, aaai25, neurips_2023, etc.)
\newcommand{\lpsb@detect@template}{%
  % Default to article
  \gdef\lpsb@detected@template{article}%
  \global\@lpsb@template@detectedfalse
  %
  % Strategy: Detect by characteristic internal macros that each template family defines
  % This is more robust than checking package names by year
  %
  % Check for specific class files first (these are stable names)
  \@ifclassloaded{llncs}{\gdef\lpsb@detected@template{llncs}\global\@lpsb@template@detectedtrue}{}%
  \if@lpsb@template@detected\else
    \@ifclassloaded{IEEEtran}{\gdef\lpsb@detected@template{ieeetran}\global\@lpsb@template@detectedtrue}{}%
  \fi
  \if@lpsb@template@detected\else
    % acmart loads amsart.cls internally; do NOT let amsart override acmart.
    \@ifclassloaded{acmart}{\gdef\lpsb@detected@template{acmart}\global\@lpsb@template@detectedtrue}{}%
  \fi
  \if@lpsb@template@detected\else
    \@ifclassloaded{elsarticle}{\gdef\lpsb@detected@template{elsarticle}\global\@lpsb@template@detectedtrue}{}%
  \fi
  \if@lpsb@template@detected\else
    \@ifclassloaded{svjour3}{\gdef\lpsb@detected@template{svjour}\global\@lpsb@template@detectedtrue}{}%
  \fi
  \if@lpsb@template@detected\else
    \@ifclassloaded{svjour}{\gdef\lpsb@detected@template{svjour}\global\@lpsb@template@detectedtrue}{}%
  \fi
  \if@lpsb@template@detected\else
    \@ifclassloaded{amsart}{\gdef\lpsb@detected@template{amsart}\global\@lpsb@template@detectedtrue}{}%
  \fi
  \if@lpsb@template@detected\else
    \@ifclassloaded{revtex4-2}{\gdef\lpsb@detected@template{revtex}\global\@lpsb@template@detectedtrue}{}%
  \fi
  \if@lpsb@template@detected\else
    \@ifclassloaded{revtex4-1}{\gdef\lpsb@detected@template{revtex}\global\@lpsb@template@detectedtrue}{}%
  \fi
  %
  % Detect conference styles by characteristic macros (works for any year variant)
  %
  % NeurIPS: defines \@toptitlebar and \@bottomtitlebar for title decoration
  \if@lpsb@template@detected\else
    \@ifundefined{@toptitlebar}{}{%
      \@ifundefined{@bottomtitlebar}{}{\gdef\lpsb@detected@template{neurips}\global\@lpsb@template@detectedtrue}%
    }%
  \fi
  % ICLR: defines \iclrfinalcopy command (not the conditional \ificlrfinal)
  \if@lpsb@template@detected\else
    \@ifundefined{iclrfinalcopy}{}{\gdef\lpsb@detected@template{iclr}\global\@lpsb@template@detectedtrue}%
  \fi
  % ACL/EMNLP/NAACL: defines \outauthor and \titlebox length
  \if@lpsb@template@detected\else
    \@ifundefined{outauthor}{}{%
      \@ifundefined{titlebox}{}{\gdef\lpsb@detected@template{acl}\global\@lpsb@template@detectedtrue}%
    }%
  \fi
  % CVPR: defines \cvprsection command (not the conditional \ifcvprfinal)
  \if@lpsb@template@detected\else
    \@ifundefined{cvprsection}{}{%
      \gdef\lpsb@detected@template{cvpr}%
      \global\@lpsb@template@detectedtrue
      % Note: Author wrapping is handled in \lpsb@hook@maketitle@cvpr
    }%
  \fi
  % AAAI: defines \copyrighttext command (more reliable than \affiliations_ which is defined later)
  \if@lpsb@template@detected\else
    \@ifundefined{copyrighttext}{}{\gdef\lpsb@detected@template{aaai}\global\@lpsb@template@detectedtrue}%
  \fi
  % ICML: defines \icmltitle command
  \if@lpsb@template@detected\else
    \@ifundefined{icmltitle}{}{\gdef\lpsb@detected@template{icml}\global\@lpsb@template@detectedtrue}%
  \fi
  % AASTeX/RevTeX family: defines \frontmatter@maketitle
  \if@lpsb@template@detected\else
    \@ifundefined{frontmatter@maketitle}{}{\gdef\lpsb@detected@template{aastex}\global\@lpsb@template@detectedtrue}%
  \fi
  %
  % Additional conference templates
  % ICCV: defines \iccvsection command
  \if@lpsb@template@detected\else
    \@ifundefined{iccvsection}{}{\gdef\lpsb@detected@template{iccv}\global\@lpsb@template@detectedtrue}%
  \fi
  % WACV: defines \wacvsection command
  \if@lpsb@template@detected\else
    \@ifundefined{wacvsection}{}{\gdef\lpsb@detected@template{wacv}\global\@lpsb@template@detectedtrue}%
  \fi
  % AISTATS: defines \aistatstitle command
  \if@lpsb@template@detected\else
    \@ifundefined{aistatstitle}{}{\gdef\lpsb@detected@template{aistats}\global\@lpsb@template@detectedtrue}%
  \fi
  % TMLR (Transactions on ML Research): defines \interauthorskip (not \openreview which is user-defined)
  \if@lpsb@template@detected\else
    \@ifundefined{interauthorskip}{}{%
      % Also check for \aftertitskip to distinguish from other templates
      \@ifundefined{aftertitskip}{}{%
        \gdef\lpsb@detected@template{tmlr}\global\@lpsb@template@detectedtrue
      }%
    }%
  \fi
  %
  % Journal templates
  % MNRAS (Monthly Notices of Royal Astronomical Society): defines \ion command
  \if@lpsb@template@detected\else
    \@ifundefined{ion}{}{\gdef\lpsb@detected@template{mnras}\global\@lpsb@template@detectedtrue}%
  \fi
  %
  \typeout{LPSB-MCID Info: Detected template type: \lpsb@detected@template}%
}

% Hook \maketitle to suppress normal P tags and inline tags during title area
% Also provides TitleArea semantic tag for templates without fine-grained hooks
\AtBeginDocument{%
  \lpsb@detect@template
  \@ifundefined{maketitle}{}{%
    \let\lpsb@orig@maketitle\maketitle
    \def\maketitle{%
      \global\@lpsb@in@maketitletrue
      \global\@lpsb@suppress@inlinetrue  % Suppress inline tags during title
      % End any active P tag before title area
      \if@lpsb@active
        \lpsbTagEnd
        % Start TitleArea tag to wrap entire title block
        % This provides semantic marking even for complex templates
        \lpsbTagBegin{TitleArea}%
      \fi
      \lpsb@orig@maketitle
      \if@lpsb@active
        % Close TitleArea tag
        \lpsbTagEnd
      \fi
      \global\@lpsb@suppress@inlinefalse
      \global\@lpsb@in@maketitlefalse
      % Start P for content after title
      \if@lpsb@active
        \lpsbTagBegin{P}%
        \global\@lpsb@first@paratrue
      \fi
    }%
  }%
}

% Hook \@maketitle for standard article class and similar templates
% This wraps \@title, \@author, \@date with semantic tags
%
% Strategy for different template families:
% 1. Complex frontmatter (revtex, aastex, acmart, amsart): passthrough (too complex to hook safely)
% 2. NeurIPS family: hook \@toptitlebar/\@bottomtitlebar for Title, wrap \@author for Author
% 3. ICLR/CVPR/ICML/ACL/AAAI/ICCV family: wrap \@title/\@author directly (simple structure)
% 4. Standard article: wrap \@title/\@author/\@date in \@maketitle
%
% All templates get TitleArea wrapper from \maketitle hook above.

% Helper: Wrap \@title and \@author for conference templates
% These templates use simple {\LARGE\bf \@title\par} ... \@author patterns
\newcommand{\lpsb@wrap@title@author@simple}{%
  \@ifundefined{@title}{}{%
    \let\lpsb@saved@title@conf\@title
    \def\@title{%
      \lpsbTagBegin{Title}%
      \lpsb@saved@title@conf
      \lpsbTagEnd
    }%
  }%
  \@ifundefined{@author}{}{%
    \let\lpsb@saved@author@conf\@author
    \def\@author{%
      \lpsbTagBegin{Author}%
      \lpsb@saved@author@conf
      \lpsbTagEnd
    }%
  }%
}

% Helper: Standard article class hook (wraps in \@maketitle with group)
\newcommand{\lpsb@hook@maketitle@standard}{%
  \let\lpsb@orig@@maketitle\@maketitle
  \def\@maketitle{%
    % Create a group to localize changes
    \begingroup
      % Wrap \@title with Title tag
      \@ifundefined{@title}{}{%
        \let\lpsb@saved@title\@title
        \def\@title{%
          \lpsbTagBegin{Title}%
          \lpsb@saved@title
          \lpsbTagEnd
        }%
      }%
      % Wrap \@author with Author tag (check if it's not empty)
      \@ifundefined{@author}{}{%
        \let\lpsb@saved@author\@author
        \def\@author{%
          \lpsbTagBegin{Author}%
          \lpsb@saved@author
          \lpsbTagEnd
        }%
      }%
      % Wrap \@date with Date tag
      \@ifundefined{@date}{}{%
        \let\lpsb@saved@date\@date
        \def\@date{%
          \lpsbTagBegin{Date}%
          \lpsb@saved@date
          \lpsbTagEnd
        }%
      }%
      % For Elsevier: wrap \elsauthors if present
      \@ifundefined{elsauthors}{}{%
        \let\lpsb@saved@elsauthors\elsauthors
        \def\elsauthors{%
          \lpsbTagBegin{Author}%
          \lpsb@saved@elsauthors
          \lpsbTagEnd
        }%
      }%
      % For AMS: wrap \authors if present (different from \@author)
      \@ifundefined{authors}{}{%
        \let\lpsb@saved@authors\authors
        \def\authors{%
          \lpsbTagBegin{Author}%
          \lpsb@saved@authors
          \lpsbTagEnd
        }%
      }%
      % For Springer: wrap \@institute if present
      \@ifundefined{@institute}{}{%
        \let\lpsb@saved@institute\@institute
        \def\@institute{%
          \lpsbTagBegin{Affiliation}%
          \lpsb@saved@institute
          \lpsbTagEnd
        }%
      }%
      % For templates with institutename (llncs)
      \@ifundefined{institutename}{}{%
        \let\lpsb@saved@institutename\institutename
        \def\institutename{%
          \lpsbTagBegin{Affiliation}%
          \lpsb@saved@institutename
          \lpsbTagEnd
        }%
      }%
      % For templates with \@subtitle
      \@ifundefined{@subtitle}{}{%
        \let\lpsb@saved@subtitle\@subtitle
        \def\@subtitle{%
          \lpsbTagBegin{Subtitle}%
          \lpsb@saved@subtitle
          \lpsbTagEnd
        }%
      }%
      \lpsb@orig@@maketitle
    \endgroup
  }%
}

% Helper: NeurIPS-style hook using \@toptitlebar/\@bottomtitlebar
% Structure: \@toptitlebar ... {\LARGE\bf \@title\par} ... \@bottomtitlebar ... \@author
\newcommand{\lpsb@hook@maketitle@neurips}{%
  % Hook \@toptitlebar to start Title tag after it
  \@ifundefined{@toptitlebar}{}{%
    \let\lpsb@orig@toptitlebar\@toptitlebar
    \def\@toptitlebar{%
      \lpsb@orig@toptitlebar
      \if@lpsb@active
        \lpsbTagBegin{Title}%
      \fi
    }%
  }%
  % Hook \@bottomtitlebar to end Title tag and start Author tag
  \@ifundefined{@bottomtitlebar}{}{%
    \let\lpsb@orig@bottomtitlebar\@bottomtitlebar
    \def\@bottomtitlebar{%
      \if@lpsb@active
        \lpsbTagEnd  % End Title
        \lpsbTagBegin{Author}%  % Start Author (will be closed by TitleArea end)
      \fi
      \lpsb@orig@bottomtitlebar
    }%
  }%
  \typeout{LPSB-MCID Info: neurips template - hooked @toptitlebar/@bottomtitlebar for Title/Author}%
}

% Helper: Conference template hook (ICLR, CVPR, ICML, etc.)
% These templates use simple \@maketitle with direct \@title and \@author usage
\newcommand{\lpsb@hook@maketitle@conference}{%
  \@ifundefined{@maketitle}{}{%
    \let\lpsb@orig@@maketitle@conf\@maketitle
    \def\@maketitle{%
      \begingroup
        \lpsb@wrap@title@author@simple
        % CRITICAL: Set maketitle flag so tabular hook skips setting tabular flag
        % This allows author content inside tabular to be properly tagged
        \global\@lpsb@in@maketitletrue
        \@lpsb@in@tabularfalse
        \lpsb@orig@@maketitle@conf
        \global\@lpsb@in@maketitlefalse
      \endgroup
    }%
  }%
}

% Helper: CVPR-specific hook for abstract (uses \def not environment)
% Flags to prevent double-output of title/author content
\newif\if@lpsb@title@done \@lpsb@title@donefalse
\newif\if@lpsb@author@done \@lpsb@author@donefalse
\newcommand{\lpsb@hook@maketitle@cvpr}{%
  % Hook CVPR's \@maketitle - completely replace it to wrap tabular with Author tag
  \@ifundefined{@maketitle}{}{%
    % Save original content ONCE at hook time
    \let\lpsb@saved@title@content\@title
    \let\lpsb@saved@author@content\@author
    % Redefine \@title to output ONCE with tags
    \def\@title{%
      \if@lpsb@title@done\else
        \global\@lpsb@title@donetrue
        \lpsbTagBegin{Title}%
        \lpsb@saved@title@content
        \lpsbTagEnd
      \fi
    }%
    % Replace \@maketitle with our version that wraps tabular OUTSIDE
    \def\@maketitle{%
      % Set flags to prevent interference
      \global\@lpsb@in@maketitletrue
      \@lpsb@in@tabularfalse
      \global\@lpsb@suppress@inlinefalse
      \newpage
      \null
      \@ifundefined{iftoggle}{\vskip .375in}{%
        \iftoggle{cvprrebuttal}{\vspace*{-.3in}}{\vskip .375in}%
      }%
      \begin{center}%
        % Title with tag
        \@ifundefined{iftoggle}{%
          {\Large \bf \@title \par}%
        }{%
          \iftoggle{cvprrebuttal}{{\large \bf \@title \par}}{{\Large \bf \@title \par}}%
        }%
        % Author area - wrap the ENTIRE tabular with Author tag
        \@ifundefined{iftoggle}{\vspace*{24pt}}{%
          \iftoggle{cvprrebuttal}{\vspace*{-22pt}}{\vspace*{24pt}}%
        }%
        {%
          \large
          \lineskip .5em
          % Author area - wrap tabular with Author tag (tabular cell boundaries limit coverage)
          \if@lpsb@author@done\else
            \global\@lpsb@author@donetrue
            \lpsbTagBegin{Author}%
            \begin{tabular}[t]{c}%
              \@ifundefined{iftoggle}{%
                \lpsb@saved@author@content
              }{%
                \iftoggle{cvprfinal}{%
                  \lpsb@saved@author@content
                }{%
                  \iftoggle{cvprrebuttal}{}{%
                    Anonymous \@ifundefined{confName}{CVPR}{\confName}~submission\\
                    \vspace*{1pt}\\
                    Paper ID \@ifundefined{paperID}{???}{\paperID}%
                  }%
                }%
              }%
            \end{tabular}%
            \lpsbTagEnd
          \fi
          \par
        }%
        \vskip .5em
        \vspace*{12pt}%
      \end{center}%
      \global\@lpsb@in@maketitlefalse
    }%
  }%
  % Hook CVPR abstract command (not environment)
  \@ifundefined{abstract}{}{%
    \let\lpsb@orig@abstract@cvpr\abstract
    \def\abstract{%
      \lpsbTagEnd% Close any open tag
      \lpsbTagBegin{H1}%
      \lpsb@orig@abstract@cvpr
      \lpsbTagEnd% Close H1 after "Abstract" title
      \lpsbTagBegin{P}%
    }%
  }%
  \@ifundefined{endabstract}{}{%
    \let\lpsb@orig@endabstract@cvpr\endabstract
    \def\endabstract{%
      \lpsbTagEnd% Close P
      \lpsb@orig@endabstract@cvpr
      \lpsbTagBegin{P}% Start new P for content after abstract
    }%
  }%
}

% Helper: ICML-specific hook
% ICML uses \twocolumn[...] for title block, not \@maketitle.
% We need to hook \icmltitle and \icmlauthor directly.
%
% IMPORTANT: \icmltitle is called in preamble to STORE the title text.
% The actual typesetting happens later inside \twocolumn[...] when ICML calls
% the stored \@icmltitle. So we need to wrap the STORED content definition.
\newcommand{\lpsb@hook@maketitle@icml}{%
  % Hook \icmltitle to wrap the stored title with Title BDC/EMC
  \@ifundefined{icmltitle}{}{%
    \let\lpsb@orig@icmltitle\icmltitle
    \long\def\icmltitle##1{%
      % Store wrapped version that includes Title tags
      \lpsb@orig@icmltitle{%
        \lpsbTagEnd% Close any open P tag
        \lpsbTagBegin{Title}%
        ##1%
        \lpsbTagEnd% Close Title
        \lpsbTagBegin{P}% Open P for content after title
      }%
    }%
  }%
  % Hook \icmlauthor to wrap stored author with Author BDC/EMC
  % NOTE: The second argument contains affiliation markers like *1
  % For simplicity, we only tag the author name, not the markers
  \@ifundefined{icmlauthor}{}{%
    \let\lpsb@orig@icmlauthor\icmlauthor
    \long\def\icmlauthor##1##2{%
      % Force accepted-style expansion to avoid conditional breakage.
      \mbox{\bf ##1}\,\@for\theaffil:=##2\do{\@pa{\theaffil}}%
      \addtofullauthorlist{##1}%
    }%
  }%
  % Hook ICML abstract environment to tag "Abstract" title as H1
  % ICML abstract structure:
  %   \centerline{\large\bf Abstract}  <- this should be H1
  %   \vspace{-0.12in}\begin{quote}    <- quote content should be P
  %   ... content ...
  %   \par\end{quote}
  %
  % Strategy: Redefine the entire abstract environment to insert tags at correct positions
  % CRITICAL: Set @lpsb@in@abstract flag to prevent everypar from creating new P elements
  % when text flows across columns. This keeps the entire abstract as one logical P element.
  \AtBeginDocument{%
    \@ifundefined{abstract}{}{%
      \renewenvironment{abstract}{%
        % CRITICAL: Set flag BEFORE \begin{quote} to prevent quote hook from interfering
        \global\@lpsb@in@abstracttrue
        % Close any open P tag first
        \lpsbTagEnd
        % Output "Abstract" title with H1 tag
        \lpsbTagBegin{H1}%
        \centerline{\large\bf Abstract}%
        \lpsbTagEnd
        % Start the quote environment for abstract content
        \vspace{-0.12in}%
        \begin{quote}%
        % Open P tag for abstract content
        \lpsbTagBegin{P}%
      }{%
        % Close P tag for abstract content BEFORE \end{quote}
        \lpsbTagEnd
        \par\end{quote}%
        % Clear the abstract flag AFTER \end{quote} to prevent quote hook from interfering
        \global\@lpsb@in@abstractfalse
        \vskip 0.12in
        % Reopen P for content after abstract
        \lpsbTagBegin{P}%
      }%
    }%
  }%
}

