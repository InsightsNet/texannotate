% --- Wrapfigure/Wraptable Tagging ---
% wrapfig does NOT behave like a normal float:
% - It builds the wrapped object into \WF@box, then injects that box later via \everypar.
% - In collision cases it can also "force to float".
%
% Environment-level tagging (BeforeBeginEnvironment/AfterEndEnvironment) is wrong here:
% it tends to tag the wrapped *text* as Table/Figure and the wrapped object as P,
% swapping semantics (e.g. Table 8 on page 13 in 2401.00006).
%
% Correct approach: tag INSIDE the wrapped object box (\WF@box), not around the env.
\AtBeginDocument{%
  \@ifpackageloaded{wrapfig}{%
    \typeout{LPSB-MCID Info: wrapfig detected - tagging wrap box via WF@rapt/endwrapfloat}%
    % Tracks whether we isolated tagging state for a wrap box.
    \newif\if@lpsb@wf@boxing \@lpsb@wf@boxingfalse
    % Tracks whether we need to resume a P after wrap box injection.
    \newif\if@lpsb@wf@resumeP \@lpsb@wf@resumePfalse
    % True only while wrapfig injects \WF@box via \everypar.
    \newif\if@lpsb@wrapfig@inject \@lpsb@wrapfig@injectfalse
    % Patch \WF@rapt: called after placement args are parsed, right before
    % wrap content starts. At this point wrapfig has opened \WF@box (vtop/hbox)
    % and is about to read the environment body into it.
    \@ifundefined{WF@rapt}{}{%
      \let\lpsb@orig@WF@rapt\WF@rapt
      \def\WF@rapt[#1]#2{%
        \lpsb@orig@WF@rapt[#1]{#2}%
        \if@lpsb@active
          % CRITICAL:
          % wrapfig builds content into \WF@box (a \vtop/\hbox) using \setbox.
          % Our tagging state (\lpsb@current@logical@id/type, stack, in@tag) is GLOBAL.
          % If we mutate it inside \WF@box without restoring, we corrupt the outer
          % document state and can swap Table/P semantics in the surrounding text.
          %
          % So: snapshot outer state, isolate box state, tag inside the box, and
          % restore the outer state in \endwrapfloat.
          \xdef\lpsb@wf@saved@tag@stack{\lpsb@tag@stack}%
          \xdef\lpsb@wf@saved@curid{\lpsb@current@logical@id}%
          \xdef\lpsb@wf@saved@curtype{\lpsb@current@tag@type}%
          \if@lpsb@in@tag
            \gdef\lpsb@wf@saved@in@tag{1}%
          \else
            \gdef\lpsb@wf@saved@in@tag{0}%
          \fi
          \global\@lpsb@wf@boxingtrue
          % Isolate state for box tagging: start from a clean stack.
          \gdef\lpsb@tag@stack{}%
          \global\@lpsb@in@tagfalse
          % Determine Figure vs Table from \@captype (set by wrapfig)
          \edef\lpsb@wf@captype{\@captype}%
          \def\lpsb@wf@table{table}%
          \ifx\lpsb@wf@captype\lpsb@wf@table
            \lpsbTagBegin{Table}%
          \else
            \lpsbTagBegin{Figure}%
          \fi
          \global\@lpsb@suppress@inlinetrue
        \fi
      }%
    }%
    % Patch \endwrapfloat: close Table/Figure tag inside \WF@box before
    % wrapfig finalizes and stores the box.
    \@ifundefined{endwrapfloat}{}{%
      \let\lpsb@orig@endwrapfloat\endwrapfloat
      \def\endwrapfloat{%
        \if@lpsb@active
          \global\@lpsb@suppress@inlinefalse
          \lpsbTagEnd
          % Restore outer tagging state if we isolated it in \WF@rapt.
          \if@lpsb@wf@boxing
            \xdef\lpsb@tag@stack{\lpsb@wf@saved@tag@stack}%
            \xdef\lpsb@current@logical@id{\lpsb@wf@saved@curid}%
            \xdef\lpsb@current@tag@type{\lpsb@wf@saved@curtype}%
            \ifnum\lpsb@wf@saved@in@tag=1\relax
              \global\@lpsb@in@tagtrue
            \else
              \global\@lpsb@in@tagfalse
            \fi
            \global\@lpsb@wf@boxingfalse
          \fi
        \fi
        \lpsb@orig@endwrapfloat
      }%
    }%
    % Patch \WF@floathand: wrapfig injects \WF@box later via \everypar.
    % If we leave a /P BDC open, the injected box (and its tagging) can end up
    % splitting the paragraph stream, causing Table/P semantics to swap.
    % Close any open tag before injection, then resume P for the paragraph text.
    \@ifundefined{WF@floathand}{}{%
      \let\lpsb@orig@WF@floathand\WF@floathand
      \def\WF@floathand{%
        \if@lpsb@active
          \if@lpsb@in@tag
            \lpsbTagEnd
          \fi
        \fi
        \global\@lpsb@wrapfig@injecttrue
        \lpsb@orig@WF@floathand
        \global\@lpsb@wrapfig@injectfalse
        \if@lpsb@active
          % Ensure paragraph text after wrapfig injection is tagged.
          \if@lpsb@in@tag\else
            \lpsbTagBegin{P}%
            \global\@lpsb@first@paratrue
          \fi
        \fi
      }%
    }%
  }{}%
}

% --- Tabular/TabularX Outside Float ---
% When tabular environments appear outside of table floats, they should
% still be tagged as Table and have inline suppression.
% Note: We detect this by checking if we're NOT inside a float.
\AtBeginDocument{%
  \@ifpackageloaded{tabularx}{%
    \BeforeBeginEnvironment{tabularx}{%
      \if@lpsb@active
        \if@lpsb@in@float\else
          \lpsbTagEnd
          \lpsbTagBegin{Table}%
          \global\@lpsb@suppress@inlinetrue
        \fi
      \fi
    }%
    \AfterEndEnvironment{tabularx}{%
      \if@lpsb@active
        \if@lpsb@in@float\else
          \global\@lpsb@suppress@inlinefalse
          \lpsbTagEnd
          \lpsbTagBegin{P}%
        \fi
      \fi
    }%
  }{}%
}

% Standard tabular: suppress inline when outside float
\BeforeBeginEnvironment{tabular}{%
  \if@lpsb@active
    \if@lpsb@in@float\else
      \global\@lpsb@suppress@inlinetrue
    \fi
  \fi
}
\AfterEndEnvironment{tabular}{%
  \if@lpsb@active
    \if@lpsb@in@float\else
      \global\@lpsb@suppress@inlinefalse
    \fi
  \fi
}

% --- Citations → Reference ---
% Keep citations as atom tags so they don't split /P into separate logical elements.
% NOTE: natbib supports up to two optional args: \citep[pre][post]{key}.
%
% SOLUTION: Instead of hooking user-level commands (\cite, \citep, \citet),
% we hook natbib's internal output primitive \NAT@citetp which is called
% AFTER all argument parsing is complete. This avoids:
% 1. Misplaced alignment tab errors from & in bibcodes
% 2. Breaking natbib's complex argument scanning logic
%
% For non-natbib documents, we hook the standard \@citex command.
%
\AtBeginDocument{%
  \@ifpackageloaded{natbib}{%
    \typeout{LPSB-MCID Info: natbib detected - hooking internal citation output}%
    % Hook \NAT@citetp - this is called to output the final citation text
    % It receives the formatted citation as its argument
    \ifdefined\NAT@citetp
      \let\lpsb@orig@NAT@citetp\NAT@citetp
      \long\def\NAT@citetp#1{%
        \lpsbTagAtom{Reference}{\lpsb@orig@NAT@citetp{#1}}%
      }%
    \fi
    % Also hook \NAT@citexnum for numeric citations
    \ifdefined\NAT@citexnum
      \let\lpsb@orig@NAT@citexnum\NAT@citexnum
      % NAT@citexnum doesn't take an argument in the same way,
      % it builds output internally. We hook at hyper@natlinkstart instead.
    \fi
  }{%
    % Non-natbib: hook standard \@citex if available
    \ifdefined\@citex
      \let\lpsb@orig@citex\@citex
      \long\def\@citex[#1]#2{%
        \lpsbTagAtom{Reference}{\lpsb@orig@citex[#1]{#2}}%
      }%
      \typeout{LPSB-MCID Info: standard LaTeX citation hook installed}%
    \fi
  }%
}

% --- Hyperlinks → Link ---
% NOTE: Hooking \href is complex because:
% 1. \href has optional arguments: \href[options]{url}{text}
% 2. hyperref heavily patches \href internally
% 3. Many packages (doi, url) wrap \href in complex ways
%
% For now, we leave \href unhooked. The hyperref package already provides
% some accessibility features for links. A proper implementation would need:
% - Use \LetLtxMacro to preserve optional argument handling
% - Hook at hyperref's internal level (e.g., \hyper@link)
% - Careful testing with all document classes
%
% TODO: Implement safe \href hooking in a future version.
% \AtBeginDocument{%
%   % \href hook implementation here
% }

%% =========================================
%% 7. Document Setup and Finalization
%% =========================================
\AtEndDocument{%
  \lpsbTagEnd
  % CRITICAL FIX: Disable LPSB after document ends to prevent infinite page generation.
  % Some document/package combinations (especially with float.sty) can trigger
  % infinite output routine calls after \clearpage. By disabling LPSB here,
  % we prevent our shipout hooks from interfering with the output routine cleanup.
  % Note: Floats are already tagged inside their boxes via \@xfloat hook,
  % so disabling here doesn't affect float tagging.
  \global\@lpsb@activefalse
  % Enable PDF MarkInfo
  \ifLuaTeX
    \pdfextension catalog{/MarkInfo << /Marked true >>}%
  \else
    \pdfcatalog{/MarkInfo << /Marked true >>}%
  \fi
  % Write summary
  \immediate\write\@auxout{%
    \string\lpsb@summary{\thelpsb@logicalElemID}{\thelpsb@globalMCID}{\thelpsb@currentPage}%
  }%
}

