  \fi
}

%% =========================================
%% 5. Core API: Tag Begin/End
%% =========================================

% Begin a new tagged element
% #1 = tag type (P, H1, H2, Abstract, Figure, etc.)
\newcommand{\lpsbTagBegin}[1]{%
  % CRITICAL: Skip in non-typesetting contexts (moving arguments)
  \ifx\protect\@typeset@protect
    \if@lpsb@active
      % If already in a tag, save current state to stack
      \if@lpsb@in@tag
        \lpsb@push@tag{\lpsb@current@logical@id}{\lpsb@current@tag@type}%
        \lpsb@pdfliteralcmd{ EMC }%
      \fi
      %
      % Start new element
      \stepcounter{lpsb@logicalElemID}%
      \stepcounter{lpsb@globalMCID}%
      \xdef\lpsb@current@logical@id{\thelpsb@logicalElemID}%
      \xdef\lpsb@current@tag@type{#1}%
      \global\@lpsb@in@tagtrue
      %
      % Insert BDC into content stream
      \lpsb@pdfliteralcmd{ /#1 << /MCID \thelpsb@globalMCID >> BDC }%
      %
      % Record to aux file with source line number for reading order
      \immediate\write\@auxout{%
        \string\lpsb@tag@data{\thelpsb@logicalElemID}{#1}{\thelpsb@globalMCID}{\thelpsb@currentPage}{\the\inputlineno}%
      }%
    \fi % @lpsb@active
  \fi % @typeset@protect
}

% Force-begin a tag even if \protect is not in typeset mode.
% Use sparingly for cases like floats where we need a P to resume.
% IMPORTANT: Skip in math mode to avoid spurious P tags in inline math
\newcommand{\lpsbTagBeginForce}[1]{%
  \if@lpsb@active
    % Skip in math mode - inline math ($...$) and display math ($$...$$, \[...\])
    % should not create P tags for subscripts/superscripts
    \ifmmode
      \lpsb@debug{lpsbTagBeginForce: SKIPPED in math mode}%
    \else
      % If already in a tag, save current state to stack
      \if@lpsb@in@tag
        \lpsb@push@tag{\lpsb@current@logical@id}{\lpsb@current@tag@type}%
        \lpsb@pdfliteralcmd{ EMC }%
      \fi
      % Start new element
      \stepcounter{lpsb@logicalElemID}%
      \stepcounter{lpsb@globalMCID}%
      \xdef\lpsb@current@logical@id{\thelpsb@logicalElemID}%
      \xdef\lpsb@current@tag@type{#1}%
      \global\@lpsb@in@tagtrue
      % Insert BDC into content stream
      \lpsb@pdfliteralcmd{ /#1 << /MCID \thelpsb@globalMCID >> BDC }%
      % Record to aux file with source line number for reading order
      \immediate\write\@auxout{%
        \string\lpsb@tag@data{\thelpsb@logicalElemID}{#1}{\thelpsb@globalMCID}{\thelpsb@currentPage}{\the\inputlineno}%
      }%
    \fi
  \fi
}

% End current tagged element
\newcommand{\lpsbTagEnd}{%
  % CRITICAL: Skip in non-typesetting contexts (moving arguments)
  \ifx\protect\@typeset@protect
    \if@lpsb@active
      \if@lpsb@in@tag
        \lpsb@pdfliteralcmd{ EMC }%
        %
        % Record end
        \immediate\write\@auxout{%
          \string\lpsb@tag@end{\lpsb@current@logical@id}{\thelpsb@currentPage}%
        }%
        %
        % Restore parent from stack if any
        \ifx\lpsb@tag@stack\empty
          \global\@lpsb@in@tagfalse
        \else
          \lpsb@pop@tag
          % Check if restoring a section heading that is now complete
          % If @nobreak is false, the heading text has been output and we should
          % NOT reopen the heading - start P instead.
          \lpsb@maybe@close@heading@or@reopen
        \fi
      \fi
    \fi
  \fi
}

% Force-end a tag even if \protect is not in typeset mode.
% Use sparingly for section headings that must not leak into body text.
\newcommand{\lpsbTagEndForce}{%
  \if@lpsb@active
    \if@lpsb@in@tag
      \lpsb@pdfliteralcmd{ EMC }%
      \immediate\write\@auxout{%
        \string\lpsb@tag@end{\lpsb@current@logical@id}{\thelpsb@currentPage}%
      }%
      \ifx\lpsb@tag@stack\empty
        \global\@lpsb@in@tagfalse
      \else
        \lpsb@pop@tag
        \lpsb@maybe@close@heading@or@reopen
      \fi
    \fi
  \fi
}

% Helper: Reopen parent tag normally (used when parent should continue)
% CRITICAL: Do NOT reopen Table/Figure containers
\newcommand{\lpsb@reopen@parent@tag}{%
  \lpsb@reopen@unless@container{\lpsb@current@logical@id}{\lpsb@current@tag@type}%
  \global\@lpsb@first@paratrue
}

% Helper: Check if restored parent is a completed section heading
% Section headings (H1-H6) should only continue if @nobreak is still true
% (meaning the heading text hasn't been output yet via everypar).
% Once @nobreak becomes false, the heading is complete and should not reopen.
\newcommand{\lpsb@maybe@close@heading@or@reopen}{%
  \edef\lpsb@tmp@restored{\lpsb@current@tag@type}%
  \def\lpsb@const@H{H}%
  % Check if tag type starts with "H" (H1, H2, H3, etc.)
  \expandafter\lpsb@check@heading@prefix\lpsb@tmp@restored\@nil
}
\def\lpsb@check@heading@prefix#1#2\@nil{%
  \def\lpsb@tmp@first{#1}%
  \ifx\lpsb@tmp@first\lpsb@const@H
    % Headings should not continue as parents for following text.
    % Always close H* and start a fresh P.
    \immediate\write\@auxout{%
      \string\lpsb@tag@end{\lpsb@current@logical@id}{\thelpsb@currentPage}%
    }%
    \global\@lpsb@in@sectionfalse
    % Start new P for content after the block element
    \lpsbTagBegin{P}%
    \global\@lpsb@first@paratrue
  \else
    % Not a heading - reopen parent normally
    \lpsb@reopen@parent@tag
  \fi
}

% End tagged element for FLOATS - closes tag but does NOT restore parent
% This is because floats appear at different positions than their source location,
% so restoring the parent P would cause it to incorrectly span the float's rendered content.
\newcommand{\lpsbTagEndFloat}{%
  % CRITICAL: Skip in non-typesetting contexts (moving arguments)
  \ifx\protect\@typeset@protect
    \if@lpsb@active
      \if@lpsb@in@tag
        \lpsb@pdfliteralcmd{ EMC }%
        % Record end
        \immediate\write\@auxout{%
          \string\lpsb@tag@end{\lpsb@current@logical@id}{\thelpsb@currentPage}%
        }%
        % Clear stack and mark not in tag - parent should NOT continue after float
        \gdef\lpsb@tag@stack{}%
        \global\@lpsb@in@tagfalse
      \fi
    \fi
  \fi
}

% Begin tagged element for FLOATS - starts tag WITHOUT pushing current to stack
% Use this inside @xfloat because the float box is placed asynchronously.
% We don't want to save/restore parent P since that would create incorrect nesting.
\newcommand{\lpsbTagBeginFloat}[1]{%
  % CRITICAL: Skip in non-typesetting contexts (moving arguments)
  \ifx\protect\@typeset@protect
    \if@lpsb@active
      % DON'T push current tag to stack - floats are self-contained
      % Just close current if any (but don't save it)
      \if@lpsb@in@tag
        \lpsb@pdfliteralcmd{ EMC }%
        % Record end of the parent tag that was open
        \immediate\write\@auxout{%
          \string\lpsb@tag@end{\lpsb@current@logical@id}{\thelpsb@currentPage}%
        }%
        % Clear stack since this P should not continue after float
        \gdef\lpsb@tag@stack{}%
      \fi
      % Start new element for the float
      \stepcounter{lpsb@logicalElemID}%
      \stepcounter{lpsb@globalMCID}%
      \xdef\lpsb@current@logical@id{\thelpsb@logicalElemID}%
      \xdef\lpsb@current@tag@type{#1}%
      \global\@lpsb@in@tagtrue
      % Insert BDC
      \lpsb@pdfliteralcmd{ /#1 << /MCID \thelpsb@globalMCID >> BDC }%
      % Record to aux file with source line number
      \immediate\write\@auxout{%
        \string\lpsb@tag@data{\thelpsb@logicalElemID}{#1}{\thelpsb@globalMCID}{\thelpsb@currentPage}{\the\inputlineno}%
      }%
    \fi
  \fi
}

% Inline tag (atom) - nested within current parent element
% For inline elements like Strong, Em, InlineMath, Reference
% Records parent element ID for proper nesting in output
% IMPORTANT: PDF MCIDs don't nest - must close parent, insert atom, reopen parent
% IMPORTANT: Use \long to handle arguments containing \par (paragraph breaks)
\long\def\lpsb@TagAtomImpl#1#2{%
  % CRITICAL: Skip in non-typesetting contexts (moving arguments)
  \ifx\protect\@typeset@protect
    \if@lpsb@active
      \if@lpsb@in@tag
        % Save parent info - use \xdef for GLOBAL expansion (survives groups)
        \xdef\lpsb@saved@parent@id{\lpsb@current@logical@id}%
        \xdef\lpsb@saved@parent@type{\lpsb@current@tag@type}%
        % Close parent MCID temporarily
        \lpsb@pdfliteralcmd{ EMC }%
      \else
        \gdef\lpsb@saved@parent@id{}%
        \gdef\lpsb@saved@parent@type{}%
      \fi
      % Insert atom element
      \stepcounter{lpsb@logicalElemID}%
      \stepcounter{lpsb@globalMCID}%
      \lpsb@pdfliteralcmd{ /#1 << /MCID \thelpsb@globalMCID >> BDC }%
      % Write atom record - capture values NOW before #2 executes
      \xdef\lpsb@atom@elemid{\thelpsb@logicalElemID}%
      \xdef\lpsb@atom@mcid{\thelpsb@globalMCID}%
      \xdef\lpsb@atom@page{\thelpsb@currentPage}%
      \immediate\write\@auxout{\string\lpsb@tag@atom{\lpsb@atom@elemid}{#1}{\lpsb@atom@mcid}{\lpsb@atom@page}{\lpsb@saved@parent@id}}%
      \def\lpsb@atom@type{#1}%
      \ifx\lpsb@atom@type\lpsb@Caption@const
        % Treat Caption as the current parent during its content, so InlineMath
        % reopens as Caption rather than the enclosing Figure/Table.
        \xdef\lpsb@saved@tag@type{\lpsb@current@tag@type}%
        \xdef\lpsb@saved@tag@id{\lpsb@current@logical@id}%
        \xdef\lpsb@current@tag@type{Caption}%
        \xdef\lpsb@current@logical@id{\lpsb@atom@elemid}%
        #2%
        \xdef\lpsb@current@tag@type{\lpsb@saved@tag@type}%
        \xdef\lpsb@current@logical@id{\lpsb@saved@tag@id}%
      \else
        #2%
      \fi
      \lpsb@pdfliteralcmd{ EMC }%
      % Reopen parent with continuation MCID (unless it's a container)
      \if@lpsb@in@tag
        \lpsb@reopen@unless@container{\lpsb@saved@parent@id}{\lpsb@saved@parent@type}%
      \fi
    \else
      #2%
    \fi
  \else
    #2%
  \fi
}

% Inline tag (atom) that ENDS the current parent element.
%
% This is only safe in special cases where the parent should not continue after
% the atom (e.g. wrapfig injecting a wrapped box via \everypar, where reopening
% the parent can leak into surrounding paragraph text).
%
% Semantics:
% - Close parent BDC (EMC)
% - Emit atom BDC/EMC and record parent_id
% - Record tag_end for the parent and clear state (do NOT reopen parent)
\long\def\lpsb@TagAtomImplEndParent#1#2{%
  % CRITICAL: Skip in non-typesetting contexts (moving arguments)
  \ifx\protect\@typeset@protect
    \if@lpsb@active
      \if@lpsb@in@tag
        % Save parent info
        \xdef\lpsb@saved@parent@id{\lpsb@current@logical@id}%
        \xdef\lpsb@saved@parent@type{\lpsb@current@tag@type}%
        % Close parent MCID
        \lpsb@pdfliteralcmd{ EMC }%
      \else
        \gdef\lpsb@saved@parent@id{}%
        \gdef\lpsb@saved@parent@type{}%
      \fi
      % Emit atom element
      \stepcounter{lpsb@logicalElemID}%
      \stepcounter{lpsb@globalMCID}%
      \lpsb@pdfliteralcmd{ /#1 << /MCID \thelpsb@globalMCID >> BDC }%
      % Write atom record (captures parent id even though parent ends here)
      \xdef\lpsb@atom@elemid{\thelpsb@logicalElemID}%
      \xdef\lpsb@atom@mcid{\thelpsb@globalMCID}%
      \xdef\lpsb@atom@page{\thelpsb@currentPage}%
      \immediate\write\@auxout{\string\lpsb@tag@atom{\lpsb@atom@elemid}{#1}{\lpsb@atom@mcid}{\lpsb@atom@page}{\lpsb@saved@parent@id}}%
      #2%
      \lpsb@pdfliteralcmd{ EMC }%
      % End the parent element HERE (do not reopen).
      \ifx\lpsb@saved@parent@id\@empty\else
        \immediate\write\@auxout{\string\lpsb@tag@end{\lpsb@saved@parent@id}{\thelpsb@currentPage}}%
      \fi
      % Clear state: parent ended, no active tag.
      \gdef\lpsb@tag@stack{}%
      \global\@lpsb@in@tagfalse
    \else
      #2%
    \fi
  \else
    #2%
  \fi
}

% Predefine Caption constant (used for float filtering in lpsbTagAtom)
\def\lpsb@Caption@const{Caption}%

% IMPORTANT: Use \protected to prevent expansion during argument parsing
% This is critical for compatibility with subfigure.sty and similar packages
% that expand their arguments. The \protected prefix (e-TeX) ensures this
% macro is not expanded in expansion-only contexts.
%
% Additionally, we add \ifx\protect\@typeset@protect guard AT THE TOP
% to ensure NO code (including \def) runs in non-typesetting contexts.
% Uses \long\protected\def to handle:
% 1. \long - arguments containing \par (paragraph breaks)
% 2. \protected - prevents expansion in moving arguments
\long\protected\def\lpsbTagAtom#1#2{%
  % CRITICAL: Skip in non-typesetting contexts (moving arguments, \setbox measurement)
  % This is the key fix for subfigure.sty compatibility - no code runs during expansion
  \ifx\protect\@typeset@protect
    % [MATH MODE GUARD] Skip tagging inside math mode
    % Reason: Inserting \pdfliteral (BDC/EMC markers) in math mode can:
    % 1. Break formula kerning and inter-character spacing
    % 2. Cause "Missing }" errors in complex math environments (align, gather)
    % 3. Create semantically invalid PDF structure (Strong inside Formula)
    \ifmmode
      % Math mode: just output content, no tagging
      #2%
    \else
      % Text mode: proceed with normal tagging logic
      % CRITICAL: Check pending P flags BEFORE checking @lpsb@in@tag
      % This handles atoms (e.g. citations) immediately after floats
      \if@lpsb@active
        \if@lpsb@in@tag\else
          \if@lpsb@P@pending@after@float
            \global\@lpsb@P@pending@after@floatfalse
            \lpsbTagBegin{P}%
            \global\@lpsb@first@parafalse
          \fi
        \fi
      \fi
      % Check if we're in a float and handle accordingly
      \def\lpsb@atom@type{#1}%
      \if@lpsb@in@float
        % In float: only tag Caption type, pass through others
        \ifx\lpsb@atom@type\lpsb@Caption@const
          \lpsb@TagAtomImpl{#1}{#2}%
        \else
          #2%
        \fi
      \else
        % Not in float: tag everything
        \lpsb@TagAtomImpl{#1}{#2}%
      \fi
    \fi
  \else
    % Not typesetting - just output content, no tagging
    #2%
  \fi
}

% NOTE: Legacy subfigure.sty compatibility is handled by the \@typeset@protect
% guard at the top of \lpsbTagAtom - no special detection or handling needed.

% Reference atom that also records citation keys (for downstream parent/child structure).
% #1 = cite key string (verbatim-ish), #2 = content (expands to printed citation)
% FIX: Use \protected\def to prevent expansion in moving arguments (ToC, aux)
\protected\def\lpsbTagReferenceAtom#1#2{%
  % CRITICAL: Skip in non-typesetting contexts (moving arguments)
  \ifx\protect\@typeset@protect
    \if@lpsb@active
      % CRITICAL: Check pending P flags BEFORE checking @lpsb@in@tag
      % This handles citations immediately after floats (which don't trigger everypar)
      \if@lpsb@in@tag\else
        \if@lpsb@P@pending@after@float
          \global\@lpsb@P@pending@after@floatfalse
          \lpsbTagBegin{P}%
          \global\@lpsb@first@parafalse
        \fi
      \fi
      \if@lpsb@in@tag
        % Inside a parent tag: emit proper Reference atom with EMC/BDC
        % CRITICAL: Use \edef with \the to get counter values, store in global macros
        \edef\lpsb@saved@parent@id{\lpsb@current@logical@id}%
        \edef\lpsb@saved@parent@type{\lpsb@current@tag@type}%
        \lpsb@pdfliteralcmd{ EMC }%
        \stepcounter{lpsb@logicalElemID}%
        \stepcounter{lpsb@globalMCID}%
        \lpsb@pdfliteralcmd{ /Reference << /MCID \thelpsb@globalMCID >> BDC }%
        \immediate\write\@auxout{%
          \string\lpsb@tag@atom{\thelpsb@logicalElemID}{Reference}{\thelpsb@globalMCID}{\thelpsb@currentPage}{\lpsb@saved@parent@id}%
        }%
        % Record keys (detokenized to keep aux robust)
        \begingroup
          \edef\lpsb@tmp@keys{\detokenize{#1}}%
          \immediate\write\@auxout{%
            \string\lpsb@refkey{\thelpsb@logicalElemID}{\lpsb@tmp@keys}%
          }%
        \endgroup
        #2%
        \lpsb@pdfliteralcmd{ EMC }%
        % Reopen parent tag (unless it's a container)
        \lpsb@reopen@unless@container{\lpsb@saved@parent@id}{\lpsb@saved@parent@type}%
      \else
        % NOT inside a parent tag: emit standalone Reference BDC/EMC
        % After Reference ends, start a new P for subsequent text
        \stepcounter{lpsb@logicalElemID}%
        \stepcounter{lpsb@globalMCID}%
        \lpsb@pdfliteralcmd{ /Reference << /MCID \thelpsb@globalMCID >> BDC }%
        \immediate\write\@auxout{%
          \string\lpsb@tag@atom{\thelpsb@logicalElemID}{Reference}{\thelpsb@globalMCID}{\thelpsb@currentPage}{}%
        }%
        \begingroup
          \edef\lpsb@tmp@keys{\detokenize{#1}}%
          \immediate\write\@auxout{%
            \string\lpsb@refkey{\thelpsb@logicalElemID}{\lpsb@tmp@keys}%
          }%
        \endgroup
        #2%
        \lpsb@pdfliteralcmd{ EMC }%
        % Start new P for subsequent text (prevents untagged content after Reference)
        \lpsbTagBegin{P}%
        \global\@lpsb@first@paratrue
      \fi
    \else
      #2%
    \fi
  \else
    #2%
  \fi
}

%% =========================================
%% 6. Automatic Hooks for Standard Elements  
%% =========================================

% --- Title → H (Document Title) ---
% Hook \maketitle to capture title region
\AtBeginDocument{%
  \@ifundefined{maketitle}{}{%
    % Disabled: \maketitle is one of the most class-specific and fragile macros.
    % Wrapping it has caused stack overflows in real papers.
    \typeout{LPSB-MCID Info: skipping maketitle hook}%
  }%
  % Hook \author to capture author info (supports optional parameter)
  \@ifundefined{author}{}{%
    \let\lpsb@orig@author\author
    \renewcommand{\author}{%
      \@ifnextchar[\lpsb@author@opt\lpsb@author@noopt
    }%
    % IMPORTANT: Use \long to handle args with \par (multi-line affiliations, \thanks, etc.)
    \long\def\lpsb@author@opt[#1]#2{%
      \stepcounter{lpsb@logicalElemID}%
      \immediate\write\@auxout{%
        \string\lpsb@meta{Author}{\thelpsb@logicalElemID}%
      }%
      \lpsb@orig@author[#1]{#2}%
    }%
    \long\def\lpsb@author@noopt#1{%
      \stepcounter{lpsb@logicalElemID}%
      \immediate\write\@auxout{%
        \string\lpsb@meta{Author}{\thelpsb@logicalElemID}%
      }%
      \lpsb@orig@author{#1}%
    }%
  }%
  % Hook \affiliation (common in many class files, supports optional parameter)
  \@ifundefined{affiliation}{}{%
    \let\lpsb@orig@affiliation\affiliation
    \renewcommand{\affiliation}{%
      \@ifnextchar[\lpsb@affiliation@opt\lpsb@affiliation@noopt
    }%
    \long\def\lpsb@affiliation@opt[#1]#2{%
      \stepcounter{lpsb@logicalElemID}%
      \immediate\write\@auxout{%
        \string\lpsb@meta{Affiliation}{\thelpsb@logicalElemID}%
      }%
      \lpsb@orig@affiliation[#1]{#2}%
    }%
    \long\def\lpsb@affiliation@noopt#1{%
      \stepcounter{lpsb@logicalElemID}%
      \immediate\write\@auxout{%
        \string\lpsb@meta{Affiliation}{\thelpsb@logicalElemID}%
      }%
      \lpsb@orig@affiliation{#1}%
    }%
  }%
  % Hook \institute (common in some classes like beamer, svjour, supports optional parameter)
  \@ifundefined{institute}{}{%
    \let\lpsb@orig@institute\institute
    \renewcommand{\institute}{%
      \@ifnextchar[\lpsb@institute@opt\lpsb@institute@noopt
    }%
    \long\def\lpsb@institute@opt[#1]#2{%
      \stepcounter{lpsb@logicalElemID}%
      \immediate\write\@auxout{%
        \string\lpsb@meta{Affiliation}{\thelpsb@logicalElemID}%
      }%
      \lpsb@orig@institute[#1]{#2}%
    }%
    \long\def\lpsb@institute@noopt#1{%
      \stepcounter{lpsb@logicalElemID}%
      \immediate\write\@auxout{%
        \string\lpsb@meta{Affiliation}{\thelpsb@logicalElemID}%
      }%
      \lpsb@orig@institute{#1}%
    }%
  }%
}

% --- Sections → H1, H2, H3, etc. ---
% Section titles only - H1 wraps title text, then P starts for content
%
% IMPORTANT: LaTeX may defer section headings to the next page if there's
% insufficient space. For display-style headings (not run-in), the title
% is stored in \@svsechd and output via \everypar on the NEXT paragraph.
%
% Strategy: We hook into the actual heading output mechanism:
% 1. When \section is called, we DON'T emit H1 immediately
% 2. We set a flag indicating "next everypar should be H1"
% 3. In everypar, if the flag is set, we emit H1 for that content
% 4. After the heading content, we close H1 and start P
%
% This ensures H1 wraps the actual heading text, even across page breaks.
%
% SKIP SECTION HOOKS for templates with incompatible section internals.
% These templates use complex section formatting that breaks when LPSB
% wraps \section/\subsection commands.

\newif\if@lpsb@in@section \@lpsb@in@sectionfalse
\newif\if@lpsb@section@pending \@lpsb@section@pendingfalse
% Flag: defer P tag creation after section heading until real content appears
% This prevents empty P tags when floats immediately follow \section{...}
\newif\if@lpsb@P@pending@after@section \@lpsb@P@pending@after@sectionfalse
% === EXTENDED DEFERRED P TAG PATTERN ===
% These flags implement the "don't rush to open tags" philosophy:
% Set a flag, wait until real text is typeset (\everypar), then decide.
%
% Phase 1: Display Math Protection
% Prevents empty P tags after equation/align environments
\newif\if@lpsb@P@pending@after@math \@lpsb@P@pending@after@mathfalse
%
% Phase 2: List Transition Protection  
% Prevents empty P tags after itemize/enumerate/description
\newif\if@lpsb@P@pending@after@list \@lpsb@P@pending@after@listfalse
\newif\if@lpsb@P@pending@after@float \@lpsb@P@pending@after@floatfalse
% Phase 2b: Protection flag for P tag just started before a float
% Prevents the P tag from being immediately closed by AtBeginEnvironment
\newif\if@lpsb@just@started@P@before@float \@lpsb@just@started@P@before@floatfalse
%
% Phase 3: Layout Environment Suppression
% Prevents spurious P tags inside center/minipage layout environments
\newif\if@lpsb@suppress@pending@trigger \@lpsb@suppress@pending@triggerfalse
%
% Phase 4: Block Tag Lock
% Prevents block-level tags (P, H1, etc.) inside atomic constructs (Caption, Footnote)
\newif\if@lpsb@lock@block@tags \@lpsb@lock@block@tagsfalse
\gdef\lpsb@pending@heading@level{H1}
\gdef\lpsb@current@section@id{}

% Flag to track if we need to emit heading tag at next everypar
\newif\if@lpsb@heading@deferred \@lpsb@heading@deferredfalse

% Flag to skip section hooks for incompatible templates
\newif\if@lpsb@skip@sectionhooks \@lpsb@skip@sectionhooksfalse

\AtBeginDocument{%
  % Check for incompatible section handling templates
  % smf (Société Mathématique de France) uses complex \smf@sf and \smf@eebox
  \def\lpsb@tmp@smf{smf}%
  \ifx\lpsb@detected@template\lpsb@tmp@smf\global\@lpsb@skip@sectionhookstrue\fi
  % smfart class files define \smf@sf
  \@ifundefined{smf@sf}{}{\global\@lpsb@skip@sectionhookstrue}%
  %
  \if@lpsb@skip@sectionhooks
    \typeout{LPSB-MCID Info: Skipping section hooks (incompatible package detected)}%
  \else
  %
  % Hook \@afterheading - this is called after \@xsect but BEFORE
  % the heading text is actually output (for display headings).
  % We use this to set up deferred heading tagging.
  %
  % CRITICAL: The original \@afterheading SETS \@nobreaktrue for display headings.
  % We must call it FIRST, then check the flag, otherwise we always get false!
  \@ifundefined{@afterheading}{}{%
    \let\lpsb@orig@@afterheading\@afterheading
    \def\@afterheading{%
      % Call original FIRST - it sets \@nobreaktrue and OVERWRITES \everypar
      \lpsb@orig@@afterheading
      % Now check if heading is deferred (display-style)
      % \@nobreak is true for display headings, false for run-in
      \if@nobreak
        % Display heading - title is already typeset; do NOT defer heading tag.
        \global\@lpsb@heading@deferredfalse
        % CRITICAL: LaTeX's @afterheading just OVERWROTE \everypar.
        % We must re-inject our P-pending logic into the NEW everypar.
        \if@lpsb@P@pending@after@section
          \edef\lpsb@saved@everypar{\the\everypar}%
          \everypar{%
            \lpsb@saved@everypar
            % After LaTeX's everypar content runs, handle our P tag
            \if@lpsb@P@pending@after@section
              \global\@lpsb@P@pending@after@sectionfalse
              \if@lpsb@in@tag\lpsbTagEnd\fi
              \lpsbTagBegin{P}%
              \global\@lpsb@first@parafalse
            \fi
          }%
        \fi
      \else
        % Run-in heading - title is still output via \everypar (\@svsechd).
        % Do NOT close the heading tag here; let our everypar hook close the H*
        % immediately after the run-in title is actually typeset, then start P.
        \if@lpsb@in@section
          \global\@lpsb@heading@deferredtrue
        \fi
      \fi
    }%
  }%
  %
  % Hook \@sect to capture when heading text is about to be stored
  % \@sect handles numbered sections: \@sect{name}{level}{indent}{beforeskip}{afterskip}{style}{*heading}
  \@ifundefined{@sect}{}{%
    \let\lpsb@orig@@sect\@sect
    \def\@sect#1#2#3#4#5#6[#7]#8{%
      \typeout{[LPSB-SECT] @sect CALLED: name=#1 level=#2 in@section=\if@lpsb@in@section TRUE\else FALSE\fi}%
      % Call original \@sect
      \lpsb@orig@@sect{#1}{#2}{#3}{#4}{#5}{#6}[#7]{#8}%
      % For display headings (after-skip > 0), close H* here to avoid leaking.
      \if@lpsb@in@section
        \typeout{[LPSB-SECT] @sect: in@section=TRUE, tempskipa=\the\@tempskipa}%
        \ifdim\@tempskipa>\z@
          \typeout{[LPSB-SECT] @sect: tempskipa>0, checking current@is@heading}%
          \lpsb@set@current@heading@flag
          \if@lpsb@current@is@heading
            \typeout{[LPSB-SECT] @sect: closing heading, setting P@pending=TRUE}%
            \lpsbTagEndForce
            \global\@lpsb@heading@deferredfalse
            \global\@lpsb@P@pending@after@sectiontrue
            \global\@lpsb@in@sectionfalse
            \global\@lpsb@heading@closedin@secttrue
          \else
            \typeout{[LPSB-SECT] @sect: current@is@heading=FALSE, NOT closing}%
          \fi
        \else
          \typeout{[LPSB-SECT] @sect: tempskipa<=0, skipping (run-in heading)}%
        \fi
      \else
        \typeout{[LPSB-SECT] @sect: in@section=FALSE, heading not tagged by LPSB}%
      \fi
    }%
  }%
  % CVPR: wrap number+title inside H tags via cvprsect overrides
  \def\lpsb@tmp@cvpr{cvpr}%
  \ifx\lpsb@detected@template\lpsb@tmp@cvpr
    \@ifundefined{cvprsect}{}{%
      \let\lpsb@orig@cvprsect\cvprsect
      \def\cvprsect#1{%
        \refstepcounter{section}%
        \edef\lpsb@cvpr@num{\thesection}%
        \lpsbTagBeginForce{\lpsb@H@section}%
        \cvprsection*{\lpsb@cvpr@num.\hskip 0.4em #1}%
        \lpsbTagEndForce
        \addcontentsline{toc}{section}{\protect\numberline{\lpsb@cvpr@num}#1}%
