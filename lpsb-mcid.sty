%% lpsb-mcid.sty - MCID-based Tagged PDF for LPSB
%% Complete implementation with all semantic element types
%% TL2016 compatible (uses \pdfliteral and atbegshi)
%%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{lpsb-mcid}[2026/01/11 LPSB MCID-based Tagging]

\RequirePackage{atbegshi}
\RequirePackage{etoolbox}

\makeatletter

%% =========================================
%% 1. Package Options and Engine Detection
%% =========================================
\RequirePackage{iftex}

% Package option: pass-one (enables positioning collection mode)
\DeclareOption{pass-one}{%
  \AtEndOfPackage{\global\@lpsb@pass@onetrue}%
}
\ProcessOptions\relax

% LuaTeX uses different primitive names
\ifLuaTeX
  \let\lpsb@pdfliteral\pdfextension
  \def\lpsb@pdfliteralcmd#1{\pdfextension literal direct {#1}}
\else
  \def\lpsb@pdfliteralcmd#1{\pdfliteral direct {#1}}
\fi

%% =========================================
%% 1b. Aux File Command Definitions (No-ops)
%% =========================================
% These commands are written to aux file. Define them as no-ops
% BEFORE aux is read (during second pass) to prevent visible output.
\providecommand{\lpsb@tag@data}[4]{}
\providecommand{\lpsb@tag@atom}[5]{}
\providecommand{\lpsb@tag@end}[2]{}
\providecommand{\lpsb@mcid@cont}[3]{}
\providecommand{\lpsb@summary}[3]{}
\providecommand{\lpsb@meta}[2]{}
\providecommand{\lpsb@refkey}[2]{} % {elem_id}{cite_keys}

% Two-pass compilation aux commands
\providecommand{\lpsb@pass@float}[4]{}   % {float_id}{source_page}{rendered_page}{type}
\providecommand{\lpsb@pass@pagebreak}[2]{} % {page}{active_elem_id}
\providecommand{\lpsb@pass@elempage}[3]{}  % {elem_id}{start_page}{end_page}

%% =========================================
%% 1c. Two-Pass Compilation Options
%% =========================================
% Pass 1: Collect positioning information only (no BDC emission)
% Pass 2: Use collected info to emit precise BDC markers (default when pass-one data exists)

\newif\if@lpsb@pass@one \@lpsb@pass@onefalse  % Currently in pass-one mode
\newif\if@lpsb@has@pass@data \@lpsb@has@pass@datafalse  % Pass-one data exists in aux

% Counter for float tracking in pass-one
\newcounter{lpsb@floatID}
\setcounter{lpsb@floatID}{0}

% Storage for pass-one float placement data (read from aux)
% Format: \lpsb@float@page@{float_id} -> rendered_page
\newcommand{\lpsb@record@float@page}[2]{%
  \expandafter\gdef\csname lpsb@float@page@#1\endcsname{#2}%
}
\newcommand{\lpsb@get@float@page}[1]{%
  \ifcsname lpsb@float@page@#1\endcsname
    \csname lpsb@float@page@#1\endcsname
  \else
    0%
  \fi
}

% Process pass-one aux commands when aux is read
\AtBeginDocument{%
  % Re-define aux readers to actually store the data
  \renewcommand{\lpsb@pass@float}[4]{%
    \global\@lpsb@has@pass@datatrue
    \lpsb@record@float@page{#1}{#3}% Store: float_id -> rendered_page
  }%
}

% Record document layout mode (single/two column) to aux file
% This allows post-processing to use definitive layout info instead of heuristics
\AtBeginDocument{%
  \if@twocolumn
    \immediate\write\@auxout{\string\lpsb@layout{twocolumn}}%
  \else
    \immediate\write\@auxout{\string\lpsb@layout{onecolumn}}%
  \fi
}

% Track layout switches mid-document (e.g., \onecolumn in appendix)
% Record: \lpsb@layout@switch{mode}{page}
\let\lpsb@orig@onecolumn\onecolumn
\renewcommand{\onecolumn}{%
  \lpsb@orig@onecolumn
  \protected@write\@auxout{}{\string\lpsb@layout@switch{onecolumn}{\thepage}}%
}
% IMPORTANT:
% - \twocolumn has an optional argument: \twocolumn[<top material>]
% - Many classes call it inside \maketitle.
% If we wrap it without preserving the optional-arg form, the delimiter tokens
% '[' and ']' can leak into the PDF as visible glyphs.
%
% Also, other packages/classes may redefine \twocolumn in \AtBeginDocument.
% To avoid capturing an early definition, we (re)install our wrapper at the
% end of \begin{document} initialization (when available).
%
\newif\if@lpsb@twocolumn@wrapped \@lpsb@twocolumn@wrappedfalse
\newcommand{\lpsb@orig@twocolumn}{}%
\protected\def\lpsb@twocolumn@wrapper{%
  \@ifnextchar[\lpsb@twocolumn@wrapper@opt\lpsb@twocolumn@wrapper@noopt
}
\def\lpsb@twocolumn@wrapper@opt[#1]{%
  \lpsb@orig@twocolumn[#1]%
  \protected@write\@auxout{}{\string\lpsb@layout@switch{twocolumn}{\thepage}}%
}
\def\lpsb@twocolumn@wrapper@noopt{%
  \lpsb@orig@twocolumn
  \protected@write\@auxout{}{\string\lpsb@layout@switch{twocolumn}{\thepage}}%
}
% Install twocolumn wrapper - but skip for classes with complex twocolumn usage
% IEEEtran uses \twocolumn[{\IEEEquantizevspace{...}}] which conflicts with
% our \@ifnextchar[ based wrapper.
\def\lpsb@install@twocolumn@wrapper{%
  % Check if IEEEtran class is loaded by looking for its internal dimension
  % (@IEEEtrantmpdimenA is defined early in IEEEtran.cls)
  \@ifundefined{@IEEEtrantmpdimenA}{%
    % Not IEEEtran - safe to install full wrapper
    \ifx\twocolumn\lpsb@twocolumn@wrapper
    \else
      \let\lpsb@orig@twocolumn\twocolumn
      \let\twocolumn\lpsb@twocolumn@wrapper
      \global\@lpsb@twocolumn@wrappedtrue
    \fi
  }{%
    % IEEEtran detected - use pure passthrough to avoid conflicts
    \typeout{LPSB-MCID Info: IEEEtran detected - using passthrough twocolumn wrapper}%
    \let\lpsb@orig@twocolumn\twocolumn
    \def\twocolumn{%
      \lpsb@orig@twocolumn
      % Note: layout switch recording skipped for IEEEtran compatibility
    }%
  }%
}
\lpsb@install@twocolumn@wrapper
% Re-install late to capture final \twocolumn definition (TL2020+).
\@ifundefined{AddToHook}{%
  \AtBeginDocument{\lpsb@install@twocolumn@wrapper}%
}{%
  \AddToHook{begindocument/end}{\lpsb@install@twocolumn@wrapper}%
}

% Define aux readers (no-op, just for parsing by Python)
\newcommand{\lpsb@layout}[1]{}
\newcommand{\lpsb@layout@switch}[2]{}


% Smart float handling: check if float lands on same page
% If we have pass-one data and float goes to a DIFFERENT page,
% we don't need to close the current P tag (since rendered content won't be interrupted)
\newif\if@lpsb@float@same@page \@lpsb@float@same@pagetrue  % Default: assume same page

\newcommand{\lpsb@check@float@page}{%
  % Get the float ID that will be assigned
  \edef\lpsb@next@float@id{\number\numexpr\value{lpsb@floatID}+1\relax}%
  %
  \if@lpsb@has@pass@data
    % We have pass-one data - check where this float lands
    \edef\lpsb@float@target@page{\lpsb@get@float@page{\lpsb@next@float@id}}%
    \ifnum\lpsb@float@target@page=0
      % No data for this float - assume same page (conservative)
      \global\@lpsb@float@same@pagetrue
    \else
      \ifnum\lpsb@float@target@page=\value{lpsb@currentPage}
        % Float lands on current page - need to close P
        \global\@lpsb@float@same@pagetrue
      \else
        % Float lands on different page - DON'T close P
        \global\@lpsb@float@same@pagefalse
      \fi
    \fi
  \else
    % No pass-one data - use conservative behavior (close P)
    \global\@lpsb@float@same@pagetrue
  \fi
}

%% =========================================
%% 2. Core MCID State Management
%% =========================================
\newif\if@lpsb@in@tag \@lpsb@in@tagfalse
\newif\if@lpsb@active  \@lpsb@activefalse

\newcounter{lpsb@globalMCID}        % Global MCID across all elements
\newcounter{lpsb@logicalElemID}     % Logical element ID
\newcounter{lpsb@currentPage}       % Current page number
\setcounter{lpsb@currentPage}{1}

% Current tag state
\gdef\lpsb@current@logical@id{0}
\gdef\lpsb@current@tag@type{P}

% Tag stack for nesting (stores: id,type,id,type,...)
\gdef\lpsb@tag@stack{}

%% =========================================
%% 3. Stack Operations for Nested Tags
%% =========================================
\newcommand{\lpsb@push@tag}[2]{%
  % Push id,type onto stack
  \xdef\lpsb@tag@stack{#1,#2,\lpsb@tag@stack}%
}

\newcommand{\lpsb@pop@tag}{%
  % Pop top id,type from stack and restore
  \expandafter\lpsb@do@pop\lpsb@tag@stack\@nil
}
\def\lpsb@do@pop#1,#2,#3\@nil{%
  \xdef\lpsb@current@logical@id{#1}%
  \xdef\lpsb@current@tag@type{#2}%
  \xdef\lpsb@tag@stack{#3}%
}

%% =========================================
%% 4. Page Boundary Handlers (Cross-page)
%% =========================================
% Flag to disable tagging during shipout (for header/footer)
\newif\if@lpsb@in@shipout \@lpsb@in@shipoutfalse
% Flag to defer BDC insertion until first real content
\newif\if@lpsb@needs@reopen \@lpsb@needs@reopenfalse
% Store tag info for cross-page reopening
\gdef\lpsb@reopen@type{}
\gdef\lpsb@reopen@id{}

\AtBeginShipout{%
  \global\@lpsb@in@shipouttrue  % Disable tagging during shipout
  \if@lpsb@active
    \stepcounter{lpsb@currentPage}%  % Increment page counter at each shipout
    \if@lpsb@in@tag
      % Close current tag before page ships
      \lpsb@pdfliteralcmd{ EMC }%
      % Store info for reopening and mark flag
      \xdef\lpsb@reopen@type{\lpsb@current@tag@type}%
      \xdef\lpsb@reopen@id{\lpsb@current@logical@id}%
      \global\@lpsb@needs@reopentrue
    \fi
  \fi
}

% After shipout completes, reopen the tag for continued content
\AtBeginShipoutNext{%
  \global\@lpsb@in@shipoutfalse
  \if@lpsb@active
    \if@lpsb@needs@reopen
      \global\@lpsb@needs@reopenfalse
      % Floats (Figure/Table) are self-contained - don't reopen them
      % Check @lpsb@in@float flag which is set during float environments
      \if@lpsb@in@float
        % We're inside a float - use P for any subsequent content
        \xdef\lpsb@actual@reopen@type{P}%
      \else
        \xdef\lpsb@actual@reopen@type{\lpsb@reopen@type}%
      \fi
      % Immediately reopen tag
      \stepcounter{lpsb@globalMCID}%
      \lpsb@pdfliteralcmd{ /\lpsb@actual@reopen@type\space << /MCID \thelpsb@globalMCID >> BDC }%
      \immediate\write\@auxout{%
        \string\lpsb@mcid@cont{\lpsb@reopen@id}{\thelpsb@globalMCID}{\thelpsb@currentPage}%
      }%
      % CRITICAL: Set @lpsb@in@tag to true and restore current tag state
      \global\@lpsb@in@tagtrue
      \xdef\lpsb@current@logical@id{\lpsb@reopen@id}%
      \xdef\lpsb@current@tag@type{\lpsb@actual@reopen@type}%
    \fi
  \fi
}

% --- Header/Footer: Mark as Artifact (non-structural content) ---
% Page numbers, running heads, etc. should be marked as /Artifact (PDF/UA standard)
% not as P. This is cleaner than trying to suppress MCIDs entirely.

% Helper to wrap fancyhdr internals with Artifact
\newcommand{\lpsb@wrap@fancyhdr@artifact}{%
  \@ifundefined{f@nch@head}{}{%
    \@ifundefined{lpsb@orig@fnchhead}{%
      % Wrap \f@nch@head with Artifact BMC/EMC
      \let\lpsb@orig@fnchhead\f@nch@head
      \long\def\f@nch@head##1##2##3##4##5{%
        \lpsb@pdfliteralcmd{ /Artifact BMC }%
        \lpsb@orig@fnchhead{##1}{##2}{##3}{##4}{##5}%
        \lpsb@pdfliteralcmd{ EMC }%
      }%
    }{}%
  }%
  \@ifundefined{f@nch@foot}{}{%
    \@ifundefined{lpsb@orig@fnchfoot}{%
      % Wrap \f@nch@foot with Artifact BMC/EMC
      \let\lpsb@orig@fnchfoot\f@nch@foot
      \long\def\f@nch@foot##1##2##3##4##5{%
        \lpsb@pdfliteralcmd{ /Artifact BMC }%
        \lpsb@orig@fnchfoot{##1}{##2}{##3}{##4}{##5}%
        \lpsb@pdfliteralcmd{ EMC }%
      }%
    }{}%
  }%
}

% Try to wrap fancyhdr NOW (if already loaded before lpsb-mcid)
\@ifpackageloaded{fancyhdr}{\lpsb@wrap@fancyhdr@artifact}{}

% Also wrap at begin document (for case where fancyhdr loaded AFTER lpsb-mcid)
\AtBeginDocument{%
  \@ifpackageloaded{fancyhdr}{\lpsb@wrap@fancyhdr@artifact}{}%
  % Also wrap @oddfoot etc. for non-fancy pagestyles or non-fancyhdr documents
  \lpsb@wrap@headfoot@artifact
}

% Fallback: wrap standard LaTeX header/footer commands with Artifact
\newcommand{\lpsb@wrap@headfoot@artifact}{%
  \@ifundefined{@oddfoot}{}{%
    \let\lpsb@orig@oddfoot\@oddfoot
    \def\@oddfoot{\lpsb@pdfliteralcmd{ /Artifact BMC }\lpsb@orig@oddfoot\lpsb@pdfliteralcmd{ EMC }}%
  }%
  \@ifundefined{@evenfoot}{}{%
    \let\lpsb@orig@evenfoot\@evenfoot
    \def\@evenfoot{\lpsb@pdfliteralcmd{ /Artifact BMC }\lpsb@orig@evenfoot\lpsb@pdfliteralcmd{ EMC }}%
  }%
  \@ifundefined{@oddhead}{}{%
    \let\lpsb@orig@oddhead\@oddhead
    \def\@oddhead{\lpsb@pdfliteralcmd{ /Artifact BMC }\lpsb@orig@oddhead\lpsb@pdfliteralcmd{ EMC }}%
  }%
  \@ifundefined{@evenhead}{}{%
    \let\lpsb@orig@evenhead\@evenhead
    \def\@evenhead{\lpsb@pdfliteralcmd{ /Artifact BMC }\lpsb@orig@evenhead\lpsb@pdfliteralcmd{ EMC }}%
  }%
}

%% =========================================
%% 5. Core API: Tag Begin/End
%% =========================================

% Begin a new tagged element
% #1 = tag type (P, H1, H2, Abstract, Figure, etc.)
\newcommand{\lpsbTagBegin}[1]{%
  \if@lpsb@active
    % If already in a tag, save current state to stack
    \if@lpsb@in@tag
      \lpsb@push@tag{\lpsb@current@logical@id}{\lpsb@current@tag@type}%
      \lpsb@pdfliteralcmd{ EMC }%
    \fi
    %
    % Start new element
    \stepcounter{lpsb@logicalElemID}%
    \stepcounter{lpsb@globalMCID}%
    \xdef\lpsb@current@logical@id{\thelpsb@logicalElemID}%
    \xdef\lpsb@current@tag@type{#1}%
    \global\@lpsb@in@tagtrue
    %
    % Insert BDC into content stream
    \lpsb@pdfliteralcmd{ /#1 << /MCID \thelpsb@globalMCID >> BDC }%
    %
    % Record to aux file
    \immediate\write\@auxout{%
      \string\lpsb@tag@data{\thelpsb@logicalElemID}{#1}{\thelpsb@globalMCID}{\thelpsb@currentPage}%
    }%
  \fi % @lpsb@active
}

% End current tagged element
\newcommand{\lpsbTagEnd}{%
  \if@lpsb@active
    \if@lpsb@in@tag
      \lpsb@pdfliteralcmd{ EMC }%
      %
      % Record end
      \immediate\write\@auxout{%
        \string\lpsb@tag@end{\lpsb@current@logical@id}{\thelpsb@currentPage}%
      }%
      %
      % Restore parent from stack if any
      \ifx\lpsb@tag@stack\empty
        \global\@lpsb@in@tagfalse
      \else
        \lpsb@pop@tag
        % Reopen parent tag with new MCID
        \stepcounter{lpsb@globalMCID}%
        \lpsb@pdfliteralcmd{ /\lpsb@current@tag@type\space << /MCID \thelpsb@globalMCID >> BDC }%
        \immediate\write\@auxout{%
          \string\lpsb@mcid@cont{\lpsb@current@logical@id}{\thelpsb@globalMCID}{\thelpsb@currentPage}%
        }%
        % Prevent everypar from cycling the restored P
        \global\@lpsb@first@paratrue
      \fi
    \fi
  \fi
}

% End tagged element for FLOATS - closes tag but does NOT restore parent
% This is because floats appear at different positions than their source location,
% so restoring the parent P would cause it to incorrectly span the float's rendered content.
\newcommand{\lpsbTagEndFloat}{%
  \if@lpsb@active
    \if@lpsb@in@tag
      \lpsb@pdfliteralcmd{ EMC }%
      % Record end
      \immediate\write\@auxout{%
        \string\lpsb@tag@end{\lpsb@current@logical@id}{\thelpsb@currentPage}%
      }%
      % Clear stack and mark not in tag - parent should NOT continue after float
      \gdef\lpsb@tag@stack{}%
      \global\@lpsb@in@tagfalse
    \fi
  \fi
}

% Begin tagged element for FLOATS - starts tag WITHOUT pushing current to stack
% Use this inside @xfloat because the float box is placed asynchronously.
% We don't want to save/restore parent P since that would create incorrect nesting.
\newcommand{\lpsbTagBeginFloat}[1]{%
  \if@lpsb@active
    % DON'T push current tag to stack - floats are self-contained
    % Just close current if any (but don't save it)
    \if@lpsb@in@tag
      \lpsb@pdfliteralcmd{ EMC }%
      % Record end of the parent tag that was open
      \immediate\write\@auxout{%
        \string\lpsb@tag@end{\lpsb@current@logical@id}{\thelpsb@currentPage}%
      }%
      % Clear stack since this P should not continue after float
      \gdef\lpsb@tag@stack{}%
    \fi
    % Start new element for the float
    \stepcounter{lpsb@logicalElemID}%
    \stepcounter{lpsb@globalMCID}%
    \xdef\lpsb@current@logical@id{\thelpsb@logicalElemID}%
    \xdef\lpsb@current@tag@type{#1}%
    \global\@lpsb@in@tagtrue
    % Insert BDC
    \lpsb@pdfliteralcmd{ /#1 << /MCID \thelpsb@globalMCID >> BDC }%
    % Record to aux file
    \immediate\write\@auxout{%
      \string\lpsb@tag@data{\thelpsb@logicalElemID}{#1}{\thelpsb@globalMCID}{\thelpsb@currentPage}%
    }%
  \fi
}

% Inline tag (atom) - nested within current parent element
% For inline elements like Strong, Em, InlineMath, Reference
% Records parent element ID for proper nesting in output
% IMPORTANT: PDF MCIDs don't nest - must close parent, insert atom, reopen parent
\newcommand{\lpsb@TagAtomImpl}[2]{%
  \if@lpsb@active
    \if@lpsb@in@tag
      % Save parent info - use \protected@edef to avoid expansion issues in subfigure
      \protected@edef\lpsb@saved@parent@id{\lpsb@current@logical@id}%
      \protected@edef\lpsb@saved@parent@type{\lpsb@current@tag@type}%
      % Close parent MCID temporarily
      \lpsb@pdfliteralcmd{ EMC }%
    \else
      \def\lpsb@saved@parent@id{}%
      \def\lpsb@saved@parent@type{}%
    \fi
    % Insert atom element
    \stepcounter{lpsb@logicalElemID}%
    \stepcounter{lpsb@globalMCID}%
    \lpsb@pdfliteralcmd{ /#1 << /MCID \thelpsb@globalMCID >> BDC }%
    \immediate\write\@auxout{%
      \string\lpsb@tag@atom{\thelpsb@logicalElemID}{#1}{\thelpsb@globalMCID}{\thelpsb@currentPage}{\lpsb@saved@parent@id}%
    }%
    #2%
    \lpsb@pdfliteralcmd{ EMC }%
    % Reopen parent with continuation MCID
    \if@lpsb@in@tag
      \stepcounter{lpsb@globalMCID}%
      \lpsb@pdfliteralcmd{ /\lpsb@saved@parent@type\space << /MCID \thelpsb@globalMCID >> BDC }%
      \immediate\write\@auxout{%
        \string\lpsb@mcid@cont{\lpsb@saved@parent@id}{\thelpsb@globalMCID}{\thelpsb@currentPage}%
      }%
    \fi
  \else
    #2%
  \fi
}

% IMPORTANT: Use \protected to prevent expansion during argument parsing
% This is critical for compatibility with subfigure.sty and similar packages
% that expand their arguments. The \protected prefix (e-TeX) ensures this
% macro is not expanded in expansion-only contexts.
\protected\def\lpsbTagAtom#1#2{%
  % Check if we're in a float and handle accordingly
  \def\lpsb@Caption@const{Caption}%
  \def\lpsb@atom@type{#1}%
  \if@lpsb@in@float
    % In float: only tag Caption type, pass through others
    \ifx\lpsb@atom@type\lpsb@Caption@const
      \lpsb@TagAtomImpl{#1}{#2}%
    \else
      #2%
    \fi
  \else
    % Not in float: tag everything
    \lpsb@TagAtomImpl{#1}{#2}%
  \fi
}

% CRITICAL: Disable atom tagging entirely when legacy subfigure.sty is loaded.
% Even with \protected\def, the \def commands inside lpsbTagAtom cause
% layout issues when the macro is executed inside subfigure's internal context.
% The only safe solution is to make it a pure passthrough.
%
% We use AtEndOfPackage to run this check immediately after lpsb-mcid.sty
% is fully loaded (but before document content). Additionally, we use
% AtBeginDocument as a fallback in case subfigure is loaded after us.

% Flag to track if subfigure was detected
\newif\if@lpsb@subfigure@detected

% Primary check: run at end of our package (catches subfigure loaded before us)
\AtEndOfPackage{%
  \@ifpackageloaded{subfigure}{%
    \typeout{LPSB-MCID Info: Legacy subfigure.sty detected (at package end) - disabling atom tagging}%
    \@lpsb@subfigure@detectedtrue
    \protected\def\lpsbTagAtom#1#2{#2}%
  }{}%
}

% Secondary check: AtBeginDocument (catches subfigure loaded after us)
\AtBeginDocument{%
  \if@lpsb@subfigure@detected\else
    \@ifpackageloaded{subfigure}{%
      \typeout{LPSB-MCID Info: Legacy subfigure.sty detected (at begin doc) - disabling atom tagging}%
      \protected\def\lpsbTagAtom#1#2{#2}%
    }{}%
  \fi
}

% Reference atom that also records citation keys (for downstream parent/child structure).
% #1 = cite key string (verbatim-ish), #2 = content (expands to printed citation)
\newcommand{\lpsbTagReferenceAtom}[2]{%
  \if@lpsb@active
    \if@lpsb@in@tag
      % Inside a parent tag: emit proper Reference atom with EMC/BDC
      \edef\lpsb@saved@parent@id{\lpsb@current@logical@id}%
      \edef\lpsb@saved@parent@type{\lpsb@current@tag@type}%
      \lpsb@pdfliteralcmd{ EMC }%
      \stepcounter{lpsb@logicalElemID}%
      \stepcounter{lpsb@globalMCID}%
      \lpsb@pdfliteralcmd{ /Reference << /MCID \thelpsb@globalMCID >> BDC }%
      \immediate\write\@auxout{%
        \string\lpsb@tag@atom{\thelpsb@logicalElemID}{Reference}{\thelpsb@globalMCID}{\thelpsb@currentPage}{\lpsb@saved@parent@id}%
      }%
      % Record keys (detokenized to keep aux robust)
      \begingroup
        \edef\lpsb@tmp@keys{\detokenize{#1}}%
        \immediate\write\@auxout{%
          \string\lpsb@refkey{\thelpsb@logicalElemID}{\lpsb@tmp@keys}%
        }%
      \endgroup
      #2%
      \lpsb@pdfliteralcmd{ EMC }%
      % Reopen parent tag
      \stepcounter{lpsb@globalMCID}%
      \lpsb@pdfliteralcmd{ /\lpsb@saved@parent@type\space << /MCID \thelpsb@globalMCID >> BDC }%
      \immediate\write\@auxout{%
        \string\lpsb@mcid@cont{\lpsb@saved@parent@id}{\thelpsb@globalMCID}{\thelpsb@currentPage}%
      }%
    \else
      % NOT inside a parent tag: emit standalone Reference BDC/EMC
      % After Reference ends, start a new P for subsequent text
      \stepcounter{lpsb@logicalElemID}%
      \stepcounter{lpsb@globalMCID}%
      \lpsb@pdfliteralcmd{ /Reference << /MCID \thelpsb@globalMCID >> BDC }%
      \immediate\write\@auxout{%
        \string\lpsb@tag@atom{\thelpsb@logicalElemID}{Reference}{\thelpsb@globalMCID}{\thelpsb@currentPage}{}%
      }%
      \begingroup
        \edef\lpsb@tmp@keys{\detokenize{#1}}%
        \immediate\write\@auxout{%
          \string\lpsb@refkey{\thelpsb@logicalElemID}{\lpsb@tmp@keys}%
        }%
      \endgroup
      #2%
      \lpsb@pdfliteralcmd{ EMC }%
      % Start new P for subsequent text (prevents untagged content after Reference)
      \lpsbTagBegin{P}%
      \global\@lpsb@first@paratrue
    \fi
  \else
    #2%
  \fi
}

%% =========================================
%% 6. Automatic Hooks for Standard Elements  
%% =========================================

% --- Title → H (Document Title) ---
% Hook \maketitle to capture title region
\AtBeginDocument{%
  \@ifundefined{maketitle}{}{%
    % Disabled: \maketitle is one of the most class-specific and fragile macros.
    % Wrapping it has caused stack overflows in real papers.
    \typeout{LPSB-MCID Info: skipping maketitle hook}%
  }%
  % Hook \author to capture author info
  \@ifundefined{author}{}{%
    \let\lpsb@orig@author\author
    \renewcommand{\author}[1]{%
      \stepcounter{lpsb@logicalElemID}%
      \immediate\write\@auxout{%
        \string\lpsb@meta{Author}{\thelpsb@logicalElemID}%
      }%
      \lpsb@orig@author{#1}%
    }%
  }%
  % Hook \affiliation (common in many class files)
  \@ifundefined{affiliation}{}{%
    \let\lpsb@orig@affiliation\affiliation
    \renewcommand{\affiliation}[1]{%
      \stepcounter{lpsb@logicalElemID}%
      \immediate\write\@auxout{%
        \string\lpsb@meta{Affiliation}{\thelpsb@logicalElemID}%
      }%
      \lpsb@orig@affiliation{#1}%
    }%
  }%
  % Hook \institute (common in some classes like beamer, svjour)
  \@ifundefined{institute}{}{%
    \let\lpsb@orig@institute\institute
    \renewcommand{\institute}[1]{%
      \stepcounter{lpsb@logicalElemID}%
      \immediate\write\@auxout{%
        \string\lpsb@meta{Affiliation}{\thelpsb@logicalElemID}%
      }%
      \lpsb@orig@institute{#1}%
    }%
  }%
}

% --- Sections → H1, H2, H3, etc. ---
% Section titles only - H1 wraps title text, then P starts for content
% Simple approach: wrap the entire section command and use \aftergroup

\AtBeginDocument{%
  % Hook \section
  \@ifundefined{section}{}{%
    \let\lpsb@orig@section\section
    \renewcommand{\section}[1][]{%
      \lpsbTagEnd
      \lpsbTagBegin{H1}%
      \def\lpsb@sec@opt{#1}%
      \ifx\lpsb@sec@opt\@empty
        \expandafter\lpsb@do@section
      \else
        \expandafter\lpsb@do@section@opt
      \fi
    }%
    \newcommand{\lpsb@do@section}[1]{%
      \lpsb@orig@section{#1}%
      \lpsbTagEnd\lpsbTagBegin{P}%
    }%
    \newcommand{\lpsb@do@section@opt}[1]{%
      \expandafter\lpsb@orig@section\expandafter[\lpsb@sec@opt]{#1}%
      \lpsbTagEnd\lpsbTagBegin{P}%
    }%
  }%
  % Hook \subsection
  \@ifundefined{subsection}{}{%
    \let\lpsb@orig@subsec\subsection
    \renewcommand{\subsection}[1][]{%
      \lpsbTagEnd
      \lpsbTagBegin{H2}%
      \def\lpsb@subsec@opt{#1}%
      \ifx\lpsb@subsec@opt\@empty
        \expandafter\lpsb@do@subsec
      \else
        \expandafter\lpsb@do@subsec@opt
      \fi
    }%
    \newcommand{\lpsb@do@subsec}[1]{%
      \lpsb@orig@subsec{#1}%
      \lpsbTagEnd\lpsbTagBegin{P}%
    }%
    \newcommand{\lpsb@do@subsec@opt}[1]{%
      \expandafter\lpsb@orig@subsec\expandafter[\lpsb@subsec@opt]{#1}%
      \lpsbTagEnd\lpsbTagBegin{P}%
    }%
  }%
  % Hook \@ssect for starred sections (\section*, \subsection*)
  % \@ssect{indent}{beforeskip}{afterskip}{style}{title}
  % 
  % KNOWN LIMITATION: LaTeX's section formatting outputs content in stages.
  % For starred sections, the title text may be output AFTER \@ssect returns
  % (via \@svsechd in \@xsect). This causes split tagging where H1 contains
  % only the section number area (e.g., "6*") and the title goes to following P.
  % 
  % This is a LaTeX kernel limitation. Use post-processing to merge split headings.
  % See: script/fix_split_headings.py
  \newif\if@lpsb@in@section \@lpsb@in@sectionfalse
  \@ifundefined{@ssect}{}{%
    \let\lpsb@orig@@ssect\@ssect
    \def\@ssect#1#2#3#4#5{%
      \lpsbTagEnd
      \global\@lpsb@in@sectiontrue
      % Determine heading level based on indent (rough heuristic)
      \ifdim#1<1em
        \lpsbTagBegin{H1}%
      \else
        \lpsbTagBegin{H2}%
      \fi
      \lpsb@orig@@ssect{#1}{#2}{#3}{#4}{#5}%
      \lpsbTagEnd
      \lpsbTagBegin{P}%
      \global\@lpsb@in@sectionfalse
      \global\@lpsb@first@paratrue
    }%
  }%
}

% --- Paragraph → P ---
% Use everyhook package for robust \everypar hooking (TL2016+)
% \PushPostHook{par} survives even when other packages reset \everypar

% Float environment flag (must be defined before everypar hook)
\newif\if@lpsb@in@float \@lpsb@in@floatfalse

% Flag for everyhook availability
\newif\if@lpsb@everyhook@available \@lpsb@everyhook@availablefalse

% Define first-para flag unconditionally (needed in both paths)
\newif\if@lpsb@first@para \@lpsb@first@paratrue
\def\lpsb@P@const{P}%

% Paragraph detection logic - defined separately to avoid \IfFileExists parsing issues
% with nested \if..\fi conditionals

% Inner paragraph hook - the core logic, extracted for conditional reuse
\newcommand{\lpsb@para@hook@inner}{%
  % Filter: skip section formatting (to prevent H1/H2 from being interrupted)
  \if@lpsb@in@section\else
  % Natural paragraph detected
  \if@lpsb@in@tag
    % Already in a tag
    \if@lpsb@first@para
      % First para after structure - don't CYCLE P
      \global\@lpsb@first@parafalse
    \else
      % if it's P, cycle it
      \ifx\lpsb@current@tag@type\lpsb@P@const
        \lpsbTagEnd
        \lpsbTagBegin{P}%
      \fi
    \fi
  \else
    % NOT in any tag - ALWAYS start new P (after float or other structure)
    \lpsbTagBegin{P}%
    \global\@lpsb@first@parafalse
  \fi
  \fi % @lpsb@in@section
}

\newcommand{\lpsb@para@hook}{%
  % FIRST: Handle cross-page tag continuation
  \if@lpsb@needs@reopen
    \global\@lpsb@needs@reopenfalse
    \if@lpsb@in@tag
      % Reopen tag on new page with new MCID
      \stepcounter{lpsb@globalMCID}%
      \lpsb@pdfliteralcmd{ /\lpsb@current@tag@type\space << /MCID \thelpsb@globalMCID >> BDC }%
      \immediate\write\@auxout{%
        \string\lpsb@mcid@cont{\lpsb@current@logical@id}{\thelpsb@globalMCID}{\thelpsb@currentPage}%
      }%
    \fi
  \fi
  % Normal paragraph handling
  \if@lpsb@in@shipout\else  % Skip during shipout (header/footer)
  \if@lpsb@active
    % Filter: skip list items (@listdepth > 0)
    \ifnum\@listdepth=0
      % Filter: skip minipage
      \if@minipage\else
        % Filter floats when legacy subfigure.sty is loaded
        % (subfigure.sty's argument parsing can trigger everypar incorrectly)
        % Note: Without subfigure.sty, we do NOT filter by @lpsb@in@float because
        % float boxes may contain paragraph text that needs proper P tagging.
        \if@lpsb@subfigure@detected
          \if@lpsb@in@float
            % Skip - subfigure + float = no paragraph tagging
          \else
            % subfigure loaded but not in float - proceed with paragraph detection
            \lpsb@para@hook@inner
          \fi
        \else
          % No subfigure - always proceed with paragraph detection
          \lpsb@para@hook@inner
        \fi
      \fi % @minipage
    \fi % @listdepth
  \fi % @lpsb@active
  \fi % @lpsb@in@shipout
}%

% Set up paragraph hook using the best available method:
% 1. Modern LaTeX hook system (AddToHook{para/begin}) - TL2020+
% 2. Fallback to everyhook package if available - TL2016+
% 3. Warning if neither is available

\newif\if@lpsb@parahook@installed \@lpsb@parahook@installedfalse

% Try modern LaTeX hook system first (available in TL2020+)
\@ifundefined{AddToHook}{%
  % AddToHook not available, try everyhook
  \IfFileExists{everyhook.sty}{%
    \RequirePackage{everyhook}%
    \global\@lpsb@everyhook@availabletrue
    \PushPostHook{par}{\lpsb@para@hook}%
    \global\@lpsb@parahook@installedtrue
  }{%
    \PackageWarning{lpsb-mcid}{Neither AddToHook nor everyhook.sty available. Paragraph detection disabled.}%
  }%
}{%
  % Use modern AddToHook (more reliable, kernel-managed)
  \AddToHook{para/begin}{\lpsb@para@hook}%
  \global\@lpsb@parahook@installedtrue
}

\AtBeginDocument{%
  % Activate tagging, then start first P.
  \global\@lpsb@activetrue
  \lpsbTagBegin{P}%
}

% --- Abstract → P with abstract annotation ---
% Use P tag for PDF 2.0 compatibility, but record it as Abstract in aux
% NOTE: Disabled abstract hooks entirely because many conference templates
% (ICLR, NeurIPS, CVPR, etc.) redefine abstract using \begin{quote} internally,
% which causes stack overflow when etoolbox patches the environment.
% Abstract content will still be captured as P tags.
\newif\if@lpsb@in@abstract \@lpsb@in@abstractfalse

% We skip hooking abstract environment here because it conflicts with
% many conference templates. The abstract content is still captured as normal P.
% Future: add per-class detection to enable selectively.

% --- Lists → L, LI ---
% Note: These hooks must check @lpsb@active because they can fire
% before \begin{document} (e.g., inside conference style file definitions)
\AtBeginEnvironment{itemize}{%
  \if@lpsb@active
    \lpsbTagEnd
    \lpsbTagBegin{L}%
  \fi
}
\AtEndEnvironment{itemize}{%
  \if@lpsb@active
    \lpsbTagEnd
    \lpsbTagBegin{P}% Start P after list
  \fi
}

\AtBeginEnvironment{enumerate}{%
  \if@lpsb@active
    \lpsbTagEnd
    \lpsbTagBegin{L}%
  \fi
}
\AtEndEnvironment{enumerate}{%
  \if@lpsb@active
    \lpsbTagEnd
    \lpsbTagBegin{P}%
  \fi
}

\AtBeginEnvironment{description}{%
  \if@lpsb@active
    \lpsbTagEnd
    \lpsbTagBegin{L}%
  \fi
}
\AtEndEnvironment{description}{%
  \if@lpsb@active
    \lpsbTagEnd
    \lpsbTagBegin{P}%  % Resume P after description list
  \fi
}

% --- Bibliography → BibList ---
% Bibliography environment gets special treatment.
% The \bibsection command (from natbib) uses \section* internally,
% which will be handled by the @ssect hook. We just need to suppress
% the empty P tags that appear during transition.
\newif\if@lpsb@in@bib \@lpsb@in@bibfalse

\AtBeginDocument{%
  % Hook \bibsection to start BibList AFTER the heading is output
  % NOTE: Do NOT add H1 here - @ssect hook already handles that!
  \@ifundefined{bibsection}{}{%
    \let\lpsb@orig@bibsection\bibsection
    \renewcommand{\bibsection}{%
      % Call original - @ssect will handle the H1 tagging
      \lpsb@orig@bibsection
      % NOW start BibList after heading is done
      \if@lpsb@active
        \lpsbTagEnd  % Close whateverP is open
        \lpsbTagBegin{BibList}%
      \fi
    }%
  }%
}

\AtBeginEnvironment{thebibliography}{%
  \global\@lpsb@in@bibtrue
  % Don't start BibList here - bibsection hook handles it after heading
}
\AtEndEnvironment{thebibliography}{%
  \global\@lpsb@in@bibfalse
  \if@lpsb@active
    \lpsbTagEnd
    \lpsbTagBegin{P}%
  \fi
}

% Hook \item for LI - but NOT inside Abstract
% MUST handle optional argument correctly: \item[label] vs \item
% CRITICAL: Check \@listdepth to ensure we're inside a real list environment
\AtBeginDocument{%
  \let\lpsb@orig@item\item
  \def\item{%
    \@ifnextchar[\lpsb@item@opt\lpsb@item@noopt
  }%
  \def\lpsb@item@opt[#1]{%
    \if@lpsb@in@abstract
      \lpsb@orig@item[#1]%
    \else\if@lpsb@in@bib
      % Inside bibliography: use BibEntry tag
      \lpsbTagEnd
      \lpsbTagBegin{BibEntry}%
      \lpsb@orig@item[#1]%
    \else
      % Only tag as LI if we're actually inside a list (\@listdepth > 0)
      \ifnum\@listdepth>0
        \lpsbTagEnd
        \lpsbTagBegin{LI}%
      \fi
      \lpsb@orig@item[#1]%
    \fi\fi
  }%
  \def\lpsb@item@noopt{%
    \if@lpsb@in@abstract
      \lpsb@orig@item
    \else\if@lpsb@in@bib
      \lpsbTagEnd
      \lpsbTagBegin{BibEntry}%
      \lpsb@orig@item
    \else
      % Only tag as LI if we're actually inside a list (\@listdepth > 0)
      \ifnum\@listdepth>0
        \lpsbTagEnd
        \lpsbTagBegin{LI}%
      \fi
      \lpsb@orig@item
    \fi\fi
  }%
}


% --- Figure/Table → Figure/Table ---
% SOLUTION: Patch \@xfloat and \end@float to inject BDC/EMC INSIDE the float box.
% This ensures markers appear at the actual placement position, not source location.

% Save float type for use in BDC
\newcommand{\lpsb@current@float@type}{}

\AtBeginDocument{%
  % Patch \@xfloat - this is called after the float box is opened
  \let\lpsb@orig@@xfloat\@xfloat
  \def\@xfloat#1[#2]{%
    \lpsb@orig@@xfloat{#1}[#2]%
    % Now we're INSIDE the float's vbox - BDC here will be in the float!
    \global\@lpsb@in@floattrue
    %
    % Two-pass: assign float ID and record source page
    \stepcounter{lpsb@floatID}%
    \edef\lpsb@this@float@id{\thelpsb@floatID}%
    \edef\lpsb@this@float@source@page{\thelpsb@currentPage}%
    %
    % Store float ID in the box for shipout tracking
    % We use \special or \pdfliteral to embed a marker
    \if@lpsb@pass@one
      % In pass-one, record the float ID and source page
      % The rendered page will be recorded at shipout
      \immediate\write\@auxout{%
        \string\lpsb@pass@float{\lpsb@this@float@id}{\lpsb@this@float@source@page}{\thelpsb@currentPage}{#1}%
      }%
    \fi
    %
    \if@lpsb@active
      % Skip BDC emission in pass-one mode
      \if@lpsb@pass@one\else
        \def\lpsb@temp@a{#1}%
        \def\lpsb@temp@figure{figure}%
        \def\lpsb@temp@table{table}%
        \ifx\lpsb@temp@a\lpsb@temp@figure
          \gdef\lpsb@current@float@type{Figure}%
          % In pass-2 with data: check if float lands on different page
          \if@lpsb@has@pass@data
            % We have positioning data - use smart tagging
            \lpsbTagBeginFloat{Figure}%
          \else
            % No pass data - use original behavior
            \lpsbTagBeginFloat{Figure}%
          \fi
        \else\ifx\lpsb@temp@a\lpsb@temp@table
          \gdef\lpsb@current@float@type{Table}%
          \if@lpsb@has@pass@data
            \lpsbTagBeginFloat{Table}%
          \else
            \lpsbTagBeginFloat{Table}%
          \fi
        \else
          % Unknown float type
          \gdef\lpsb@current@float@type{Figure}%
          \lpsbTagBeginFloat{Figure}%
        \fi\fi
      \fi
    \fi
  }%
  %
  % Patch \end@float - close tag before box ends
  \let\lpsb@orig@endfloat\end@float
  \def\end@float{%
    \if@lpsb@active
      \if@lpsb@pass@one\else
        \lpsbTagEndFloat  % EMC inside float box, don't restore parent
      \fi
      % Set first_para flag to prevent everypar from cycling P immediately
      \global\@lpsb@first@paratrue
    \fi
    \global\@lpsb@in@floatfalse
    \lpsb@orig@endfloat
  }%
  %
  % Double-column float variants
  \@ifundefined{@dbfloat}{}{%
    \let\lpsb@orig@@dbfloat\@dbfloat
    \def\@dbfloat#1{%
      \lpsb@orig@@dbfloat{#1}%
      \global\@lpsb@in@floattrue
      \if@lpsb@active
        \def\lpsb@temp@a{#1}%
        \def\lpsb@temp@figure{figure}%
        \def\lpsb@temp@table{table}%
        \ifx\lpsb@temp@a\lpsb@temp@figure
          \gdef\lpsb@current@float@type{Figure}%
          \lpsbTagBeginFloat{Figure}%
        \else\ifx\lpsb@temp@a\lpsb@temp@table
          \gdef\lpsb@current@float@type{Table}%
          \lpsbTagBeginFloat{Table}%
        \else
          \gdef\lpsb@current@float@type{Figure}%
          \lpsbTagBeginFloat{Figure}%
        \fi\fi
      \fi
    }%
  }%
  \@ifundefined{end@dblfloat}{}{%
    \let\lpsb@orig@enddblfloat\end@dblfloat
    \def\end@dblfloat{%
      \if@lpsb@active
        \lpsbTagEndFloat  % EMC inside float box, don't restore parent
        % Set first_para flag to prevent everypar from cycling P immediately
        \global\@lpsb@first@paratrue
      \fi
      \global\@lpsb@in@floatfalse
      \lpsb@orig@enddblfloat
    }%
  }%
}

% At source location: CLOSE current P before float definition starts
% This is critical because P tags at source location would otherwise
% span across the async float placement, incorrectly wrapping content
% that appears after the float in the rendered PDF.
%
% SMART LOGIC (Pass 2 with pass-one data):
% - If float lands on SAME page: close P (conservative, correct)
% - If float lands on DIFFERENT page: DON'T close P (the P content is not interrupted)
\AtBeginEnvironment{figure}{%
  \if@lpsb@active\if@lpsb@in@tag%
    \lpsb@check@float@page  % Check where this float will land
    \if@lpsb@float@same@page
      % Float on same page - close P to avoid incorrect nesting
      \lpsb@pdfliteralcmd{ EMC }%
      \immediate\write\@auxout{\string\lpsb@tag@end{\lpsb@current@logical@id}{\thelpsb@currentPage}}%
      \gdef\lpsb@tag@stack{}%
      \global\@lpsb@in@tagfalse%
    \fi
  \fi\fi%
}
\AtBeginEnvironment{figure*}{%
  \if@lpsb@active\if@lpsb@in@tag%
    \lpsb@check@float@page
    \if@lpsb@float@same@page
      \lpsb@pdfliteralcmd{ EMC }%
      \immediate\write\@auxout{\string\lpsb@tag@end{\lpsb@current@logical@id}{\thelpsb@currentPage}}%
      \gdef\lpsb@tag@stack{}%
      \global\@lpsb@in@tagfalse%
    \fi
  \fi\fi%
}
\AtBeginEnvironment{table}{%
  \if@lpsb@active\if@lpsb@in@tag%
    \lpsb@check@float@page
    \if@lpsb@float@same@page
      \lpsb@pdfliteralcmd{ EMC }%
      \immediate\write\@auxout{\string\lpsb@tag@end{\lpsb@current@logical@id}{\thelpsb@currentPage}}%
      \gdef\lpsb@tag@stack{}%
      \global\@lpsb@in@tagfalse%
    \fi
  \fi\fi%
}
\AtBeginEnvironment{table*}{%
  \if@lpsb@active\if@lpsb@in@tag%
    \lpsb@check@float@page
    \if@lpsb@float@same@page
      \lpsb@pdfliteralcmd{ EMC }%
      \immediate\write\@auxout{\string\lpsb@tag@end{\lpsb@current@logical@id}{\thelpsb@currentPage}}%
      \gdef\lpsb@tag@stack{}%
      \global\@lpsb@in@tagfalse%
    \fi
  \fi\fi%
}

% At source location: start P after float definition if not already in a tag
% Note: end@float handles the EMC+tag closure at shipout time, not here.
% Here we ensure a P is open for content after the \end{figure} in source.
\AtEndEnvironment{figure}{\if@lpsb@active\if@lpsb@in@tag\else\lpsbTagBegin{P}\fi\global\@lpsb@first@paratrue\fi}
\AtEndEnvironment{figure*}{\if@lpsb@active\if@lpsb@in@tag\else\lpsbTagBegin{P}\fi\global\@lpsb@first@paratrue\fi}
\AtEndEnvironment{table}{\if@lpsb@active\if@lpsb@in@tag\else\lpsbTagBegin{P}\fi\global\@lpsb@first@paratrue\fi}
\AtEndEnvironment{table*}{\if@lpsb@active\if@lpsb@in@tag\else\lpsbTagBegin{P}\fi\global\@lpsb@first@paratrue\fi}
% --- Caption → Caption ---
% Hook \caption and \subcaption as Caption atoms.
%
% Rationale: patching caption internals (\caption@makecaption / \@makecaption) is
% fragile and can miss some code paths. Wrapping the user-level macros is much
% more reliable, and also gives us a parent_id (Figure/Table) via lpsbTagAtom.
\newcommand{\lpsb@patch@subfigure@caption}{%
  % subcaption's subfigure environment often rebinds \caption locally; that can
  % bypass our global \caption wrapper. Re-wrap the *current* \caption inside
  % the subfigure group so subcaptions get tagged as Caption atoms.
  \@ifundefined{caption}{}{%
    \let\lpsb@orig@subfig@caption\caption
    \renewcommand{\caption}{\@ifnextchar[\lpsb@subfigcap@opt\lpsb@subfigcap@noopt}%
    \def\lpsb@subfigcap@opt[##1]##2{\lpsbTagAtom{Caption}{\lpsb@orig@subfig@caption[##1]{##2}}}%
    \def\lpsb@subfigcap@noopt##1{\lpsbTagAtom{Caption}{\lpsb@orig@subfig@caption{##1}}}%
  }%
}
\AtBeginDocument{%
  % Skip caption hooks if legacy subfigure.sty is loaded (causes expansion conflicts)
  \@ifpackageloaded{subfigure}{%
    % Legacy subfigure.sty detected - it redefines \caption internally
    % and has incompatible expansion behavior with our hooks.
    % Caption tagging is sacrificed for compilation compatibility.
    \PackageInfo{lpsb-mcid}{Legacy subfigure.sty detected - skipping caption hooks}%
  }{%
    % Safe to hook captions (subcaption package or no subfigure package)
    \@ifundefined{caption}{}{%
      \let\lpsb@orig@caption\caption
      \renewcommand{\caption}{\@ifnextchar[\lpsb@cap@opt\lpsb@cap@noopt}%
      \def\lpsb@cap@opt[#1]#2{\lpsbTagAtom{Caption}{\lpsb@orig@caption[#1]{#2}}}%
      \def\lpsb@cap@noopt#1{\lpsbTagAtom{Caption}{\lpsb@orig@caption{#1}}}%
    }%
    % subcaption package: \subcaption has same optional-arg pattern.
    \@ifundefined{subcaption}{}{%
      \let\lpsb@orig@subcaption\subcaption
      \renewcommand{\subcaption}{\@ifnextchar[\lpsb@subcap@opt\lpsb@subcap@noopt}%
      \def\lpsb@subcap@opt[#1]#2{\lpsbTagAtom{Caption}{\lpsb@orig@subcaption[#1]{#2}}}%
      \def\lpsb@subcap@noopt#1{\lpsbTagAtom{Caption}{\lpsb@orig@subcaption{#1}}}%
    }%
    % subcaption package: subfigure environment can override \caption locally.
    % Hook the environment start and re-wrap \caption inside its group.
    \@ifundefined{subfigure}{}{%
      \AtBeginEnvironment{subfigure}{\lpsb@patch@subfigure@caption}%
    }%
    % subcaption: setcaptionsubtype triggers \caption@subtypehook; use that as a
    % reliable place to re-wrap \caption for sub-captions (works even if subcaption
    % swaps \caption behind our back).
    \@ifundefined{caption@subtypehook}{}{%
      \g@addto@macro\caption@subtypehook{\lpsb@patch@subfigure@caption}%
    }%
  }%
}

% --- Footnote → Note ---
% Hook \footnote to tag as Note (PDF/UA)
\AtBeginDocument{%
  \@ifundefined{footnote}{}{%
    \let\lpsb@orig@footnote\footnote
    \renewcommand{\footnote}[2][]{%
      \def\lpsb@fn@opt{#1}%
      \ifx\lpsb@fn@opt\@empty
        \lpsbTagAtom{Note}{\lpsb@orig@footnote{#2}}%
      \else
        \lpsbTagAtom{Note}{\lpsb@orig@footnote[#1]{#2}}%
      \fi
    }%
  }%
  % Many papers use split footnotes: \footnotemark + \footnotetext.
  \@ifundefined{footnotemark}{}{%
    \let\lpsb@orig@footnotemark\footnotemark
    \renewcommand{\footnotemark}{%
      \@ifnextchar[\lpsb@fnmark@opt\lpsb@fnmark@noopt
    }%
    \def\lpsb@fnmark@opt[#1]{\lpsbTagAtom{Note}{\lpsb@orig@footnotemark[#1]}}%
    \def\lpsb@fnmark@noopt{\lpsbTagAtom{Note}{\lpsb@orig@footnotemark}}%
  }%
  \@ifundefined{footnotetext}{}{%
    \let\lpsb@orig@footnotetext\footnotetext
    \renewcommand{\footnotetext}{%
      \@ifnextchar[\lpsb@fntext@opt\lpsb@fntext@noopt
    }%
    \def\lpsb@fntext@opt[#1]#2{\lpsbTagAtom{Note}{\lpsb@orig@footnotetext[#1]{#2}}}%
    \def\lpsb@fntext@noopt#1{\lpsbTagAtom{Note}{\lpsb@orig@footnotetext{#1}}}%
  }%
  % Standard \footnote uses internal \@footnotemark/\@footnotetext; hook those too so the
  % footnote text itself gets tagged (not just the mark in the paragraph).
  %
  % CRITICAL: \@footnotetext uses \insert\footins{...} which is async (like floats).
  % The content is rendered at page bottom, not when the command is called.
  % To properly tag, we hook \@makefntext which formats the actual footnote content.
  %
  % Footnote structure in PDF/UA:
  % - Footnote mark (in paragraph): tagged via \footnote -> \lpsbTagAtom{Note}{mark}
  % - Footnote text (at page bottom): tagged via \@makefntext hook
  %
  \newif\if@lpsb@in@footnote \@lpsb@in@footnotefalse
  %
  \@ifundefined{@makefntext}{}{%
    \let\lpsb@orig@@makefntext\@makefntext
    \long\def\@makefntext#1{%
      \if@lpsb@active
        % Open Note tag for footnote text, close current P if any
        \lpsbTagEnd
        \lpsbTagBegin{Note}%
        \global\@lpsb@in@footnotetrue
        \lpsb@orig@@makefntext{#1}%
        \lpsbTagEnd
        % Restore P for any content after footnote
        \lpsbTagBegin{P}%
        \global\@lpsb@in@footnotefalse
      \else
        \lpsb@orig@@makefntext{#1}%
      \fi
    }%
  }%
  % Also hook minipage footnotes
  \@ifundefined{@mpfootnotetext}{}{%
    \let\lpsb@orig@@mpfootnotetext\@mpfootnotetext
    \long\def\@mpfootnotetext#1{%
      % minipage footnotes use similar mechanism
      \lpsb@orig@@mpfootnotetext{#1}%
    }%
  }%
}

% --- URL/Hyperlinks → Link ---
% Tag \url and \href as Link (PDF/UA) for accessibility
\AtBeginDocument{%
  % Hook \url from url.sty
  \@ifundefined{url}{}{%
    \let\lpsb@orig@url\url
    \renewcommand{\url}[1]{%
      \lpsbTagAtom{Link}{\lpsb@orig@url{#1}}%
    }%
  }%
  % Hook \href from hyperref.sty
  \@ifundefined{href}{}{%
    \let\lpsb@orig@href\href
    \renewcommand{\href}[2]{%
      \lpsbTagAtom{Link}{\lpsb@orig@href{#1}{#2}}%
    }%
  }%
  % Hook \nolinkurl from hyperref.sty
  \@ifundefined{nolinkurl}{}{%
    \let\lpsb@orig@nolinkurl\nolinkurl
    \renewcommand{\nolinkurl}[1]{%
      \lpsbTagAtom{Link}{\lpsb@orig@nolinkurl{#1}}%
    }%
  }%
}

% --- Emphasis → Em/Strong ---
% Use atom tags for inline formatting
\let\lpsb@orig@emph\emph
\renewcommand{\emph}[1]{%
  \lpsbTagAtom{Em}{\lpsb@orig@emph{#1}}%
}

\let\lpsb@orig@textbf\textbf
\renewcommand{\textbf}[1]{%
  \lpsbTagAtom{Strong}{\lpsb@orig@textbf{#1}}%
}

\let\lpsb@orig@textit\textit
\renewcommand{\textit}[1]{%
  \lpsbTagAtom{Em}{\lpsb@orig@textit{#1}}%
}

% --- Declarative Font Commands (DISABLED) ---
% Old-style font switches like \bf/\it/\em are heavily used by class files in
% fragile places (notably \maketitle). Hooking them reliably without breaking
% real-world documents is hard; it also isn't required for inline-math tagging.
%
% Keep tagging on the semantic commands (\textbf/\textit/\emph) only.

% --- Math → Formula/InlineMath ---
% Inline math tagging:
% Do NOT play games with catcodes (making '$' active breaks real papers).
% Instead, use TeX's math entry hooks and close the tag using \aftergroup,
% which runs at the end of the math group.
\newif\if@lpsb@in@inline@math \@lpsb@in@inline@mathfalse
\gdef\lpsb@math@parent@id{}
\gdef\lpsb@math@parent@type{}

\newcommand{\lpsb@inline@math@begin}{%
  \if@lpsb@active
    \if@lpsb@in@shipout\else
      \if@lpsb@in@tag
        \xdef\lpsb@math@parent@id{\lpsb@current@logical@id}%
        \xdef\lpsb@math@parent@type{\lpsb@current@tag@type}%
        % Close parent MCID temporarily
        \lpsb@pdfliteralcmd{ EMC }%
      \else
        \gdef\lpsb@math@parent@id{}%
        \gdef\lpsb@math@parent@type{}%
      \fi
      % Start InlineMath atom
      \stepcounter{lpsb@logicalElemID}%
      \stepcounter{lpsb@globalMCID}%
      \lpsb@pdfliteralcmd{ /InlineMath << /MCID \thelpsb@globalMCID >> BDC }%
      \immediate\write\@auxout{%
        \string\lpsb@tag@atom{\thelpsb@logicalElemID}{InlineMath}{\thelpsb@globalMCID}{\thelpsb@currentPage}{\lpsb@math@parent@id}%
      }%
      \global\@lpsb@in@inline@mathtrue
    \fi
  \fi
}

\newcommand{\lpsb@inline@math@end}{%
  \if@lpsb@active
    \if@lpsb@in@inline@math
      % Close InlineMath MCID
      \lpsb@pdfliteralcmd{ EMC }%
      \global\@lpsb@in@inline@mathfalse
      % Reopen parent MCID with a continuation MCID
      \ifx\lpsb@math@parent@id\@empty\else
        \stepcounter{lpsb@globalMCID}%
        \lpsb@pdfliteralcmd{ /\lpsb@math@parent@type\space << /MCID \thelpsb@globalMCID >> BDC }%
        \immediate\write\@auxout{%
          \string\lpsb@mcid@cont{\lpsb@math@parent@id}{\thelpsb@globalMCID}{\thelpsb@currentPage}%
        }%
      \fi
    \fi
  \fi
}

% Reliable inline-math hook: \(...\) is a macro pair, unlike $...$.
% If sources are preprocessed to use \(...\), this gives stable inline-math tagging
% without touching catcodes or low-level math internals.
\AtBeginDocument{%
  \@ifundefined{(}{}{%
    \let\lpsb@orig@lparen\(
    \let\lpsb@orig@rparen\)
    \def\({\lpsb@inline@math@begin\lpsb@orig@lparen}%
    \def\){\lpsb@orig@rparen\lpsb@inline@math@end}%
  }%
}

% Hook equation/align environments instead (more reliable)
\AtBeginEnvironment{equation}{%
  \lpsbTagEnd
  \lpsbTagBegin{Formula}%
}
% IMPORTANT:
% etoolbox's \AtEndEnvironment runs at the START of \end{equation}, which is
% too early for amsmath: equation numbers/tags may be typeset during \endequation.
% Use \AfterEndEnvironment when available; otherwise patch \endequation.
\@ifundefined{AfterEndEnvironment}{%
  \AtBeginDocument{%
    \@ifundefined{endequation}{}{%
      \apptocmd{\endequation}{%
        \lpsbTagEnd
        \lpsbTagBegin{P}%
      }{}{}%
    }%
  }%
}{%
  \AfterEndEnvironment{equation}{%
    \lpsbTagEnd
    \lpsbTagBegin{P}%
  }%
}

% --- Citations → Reference ---
% Keep citations as atom tags so they don't split /P into separate logical elements.
% NOTE: natbib supports up to two optional args: \citep[pre][post]{key}.
\AtBeginDocument{%
  \@ifpackageloaded{natbib}{%
    \typeout{LPSB-MCID Info: natbib detected - tagging citep/citet/cite as Reference atoms}%
    %
    % NOTE: natbib also provides \citealt/\citealp etc. We intentionally do NOT
    % wrap those here yet; they are used in moving arguments in real templates.
    %
    \@ifundefined{citep}{}{%
      \let\lpsb@orig@citep\citep
      \def\citep{\@ifnextchar[\lpsb@citep@optA\lpsb@citep@noopt}%
      \def\lpsb@citep@optA[#1]{\@ifnextchar[\lpsb@citep@optB[#1]\lpsb@citep@oneopt[#1]}%
      \def\lpsb@citep@optB[#1][#2]#3{\lpsbTagReferenceAtom{#3}{\lpsb@orig@citep[#1][#2]{#3}}}%
      \def\lpsb@citep@oneopt[#1]#2{\lpsbTagReferenceAtom{#2}{\lpsb@orig@citep[#1]{#2}}}%
      \def\lpsb@citep@noopt#1{\lpsbTagReferenceAtom{#1}{\lpsb@orig@citep{#1}}}%
    }%
    \@ifundefined{citet}{}{%
      \let\lpsb@orig@citet\citet
      \def\citet{\@ifnextchar[\lpsb@citet@optA\lpsb@citet@noopt}%
      \def\lpsb@citet@optA[#1]{\@ifnextchar[\lpsb@citet@optB[#1]\lpsb@citet@oneopt[#1]}%
      \def\lpsb@citet@optB[#1][#2]#3{\lpsbTagReferenceAtom{#3}{\lpsb@orig@citet[#1][#2]{#3}}}%
      \def\lpsb@citet@oneopt[#1]#2{\lpsbTagReferenceAtom{#2}{\lpsb@orig@citet[#1]{#2}}}%
      \def\lpsb@citet@noopt#1{\lpsbTagReferenceAtom{#1}{\lpsb@orig@citet{#1}}}%
    }%
    \@ifundefined{cite}{}{%
      \let\lpsb@orig@cite\cite
      \def\cite{\@ifnextchar[\lpsb@cite@optA\lpsb@cite@noopt}%
      \def\lpsb@cite@optA[#1]{\@ifnextchar[\lpsb@cite@optB[#1]\lpsb@cite@oneopt[#1]}%
      \def\lpsb@cite@optB[#1][#2]#3{\lpsbTagReferenceAtom{#3}{\lpsb@orig@cite[#1][#2]{#3}}}%
      \def\lpsb@cite@oneopt[#1]#2{\lpsbTagReferenceAtom{#2}{\lpsb@orig@cite[#1]{#2}}}%
      \def\lpsb@cite@noopt#1{\lpsbTagReferenceAtom{#1}{\lpsb@orig@cite{#1}}}%
    }%
  }{%
    % Non-natbib: hook standard \cite as an atom.
    \@ifundefined{cite}{}{%
      \typeout{LPSB-MCID Info: tagging cite as Reference atom}%
      \let\lpsb@orig@cite\cite
      \def\cite{\@ifnextchar[\lpsb@cite@opt\lpsb@cite@noopt}%
      \def\lpsb@cite@opt[#1]#2{\lpsbTagReferenceAtom{#2}{\lpsb@orig@cite[#1]{#2}}}%
      \def\lpsb@cite@noopt#1{\lpsbTagReferenceAtom{#1}{\lpsb@orig@cite{#1}}}%
    }%
  }%
}

% --- Hyperlinks → Link ---
\AtBeginDocument{%
  % Disabled: \href is heavily patched by hyperref and is used in moving arguments.
  % Wrapping it breaks real documents. Keep it untouched.
}

%% =========================================
%% 7. Document Setup and Finalization
%% =========================================
\AtEndDocument{%
  \lpsbTagEnd
  % Enable PDF MarkInfo
  \ifLuaTeX
    \pdfextension catalog{/MarkInfo << /Marked true >>}%
  \else
    \pdfcatalog{/MarkInfo << /Marked true >>}%
  \fi
  % Write summary
  \immediate\write\@auxout{%
    \string\lpsb@summary{\thelpsb@logicalElemID}{\thelpsb@globalMCID}{\thelpsb@currentPage}%
  }%
}

