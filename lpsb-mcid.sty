        \def\@svsechd{#6\hskip #3\relax\global\@lpsb@in@sectiontrue\global\@lpsb@runin@heading@guardtrue\lpsbTagBegin{\lpsb@tmp@heading@level}\@svsec #8\lpsbTagEnd\global\@lpsb@runin@heading@guardfalse\global\@lpsb@in@sectionfalse\csname #1mark\endcsname
                      {#7}\addcontentsline
                           {toc}{#1}{\ifnum #2>\c@secnumdepth \else
