}

% --- Tabular/TabularX Outside Float ---
% When tabular environments appear outside of table floats, they should
% still be tagged as Table and have inline suppression.
% Note: We detect this by checking if we're NOT inside a float.
\AtBeginDocument{%
  \@ifpackageloaded{tabularx}{%
    \BeforeBeginEnvironment{tabularx}{%
      \if@lpsb@active
        \if@lpsb@in@float\else
          \lpsbTagEnd
          \lpsbTagBegin{Table}%
          \global\@lpsb@suppress@inlinetrue
        \fi
      \fi
    }%
    \AfterEndEnvironment{tabularx}{%
      \if@lpsb@active
        \if@lpsb@in@float\else
          \global\@lpsb@suppress@inlinefalse
          \lpsbTagEnd
          \lpsbTagBegin{P}%
        \fi
      \fi
    }%
  }{}%
}

% Standard tabular: suppress inline when outside float
\BeforeBeginEnvironment{tabular}{%
  \if@lpsb@active
    \if@lpsb@in@float\else
      \global\@lpsb@suppress@inlinetrue
    \fi
  \fi
}
\AfterEndEnvironment{tabular}{%
  \if@lpsb@active
    \if@lpsb@in@float\else
      \global\@lpsb@suppress@inlinefalse
    \fi
  \fi
}

% --- Citations → Reference ---
% Keep citations as atom tags so they don't split /P into separate logical elements.
% NOTE: natbib supports up to two optional args: \citep[pre][post]{key}.
%
% CRITICAL: Citation commands are often used in moving arguments (\caption, \section).
% The \@ifnextchar[ trick is FRAGILE and breaks in moving arguments.
% Solution: Use \protected\def for the outer command to delay expansion.
%
\AtBeginDocument{%
  \@ifpackageloaded{natbib}{%
    \typeout{LPSB-MCID Info: natbib detected}%
    %
    % DISABLED: Citation wrappers cause "Misplaced alignment tab" errors when
    % bibcodes contain & (e.g., 2013A&A...556A...2V for Astronomy & Astrophysics).
    % The & is interpreted as alignment tab during \def argument parsing.
    %
    % Tradeoff: Citations are not individually tagged as Reference atoms,
    % but compilation succeeds for papers with A&A-style bibcodes.
    %
    % TODO: Find a way to wrap citations without re-parsing the bibcode argument.
    % Possible approach: Hook natbib internal primitives after parsing is complete.
  }{}%
}

% --- Hyperlinks → Link ---
\AtBeginDocument{%
  % Disabled: \href is heavily patched by hyperref and is used in moving arguments.
  % Wrapping it breaks real documents. Keep it untouched.
}

%% =========================================
%% 7. Document Setup and Finalization
%% =========================================
\AtEndDocument{%
  \lpsbTagEnd
  % CRITICAL FIX: Disable LPSB after document ends to prevent infinite page generation.
  % Some document/package combinations (especially with float.sty) can trigger
  % infinite output routine calls after \clearpage. By disabling LPSB here,
  % we prevent our shipout hooks from interfering with the output routine cleanup.
  % Note: Floats are already tagged inside their boxes via \@xfloat hook,
  % so disabling here doesn't affect float tagging.
  \global\@lpsb@activefalse
  % Enable PDF MarkInfo
  \ifLuaTeX
    \pdfextension catalog{/MarkInfo << /Marked true >>}%
  \else
    \pdfcatalog{/MarkInfo << /Marked true >>}%
  \fi
  % Write summary
  \immediate\write\@auxout{%
    \string\lpsb@summary{\thelpsb@logicalElemID}{\thelpsb@globalMCID}{\thelpsb@currentPage}%
  }%
}

