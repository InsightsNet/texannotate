%% =========================================
%% 4e. Code Listing Semantic Tagging
%% =========================================
% lstlisting environments should be tagged as Code instead of P
% Note: listings package uses complex internals, use etoolbox hooks instead
% Note: We don't call lpsbTagEnd here to avoid breaking section headings

\AtBeginDocument{%
  \@ifpackageloaded{listings}{%
    % Use etoolbox hooks instead of renewenvironment (listings is complex)
    \BeforeBeginEnvironment{lstlisting}{%
      \lpsbTagBegin{Code}%
    }%
    \AfterEndEnvironment{lstlisting}{%
      \lpsbTagEnd
    }%
    % Hook listings caption: listings uses \lst@MakeCaption internally
    \@ifundefined{lst@MakeCaption}{}{%
      \let\lpsb@orig@lstMakeCaption\lst@MakeCaption
      \def\lst@MakeCaption#1{%
        \lpsbTagAtom{Caption}{\lpsb@orig@lstMakeCaption{#1}}%
      }%
    }%
  }{}%
  % fancyvrb package: Verbatim environment
  \@ifpackageloaded{fancyvrb}{%
    \BeforeBeginEnvironment{Verbatim}{%
      \lpsbTagBegin{Code}%
    }%
    \AfterEndEnvironment{Verbatim}{%
      \lpsbTagEnd
    }%
  }{}%
}

%% =========================================
%% 4f. Algorithm Semantic Tagging
%% =========================================
% algorithm environments should be tagged as Algorithm instead of P
% Using etoolbox hooks for consistency
% Note: We don't call lpsbTagEnd here to avoid breaking section headings

% Flag to suppress inline tags (Strong, Em, etc.) inside certain environments
\newif\if@lpsb@suppress@inline \@lpsb@suppress@inlinefalse
\newif\if@lpsb@in@algorithm \@lpsb@in@algorithmfalse

\newif\if@lpsb@algorithm@hooked \@lpsb@algorithm@hookedfalse

% algorithm2e package
\AtBeginDocument{%
  \@ifpackageloaded{algorithm2e}{%
    \if@lpsb@algorithm@hooked\else
      \global\@lpsb@algorithm@hookedtrue
      \BeforeBeginEnvironment{algorithm}{%
        \lpsbTagBegin{Algorithm}%
        \global\@lpsb@in@algorithmtrue
        \global\@lpsb@suppress@inlinetrue
      }%
      \BeforeBeginEnvironment{algorithm*}{%
        \lpsbTagBegin{Algorithm}%
        \global\@lpsb@in@algorithmtrue
        \global\@lpsb@suppress@inlinetrue
      }%
      \AfterEndEnvironment{algorithm}{%
        \global\@lpsb@suppress@inlinefalse
        \global\@lpsb@in@algorithmfalse
        \lpsbTagEnd
        % CRITICAL FIX: Use deferred P mechanism instead of direct call
        % Direct lpsb@start@P@after@float inserts BDC at wrong PDF position
        \global\@lpsb@P@pending@after@floattrue
        \global\@lpsb@first@paratrue
      }%
      \AfterEndEnvironment{algorithm*}{%
        \global\@lpsb@suppress@inlinefalse
        \global\@lpsb@in@algorithmfalse
        \lpsbTagEnd
        \global\@lpsb@P@pending@after@floattrue
        \global\@lpsb@first@paratrue
      }%
    \fi
  }{}%
}

% algorithm package (algorithm + algorithmic)
\AtBeginDocument{%
  \@ifpackageloaded{algorithm}{%
    \if@lpsb@algorithm@hooked\else
      \global\@lpsb@algorithm@hookedtrue
      \BeforeBeginEnvironment{algorithm}{%
        \lpsbTagBegin{Algorithm}%
        \global\@lpsb@in@algorithmtrue
        \global\@lpsb@suppress@inlinetrue
      }%
      \BeforeBeginEnvironment{algorithm*}{%
        \lpsbTagBegin{Algorithm}%
        \global\@lpsb@in@algorithmtrue
        \global\@lpsb@suppress@inlinetrue
      }%
      \AfterEndEnvironment{algorithm}{%
        \global\@lpsb@suppress@inlinefalse
        \global\@lpsb@in@algorithmfalse
        \lpsbTagEnd
        % Start P immediately - same pattern as equation environments
        \lpsb@start@P@after@float
      }%
      \AfterEndEnvironment{algorithm*}{%
        \global\@lpsb@suppress@inlinefalse
        \global\@lpsb@in@algorithmfalse
        \lpsbTagEnd
        \lpsb@start@P@after@float
      }%
    \fi
  }{}%
  \@ifpackageloaded{algorithmic}{%
    \BeforeBeginEnvironment{algorithmic}{%
      \global\@lpsb@in@algorithmtrue
    }%
    \AfterEndEnvironment{algorithmic}{%
      % Close any dangling LI from algorithmic list.
      \if@lpsb@active
        \def\lpsb@tmp@li{LI}%
        \ifx\lpsb@current@tag@type\lpsb@tmp@li
          \lpsbTagEndForce
          \global\@lpsb@P@pending@after@listtrue
        \fi
      \fi
      \global\@lpsb@in@algorithmfalse
      % Start P after algorithmic ends (if not inside algorithm wrapper)
      \if@lpsb@in@algorithm\else
        \lpsb@start@P@after@float
      \fi
    }%
  }{}%
  \@ifpackageloaded{algorithmicx}{%
    \BeforeBeginEnvironment{algorithmic}{%
      \global\@lpsb@in@algorithmtrue
    }%
    \AfterEndEnvironment{algorithmic}{%
      % Close any dangling LI from algorithmic list.
      \if@lpsb@active
        \def\lpsb@tmp@li{LI}%
        \ifx\lpsb@current@tag@type\lpsb@tmp@li
          \lpsbTagEndForce
          \global\@lpsb@P@pending@after@listtrue
        \fi
      \fi
      \global\@lpsb@in@algorithmfalse
    }%
  }{}%
}

%% =========================================
%% 4g. Multicol Environment Tagging
%% =========================================
% multicols environment collects content in a vbox before splitting into columns
% This can suppress normal everypar behavior. We explicitly start a P tag.
\AtBeginDocument{%
  \@ifpackageloaded{multicol}{%
    \BeforeBeginEnvironment{multicols}{%
      % End any active tag and start fresh P for multicol content
      \if@lpsb@active
        \lpsbTagEnd
      \fi
      \lpsbTagBegin{P}%
    }%
    \AfterEndEnvironment{multicols}{%
      \lpsbTagEnd
      % Start new P for content after multicol
      \lpsbTagBegin{P}%
    }%
  }{}%
}

%% =========================================
%% 4h. Longtable Environment Tagging
%% =========================================
% longtable creates multi-page tables outside of float environments.
% Tag as Table and suppress inline formatting to avoid fragmentation.
\AtBeginDocument{%
  \@ifpackageloaded{longtable}{%
    \BeforeBeginEnvironment{longtable}{%
      \if@lpsb@active
        \lpsbTagEnd
      \fi
      \lpsbTagBegin{Table}%
      \global\@lpsb@suppress@inlinetrue
    }%
    \AfterEndEnvironment{longtable}{%
      \global\@lpsb@suppress@inlinefalse
      \lpsbTagEnd
      \lpsbTagBegin{P}%
    }%
  }{}%
}

%% =========================================
%% 4i. Theorem Environment Tagging
%% =========================================
% Theorem-like environments (theorem, lemma, definition, etc.) should
% suppress inline tags to avoid fragmentation. We use a generic approach
% that hooks into amsthm's \@thm command.
%
% IMPORTANT: Skip these hooks when certain packages are loaded that have
% incompatible theorem internals (smfthm, thmtools, etc.)
\AtBeginDocument{%
  % Check for incompatible theorem packages
  \newif\if@lpsb@skip@thmhooks \@lpsb@skip@thmhooksfalse
  \@ifpackageloaded{smfthm}{\global\@lpsb@skip@thmhookstrue}{}%
  \@ifpackageloaded{thmtools}{\global\@lpsb@skip@thmhookstrue}{}%
  % smf class also uses incompatible theorem handling
  \def\lpsb@tmp@smf{smf}%
  \ifx\lpsb@detected@template\lpsb@tmp@smf\global\@lpsb@skip@thmhookstrue\fi
  %
  \if@lpsb@skip@thmhooks
    \typeout{LPSB-MCID Info: Skipping theorem hooks (incompatible package detected)}%
  \else
    \@ifpackageloaded{amsthm}{%
      % Hook \@thm which is called for all theorem environments
      \@ifundefined{@thm}{}{%
        \let\lpsb@orig@@thm\@thm
        \def\@thm#1#2#3{%
          \if@lpsb@active
            \lpsbTagEnd
            \lpsbTagBegin{P}%  % Use P for theorem content (semantic role unclear in PDF/UA)
            \global\@lpsb@suppress@inlinetrue
          \fi
          \lpsb@orig@@thm{#1}{#2}{#3}%
        }%
      }%
      % Hook \@endtheorem to restore inline tagging
      \@ifundefined{@endtheorem}{}{%
        \let\lpsb@orig@@endtheorem\@endtheorem
        \def\@endtheorem{%
          \lpsb@orig@@endtheorem
          \global\@lpsb@suppress@inlinefalse
        }%
      }%
    }{}%
    % Also handle old-style theorem package
    \@ifpackageloaded{theorem}{%
      \@ifundefined{@thm}{}{%
        \@ifundefined{lpsb@orig@@thm}{%  % Don't double-hook if amsthm already did
          \let\lpsb@orig@@thm\@thm
          \def\@thm#1#2#3{%
            \if@lpsb@active
              \lpsbTagEnd
              \lpsbTagBegin{P}%
              \global\@lpsb@suppress@inlinetrue
            \fi
            \lpsb@orig@@thm{#1}{#2}{#3}%
          }%
        }{}%
      }%
      \@ifundefined{@endtheorem}{}{%
        \@ifundefined{lpsb@orig@@endtheorem}{%
          \let\lpsb@orig@@endtheorem\@endtheorem
          \def\@endtheorem{%
            \lpsb@orig@@endtheorem
            \global\@lpsb@suppress@inlinefalse
          }%
        }{}%
      }%
    }{}%
  \fi
}

%% =========================================
