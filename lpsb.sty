\lpsb@intikzfalse
\newif\iflpsb@infigure  % Flag to track if we're inside a figure environment
\lpsb@infigurefalse

% ACM template detection - skip certain hooks to prevent blank first page
% acmart.cls uses abstract and other environments inside \maketitle,
% which conflicts with LPSB's \lpsbParaEnd calls
\newif\iflpsb@isacmart
\lpsb@isacmartfalse
% Detection happens inside main \AtBeginDocument (line ~850) before any conditional checks

% Figure counter (for standalone figures like tikzpicture outside figure env)
\newcount\lpsbFigureCount
\lpsbFigureCount=0
% Per-figure ID saved at start (for matching end event)
\newcount\lpsb@currentFigureID
\lpsb@currentFigureID=0

% ===================================================================
% Output File (Structure Tree JSON)
% ===================================================================
\newif\iflpsbNoIO
\lpsbNoIOfalse

\newwrite\lpsbout

\newif\iflpsbFirstEntry
\lpsbFirstEntrytrue

\iflpsbNoIO
    \long\def\lpsbWriteEntry#1{}%
\else
    \immediate\openout\lpsbout=\jobname.lpsb.json
    \immediate\write\lpsbout{[}
    \long\def\lpsbWriteEntry#1{%
        \iflpsb@reducedhooks\else  % Skip all writes in reduced hooks mode
        \iflpsbFirstEntry
            \immediate\write\lpsbout{#1}%
            \global\lpsbFirstEntryfalse
        \else
            \immediate\write\lpsbout{,#1}%
        \fi
        \fi
    }%
\fi

% ===================================================================
% PDF 2.0 Role Mapping
% ===================================================================
% LaTeX section level -> PDF/UA heading level
\def\lpsb@levelToH#1{%
    \ifcase#1 H1\or H2\or H3\or H4\or H5\or H6\else H6\fi
}

% ===================================================================
% Core Probe Command
% ===================================================================
\def\lpsbProbe#1#2#3{%
    \iflpsb@reducedhooks\else  % Skip in reduced hooks mode
    \global\advance\lpsbProbeCount by 1%
    \lpsb@savepos
    \lpsbWriteEntry{{"id": "#1", "role": "#2", "page": "\thepage", "x": \the\lpsb@lastxpos, "y": \the\lpsb@lastypos #3}}%
    \fi
}

% ===================================================================
% PHASE 1: Paragraphs (P) and Headings (H1-H6)
% ===================================================================

\makeatletter

% --- Paragraph Detection ---
% Prefer LaTeX paragraph hooks (para/begin, para/end) over \everypar.
% \everypar gets overwritten in many environments (lists, minipage, etc).
\def\lpsb@ParaBegin{%
    \iflpsb@reducedhooks\else  % Skip in reduced hooks mode (e.g., changes package)
    \iflpsbActive  % Only track if LPSB is active (delayed for acmart)
    \iflpsb@intikz\else  % Skip paragraph tracking inside TikZ/PGF
    \iflpsb@inbib\else  % Skip paragraph tracking inside bibliography
        \iflpsbInPara\else
            \global\advance\lpsbParaCount by 1%
            \global\lpsbInParatrue
            \zsavepos{lpsb-P-\the\lpsbParaCount-start}%
            \lpsbWriteEntry{{"id": "P-\the\lpsbParaCount", "role": "P", "event": "start", "page": "\thepage"}}%
        \fi
    \fi
    \fi
    \fi
    \fi
}

\def\lpsb@ParaEnd{%
    \iflpsb@reducedhooks\else  % Skip in reduced hooks mode
    \iflpsbActive  % Only track if LPSB is active (delayed for acmart)
    \iflpsbInPara
        \zsavepos{lpsb-P-\the\lpsbParaCount-end}%
        \lpsbWriteEntry{{"id": "P-\the\lpsbParaCount", "role": "P", "event": "end", "page": "\thepage"}}%
        \global\lpsbInParafalse
    \fi
    \fi
    \fi
}

% Public wrappers (no @ in name). Useful outside \makeatletter contexts.
\let\lpsbParaBegin\lpsb@ParaBegin
\let\lpsbParaEnd\lpsb@ParaEnd

% --- Heading Detection (H1-H6) ---
% Hook internal \@sect command - must be done at AtBeginDocument to avoid hyperref conflicts
% These hooks will be installed later to ensure hyperref's modifications take precedence

% JSON Escaping - use detokenize to safely convert special chars
% Note: CVPR/ICCV have \texorpdfstring which may cause JSON issues
\def\lpsb@escapeJSON#1{\detokenize{#1}}

% ===================================================================
% Environment Hooks (for structure context)
% ===================================================================
\newcommand{\lpsbHookEnv}[2]{%  #1=env name, #2=PDF role
    \AtBeginEnvironment{#1}{%
        \lpsbParaEnd% Close any open paragraph before environment starts
        \global\advance\lpsbEnvDepth by 1%
        \lpsbWriteEntry{{"id": "#1-\the\lpsbEnvDepth", "role": "#2", "event": "start", "depth": \the\lpsbEnvDepth, "page": "\thepage"}}%
    }%
    \AtEndEnvironment{#1}{%
        \lpsbWriteEntry{{"id": "#1-\the\lpsbEnvDepth", "role": "#2", "event": "end", "depth": \the\lpsbEnvDepth, "page": "\thepage"}}%
        \global\advance\lpsbEnvDepth by -1%
    }%
}

% Hook standard environments with PDF 2.0 roles
\lpsbHookEnv{document}{Document}
% Abstract hook - skip for ACM templates to prevent blank first page
% acmart uses abstract inside \maketitle, and \lpsbParaEnd there causes issues
\AtBeginEnvironment{abstract}{%
    \iflpsb@isacmart\else
        \lpsbParaEnd%
        \global\advance\lpsbEnvDepth by 1%
        \lpsbWriteEntry{{"id": "abstract-\the\lpsbEnvDepth", "role": "Sect", "event": "start", "depth": \the\lpsbEnvDepth, "page": "\thepage"}}%
    \fi
}%
\AtEndEnvironment{abstract}{%
    \iflpsb@isacmart\else
        \lpsbWriteEntry{{"id": "abstract-\the\lpsbEnvDepth", "role": "Sect", "event": "end", "depth": \the\lpsbEnvDepth, "page": "\thepage"}}%
        \global\advance\lpsbEnvDepth by -1%
    \fi
}%
% Figure environments: use shared FigureCount for consistent IDs across figure/figure*/tikzpicture/pgfpicture
\AtBeginEnvironment{figure}{%
    \lpsbParaEnd%
    \global\advance\lpsbEnvDepth by 1%
    \global\advance\lpsbFigureCount by 1%
    \global\lpsb@currentFigureID=\lpsbFigureCount% Save ID for end event
    \global\lpsb@infiguretrue% Mark that we're in a figure
    \zsavepos{lpsb-Figure-\the\lpsbFigureCount-start}%
    \lpsbWriteEntry{{"id": "Figure-\the\lpsbFigureCount", "role": "Figure", "event": "start", "env": "figure", "depth": \the\lpsbEnvDepth, "page": "\thepage"}}%
}%
\AtEndEnvironment{figure}{%
    \lpsbParaEnd%
    \zsavepos{lpsb-Figure-\the\lpsb@currentFigureID-end}%
    \lpsbWriteEntry{{"id": "Figure-\the\lpsb@currentFigureID", "role": "Figure", "event": "end", "env": "figure", "depth": \the\lpsbEnvDepth, "page": "\thepage"}}%
    \global\advance\lpsbEnvDepth by -1%
    \global\lpsb@infigurefalse%
}%
\AtBeginEnvironment{figure*}{%
    \lpsbParaEnd%
    \global\advance\lpsbEnvDepth by 1%
    \global\advance\lpsbFigureCount by 1%
    \global\lpsb@currentFigureID=\lpsbFigureCount%
    \global\lpsb@infiguretrue%
    \zsavepos{lpsb-Figure-\the\lpsbFigureCount-start}%
    \lpsbWriteEntry{{"id": "Figure-\the\lpsbFigureCount", "role": "Figure", "event": "start", "env": "figure*", "depth": \the\lpsbEnvDepth, "page": "\thepage"}}%
}%
\AtEndEnvironment{figure*}{%
    \lpsbParaEnd%
    \zsavepos{lpsb-Figure-\the\lpsb@currentFigureID-end}%
    \lpsbWriteEntry{{"id": "Figure-\the\lpsb@currentFigureID", "role": "Figure", "event": "end", "env": "figure*", "depth": \the\lpsbEnvDepth, "page": "\thepage"}}%
    \global\advance\lpsbEnvDepth by -1%
    \global\lpsb@infigurefalse%
}%
% Tables: use unique instance IDs and close open paragraphs before ending the float.
% NOTE: We intentionally avoid hooking tabular internals; they can perturb rule drawing.
\AtBeginEnvironment{table}{%
    \lpsbParaEnd%
    \global\advance\lpsbEnvDepth by 1%
    \global\advance\lpsbTableCount by 1%
    \edef\lpsb@TableID{Table-\the\lpsbTableCount}%
    \lpsbMark{\lpsb@TableID}%
    \zsavepos{lpsb-\lpsb@TableID-start}%
    \lpsbWriteEntry{{"id": "\lpsb@TableID", "role": "Table", "event": "start", "depth": \the\lpsbEnvDepth, "page": "\thepage"}}%
}%
\AtEndEnvironment{table}{%
    \lpsbParaEnd%
    \zsavepos{lpsb-\lpsb@TableID-end}%
    \lpsbWriteEntry{{"id": "\lpsb@TableID", "role": "Table", "event": "end", "depth": \the\lpsbEnvDepth, "page": "\thepage"}}%
    \global\advance\lpsbEnvDepth by -1%
}%
\AtBeginEnvironment{table*}{%
    \lpsbParaEnd%
    \global\advance\lpsbEnvDepth by 1%
    \global\advance\lpsbTableCount by 1%
    \edef\lpsb@TableID{Table-\the\lpsbTableCount}%
    \lpsbMark{\lpsb@TableID}%
    \zsavepos{lpsb-\lpsb@TableID-start}%
    \lpsbWriteEntry{{"id": "\lpsb@TableID", "role": "Table", "event": "start", "depth": \the\lpsbEnvDepth, "page": "\thepage"}}%
}%
\AtEndEnvironment{table*}{%
    \lpsbParaEnd%
    \zsavepos{lpsb-\lpsb@TableID-end}%
    \lpsbWriteEntry{{"id": "\lpsb@TableID", "role": "Table", "event": "end", "depth": \the\lpsbEnvDepth, "page": "\thepage"}}%
    \global\advance\lpsbEnvDepth by -1%
}%

