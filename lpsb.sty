% ===================================================================
% LPSB Package - LaTeX-PDF Semantic Bridge
% 
% PDF 2.0 Structure Element Support
% USAGE: \usepackage{lpsb} (after \documentclass)
% ===================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{lpsb}[2026/01/05 LPSB Package - PDF 2.0 Structure Elements]%

% Engine detection and primitive compatibility
\RequirePackage{iftex}
\RequirePackage[savepos]{zref}

% Compatibility fix for older TeX Live versions (e.g., TL2020)
% Problem: When the .aux file is read (before \begin{document}),
% \zref@newlabel may not be defined in older zref versions,
% causing "Undefined control sequence" errors on the second pass.
% Solution: Provide an immediate fallback no-op definition.
% zref will overwrite this with the real definition if it initializes properly.
\@ifundefined{zref@newlabel}{%
    \typeout{LPSB: Defining fallback zref@newlabel for old zref compatibility}%
    \long\def\zref@newlabel#1#2{}%
}{}
% Also handle posx/posy which appear inside zref labels
\@ifundefined{posx}{\def\posx#1{}}{}
\@ifundefined{posy}{\def\posy#1{}}{}

\ifLuaTeX
    \let\lpsb@savepos\savepos
    \let\lpsb@lastxpos\lastxpos
    \let\lpsb@lastypos\lastypos
\else
    \let\lpsb@savepos\pdfsavepos
    \let\lpsb@lastxpos\pdflastxpos
    \let\lpsb@lastypos\pdflastypos
\fi


% ===================================================================
% Package Compatibility Detection
% ===================================================================
% Some packages use internal macros that conflict with LPSB hooks.
% We detect these packages and COMPLETELY disable LPSB to avoid errors.

% Flag for disabled mode (completely disables ALL LPSB functionality)
\newif\iflpsb@disabled
\lpsb@disabledfalse

% Alias for backward compatibility
\let\iflpsb@reducedhooks\iflpsb@disabled
\let\lpsb@reducedhookstrue\lpsb@disabledtrue
\let\lpsb@reducedhooksfalse\lpsb@disabledfalse

% Detect conflicting packages after \begin{document}
\AtBeginDocument{%
    % 'changes' package uses xkeyval internally and LPSB hooks can corrupt
    % xkeyval's internal parsing state (XKV@resa, etc.)
    \@ifpackageloaded{changes}{%
        \typeout{LPSB WARNING: Detected 'changes' package - DISABLING ALL LPSB FUNCTIONALITY}%
        \global\lpsb@disabledtrue
    }{}%
    % 'soul' package can also conflict
    \@ifpackageloaded{soul}{%
        \typeout{LPSB WARNING: Detected 'soul' package - DISABLING ALL LPSB FUNCTIONALITY}%
        \global\lpsb@disabledtrue
    }{}%
    % Print final status
    \iflpsb@disabled
        \typeout{LPSB: Package DISABLED due to conflicting packages}%
    \fi
}

% ===================================================================
% Protected AddToHook Wrapper
% ===================================================================
% This wrapper ensures LPSB hooks are no-ops when disabled.
% The callback body is wrapped to check disabled flag at EXECUTION time,
% not at definition time, which prevents argument expansion issues.
\def\lpsb@AddToHook#1#2{%
    \AddToHook{#1}{\iflpsb@disabled\else #2\fi}%
}

