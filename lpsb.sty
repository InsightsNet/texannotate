% --- Caption Hook (deferred to AtBeginDocument for compatibility) ---
\newcount\lpsbCaptionCount
\lpsbCaptionCount=0

% --- Tables ---
% IMPORTANT: Do NOT hook `tabular` internals. Even seemingly harmless injections at
% environment begin/end can perturb alignment/rule drawing in some documents.
% We rely on the outer `table` environment for the Table container role.

% --- Inline Text Formatting ---
% Counters for inline formatting
\newcount\lpsbStrongCount \lpsbStrongCount=0
\newcount\lpsbEmCount \lpsbEmCount=0

% Hook \textbf for strong emphasis
% Conditional tracking: \ifmmode checks if we're in math mode
% - Text mode: full zsavepos coordinates
% - Math mode (like \bm{\textbf{...}}): skip zsavepos to avoid ZREF conflict,
%   but record inMathMode:true for coordinate inheritance from parent Math
% NOTE: Check lpsbActive to avoid logging before \begin{document}
\let\lpsb@origtextbf\textbf
\renewcommand{\textbf}[1]{%
    \iflpsbActive
        \ifvmode\leavevmode\fi% Ensure paragraph starts first
        \global\advance\lpsbStrongCount by 1%
        \ifmmode
            % In math mode (e.g., inside \bm{}) - skip zsavepos to avoid ZREF conflict
            \lpsbWriteEntry{{"id": "Strong-\the\lpsbStrongCount", "role": "Strong", "event": "atom", "inMathMode": true, "page": "\thepage"}}%
            \lpsb@origtextbf{#1}%
        \else
            % Normal text mode - record full coordinates
            \zsavepos{lpsb-Strong-\the\lpsbStrongCount-start}%
            \lpsbWriteEntry{{"id": "Strong-\the\lpsbStrongCount", "role": "Strong", "event": "start", "page": "\thepage"}}%
            \lpsb@origtextbf{#1}%
            \zsavepos{lpsb-Strong-\the\lpsbStrongCount-end}%
            \lpsbWriteEntry{{"id": "Strong-\the\lpsbStrongCount", "role": "Strong", "event": "end", "page": "\thepage"}}%
        \fi
    \else
        \lpsb@origtextbf{#1}%
    \fi
}

% Hook \textit for italic
% Same conditional tracking as \textbf
\let\lpsb@origtextit\textit
\renewcommand{\textit}[1]{%
    \iflpsbActive
        \ifvmode\leavevmode\fi% Ensure paragraph starts first
        \global\advance\lpsbEmCount by 1%
        \ifmmode
            % In math mode - skip zsavepos, record inMathMode:true
            \lpsbWriteEntry{{"id": "Em-\the\lpsbEmCount", "role": "Em", "event": "atom", "inMathMode": true, "page": "\thepage"}}%
            \lpsb@origtextit{#1}%
        \else
            % Normal text mode - record full coordinates
            \zsavepos{lpsb-Em-\the\lpsbEmCount-start}%
            \lpsbWriteEntry{{"id": "Em-\the\lpsbEmCount", "role": "Em", "event": "start", "page": "\thepage"}}%
            \lpsb@origtextit{#1}%
            \zsavepos{lpsb-Em-\the\lpsbEmCount-end}%
            \lpsbWriteEntry{{"id": "Em-\the\lpsbEmCount", "role": "Em", "event": "end", "page": "\thepage"}}%
        \fi
    \else
        \lpsb@origtextit{#1}%
    \fi
}

% Hook \emph - shares counter with \textit
% Same conditional tracking
\let\lpsb@origemph\emph
\renewcommand{\emph}[1]{%
    \iflpsbActive
        \ifvmode\leavevmode\fi% Ensure paragraph starts first
        \global\advance\lpsbEmCount by 1%
        \ifmmode
            % In math mode - skip zsavepos, record inMathMode:true
            \lpsbWriteEntry{{"id": "Em-\the\lpsbEmCount", "role": "Em", "event": "atom", "inMathMode": true, "page": "\thepage"}}%
            \lpsb@origemph{#1}%
        \else
            % Normal text mode - record full coordinates
            \zsavepos{lpsb-Em-\the\lpsbEmCount-start}%
            \lpsbWriteEntry{{"id": "Em-\the\lpsbEmCount", "role": "Em", "event": "start", "page": "\thepage"}}%
            \lpsb@origemph{#1}%
            \zsavepos{lpsb-Em-\the\lpsbEmCount-end}%
            \lpsbWriteEntry{{"id": "Em-\the\lpsbEmCount", "role": "Em", "event": "end", "page": "\thepage"}}%
        \fi
    \else
        \lpsb@origemph{#1}%
    \fi
}

