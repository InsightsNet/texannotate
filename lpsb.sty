\newcount\lpsbRefCount
\lpsbRefCount=0

% Context-aware counters for cross-compilation alignment
\newcount\lpsbSectionNum
\lpsbSectionNum=0
% NOTE:
% - \lpsbSectionNum counts ALL headings (\section, \subsection, ...) and can diverge across engines.
% - For cross-engine math alignment we use a separate, coarse context counter bumped only at top-level.
\newcount\lpsbMathContextNum
\lpsbMathContextNum=0
% Separate per-context counters so display-math IDs are stable even if inline math differs.
\newcount\lpsbDisplayMathInContext
\lpsbDisplayMathInContext=0
\newcount\lpsbInlineMathInContext
\lpsbInlineMathInContext=0
\newcount\lpsbDisplayMathCount
\lpsbDisplayMathCount=0

% Explicit ID marker for cross-engine alignment (LaTeXML binding consumes this).
\providecommand{\lpsbMark}[1]{}%
\def\lpsb@PendingDisplayMathID{}%
\def\lpsb@DisplayMathMark{%
    \ifx\lpsb@PendingDisplayMathID\@empty\else
        \lpsbMark{\lpsb@PendingDisplayMathID}%
        \let\lpsb@PendingDisplayMathID\@empty
    \fi
}%
\newcount\lpsbInlineMathCount
\lpsbInlineMathCount=0

% Flags
\newif\iflpsbActive
\lpsbActivefalse
\newif\iflpsbInPara
\lpsbInParafalse
\newif\iflpsb@indisplay  % For inline math filtering (true when in display math environment)
\lpsb@indisplayfalse
