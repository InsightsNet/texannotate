% ===================================================================
% longtable Support (Command Redefinition)
% ===================================================================
% Note: TaggingSocket only works when DocumentMetadata{tagging=on} is used,
% which conflicts with LPSB. Using command redefinition for all cases.

\newif\iflpsb@inlongtable
\lpsb@inlongtablefalse

\newcount\lpsbLTRowCount
\lpsbLTRowCount=0

\AtBeginDocument{%
  \@ifpackageloaded{longtable}{%
    % Save original longtable command
    \let\lpsb@orig@longtable\longtable
    \let\lpsb@orig@endlongtable\endlongtable
    
    % Redefine longtable to add start/end markers
    \renewcommand{\longtable}{%
      \global\advance\lpsbTableCount by 1%
      \global\lpsbLTRowCount=0%
      \global\lpsb@inlongtabletrue%
      \lpsbWriteEntry{{"id": "Table-\the\lpsbTableCount", "role": "Table", "event": "start", "env": "longtable", "page": "\thepage"}}%
      \lpsb@orig@longtable
    }%
    
    \renewcommand{\endlongtable}{%
      \lpsb@orig@endlongtable
      \lpsbWriteEntry{{"id": "Table-\the\lpsbTableCount", "role": "Table", "event": "end", "env": "longtable", "page": "\thepage"}}%
      \global\lpsb@inlongtablefalse%
    }%
    
    \typeout{LPSB Info: Hooked longtable environment}%
  }{}%
}


% Special hook for Math environments - uses context-aware IDs for cross-compilation alignment
% v3.1: Now captures LaTeX source code as fallback for MathML
\newcommand{\lpsbHookMath}[1]{%  #1=env name
    \AtBeginEnvironment{#1}{%
        \lpsbParaEnd% Close any open paragraph before math starts
        \global\lpsb@indisplaytrue% Mark that we're in display math (for everymath filter)
        \global\advance\lpsbDisplayMathCount by 1%
        \global\advance\lpsbDisplayMathInContext by 1%
        \edef\lpsb@DisplayMathID{Sec-\the\lpsbMathContextNum-Math-\the\lpsbDisplayMathInContext}%
        \edef\lpsb@PendingDisplayMathID{\lpsb@DisplayMathID}%
        \zsavepos{lpsb-\lpsb@DisplayMathID-start}%
        \lpsbWriteEntry{{"id": "\lpsb@DisplayMathID", "role": "Formula", "event": "start", "env": "#1", "page": "\thepage"}}%
    }%
    \AtEndEnvironment{#1}{%
        \zsavepos{lpsb-\lpsb@DisplayMathID-end}%
        \lpsbWriteEntry{{"id": "\lpsb@DisplayMathID", "role": "Formula", "event": "end", "page": "\thepage"}}%
        \global\lpsb@indisplayfalse% Reset display flag
    }%
}

% Capture LaTeX source for simple equation environment using environ
% This provides a fallback when MathML conversion fails
\@ifpackageloaded{environ}{%
    % environ is loaded, we can use it for source capture
    \let\lpsb@orig@equation\equation
    \let\lpsb@orig@endequation\endequation
    
    \RenewEnviron{equation}{%
        \global\advance\lpsbDisplayMathCount by 1%
        \global\advance\lpsbDisplayMathInContext by 1%
        \edef\lpsb@DisplayMathID{Sec-\the\lpsbMathContextNum-Math-\the\lpsbDisplayMathInContext}%
        \edef\lpsb@PendingDisplayMathID{\lpsb@DisplayMathID}%
        \zsavepos{lpsb-\lpsb@DisplayMathID-start}%
        \lpsbWriteEntry{{"id": "\lpsb@DisplayMathID", "role": "Formula", "event": "start", "env": "equation", "latex": "\lpsb@escapeJSON{\BODY}", "page": "\thepage"}}%
        \lpsb@orig@equation\BODY\lpsb@orig@endequation%
        \zsavepos{lpsb-\lpsb@DisplayMathID-end}%
        \lpsbWriteEntry{{"id": "\lpsb@DisplayMathID", "role": "Formula", "event": "end", "page": "\thepage"}}%
    }%
    \typeout{LPSB Info: equation environment configured with LaTeX source capture}%
}{%
    % environ not loaded - use standard hook approach
    \lpsbHookMath{equation}%
}%

% Note: equation is handled above via environ (with fallback)
% \lpsbHookMath{equation} - now handled above
\lpsbHookMath{equation*}
\lpsbHookMath{align}
\lpsbHookMath{align*}
\lpsbHookMath{gather}
\lpsbHookMath{gather*}
\lpsbHookMath{multline}
\lpsbHookMath{multline*}
\lpsbHookMath{eqnarray}
\lpsbHookMath{eqnarray*}
\lpsbHookMath{displaymath}
\lpsbHookMath{flalign}
\lpsbHookMath{flalign*}

% ===================================================================
% Inline Math Tracking (pdfLaTeX side)
% ===================================================================
% Track inline math positions using \everymath
% Note: \everydisplay triggers for display math, \everymath for inline
% (iflpsb@indisplay defined in Flags section above)

% Mark when we enter display math
\let\lpsb@orig@everydisplay\everydisplay
\everydisplay\expandafter{\the\everydisplay\global\lpsb@indisplaytrue\lpsb@DisplayMathMark}

% Track inline math (only when not in display mode)
% IMPORTANT:
% - This is the ONLY robust TeX-side hook that sees both $...$ and \( ... \)
% - We emit start/end with zref labels so pdfLaTeX(aux) is the gold position source.
% - IDs use IMath to align with the Lua math pass (Sec-*-IMath-*).
%
% (lpsbInlineMathCount defined in Counters section above)
\def\lpsb@InlineMathEnd#1{%
    \edef\lpsb@tmpend{lpsb-#1-end}%
    \expandafter\zsavepos\expandafter{\lpsb@tmpend}%
    \lpsbWriteEntry{{"id": "#1", "role": "InlineMath", "event": "end", "page": "\thepage"}}%
}%
\everymath{%
    \iflpsb@indisplay\else
        \global\advance\lpsbInlineMathCount by 1%
        \global\advance\lpsbInlineMathInContext by 1%
        \edef\lpsb@InlineMathID{Sec-\the\lpsbMathContextNum-IMath-\the\lpsbInlineMathInContext}%
        \lpsbMark{\lpsb@InlineMathID}%
        \edef\lpsb@tmpstart{lpsb-\lpsb@InlineMathID-start}%
        \expandafter\zsavepos\expandafter{\lpsb@tmpstart}%
        \lpsbWriteEntry{{"id": "\lpsb@InlineMathID", "role": "InlineMath", "event": "start", "page": "\thepage"}}%
        % Schedule the end marker right after math mode closes.
        % Must be global: the math group ends before \aftergroup token executes.
        \global\edef\lpsb@InlineMathAfter{\noexpand\lpsb@InlineMathEnd{\lpsb@InlineMathID}}%
        \aftergroup\lpsb@InlineMathAfter
    \fi
}

% Reset display flag at end of each page/paragraph
\AtEndDocument{\global\lpsb@indisplayfalse}

