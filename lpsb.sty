% TikZ/PGF Support (Hybrid Approach)
% ===================================================================
% TikZ heavily manipulates coordinates and uses \pdfsavepos internally.
% We use a hybrid approach:
%   1. Record Figure start/end events at environment boundaries
%   2. Disable internal probes (\everypar, etc.) to avoid conflicts
% This preserves TikZ rendering while capturing structural information.

\AddToHook{env/tikzpicture/begin}{%
    \lpsbParaEnd% Close any open paragraph
    \global\lpsb@intikztrue% Disable internal probes
    % Only record Figure event if not already inside a figure environment
    \iflpsb@infigure\else
        \global\advance\lpsbFigureCount by 1%
        \global\advance\lpsbEnvDepth by 1%
        \lpsbWriteEntry{{"id": "Figure-\the\lpsbFigureCount", "role": "Figure", "event": "start", "env": "tikzpicture", "depth": \the\lpsbEnvDepth, "page": \thepage}}%
    \fi
}%
\AddToHook{env/tikzpicture/end}{%
    \iflpsb@infigure\else
        \lpsbWriteEntry{{"id": "Figure-\the\lpsbFigureCount", "role": "Figure", "event": "end", "env": "tikzpicture", "depth": \the\lpsbEnvDepth, "page": \thepage}}%
        \global\advance\lpsbEnvDepth by -1%
    \fi
    \global\lpsb@intikzfalse% Re-enable probes
}%

% pgfpicture is the lower-level environment used by TikZ
\AddToHook{env/pgfpicture/begin}{%
    \lpsbParaEnd%
    \global\lpsb@intikztrue%
    \iflpsb@infigure\else
        \global\advance\lpsbFigureCount by 1%
        \global\advance\lpsbEnvDepth by 1%
        \lpsbWriteEntry{{"id": "Figure-\the\lpsbFigureCount", "role": "Figure", "event": "start", "env": "pgfpicture", "depth": \the\lpsbEnvDepth, "page": \thepage}}%
    \fi
}%
\AddToHook{env/pgfpicture/end}{%
    \iflpsb@infigure\else
        \lpsbWriteEntry{{"id": "Figure-\the\lpsbFigureCount", "role": "Figure", "event": "end", "env": "pgfpicture", "depth": \the\lpsbEnvDepth, "page": \thepage}}%
        \global\advance\lpsbEnvDepth by -1%
    \fi
    \global\lpsb@intikzfalse%
}%

% ===================================================================
% List Item Hooks (LI, Lbl, LBody)
% ===================================================================
\newif\iflpsb@inbib
\lpsb@inbibfalse

% Hook thebibliography environment (deferred to avoid undefined command errors)
% Note: \thebibliography may not exist at package load time, so we hook it conditionally

% Redefine \item to preserve optional argument behavior
% We must use \def and \@ifnextchar distinct paths to avoid forcing an empty optional argument
% causing \item[] which suppresses default labels (e.g., bibliography numbers)

% Defer to AtBeginDocument to ensure we patch after packages like enumitem
\AtBeginDocument{%
\let\lpsb@origitem\item

\def\item{%
    \@ifnextchar[\lpsb@item@opt\lpsb@item@noopt
}

% Case 1: \item[...] provided
\def\lpsb@item@opt[#1]{%
    \iflpsb@inbib
        \lpsb@origitem[#1]%
    \else
        \iflpsbInListItem
            \lpsbParaEnd% Close any open paragraph
            \lpsbWriteEntry{{"id": "LI-\the\lpsbItemCount", "role": "LI", "event": "end", "page": \thepage}}%
        \fi
        \global\advance\lpsbItemCount by 1%
        \lpsbInListItemtrue
        \lpsbWriteEntry{{"id": "LI-\the\lpsbItemCount", "role": "LI", "event": "start", "page": \thepage}}%
        \lpsbWriteEntry{{"id": "Lbl-\the\lpsbItemCount", "role": "Lbl", "content": "\lpsb@escapeJSON{#1}", "page": \thepage}}%
        \lpsb@origitem[#1]%
    \fi
}

% Case 2: \item called without arguments (uses default label/number)
\def\lpsb@item@noopt{%
    \iflpsb@inbib
        \lpsb@origitem
    \else
        \iflpsbInListItem
            \lpsbParaEnd% Close any open paragraph
            \lpsbWriteEntry{{"id": "LI-\the\lpsbItemCount", "role": "LI", "event": "end", "page": \thepage}}%
        \fi
        \global\advance\lpsbItemCount by 1%
        \lpsbInListItemtrue
        \lpsbWriteEntry{{"id": "LI-\the\lpsbItemCount", "role": "LI", "event": "start", "page": \thepage}}%
        \lpsb@origitem
    \fi
}

}% End AtBeginDocument for item redefinition

% Helper macro to hook list environments manually
\newcommand{\lpsbHookList}[1]{%
    \AtBeginEnvironment{#1}{%
        \global\advance\lpsbEnvDepth by 1%
        \lpsbWriteEntry{{"id": "#1-\the\lpsbEnvDepth", "role": "L", "event": "start", "depth": \the\lpsbEnvDepth, "page": \thepage}}%
        \lpsbInListItemfalse%
    }%
    \AtEndEnvironment{#1}{%
        \lpsbParaEnd% Close any open paragraph in the last item
        \iflpsbInListItem
            \lpsbWriteEntry{{"id": "LI-\the\lpsbItemCount", "role": "LI", "event": "end", "page": \thepage}}%
        \fi
        \lpsbWriteEntry{{"id": "#1-\the\lpsbEnvDepth", "role": "L", "event": "end", "depth": \the\lpsbEnvDepth, "page": \thepage}}%
        \global\advance\lpsbEnvDepth by -1%
    }%
}
\AtBeginDocument{%
\lpsbHookList{itemize}
\lpsbHookList{enumerate}
\lpsbHookList{description}
}

