% rotating package: sidewaystable (rotated float)
% Hook by name; if the environment doesn't exist, the hook is ignored.
\AddToHook{env/sidewaystable/begin}{%
    \lpsbParaEnd%
    \global\advance\lpsbEnvDepth by 1%
    \global\advance\lpsbTableCount by 1%
    \lpsbWriteEntry{{"id": "Table-\the\lpsbTableCount", "role": "Table", "event": "start", "depth": \the\lpsbEnvDepth, "page": \thepage, "env": "sidewaystable", "rotated": true}}%
}%
\AddToHook{env/sidewaystable/end}{%
    \lpsbParaEnd%
    \lpsbWriteEntry{{"id": "Table-\the\lpsbTableCount", "role": "Table", "event": "end", "depth": \the\lpsbEnvDepth, "page": \thepage, "env": "sidewaystable", "rotated": true}}%
    \global\advance\lpsbEnvDepth by -1%
}%

% Special hook for Math environments - uses context-aware IDs for cross-compilation alignment
\newcommand{\lpsbHookMath}[1]{%  #1=env name
    \AtBeginEnvironment{#1}{%
        \lpsbParaEnd% Close any open paragraph before math starts
        \global\advance\lpsbDisplayMathCount by 1%
        \global\advance\lpsbDisplayMathInContext by 1%
        \lpsbWriteEntry{{"id": "Sec-\the\lpsbMathContextNum-Math-\the\lpsbDisplayMathInContext", "role": "Formula", "event": "start", "env": "#1", "page": \thepage}}%
    }%
    \AtEndEnvironment{#1}{%
        \lpsbWriteEntry{{"id": "Sec-\the\lpsbMathContextNum-Math-\the\lpsbDisplayMathInContext", "role": "Formula", "event": "end", "page": \thepage}}%
    }%
}
\lpsbHookMath{equation}
\lpsbHookMath{equation*}
\lpsbHookMath{align}
\lpsbHookMath{align*}
\lpsbHookMath{gather}
\lpsbHookMath{gather*}
\lpsbHookMath{multline}
\lpsbHookMath{multline*}
\lpsbHookMath{eqnarray}
\lpsbHookMath{eqnarray*}
\lpsbHookMath{displaymath}
\lpsbHookMath{flalign}
\lpsbHookMath{flalign*}
