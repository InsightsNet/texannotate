            \lpsb@origce{#1}%
            \lpsbWriteEntry{{"role": "Formula", "event": "end", "subtype": "chemistry", "page": "\thepage"}}%
        }%
        \typeout{LPSB Info: Hooked mhchem \\ce command}%
    }{}%
    % Hook \chemfig (chemfig package) for structural formulas
    \@ifpackageloaded{chemfig}{%
        \let\lpsb@origchemfig\chemfig
        \renewcommand{\chemfig}[1]{%
            \lpsbWriteEntry{{"role": "Figure", "event": "start", "subtype": "chemistry", "cmd": "chemfig", "page": "\thepage"}}%
            \lpsb@origchemfig{#1}%
            \lpsbWriteEntry{{"role": "Figure", "event": "end", "subtype": "chemistry", "page": "\thepage"}}%
        }%
        \typeout{LPSB Info: Hooked chemfig \\chemfig command}%
    }{}%
    % Hook \SI and \si (siunitx package) for SI units
    \@ifpackageloaded{siunitx}{%
        \let\lpsb@origSI\SI
        \renewcommand{\SI}[2]{%
            \lpsbWriteEntry{{"role": "Span", "event": "start", "subtype": "unit", "cmd": "SI", "page": "\thepage"}}%
            \lpsb@origSI{#1}{#2}%
            \lpsbWriteEntry{{"role": "Span", "event": "end", "subtype": "unit", "page": "\thepage"}}%
        }%
        \let\lpsb@origsi\si
        \renewcommand{\si}[1]{%
            \lpsbWriteEntry{{"role": "Span", "event": "start", "subtype": "unit", "cmd": "si", "page": "\thepage"}}%
            \lpsb@origsi{#1}%
            \lpsbWriteEntry{{"role": "Span", "event": "end", "subtype": "unit", "page": "\thepage"}}%
        }%
        \typeout{LPSB Info: Hooked siunitx commands}%
    }{}%
}

% ===================================================================
% Label Hooks and Section Hooks (After Package Loading)
% ===================================================================
\AtBeginDocument{%
    % ACM template detection - must happen first, before any conditional checks below
    \@ifclassloaded{acmart}{\global\lpsb@isacmarttrue\typeout{LPSB: Detected acmart class}}{}%
    %
    % Hyperref compatibility: disable LPSB commands during PDF bookmark generation
    % When hyperref processes section titles for PDF bookmarks, it expands many commands
    % This can cause conflicts with LPSB hooks that write to files or use special catcodes
    \@ifpackageloaded{hyperref}{%
        % hyperref's pdfstringdef context may include \par tokens. Also, our probe has 3 args.
        % Use long gobblers with the correct arity.
        \long\def\lpsb@pdfstring@gobbleone#1{}%
        \long\def\lpsb@pdfstring@gobblethree#1#2#3{}%
        \pdfstringdefDisableCommands{%
            \let\lpsbWriteEntry\lpsb@pdfstring@gobbleone
            \let\lpsbProbe\lpsb@pdfstring@gobblethree
            \let\zsavepos\@gobble
            \let\zposx\@gobble
            \let\zposy\@gobble
        }%
        \typeout{LPSB Info: Hyperref compatibility enabled}%
    }{}%
    %
    % Mark LPSB as active - inline formatting hooks will only log after this point
    % For ACM templates (acmart), we delay activation until after \maketitle
    % because ACM's title page construction triggers para hooks prematurely
    \iflpsb@isacmart
        \lpsbActivefalse% Stay inactive until maketitle completes
        % Hook into \maketitle to activate afterward AND capture abstract
        \let\lpsb@orig@maketitle\maketitle
        \renewcommand{\maketitle}{%
            % Hook @mkabstract to capture abstract at render time (inside maketitle)
            % This avoids the blank page issue caused by hooks during abstract definition
            \let\lpsb@orig@mkabstract\@mkabstract
            \def\@mkabstract{%
                \lpsbActivetrue% Temporarily activate for abstract capture
                \global\advance\lpsbEnvDepth by 1%
                \lpsbWriteEntry{{"id": "abstract-\the\lpsbEnvDepth", "role": "Sect", "event": "start", "depth": \the\lpsbEnvDepth, "page": "\thepage"}}%
                \lpsb@orig@mkabstract
                \lpsbWriteEntry{{"id": "abstract-\the\lpsbEnvDepth", "role": "Sect", "event": "end", "depth": \the\lpsbEnvDepth, "page": "\thepage"}}%
                \global\advance\lpsbEnvDepth by -1%
            }%
            \lpsb@orig@maketitle
            \lpsbActivetrue% Now activate LPSB for rest of document
        }%
    \else
        \lpsbActivetrue
    \fi
    %
    % Paragraph hooks (kernel-level, robust across environments)
    \lpsb@AddToHook{para/begin}{\lpsb@ParaBegin}%
    \lpsb@AddToHook{para/end}{\lpsb@ParaEnd}%
    %
    % Hook \label for references
    \let\lpsb@origlabel\label
    \renewcommand{\label}[1]{%
        \zsavepos{lpsb-label-#1-start}%
        \lpsbProbe{label-#1}{Reference}{, "target": "#1"}%
        \lpsb@origlabel{#1}%
    }%
    %
    % Hook thebibliography environment (conditional - may not exist in all documents)
    % Now records environment boundaries AND each \bibitem, while keeping \item hook disabled
    % IMPORTANT: Skip for packages/classes with incompatible \thebibliography redefinitions
    \newif\iflpsb@skipbiblhook
    \lpsb@skipbiblhookfalse
    \@ifpackageloaded{NJDnatbib}{\lpsb@skipbiblhooktrue}{}%  % WileyNJD-v2 class
    \iflpsb@skipbiblhook
        \typeout{LPSB Info: Skipping thebibliography hook (known conflict detected)}%
        % Still mark bibliography scope so other hooks can stay out of the way.
        % (Without this, paragraph/section hooks can fire inside bibliography and
        % interact badly with hyperref/bookmark PDF-string processing.)
        \@ifundefined{thebibliography}{}{%
            \let\lpsb@origthebibliography\thebibliography
            \let\lpsb@origendthebibliography\endthebibliography
            \renewcommand{\thebibliography}[1]{%
                \lpsb@inbibtrue%
                \lpsb@origthebibliography{#1}%
            }%
            \renewcommand{\endthebibliography}{%
                \lpsb@origendthebibliography%
                \lpsb@inbibfalse%
            }%
        }%
    \else
        \@ifundefined{thebibliography}{}{%
            \let\lpsb@origthebibliography\thebibliography
            \let\lpsb@origendthebibliography\endthebibliography
            \renewcommand{\thebibliography}[1]{%
                \lpsb@inbibtrue%
                \lpsbParaEnd%
                \global\advance\lpsbEnvDepth by 1%
                \global\advance\lpsbListCount by 1%
                \zsavepos{lpsb-BibList-\the\lpsbListCount-start}%
                \lpsbWriteEntry{{"id": "BibList-\the\lpsbListCount", "role": "BibList", "event": "start", "depth": \the\lpsbEnvDepth, "page": "\thepage"}}%
                \def\lpsbCurrentBibID{\the\lpsbListCount}%
                \lpsb@origthebibliography{#1}%
            }%
            \renewcommand{\endthebibliography}{%
                \lpsbParaEnd%
                \@ifundefined{lpsbCurrentBibID}{\def\lpsbCurrentBibID{0}}{}%
                \zsavepos{lpsb-BibList-\lpsbCurrentBibID-end}%
                \lpsbWriteEntry{{"id": "BibList-\lpsbCurrentBibID", "role": "BibList", "event": "end", "depth": \the\lpsbEnvDepth, "page": "\thepage"}}%
                \global\advance\lpsbEnvDepth by -1%
                \lpsb@origendthebibliography%
                \lpsb@inbibfalse%
            }%
        }%
    \fi
    % Hook \bibitem to track individual bibliography entries
    % IMPORTANT: Must support optional argument for natbib author-year mode: \bibitem[Author(Year)]{key}
    \@ifundefined{bibitem}{}{%
        \let\lpsb@origbibitem\bibitem
        \def\bibitem{%
            \@ifnextchar[{\lpsb@bibitem@opt}{\lpsb@bibitem@noopt}%
        }%
        \def\lpsb@bibitem@opt[#1]#2{%
            \lpsbWriteEntry{{"role": "BibEntry", "event": "item", "key": "#2", "page": "\thepage"}}%
            \lpsb@origbibitem[#1]{#2}%
        }%
        \def\lpsb@bibitem@noopt#1{%
            \lpsbWriteEntry{{"role": "BibEntry", "event": "item", "key": "#1", "page": "\thepage"}}%
            \lpsb@origbibitem{#1}%
        }%
    }%
    %
    % Hook inline math \( ... \)
    % NOTE:
    % We deliberately do NOT hook \( \) here.
    % Inline math is handled centrally via \everymath above, which covers BOTH
    % $...$ and \( ... \) and emits zref labels for gold (aux) positions.
    % Keep the original definitions intact.
    \let\lpsb@origopenmath\(
    \let\lpsb@origclosemath\)
    \def\({\lpsb@origopenmath}%
    \def\){\lpsb@origclosemath}%
    % Heading hook
    % - \lpsbSectionNum increments for every heading level (used for heading IDs).
    % - \lpsbMathContextNum increments only for top-level headings (used for math IDs).
    \let\lpsb@origsect\@sect
    \def\@sect#1#2#3#4#5#6[#7]#8{%
        % Check if CVPR already handled this section (skip flag set)
        \iflpsb@skipsect
            % Skip JSON output, just call original
            \lpsb@origsect{#1}{#2}{#3}{#4}{#5}{#6}[{#7}]{#8}%
        \else\iflpsb@inbib
            % Don't emit structure entries while in bibliography.
            \lpsb@origsect{#1}{#2}{#3}{#4}{#5}{#6}[{#7}]{#8}%
        \else
            \lpsbParaEnd% Close any open paragraph before section starts
            % Always increment heading counter (used for H-* IDs)
            \global\advance\lpsbSectionNum by 1%
            % Only bump math context on top-level headings (chapter/section in most classes)
            \ifnum#2<2\relax
                \global\advance\lpsbMathContextNum by 1%
                \global\lpsbDisplayMathInContext=0%
                \global\lpsbInlineMathInContext=0%
                % Sync with Lua if LuaTeX (for lpsb-math.lua alignment)
                \ifLuaTeX
                    \directlua{%
                        if lpsb_math and lpsb_math.new_section then
                            lpsb_math.new_section(tex.count["lpsbMathContextNum"] or 0)
                        end
                    }%
                \fi
            \fi
            % Save position BEFORE heading (for start coordinates)
            \zsavepos{lpsb-H-\the\lpsbSectionNum-start}%
            % #2 = level (0=chapter, 1=section, 2=subsection, etc)
            % #8 = title text
            % Ensure level is numeric even if LaTeX passes macros like \@M (e.g. TOC internals).
            \lpsbWriteEntry{{"id": "H-\the\lpsbSectionNum", "role": "\lpsb@levelToH{#2}", "event": "start", "level": \number#2, "title": "\lpsb@escapeJSON{#8}", "page": "\thepage", "x": \zposx{lpsb-H-\the\lpsbSectionNum-start}, "y": \zposy{lpsb-H-\the\lpsbSectionNum-start}}}%
            \lpsb@origsect{#1}{#2}{#3}{#4}{#5}{#6}[{#7}]{#8}%
            % Save position AFTER heading (for end/dimension calculation)
            \zsavepos{lpsb-H-\the\lpsbSectionNum-end}%
            \lpsbWriteEntry{{"id": "H-\the\lpsbSectionNum", "role": "\lpsb@levelToH{#2}", "event": "end", "page": "\thepage", "x": \zposx{lpsb-H-\the\lpsbSectionNum-end}, "y": \zposy{lpsb-H-\the\lpsbSectionNum-end}}}%
        \fi\fi
    }%
    %
    % Hook \@ssect for starred sections (e.g., \section*).
    % NOTE: Some classes (e.g., WileyNJD-v2 + NJDnatbib) define \@ssect with 6 args:
    %   \@ssect{level}{indent}{beforeskip}{afterskip}{style}{title}
    % while the LaTeX kernel uses 5 args. Hook the correct signature.
    \@ifclassloaded{WileyNJD-v2}{%
        \let\lpsb@origssect\@ssect
        \def\@ssect#1#2#3#4#5#6{%
            \iflpsb@skipsect
                \lpsb@origssect{#1}{#2}{#3}{#4}{#5}{#6}%
            \else\iflpsb@inbib
                \lpsb@origssect{#1}{#2}{#3}{#4}{#5}{#6}%
            \else
                \edef\lpsb@temp{\detokenize{#6}}%
                \expandafter\lpsb@checkfirstchar\lpsb@temp\relax\relax
                \iflpsb@internalcontent
                    \lpsb@origssect{#1}{#2}{#3}{#4}{#5}{#6}%
                \else
                    \lpsbWriteEntry{{"id": "H-starred-\the\lpsbEnvDepth", "role": "H", "event": "start", "title": "\lpsb@escapeJSON{#6}", "page": "\thepage"}}%
                    \lpsb@origssect{#1}{#2}{#3}{#4}{#5}{#6}%
                    \lpsbWriteEntry{{"id": "H-starred-\the\lpsbEnvDepth", "role": "H", "event": "end", "page": "\thepage"}}%
                \fi
            \fi\fi
        }%
    }{%
        \let\lpsb@origssect\@ssect
        \def\@ssect#1#2#3#4#5{%
            \iflpsb@skipsect
                \lpsb@origssect{#1}{#2}{#3}{#4}{#5}%
            \else\iflpsb@inbib
                \lpsb@origssect{#1}{#2}{#3}{#4}{#5}%
            \else
                \edef\lpsb@temp{\detokenize{#5}}%
                \expandafter\lpsb@checkfirstchar\lpsb@temp\relax\relax
                \iflpsb@internalcontent
                    \lpsb@origssect{#1}{#2}{#3}{#4}{#5}%
                \else
                    \lpsbWriteEntry{{"id": "H-starred-\the\lpsbEnvDepth", "role": "H", "event": "start", "title": "\lpsb@escapeJSON{#5}", "page": "\thepage"}}%
                    \lpsb@origssect{#1}{#2}{#3}{#4}{#5}%
                    \lpsbWriteEntry{{"id": "H-starred-\the\lpsbEnvDepth", "role": "H", "event": "end", "page": "\thepage"}}%
                \fi
            \fi\fi
        }%
    }%
    % Helper to detect if first char is backslash (internal macro indicator)
    \newif\iflpsb@internalcontent
    \def\lpsb@checkfirstchar#1#2\relax{%
        \lpsb@internalcontentfalse
        \if\noexpand#1\@backslashchar
            \lpsb@internalcontenttrue
        \fi
    }%
    %
    % ===================================================================
    % titlesec Compatibility
    % ===================================================================
    % titlesec completely rewrites section handling, bypassing \@sect.
    % Hook \ttl@straight@ii which is called for standard section formatting.
    \@ifundefined{ttl@straight@ii}{}{%
        \typeout{LPSB Info: titlesec detected, hooking ttl@straight@ii}%
        \let\lpsb@origttlstraight\ttl@straight@ii
        % ttl@straight@ii has 7 params: #1=name #2=level #3-6=format #7=title
        \def\ttl@straight@ii#1#2#3#4#5#6#7{%
            \lpsbParaEnd%
            \global\advance\lpsbSectionNum by 1%
            \lpsbWriteEntry{{"id": "H-\the\lpsbSectionNum", "role": "\lpsb@levelToH{#2}", "event": "start", "level": \number#2, "title": "\detokenize{#7}", "page": "\thepage"}}%
            \lpsb@origttlstraight{#1}{#2}{#3}{#4}{#5}{#6}{#7}%
            \lpsbWriteEntry{{"id": "H-\the\lpsbSectionNum", "role": "\lpsb@levelToH{#2}", "event": "end", "page": "\thepage"}}%
        }%
    }%
    %
    % ===================================================================
    % ===================================================================
    % REVTeX (revtex4-2, revtex4-1) rewrites \@startsection to call \@sect@ltx
    % instead of \@sect, bypassing our hook. Detect and wrap these commands.
    \@ifundefined{@sect@ltx}{}{%
        \typeout{LPSB Info: REVTeX detected, hooking @sect@ltx}%
        \let\lpsb@origsectltx\@sect@ltx
        % REVTeX \@sect@ltx has signature: #1=name #2=level #3=indent #4=beforeskip #5=afterskip #6=style [#7]=toc [#8]=title
        % Note: REVTeX uses \@dblarg so we get both [#7] and #8
        \def\@sect@ltx#1#2#3#4#5#6[#7]#8{%
            \lpsbParaEnd%
            \global\advance\lpsbSectionNum by 1%
            \ifnum#2<2\relax
                \global\advance\lpsbMathContextNum by 1%
                \global\lpsbDisplayMathInContext=0%
                \global\lpsbInlineMathInContext=0%
            \fi
            \lpsbWriteEntry{{"id": "H-\the\lpsbSectionNum", "role": "\lpsb@levelToH{#2}", "event": "start", "level": \number#2, "title": "\lpsb@escapeJSON{#8}", "page": "\thepage"}}%
            \lpsb@origsectltx{#1}{#2}{#3}{#4}{#5}{#6}[{#7}]{#8}%
            \lpsbWriteEntry{{"id": "H-\the\lpsbSectionNum", "role": "\lpsb@levelToH{#2}", "event": "end", "page": "\thepage"}}%
        }%
    }%
    \@ifundefined{@ssect@ltx}{}{%
        \typeout{LPSB Info: REVTeX detected, hooking @ssect@ltx}%
        \let\lpsb@origssectltx\@ssect@ltx
        % REVTeX \@ssect@ltx signature: #1=name #2=level #3=indent #4=beforeskip #5=afterskip #6=style [#7]=unused [#8]=title
        \def\@ssect@ltx#1#2#3#4#5#6[#7]#8{%
            \lpsbParaEnd%
            \global\advance\lpsbSectionNum by 1%
            \lpsbWriteEntry{{"id": "H-starred-\the\lpsbSectionNum", "role": "\lpsb@levelToH{#2}", "event": "start", "level": \number#2, "title": "\lpsb@escapeJSON{#8}", "page": "\thepage"}}%
            \lpsb@origssectltx{#1}{#2}{#3}{#4}{#5}{#6}[{#7}]{#8}%
            \lpsbWriteEntry{{"id": "H-starred-\the\lpsbSectionNum", "role": "\lpsb@levelToH{#2}", "event": "end", "page": "\thepage"}}%
        }%
    }%
    %
    % ===================================================================
    % Chapter Support (book, memoir, report classes)
    % ===================================================================
    % book/memoir/report use \@chapter and \@schapter for chapters instead of \@sect
    \@ifundefined{@chapter}{}{%
        \typeout{LPSB Info: Chapter support detected, hooking @chapter}%
        \let\lpsb@origchapter\@chapter
        % \@chapter signature: [#1]=toc entry #2=title
        \def\@chapter[#1]#2{%
            \lpsbParaEnd%
            \global\advance\lpsbSectionNum by 1%
            % Chapters are level 0, increment math context
            \global\advance\lpsbMathContextNum by 1%
            \global\lpsbDisplayMathInContext=0%
            \global\lpsbInlineMathInContext=0%
            \lpsbWriteEntry{{"id": "H-\the\lpsbSectionNum", "role": "H1", "event": "start", "level": 0, "title": "\lpsb@escapeJSON{#2}", "page": "\thepage"}}%
            \lpsb@origchapter[{#1}]{#2}%
            \lpsbWriteEntry{{"id": "H-\the\lpsbSectionNum", "role": "H1", "event": "end", "page": "\thepage"}}%
        }%
    }%
    \@ifundefined{@schapter}{}{%
        \typeout{LPSB Info: Chapter support detected, hooking @schapter}%
        \let\lpsb@origschapter\@schapter
        % \@schapter signature: #1=title (starred chapter)
        \def\@schapter#1{%
            \lpsbParaEnd%
            \global\advance\lpsbSectionNum by 1%
            \lpsbWriteEntry{{"id": "H-starred-\the\lpsbSectionNum", "role": "H1", "event": "start", "level": 0, "title": "\lpsb@escapeJSON{#1}", "page": "\thepage"}}%
            \lpsb@origschapter{#1}%
            \lpsbWriteEntry{{"id": "H-starred-\the\lpsbSectionNum", "role": "H1", "event": "end", "page": "\thepage"}}%
        }%
    }%
    %
    % ===================================================================
    % memoir Compatibility
    % ===================================================================
    % memoir uses \M@sect for sections, with a different signature (two optional args).
    % \M@sect signature: #1..#6 then [#7][#8] #9
    \@ifundefined{M@sect}{}{%
        \typeout{LPSB Info: memoir detected, hooking M@sect}%
        \let\lpsb@origMsect\M@sect
        \def\M@sect#1#2#3#4#5#6[#7][#8]#9{%
            \lpsbParaEnd%
            \global\advance\lpsbSectionNum by 1%
            \ifnum#2<2\relax
                \global\advance\lpsbMathContextNum by 1%
                \global\lpsbDisplayMathInContext=0%
                \global\lpsbInlineMathInContext=0%
            \fi
            \lpsbWriteEntry{{"id": "H-\the\lpsbSectionNum", "role": "\lpsb@levelToH{#2}", "event": "start", "level": \number#2, "title": "\lpsb@escapeJSON{#9}", "page": "\thepage"}}%
            \lpsb@origMsect{#1}{#2}{#3}{#4}{#5}{#6}[{#7}][{#8}]{#9}%
            \lpsbWriteEntry{{"id": "H-\the\lpsbSectionNum", "role": "\lpsb@levelToH{#2}", "event": "end", "page": "\thepage"}}%
        }%
    }%
    %
    % ===================================================================
    % KOMA-Script Compatibility (scrartcl, scrbook, scrreprt)
    % ===================================================================
    % KOMA-Script uses \scr@sect and \scr@ssect instead of \@sect/\@ssect
    \@ifundefined{scr@sect}{}{%
        \typeout{LPSB Info: KOMA-Script detected, hooking scr@sect}%
        \let\lpsb@origscrsect\scr@sect
        % \scr@sect signature: same as \@sect: #1..#6 [#7] #8
        \def\scr@sect#1#2#3#4#5#6[#7]#8{%
            \lpsbParaEnd%
            \global\advance\lpsbSectionNum by 1%
            \ifnum#2<2\relax
                \global\advance\lpsbMathContextNum by 1%
                \global\lpsbDisplayMathInContext=0%
                \global\lpsbInlineMathInContext=0%
            \fi
            \lpsbWriteEntry{{"id": "H-\the\lpsbSectionNum", "role": "\lpsb@levelToH{#2}", "event": "start", "level": \number#2, "title": "\lpsb@escapeJSON{#8}", "page": "\thepage"}}%
            \lpsb@origscrsect{#1}{#2}{#3}{#4}{#5}{#6}[{#7}]{#8}%
            \lpsbWriteEntry{{"id": "H-\the\lpsbSectionNum", "role": "\lpsb@levelToH{#2}", "event": "end", "page": "\thepage"}}%
        }%
    }%
    \@ifundefined{scr@ssect}{}{%
        \typeout{LPSB Info: KOMA-Script detected, hooking scr@ssect}%
        \let\lpsb@origscrssect\scr@ssect
        % \scr@ssect signature: #1..#5 (starred sections)
        \def\scr@ssect#1#2#3#4#5{%
            \lpsbParaEnd%
            \global\advance\lpsbSectionNum by 1%
            \lpsbWriteEntry{{"id": "H-starred-\the\lpsbSectionNum", "role": "H", "event": "start", "title": "\lpsb@escapeJSON{#5}", "page": "\thepage"}}%
            \lpsb@origscrssect{#1}{#2}{#3}{#4}{#5}%
            \lpsbWriteEntry{{"id": "H-starred-\the\lpsbSectionNum", "role": "H", "event": "end", "page": "\thepage"}}%
        }%
    }%
    %
    % ===================================================================
    % ICML Compatibility
    % ===================================================================
    % ICML uses \@sict instead of \@sect (typo for "section"?)
    \@ifundefined{@sict}{}{%
        \typeout{LPSB Info: ICML detected, hooking @sict}%
        \let\lpsb@origsict\@sict
        % \@sict signature: #1..#6 [#7] #8 (same as \@sect)
        \def\@sict#1#2#3#4#5#6[#7]#8{%
            \lpsbParaEnd%
            \global\advance\lpsbSectionNum by 1%
            \ifnum#2<2\relax
                \global\advance\lpsbMathContextNum by 1%
                \global\lpsbDisplayMathInContext=0%
                \global\lpsbInlineMathInContext=0%
            \fi
            \lpsbWriteEntry{{"id": "H-\the\lpsbSectionNum", "role": "\lpsb@levelToH{#2}", "event": "start", "level": \number#2, "title": "\lpsb@escapeJSON{#8}", "page": "\thepage"}}%
            \lpsb@origsict{#1}{#2}{#3}{#4}{#5}{#6}[{#7}]{#8}%
            \lpsbWriteEntry{{"id": "H-\the\lpsbSectionNum", "role": "\lpsb@levelToH{#2}", "event": "end", "page": "\thepage"}}%
        }%
    }%
    %
    % ===================================================================
    % CVPR/ICCV Compatibility 
    % ===================================================================
    % CVPR wraps titles with \texorpdfstring which causes JSON escape issues
    % Hook the wrapper commands to get clean titles
    % Define a skip flag for CVPR sections to prevent duplicate events
    \newif\iflpsb@skipsect
    \lpsb@skipsectfalse
    \@ifundefined{cvprsect}{}{%
        \typeout{LPSB Info: CVPR detected, hooking cvprsect for clean titles}%
        \let\lpsb@origcvprsect\cvprsect
        \def\cvprsect#1{%
            \lpsbParaEnd%
            \global\advance\lpsbSectionNum by 1%
            \lpsbWriteEntry{{"id": "H-\the\lpsbSectionNum", "role": "H2", "event": "start", "level": 1, "title": "\detokenize{#1}", "page": "\thepage"}}%
            \global\lpsb@skipsecttrue% Skip the upcoming @sect event
            \lpsb@origcvprsect{#1}%
            \global\lpsb@skipsectfalse% Reset flag
            \lpsbWriteEntry{{"id": "H-\the\lpsbSectionNum", "role": "H2", "event": "end", "page": "\thepage"}}%
        }%
        \let\lpsb@origcvprsubsect\cvprsubsect
        \def\cvprsubsect#1{%
            \lpsbParaEnd%
            \global\advance\lpsbSectionNum by 1%
            \lpsbWriteEntry{{"id": "H-\the\lpsbSectionNum", "role": "H3", "event": "start", "level": 2, "title": "\detokenize{#1}", "page": "\thepage"}}%
            \global\lpsb@skipsecttrue%
            \lpsb@origcvprsubsect{#1}%
            \global\lpsb@skipsectfalse%
            \lpsbWriteEntry{{"id": "H-\the\lpsbSectionNum", "role": "H3", "event": "end", "page": "\thepage"}}%
        }%
    }%
    % Also hook ICCV (same structure as CVPR)
    \@ifundefined{iccvsect}{}{%
        \typeout{LPSB Info: ICCV detected, hooking iccvsect for clean titles}%
        \let\lpsb@origiccvsect\iccvsect
        \def\iccvsect#1{%
            \lpsbParaEnd%
            \global\advance\lpsbSectionNum by 1%
            \lpsbWriteEntry{{"id": "H-\the\lpsbSectionNum", "role": "H2", "event": "start", "level": 1, "title": "\detokenize{#1}", "page": "\thepage"}}%
            \global\lpsb@skipsecttrue%
            \lpsb@origiccvsect{#1}%
            \global\lpsb@skipsectfalse%
            \lpsbWriteEntry{{"id": "H-\the\lpsbSectionNum", "role": "H2", "event": "end", "page": "\thepage"}}%
        }%
        \let\lpsb@origiccvsubsect\iccvsubsect
        \def\iccvsubsect#1{%
            \lpsbParaEnd%
            \global\advance\lpsbSectionNum by 1%
            \lpsbWriteEntry{{"id": "H-\the\lpsbSectionNum", "role": "H3", "event": "start", "level": 2, "title": "\detokenize{#1}", "page": "\thepage"}}%
            \global\lpsb@skipsecttrue%
            \lpsb@origiccvsubsect{#1}%
            \global\lpsb@skipsectfalse%
            \lpsbWriteEntry{{"id": "H-\the\lpsbSectionNum", "role": "H3", "event": "end", "page": "\thepage"}}%
        }%
    }%
    % Avoid non-kernel macros (\AtBeginShipoutUpperLeft/\put) which may not exist.
    \lpsb@AddToHook{shipout/before}{%
        \lpsb@savepos%
        \lpsbWriteEntry{{"role": "Calibration", "page": "\thepage", "x": \the\lpsb@lastxpos, "y": \the\lpsb@lastypos}}%
    }%
    \typeout{LPSB Info: Package active (PDF 2.0 Structure Elements)}%
    %
    % Hook \href if hyperref is loaded
    \newcount\lpsbLinkCount \lpsbLinkCount=0%
    \@ifpackageloaded{hyperref}{%
        \let\lpsb@orighref\href
        \renewcommand{\href}[2]{%
            \global\advance\lpsbLinkCount by 1%
            \zsavepos{lpsb-Link-\the\lpsbLinkCount-start}%
            \lpsbWriteEntry{{"id": "Link-\the\lpsbLinkCount", "role": "Link", "event": "start", "uri": "\lpsb@escapeJSON{#1}", "page": "\thepage"}}%
            \lpsb@orighref{#1}{#2}%
            \zsavepos{lpsb-Link-\the\lpsbLinkCount-end}%
            \lpsbWriteEntry{{"id": "Link-\the\lpsbLinkCount", "role": "Link", "event": "end", "page": "\thepage"}}%
        }%
    }{}%
    %
    % Hook \footnote
    \let\lpsb@origfootnote\footnote
    \renewcommand{\footnote}[1]{%
        \global\advance\lpsbFootnoteCount by 1%
        \zsavepos{lpsb-Footnote-\the\lpsbFootnoteCount-start}%
        \lpsbWriteEntry{{"id": "Footnote-\the\lpsbFootnoteCount", "role": "Note", "event": "start", "type": "footnote", "page": "\thepage"}}%
        \lpsb@origfootnote{#1}%
        \zsavepos{lpsb-Footnote-\the\lpsbFootnoteCount-end}%
        \lpsbWriteEntry{{"id": "Footnote-\the\lpsbFootnoteCount", "role": "Note", "event": "end", "page": "\thepage"}}%
    }%
    %
    % Hook \caption (preserve optional argument)
    \let\lpsb@origcaption\caption
    \renewcommand{\caption}[2][]{%
        \global\advance\lpsbCaptionCount by 1%
        \lpsbParaEnd%
        \zsavepos{lpsb-Caption-\the\lpsbCaptionCount-start}%
        \lpsbWriteEntry{{"id": "Caption-\the\lpsbCaptionCount", "role": "Caption", "event": "start", "page": "\thepage"}}%
        \if\relax\detokenize{#1}\relax
            \lpsb@origcaption{#2}%
        \else
            \lpsb@origcaption[#1]{#2}%
        \fi
        \zsavepos{lpsb-Caption-\the\lpsbCaptionCount-end}%
        \lpsbWriteEntry{{"id": "Caption-\the\lpsbCaptionCount", "role": "Caption", "event": "end", "page": "\thepage"}}%
    }%
    %
    % IMPORTANT: Skip for packages/classes that redefine \cite in complex ways
    % causing infinite recursion with zref. This is a trade-off: we lose cite
    % position tracking but gain compatibility.
    \newif\iflpsb@skipcitehook
    \lpsb@skipcitehookfalse
    %
    % amsrefs has complex internal recursion that conflicts with hooks
    % Hooking \citedest causes input stack overflow in production documents
    % even though minimal tests work. Skip cite hook for amsrefs documents.
    \@ifpackageloaded{amsrefs}{\lpsb@skipcitehooktrue}{}%
    % Note: achemso and revtex load natbib internally, so natbib hook will work for them
    % Check for natbib - skip cite hook for now as it interferes with natbib's
    % complex citation processing (especially author-year mode)
    % TODO: Find a way to hook that doesn't break natbib's format detection
    \@ifpackageloaded{natbib}{%
        \typeout{LPSB Info: natbib detected - skipping cite hook to preserve citation display}%
        \lpsb@skipcitehooktrue
    }{}%
    %
    % Non-natbib documents: use simple hook or skip if incompatible
    \iflpsb@skipcitehook
        \typeout{LPSB Info: Skipping cite hook (known conflict with document class/packages)}%
    \else
        \@ifundefined{lpsb@origcite}{%
            \let\lpsb@origcite\cite
            \renewcommand{\cite}[2][]{%
                \global\advance\lpsbCiteCount by 1%
                \zsavepos{lpsb-Cite-\the\lpsbCiteCount-start}%
                \lpsbWriteEntry{{"id": "Cite-\the\lpsbCiteCount", "role": "Reference", "key": "\lpsb@escapeJSON{#2}", "page": "\thepage"}}%
                \if\relax\detokenize{#1}\relax
                    \lpsb@origcite{#2}%
                \else
                    \lpsb@origcite[#1]{#2}%
                \fi
            }%
        }{}%
    \fi
    %
    % Hook \ref (basic version)
    \@ifundefined{lpsb@origref}{%
        \let\lpsb@origref\ref
        \renewcommand{\ref}[1]{%
            \global\advance\lpsbRefCount by 1%
            \zsavepos{lpsb-Ref-\the\lpsbRefCount-start}%
            \lpsbWriteEntry{{"id": "Ref-\the\lpsbRefCount", "role": "Reference", "target": "\lpsb@escapeJSON{#1}", "page": "\thepage"}}%
            \lpsb@origref{#1}%
        }%
    }{}%
}

% Hook document boundaries for full page bbox
\lpsb@AddToHook{env/document/begin}{%
    \zsavepos{lpsb-Document-start}%
}
\lpsb@AddToHook{env/document/end}{%
    \zsavepos{lpsb-Document-end}%
}

\makeatother

% ===================================================================
% End of Document Cleanup
% ===================================================================
\AtEndDocument{%
    % If the document ends while TeX still considers us in a paragraph,
    % \lpsb@AddToHook{para/end} may not have fired. Close it explicitly.
    \lpsbParaEnd%
    \lpsbWriteEntry{{"role": "Footer", "total_probes": \the\lpsbProbeCount, "total_paragraphs": \the\lpsbParaCount}}%
    \iflpsbNoIO\else
        \immediate\write\lpsbout{]}%
        \immediate\closeout\lpsbout
    \fi
    \typeout{LPSB Info: Wrote \the\lpsbProbeCount\space probes, \the\lpsbParaCount\space paragraphs}%
}

\endinput
