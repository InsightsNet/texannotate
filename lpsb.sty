% ===================================================================
% LPSB Package v3.0 - LaTeX-PDF Semantic Bridge
% 
% PDF 2.0 Structure Element Support
% USAGE: \usepackage{lpsb} (after \documentclass)
% ===================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{lpsb}[2026/01/05 v3.0 LPSB Package - PDF 2.0 Structure Elements]% Engine detection and primitive compatibility
\RequirePackage{iftex}
\RequirePackage[savepos]{zref}
\ifLuaTeX
    \let\lpsb@savepos\savepos
    \let\lpsb@lastxpos\lastxpos
    \let\lpsb@lastypos\lastypos
\else
    \let\lpsb@savepos\pdfsavepos
    \let\lpsb@lastxpos\pdflastxpos
    \let\lpsb@lastypos\pdflastypos
\fi


% ===================================================================
% Counters and State
% ===================================================================
\newcount\lpsbEnvDepth
\lpsbEnvDepth=0
\newcount\lpsbProbeCount
\lpsbProbeCount=0
\newcount\lpsbParaCount
\lpsbParaCount=0
\newcount\lpsbItemCount
\lpsbItemCount=0
\newcount\lpsbCaptionCount
\newcount\lpsbCaptionCount
\lpsbCaptionCount=0
\newcount\lpsbTableCount
\lpsbTableCount=0

% Context-aware counters for cross-compilation alignment
\newcount\lpsbSectionNum
\lpsbSectionNum=0
% NOTE:
% - \lpsbSectionNum counts ALL headings (\section, \subsection, ...) and can diverge across engines.
% - For cross-engine math alignment we use a separate, coarse context counter bumped only at top-level.
\newcount\lpsbMathContextNum
\lpsbMathContextNum=0
% Separate per-context counters so display-math IDs are stable even if inline math differs.
\newcount\lpsbDisplayMathInContext
\lpsbDisplayMathInContext=0
\newcount\lpsbInlineMathInContext
\lpsbInlineMathInContext=0
\newcount\lpsbDisplayMathCount
\lpsbDisplayMathCount=0
\newcount\lpsbInlineMathCount
\lpsbInlineMathCount=0

% Flags
\newif\iflpsbActive
\lpsbActivefalse
\newif\iflpsbInPara
\lpsbInParafalse
\newif\iflpsbInListItem
\lpsbInListItemfalse

% ===================================================================
% Output File (Structure Tree JSON)
% ===================================================================
\newwrite\lpsbout
\immediate\openout\lpsbout=\jobname.lpsb.json
\immediate\write\lpsbout{[}

\newif\iflpsbFirstEntry
\lpsbFirstEntrytrue

\def\lpsbWriteEntry#1{%
    \iflpsbFirstEntry
        \immediate\write\lpsbout{#1}%
        \global\lpsbFirstEntryfalse
    \else
        \immediate\write\lpsbout{,#1}%
    \fi
}

% ===================================================================
% PDF 2.0 Role Mapping
% ===================================================================
% LaTeX section level -> PDF/UA heading level
\def\lpsb@levelToH#1{%
    \ifcase#1 H1\or H2\or H3\or H4\or H5\or H6\else H6\fi
}

% ===================================================================
% Core Probe Command
% ===================================================================
\def\lpsbProbe#1#2#3{%
    \global\advance\lpsbProbeCount by 1%
    \lpsb@savepos
    \lpsbWriteEntry{{"id": "#1", "role": "#2", "page": \thepage, "x": \the\lpsb@lastxpos, "y": \the\lpsb@lastypos #3}}%
}

% ===================================================================
% PHASE 1: Paragraphs (P) and Headings (H1-H6)
% ===================================================================

\makeatletter

% --- Paragraph Detection ---
% Prefer LaTeX paragraph hooks (para/begin, para/end) over \everypar.
% \everypar gets overwritten in many environments (lists, minipage, etc).
\def\lpsb@ParaBegin{%
    \iflpsbInPara\else
        \global\advance\lpsbParaCount by 1%
        \global\lpsbInParatrue
        \lpsbWriteEntry{{"id": "P-\the\lpsbParaCount", "role": "P", "event": "start", "page": \thepage}}%
    \fi
}

\def\lpsb@ParaEnd{%
    \iflpsbInPara
        \lpsbWriteEntry{{"id": "P-\the\lpsbParaCount", "role": "P", "event": "end", "page": \thepage}}%
        \global\lpsbInParafalse
    \fi
}

% Public wrappers (no @ in name). Useful outside \makeatletter contexts.
\let\lpsbParaBegin\lpsb@ParaBegin
\let\lpsbParaEnd\lpsb@ParaEnd

% --- Heading Detection (H1-H6) ---
% Hook internal \@sect command - must be done at AtBeginDocument to avoid hyperref conflicts
% These hooks will be installed later to ensure hyperref's modifications take precedence

% JSON Escaping - use detokenize to safely convert all special chars
\def\lpsb@escapeJSON#1{\detokenize{#1}}

% ===================================================================
% Environment Hooks (for structure context)
% ===================================================================
\newcommand{\lpsbHookEnv}[2]{%  #1=env name, #2=PDF role
    \AtBeginEnvironment{#1}{%
        \lpsbParaEnd% Close any open paragraph before environment starts
        \global\advance\lpsbEnvDepth by 1%
        \lpsbWriteEntry{{"id": "#1-\the\lpsbEnvDepth", "role": "#2", "event": "start", "depth": \the\lpsbEnvDepth, "page": \thepage}}%
    }%
    \AtEndEnvironment{#1}{%
        \lpsbWriteEntry{{"id": "#1-\the\lpsbEnvDepth", "role": "#2", "event": "end", "depth": \the\lpsbEnvDepth, "page": \thepage}}%
        \global\advance\lpsbEnvDepth by -1%
    }%
}

% Hook standard environments with PDF 2.0 roles
\lpsbHookEnv{document}{Document}
\lpsbHookEnv{abstract}{Sect}
\lpsbHookEnv{figure}{Figure}
\lpsbHookEnv{figure*}{Figure}
% Tables: use unique instance IDs and close open paragraphs before ending the float.
% NOTE: We intentionally avoid hooking tabular internals; they can perturb rule drawing.
\AtBeginEnvironment{table}{%
    \lpsbParaEnd%
    \global\advance\lpsbEnvDepth by 1%
    \global\advance\lpsbTableCount by 1%
    \lpsbWriteEntry{{"id": "Table-\the\lpsbTableCount", "role": "Table", "event": "start", "depth": \the\lpsbEnvDepth, "page": \thepage}}%
}%
\AtEndEnvironment{table}{%
    \lpsbParaEnd%
    \lpsbWriteEntry{{"id": "Table-\the\lpsbTableCount", "role": "Table", "event": "end", "depth": \the\lpsbEnvDepth, "page": \thepage}}%
    \global\advance\lpsbEnvDepth by -1%
}%
\AtBeginEnvironment{table*}{%
    \lpsbParaEnd%
    \global\advance\lpsbEnvDepth by 1%
    \global\advance\lpsbTableCount by 1%
    \lpsbWriteEntry{{"id": "Table-\the\lpsbTableCount", "role": "Table", "event": "start", "depth": \the\lpsbEnvDepth, "page": \thepage}}%
}%
\AtEndEnvironment{table*}{%
    \lpsbParaEnd%
    \lpsbWriteEntry{{"id": "Table-\the\lpsbTableCount", "role": "Table", "event": "end", "depth": \the\lpsbEnvDepth, "page": \thepage}}%
    \global\advance\lpsbEnvDepth by -1%
}%

% longtable (multi-page table, non-float)
% Use kernel env hooks so this works even if longtable is loaded after lpsb.
\AddToHook{env/longtable/begin}{%
    \lpsbParaEnd%
    \global\advance\lpsbEnvDepth by 1%
    \global\advance\lpsbTableCount by 1%
    \lpsbWriteEntry{{"id": "Table-\the\lpsbTableCount", "role": "Table", "event": "start", "depth": \the\lpsbEnvDepth, "page": \thepage, "env": "longtable"}}%
}%
\AddToHook{env/longtable/end}{%
    \lpsbParaEnd%
    \lpsbWriteEntry{{"id": "Table-\the\lpsbTableCount", "role": "Table", "event": "end", "depth": \the\lpsbEnvDepth, "page": \thepage, "env": "longtable"}}%
    \global\advance\lpsbEnvDepth by -1%
}%

% rotating package: sidewaystable (rotated float)
% Hook by name; if the environment doesn't exist, the hook is ignored.
\AddToHook{env/sidewaystable/begin}{%
    \lpsbParaEnd%
    \global\advance\lpsbEnvDepth by 1%
    \global\advance\lpsbTableCount by 1%
    \lpsbWriteEntry{{"id": "Table-\the\lpsbTableCount", "role": "Table", "event": "start", "depth": \the\lpsbEnvDepth, "page": \thepage, "env": "sidewaystable", "rotated": true}}%
}%
\AddToHook{env/sidewaystable/end}{%
    \lpsbParaEnd%
    \lpsbWriteEntry{{"id": "Table-\the\lpsbTableCount", "role": "Table", "event": "end", "depth": \the\lpsbEnvDepth, "page": \thepage, "env": "sidewaystable", "rotated": true}}%
    \global\advance\lpsbEnvDepth by -1%
}%

% Special hook for Math environments - uses context-aware IDs for cross-compilation alignment
\newcommand{\lpsbHookMath}[1]{%  #1=env name
    \AtBeginEnvironment{#1}{%
        \lpsbParaEnd% Close any open paragraph before math starts
        \global\advance\lpsbDisplayMathCount by 1%
        \global\advance\lpsbDisplayMathInContext by 1%
        \lpsbWriteEntry{{"id": "Sec-\the\lpsbMathContextNum-Math-\the\lpsbDisplayMathInContext", "role": "Formula", "event": "start", "env": "#1", "page": \thepage}}%
    }%
    \AtEndEnvironment{#1}{%
        \lpsbWriteEntry{{"id": "Sec-\the\lpsbMathContextNum-Math-\the\lpsbDisplayMathInContext", "role": "Formula", "event": "end", "page": \thepage}}%
    }%
}
\lpsbHookMath{equation}
\lpsbHookMath{equation*}
\lpsbHookMath{align}
\lpsbHookMath{align*}
\lpsbHookMath{gather}
\lpsbHookMath{gather*}
\lpsbHookMath{gather*}
% \lpsbHookEnv{itemize}{L}     % Handled manually for LI closure
% \lpsbHookEnv{enumerate}{L}   % Handled manually for LI closure
% \lpsbHookEnv{description}{L} % Handled manually for LI closure
\lpsbHookEnv{quote}{BlockQuote}
\lpsbHookEnv{quotation}{BlockQuote}
\lpsbHookEnv{center}{Div}
\lpsbHookEnv{verbatim}{Code}
\lpsbHookEnv{minipage}{Div}
% \lpsbHookEnv{tabular}{Table} % Handled manually for TR nesting
%\lpsbHookEnv{thebibliography}{BibEntry}  % Disabled - interferes with bibliography numbering

% ===================================================================
% List Item Hooks (LI, Lbl, LBody)
% ===================================================================
\newif\iflpsb@inbib
\lpsb@inbibfalse

% Hook thebibliography environment (deferred to avoid undefined command errors)
% Note: \thebibliography may not exist at package load time, so we hook it conditionally

% Redefine \item to preserve optional argument behavior
% We must use \def and \@ifnextchar distinct paths to avoid forcing an empty optional argument
% causing \item[] which suppresses default labels (e.g., bibliography numbers)

% Defer to AtBeginDocument to ensure we patch after packages like enumitem
\AtBeginDocument{%
\let\lpsb@origitem\item

\def\item{%
    \@ifnextchar[\lpsb@item@opt\lpsb@item@noopt
}

% Case 1: \item[...] provided
\def\lpsb@item@opt[#1]{%
    \iflpsb@inbib
        \lpsb@origitem[#1]%
    \else
        \iflpsbInListItem
            \lpsbParaEnd% Close any open paragraph
            \lpsbWriteEntry{{"id": "LI-\the\lpsbItemCount", "role": "LI", "event": "end", "page": \thepage}}%
        \fi
        \global\advance\lpsbItemCount by 1%
        \lpsbInListItemtrue
        \lpsbWriteEntry{{"id": "LI-\the\lpsbItemCount", "role": "LI", "event": "start", "page": \thepage}}%
        \lpsbWriteEntry{{"id": "Lbl-\the\lpsbItemCount", "role": "Lbl", "content": "\lpsb@escapeJSON{#1}", "page": \thepage}}%
        \lpsb@origitem[#1]%
    \fi
}

% Case 2: \item called without arguments (uses default label/number)
\def\lpsb@item@noopt{%
    \iflpsb@inbib
        \lpsb@origitem
    \else
        \iflpsbInListItem
            \lpsbParaEnd% Close any open paragraph
            \lpsbWriteEntry{{"id": "LI-\the\lpsbItemCount", "role": "LI", "event": "end", "page": \thepage}}%
        \fi
        \global\advance\lpsbItemCount by 1%
        \lpsbInListItemtrue
        \lpsbWriteEntry{{"id": "LI-\the\lpsbItemCount", "role": "LI", "event": "start", "page": \thepage}}%
        \lpsb@origitem
    \fi
}

}% End AtBeginDocument for item redefinition

% Helper macro to hook list environments manually
\newcommand{\lpsbHookList}[1]{%
    \AtBeginEnvironment{#1}{%
        \global\advance\lpsbEnvDepth by 1%
        \lpsbWriteEntry{{"id": "#1-\the\lpsbEnvDepth", "role": "L", "event": "start", "depth": \the\lpsbEnvDepth, "page": \thepage}}%
        \lpsbInListItemfalse%
    }%
    \AtEndEnvironment{#1}{%
        \lpsbParaEnd% Close any open paragraph in the last item
        \iflpsbInListItem
            \lpsbWriteEntry{{"id": "LI-\the\lpsbItemCount", "role": "LI", "event": "end", "page": \thepage}}%
        \fi
        \lpsbWriteEntry{{"id": "#1-\the\lpsbEnvDepth", "role": "L", "event": "end", "depth": \the\lpsbEnvDepth, "page": \thepage}}%
        \global\advance\lpsbEnvDepth by -1%
    }%
}
\AtBeginDocument{%
\lpsbHookList{itemize}
\lpsbHookList{enumerate}
\lpsbHookList{description}
}

% ===================================================================
% PHASE 2-4: Caption, Table Cells, Inline Formatting
% ===================================================================

% --- Caption Hook (deferred to AtBeginDocument for compatibility) ---
\newcount\lpsbCaptionCount
\lpsbCaptionCount=0

% --- Tables ---
% IMPORTANT: Do NOT hook `tabular` internals. Even seemingly harmless injections at
% environment begin/end can perturb alignment/rule drawing in some documents.
% We rely on the outer `table` environment for the Table container role.

% --- Inline Text Formatting ---
% Hook \textbf for strong emphasis
\let\lpsb@origtextbf\textbf
\renewcommand{\textbf}[1]{%
    \ifvmode\leavevmode\fi% Ensure paragraph starts first
    \lpsbWriteEntry{{"role": "Strong", "event": "start", "page": \thepage}}%
    \lpsb@origtextbf{#1}%
    \lpsbWriteEntry{{"role": "Strong", "event": "end", "page": \thepage}}%
}

% Hook \textit for italic
\let\lpsb@origtextit\textit
\renewcommand{\textit}[1]{%
    \ifvmode\leavevmode\fi% Ensure paragraph starts first
    \lpsbWriteEntry{{"role": "Em", "event": "start", "page": \thepage}}%
    \lpsb@origtextit{#1}%
    \lpsbWriteEntry{{"role": "Em", "event": "end", "page": \thepage}}%
}

% Hook \emph
\let\lpsb@origemph\emph
\renewcommand{\emph}[1]{%
    \ifvmode\leavevmode\fi% Ensure paragraph starts first
    \lpsbWriteEntry{{"role": "Em", "event": "start", "page": \thepage}}%
    \lpsb@origemph{#1}%
    \lpsbWriteEntry{{"role": "Em", "event": "end", "page": \thepage}}%
}

% ===================================================================
% Label Hooks and Section Hooks (After Package Loading)
% ===================================================================
\AtBeginDocument{%
    % Paragraph hooks (kernel-level, robust across environments)
    \AddToHook{para/begin}{\lpsb@ParaBegin}%
    \AddToHook{para/end}{\lpsb@ParaEnd}%
    %
    % Hook \label for references
    \let\lpsb@origlabel\label
    \renewcommand{\label}[1]{%
        \lpsbProbe{label-#1}{Reference}{, "target": "#1"}%
        \lpsb@origlabel{#1}%
    }%
    %
    % Hook thebibliography environment (conditional - may not exist in all documents)
    \@ifundefined{thebibliography}{}{%
        \let\lpsb@origthebibliography\thebibliography
        \let\lpsb@origendthebibliography\endthebibliography
        \renewcommand{\thebibliography}[1]{%
            \lpsb@inbibtrue%
            \lpsb@origthebibliography{#1}%
        }%
        \renewcommand{\endthebibliography}{%
            \lpsb@origendthebibliography%
            \lpsb@inbibfalse%
        }%
    }%
    %
    % Hook inline math \( ... \)
    % Note: Does NOT catch $ ... $ which requires LuaTeX or dangerous hacks
    % Uses same Math-N counter as display math for cross-compilation alignment
    \let\lpsb@origopenmath\(
    \let\lpsb@origclosemath\)
    \def\({%
        \global\advance\lpsbInlineMathCount by 1%
        \global\advance\lpsbInlineMathInContext by 1%
        \lpsbWriteEntry{{"id": "Sec-\the\lpsbMathContextNum-IMath-\the\lpsbInlineMathInContext", "role": "InlineMath", "event": "start", "page": \thepage}}%
        \lpsb@origopenmath
    }%
    \def\){%
        \lpsb@origclosemath
        \lpsbWriteEntry{{"id": "Sec-\the\lpsbMathContextNum-IMath-\the\lpsbInlineMathInContext", "role": "InlineMath", "event": "end", "page": \thepage}}%
    }%
    % Heading hook
    % - \lpsbSectionNum increments for every heading level (used for heading IDs).
    % - \lpsbMathContextNum increments only for top-level headings (used for math IDs).
    \let\lpsb@origsect\@sect
    \def\@sect#1#2#3#4#5#6[#7]#8{%
        \lpsbParaEnd% Close any open paragraph before section starts
        % Always increment heading counter (used for H-* IDs)
        \global\advance\lpsbSectionNum by 1%
        % Only bump math context on top-level headings (chapter/section in most classes)
        \ifnum#2<2\relax
            \global\advance\lpsbMathContextNum by 1%
            \global\lpsbDisplayMathInContext=0%
            \global\lpsbInlineMathInContext=0%
            % Sync with Lua if LuaTeX (for lpsb-math.lua alignment)
            \ifLuaTeX
                \directlua{%
                    if lpsb_math and lpsb_math.new_section then
                        lpsb_math.new_section(tex.count["lpsbMathContextNum"] or 0)
                    end
                }%
            \fi
        \fi
        % #2 = level (0=chapter, 1=section, 2=subsection, etc)
        % #8 = title text
        \lpsbWriteEntry{{"id": "H-\the\lpsbSectionNum", "role": "\lpsb@levelToH{#2}", "event": "start", "level": #2, "title": "\lpsb@escapeJSON{#8}", "page": \thepage}}%
        \lpsb@origsect{#1}{#2}{#3}{#4}{#5}{#6}[{#7}]{#8}%
        \lpsbWriteEntry{{"id": "H-\the\lpsbSectionNum", "role": "\lpsb@levelToH{#2}", "event": "end", "page": \thepage}}%
    }%
    %
    % Hook \@ssect for starred sections (e.g., \section*)
    \let\lpsb@origssect\@ssect
    \def\@ssect#1#2#3#4#5{%
        \lpsbWriteEntry{{"id": "H-starred-\the\lpsbEnvDepth", "role": "H", "event": "start", "title": "\lpsb@escapeJSON{#5}", "page": \thepage}}%
        \lpsb@origssect{#1}{#2}{#3}{#4}{#5}%
        \lpsbWriteEntry{{"id": "H-starred-\the\lpsbEnvDepth", "role": "H", "event": "end", "page": \thepage}}%
    }%
    %
    % Calibration hook for coordinate system
    % Avoid non-kernel macros (\AtBeginShipoutUpperLeft/\put) which may not exist.
    \AddToHook{shipout/before}{%
        \lpsb@savepos%
        \lpsbWriteEntry{{"role": "Calibration", "page": \thepage, "x": \the\lpsb@lastxpos, "y": \the\lpsb@lastypos}}%
    }%
    \typeout{LPSB Info: Package v3.0 active (PDF 2.0 Structure Elements)}%
    %
    % Hook \href if hyperref is loaded
    \@ifpackageloaded{hyperref}{%
        \let\lpsb@orighref\href
        \renewcommand{\href}[2]{%
            \lpsbWriteEntry{{"role": "Link", "event": "start", "uri": "\lpsb@escapeJSON{#1}", "page": \thepage}}%
            \lpsb@orighref{#1}{#2}%
            \lpsbWriteEntry{{"role": "Link", "event": "end", "page": \thepage}}%
        }%
    }{}%
    %
    % Hook \footnote
    \let\lpsb@origfootnote\footnote
    \renewcommand{\footnote}[1]{%
        \lpsbWriteEntry{{"role": "Note", "event": "start", "type": "footnote", "page": \thepage}}%
        \lpsb@origfootnote{#1}%
        \lpsbWriteEntry{{"role": "Note", "event": "end", "page": \thepage}}%
    }%
    %
    % Hook \caption (preserve optional argument)
    \let\lpsb@origcaption\caption
    \renewcommand{\caption}[2][]{%
        \global\advance\lpsbCaptionCount by 1%
        \lpsbParaEnd%
        \lpsbWriteEntry{{"id": "Caption-\the\lpsbCaptionCount", "role": "Caption", "event": "start", "page": \thepage}}%
        \if\relax\detokenize{#1}\relax
            \lpsb@origcaption{#2}%
        \else
            \lpsb@origcaption[#1]{#2}%
        \fi
        \lpsbWriteEntry{{"id": "Caption-\the\lpsbCaptionCount", "role": "Caption", "event": "end", "page": \thepage}}%
    }%
}

\makeatother

% ===================================================================
% End of Document Cleanup
% ===================================================================
\AtEndDocument{%
    % If the document ends while TeX still considers us in a paragraph,
    % \AddToHook{para/end} may not have fired. Close it explicitly.
    \lpsbParaEnd%
    \lpsbWriteEntry{{"role": "Footer", "total_probes": \the\lpsbProbeCount, "total_paragraphs": \the\lpsbParaCount}}%
    \immediate\write\lpsbout{]}%
    \immediate\closeout\lpsbout
    \typeout{LPSB Info: Wrote \the\lpsbProbeCount\space probes, \the\lpsbParaCount\space paragraphs}%
}

\endinput
