# LPSB local overrides (optional)
#
# Usage:
#   cp docs/env.example .env
#   set -a; source .env; set +a
#
# If unset, scripts auto-detect LPSB_DIR from their own location.

# Repo root (optional)
# LPSB_DIR=/path/to/LPSB

# Where arXiv source tarballs live (default: $LPSB_DIR/data/download)
# LPSB_DATA_DIR=/path/to/data/download

# Output directories (defaults under $LPSB_DIR/)
# LPSB_OUT_DIR=/path/to/test_output
# LPSB_OUT_LUA_DIR=/path/to/test_output_lua
# LPSB_OUT_MERGED_DIR=/path/to/test_output_merged

# Optional: override merge script path
# LPSB_MERGE_PY=/path/to/LPSB/merge_lpsb.py

# Optional: docker image override for Lua verify tool
# LPSB_DOCKER_IMAGE=lpsb-texlive:latest

